{
  "name": "docs-virtengine-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical documentation for the VirtEngine Protocol — docs.virtengine.com",
  "scripts": {
    "dev": "astro dev",
    "build": "node ./scripts/build.mjs",
    "check:links": "node ../../scripts/check-links.mjs dist",
    "check:a11y": "node ../../scripts/check-a11y.mjs dist",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name docs-virtengine-com --branch main",
    "preview": "astro preview",
    "astro": "astro",
    "check:schema": "node ./scripts/check-structured-data.mjs dist https://docs.virtengine.com",
    "audit:seo": "node ./scripts/audit-seo-meta.mjs ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/starlight": "^0.36.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/questrial": "^5.2.0",
    "astro": "^5.6.0",
    "pagefind": "^1.4.0",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
