---
import Breadcrumbs, { type Crumb } from "./Breadcrumbs.astro";

/**
 * Standard page header band: breadcrumbs + eyebrow + h1 + lede on the alt surface.
 */
interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { crumbs, eyebrow, title, lede } = Astro.props;
---

<div class="bg-alt border-b border-hairline page-header-band">
  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs crumbs={crumbs} />
    {eyebrow && <p class="eyebrow mt-6 mb-0">{eyebrow}</p>}
    <h1 class="mt-2 mb-0 text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06] tracking-[-0.02em] measure">{title}</h1>
    {lede && <p class="mt-4 mb-0 text-[1.2rem] text-body measure">{lede}</p>}
    <slot />
  </div>
</div>
