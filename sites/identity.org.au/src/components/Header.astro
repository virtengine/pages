---
import { NAV, SITE } from "@data/site";
import Lockup from "./brand/Lockup.astro";

const current = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`);
---

<header class="border-t-4 border-t-navy bg-paper">
  <div class="container-site flex items-center justify-between gap-3 py-4 max-[400px]:px-4">
    <a href="/" class="no-underline" aria-label="identity.org.au home">
      <Lockup markSize={42} />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 list-none m-0 p-0">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block whitespace-nowrap px-2.5 py-2 font-semibold text-[0.95rem] no-underline rounded-tile border-b-[3px] border-transparent",
                  isActive(item.href)
                    ? "text-ink border-b-navy"
                    : "text-action hover:text-action-hover hover:underline underline-offset-4",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-2 hidden xl:block">
          <a
            href={SITE.walletPortal}
            rel="noopener"
            class="btn-primary whitespace-nowrap !px-4 !py-2 text-[0.92rem]"
          >
            Join the launch list
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10m0 0L8 3m4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="sr-only">(January 2027)</span>
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden inline-flex items-center gap-2 rounded-tile border-2 border-action px-3 py-2 font-bold text-action"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      Menu
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none">
        <path d="M1 3h12M1 7h12M1 11h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main menu" class="hidden border-t border-hairline bg-alt lg:!hidden">
    <ul class="container-site list-none m-0 py-2 px-0">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block px-5 py-3 font-semibold no-underline border-l-4",
                isActive(item.href)
                  ? "text-ink border-navy bg-paper"
                  : "text-action border-transparent",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="px-5 py-3">
        <a href={SITE.walletPortal} rel="noopener" class="btn-primary w-full justify-center">
          Join the launch list
        </a>
      </li>
    </ul>
  </nav>
</header>

<!-- Site-wide provenance banner: this is NOT a government service. -->
<div class="border-y border-hairline bg-tint">
  <div class="container-site flex items-start gap-3 py-2.5 text-[0.92rem] text-body">
    <svg width="18" height="18" viewBox="0 0 48 48" fill="none" aria-hidden="true" class="mt-0.5 flex-none">
      <path
        d="M24 2.5 43.5 9.75 V26 c0 11-8 18.7-19.5 21.75 C12.5 44.7 4.5 37 4.5 26 V9.75 Z"
        fill="none"
        stroke="var(--color-steel)"
        stroke-width="3.4"></path>
      <path d="M24 14v12" stroke="var(--color-steel)" stroke-width="4" stroke-linecap="round"></path>
      <circle cx="24" cy="33" r="2.6" fill="var(--color-steel)"></circle>
    </svg>
    <p class="m-0">
      <strong class="text-ink">identity.org.au is not an Australian Government service.</strong>
      It is an open-source community service stewarded by the not-for-profit DETIO Foundation,
      currently in the process of applying for accreditation under the Digital ID Act 2024.
      <a href="/about/what-is-identity-org-au" class="link-plain">How this service is different</a>
    </p>
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("hidden", open);
    nav?.classList.toggle("lg:!hidden", true);
  });
</script>
