---
import Phone from "./Phone.astro";
import ScreenChrome from "./ScreenChrome.astro";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Phone
  label="Wallet app mockup: the document scan step, showing a driver licence positioned inside a guided capture frame."
  class={className}
>
  <ScreenChrome title="Scan your document" step={1} />

  <text x="160" y="176" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="var(--color-ink)">Front of your document</text>
  <text x="160" y="194" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10.5" fill="var(--color-muted)">Line it up inside the frame — hold still</text>

  <!-- capture guide with corner brackets -->
  <rect x="42" y="216" width="236" height="152" rx="8" fill="var(--color-alt)" />
  <g stroke="var(--color-action)" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M42 236v-12a8 8 0 0 1 8-8h12" />
    <path d="M258 216h12a8 8 0 0 1 8 8v12" />
    <path d="M278 348v12a8 8 0 0 1-8 8h-12" />
    <path d="M62 368H50a8 8 0 0 1-8-8v-12" />
  </g>

  <!-- document inside guide -->
  <rect x="58" y="232" width="204" height="120" rx="6" fill="#ffffff" stroke="var(--color-hairline-strong)" stroke-width="1.6" />
  <rect x="58" y="232" width="204" height="22" rx="6" fill="var(--color-tint)" />
  <text x="70" y="247" font-family="Public Sans, sans-serif" font-size="9" font-weight="700" letter-spacing="1" fill="var(--color-steel)">DRIVER LICENCE</text>
  <rect x="70" y="266" width="52" height="62" rx="4" fill="var(--color-alt)" stroke="var(--color-hairline)" />
  <circle cx="96" cy="286" r="10" fill="var(--color-hairline-strong)" />
  <path d="M82 316c3-9 9-13 14-13s11 4 14 13" fill="var(--color-hairline-strong)" />
  <g fill="var(--color-hairline)">
    <rect x="134" y="268" width="112" height="8" rx="3" />
    <rect x="134" y="284" width="88" height="8" rx="3" />
    <rect x="134" y="300" width="100" height="8" rx="3" />
    <rect x="134" y="316" width="64" height="8" rx="3" />
  </g>

  <!-- quality checks -->
  <g font-family="Public Sans, sans-serif" font-size="11" font-weight="600">
    <circle cx="56" cy="404" r="8" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.6" />
    <path d="m52.5 404 2.5 2.5 4.5-5" stroke="var(--color-success-rule)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="72" y="408" fill="var(--color-body)">Edges detected</text>
    <circle cx="56" cy="432" r="8" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.6" />
    <path d="m52.5 432 2.5 2.5 4.5-5" stroke="var(--color-success-rule)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="72" y="436" fill="var(--color-body)">No glare</text>
    <circle cx="56" cy="460" r="8" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1.6" />
    <text x="72" y="464" fill="var(--color-muted)">Hold steady…</text>
  </g>

  <!-- info strip -->
  <rect x="36" y="490" width="248" height="52" rx="6" fill="var(--color-info-bg)" />
  <rect x="36" y="490" width="4" height="52" fill="var(--color-info-rule)" />
  <text x="52" y="511" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" fill="var(--color-ink)">Processed on your device</text>
  <text x="52" y="527" font-family="Public Sans, sans-serif" font-size="9.5" fill="var(--color-body)">Images are encrypted before anything is sent.</text>

  <!-- button -->
  <rect x="36" y="566" width="248" height="44" rx="5" fill="var(--color-action)" />
  <text x="160" y="593" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13.5" font-weight="700" fill="#ffffff">Capture front</text>
</Phone>
