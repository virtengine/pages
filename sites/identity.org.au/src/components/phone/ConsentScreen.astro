---
import Phone from "./Phone.astro";
import ScreenChrome from "./ScreenChrome.astro";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Phone
  label="Wallet app mockup: a consent screen showing a sharing request from a service, listing exactly what will be shared — verification level and an over-18 answer — with approve and decline buttons."
  class={className}
>
  <ScreenChrome title="Sharing request" />

  <text x="160" y="140" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="var(--color-ink)">A service is asking to check your identity</text>

  <!-- requester -->
  <rect x="32" y="158" width="256" height="58" rx="6" fill="var(--color-alt)" />
  <text x="46" y="182" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1" fill="var(--color-steel)">REQUESTED BY</text>
  <text x="46" y="200" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="var(--color-ink)">example-service.com.au</text>

  <text x="32" y="246" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">They will see</text>
  <g font-family="Public Sans, sans-serif">
    <rect x="32" y="258" width="256" height="46" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
    <circle cx="52" cy="281" r="9" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.6" />
    <path d="m48 281 3 3 5-6" stroke="var(--color-success-rule)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="70" y="277" font-size="11.5" font-weight="700" fill="var(--color-ink)">Verification level</text>
    <text x="70" y="293" font-size="9.5" fill="var(--color-muted)">Standard</text>
    <rect x="32" y="312" width="256" height="46" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
    <circle cx="52" cy="335" r="9" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.6" />
    <path d="m48 335 3 3 5-6" stroke="var(--color-success-rule)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="70" y="331" font-size="11.5" font-weight="700" fill="var(--color-ink)">Over 18</text>
    <text x="70" y="347" font-size="9.5" fill="var(--color-muted)">Yes / no only — not your date of birth</text>
  </g>

  <text x="32" y="392" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">They will never see</text>
  <g font-family="Public Sans, sans-serif" font-size="11" font-weight="600" fill="var(--color-body)">
    <g transform="translate(40 404)">
      <rect x="0" y="4" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <path d="M2 4V2.8a2.5 2.5 0 0 1 5 0V4" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <text x="20" y="11">Your documents</text>
    </g>
    <g transform="translate(40 428)">
      <rect x="0" y="4" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <path d="M2 4V2.8a2.5 2.5 0 0 1 5 0V4" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <text x="20" y="11">Your photos or biometric data</text>
    </g>
    <g transform="translate(40 452)">
      <rect x="0" y="4" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <path d="M2 4V2.8a2.5 2.5 0 0 1 5 0V4" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
      <text x="20" y="11">Your date of birth or address</text>
    </g>
  </g>

  <!-- expiry -->
  <rect x="32" y="480" width="256" height="40" rx="6" fill="var(--color-info-bg)" />
  <rect x="32" y="480" width="4" height="40" fill="var(--color-info-rule)" />
  <text x="48" y="504" font-family="Public Sans, sans-serif" font-size="9.5" fill="var(--color-body)">This consent expires automatically in 30 days.</text>

  <!-- actions -->
  <rect x="32" y="540" width="256" height="42" rx="5" fill="var(--color-action)" />
  <text x="160" y="566" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="#ffffff">Approve</text>
  <rect x="32" y="592" width="256" height="40" rx="5" fill="none" stroke="var(--color-action)" stroke-width="2" />
  <text x="160" y="617" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="var(--color-action)">Decline</text>
</Phone>
