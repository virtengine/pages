---
import Phone from "./Phone.astro";
import ScreenChrome from "./ScreenChrome.astro";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Phone
  label="Wallet app mockup: the wallet home screen showing a verified identity credential at Standard level with an over-18 proof available, and a consent activity entry."
  class={className}
>
  <ScreenChrome title="Your Identity Wallet" />

  <!-- credential card -->
  <rect x="32" y="126" width="256" height="150" rx="12" fill="var(--color-navy)" />
  <rect x="32" y="126" width="256" height="150" rx="12" fill="none" stroke="var(--color-navy-hairline)" stroke-width="1" />
  <!-- mark -->
  <path d="M54 146 66.5 150.6 V161 c0 7.2-5.2 12.2-12.5 14.2 -7.3-2-12.5-7-12.5-14.2 V150.6 Z" fill="none" stroke="#6ea3d8" stroke-width="2"></path>
  <path d="m48 160 4.5 4.5 8.5-10" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  <text x="78" y="156" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1.2" fill="var(--color-navy-muted)">VERIFIED IDENTITY</text>
  <text x="78" y="172" font-family="Public Sans, sans-serif" font-size="9" fill="var(--color-navy-muted)">VEID · VirtEngine network</text>

  <text x="54" y="212" font-family="Public Sans, sans-serif" font-size="11" fill="var(--color-navy-muted)">Verification level</text>
  <text x="54" y="234" font-family="Public Sans, sans-serif" font-size="19" font-weight="800" fill="#ffffff">Standard</text>
  <g>
    <rect x="196" y="216" width="72" height="22" rx="11" fill="#0f7a5c" />
    <path d="m208 227 3.5 3.5 6.5-7.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="226" y="231" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" fill="#ffffff">Active</text>
  </g>
  <text x="54" y="260" font-family="Public Sans, sans-serif" font-size="9.5" fill="var(--color-navy-muted)">Documents stay encrypted · nothing stored on this card</text>

  <!-- available proofs -->
  <text x="32" y="308" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">Proofs you can share</text>
  <g font-family="Public Sans, sans-serif">
    <rect x="32" y="320" width="256" height="46" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
    <text x="46" y="340" font-size="11.5" font-weight="700" fill="var(--color-ink)">Over 18</text>
    <text x="46" y="356" font-size="9.5" fill="var(--color-muted)">Zero-knowledge proof — reveals nothing else</text>
    <path d="m264 337 6 6-6 6" stroke="var(--color-action)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <rect x="32" y="374" width="256" height="46" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
    <text x="46" y="394" font-size="11.5" font-weight="700" fill="var(--color-ink)">Verification level</text>
    <text x="46" y="410" font-size="9.5" fill="var(--color-muted)">Confirms Standard — without your documents</text>
    <path d="m264 391 6 6-6 6" stroke="var(--color-action)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <rect x="32" y="428" width="256" height="46" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
    <text x="46" y="448" font-size="11.5" font-weight="700" fill="var(--color-ink)">Verified name</text>
    <text x="46" y="464" font-size="9.5" fill="var(--color-muted)">Shared only with your explicit consent</text>
    <path d="m264 445 6 6-6 6" stroke="var(--color-action)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </g>

  <!-- consent activity -->
  <text x="32" y="512" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">Consent activity</text>
  <rect x="32" y="524" width="256" height="52" rx="6" fill="var(--color-alt)" />
  <circle cx="52" cy="550" r="9" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.6" />
  <path d="m48 550 3 3 5-6" stroke="var(--color-success-rule)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  <text x="70" y="546" font-family="Public Sans, sans-serif" font-size="10.5" font-weight="700" fill="var(--color-ink)">Age check approved</text>
  <text x="70" y="562" font-family="Public Sans, sans-serif" font-size="9.5" fill="var(--color-muted)">Expires in 30 days · tap to review or revoke</text>

  <rect x="32" y="592" width="256" height="40" rx="5" fill="none" stroke="var(--color-action)" stroke-width="2" />
  <text x="160" y="617" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="var(--color-action)">Manage consent</text>
</Phone>
