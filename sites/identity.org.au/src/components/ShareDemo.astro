---
import Phone from "./phone/Phone.astro";

/**
 * Simplified, zero-JS sharing demonstration: request → one-answer proof →
 * receipt. A single radio control set drives both the illustrated phone and
 * the explanatory panel, including the stays-on-device/crosses-boundary
 * accounting. The phone artwork is decorative; panels carry the meaning.
 */
interface Props {
  idPrefix?: string;
  class?: string;
}

const { idPrefix = "share", class: className } = Astro.props;

const states = [
  {
    id: "request",
    label: "Request",
    title: "Approve exactly two answers",
    body: "A service asks for your verification level and whether you are over 18. It also shows what it will never receive, and when its permission ends.",
    stays: "Documents, biometrics and your exact date of birth",
    shared: "Nothing yet — no data moves until you approve",
  },
  {
    id: "proof",
    label: "Proof",
    title: "Send one answer, not your documents",
    body: "Your fields stay locked and encrypted on the phone. The wallet generates a cryptographic yes that the service can check without seeing the underlying data.",
    stays: "Name, date of birth, address and document number",
    shared: "Over 18 — yes, with the approved expiry",
  },
  {
    id: "receipt",
    label: "Receipt",
    title: "Keep a receipt, not a copy",
    body: "The service opens because the signed answer is valid. It keeps a consent receipt and expiry date — not a copy of your identity evidence.",
    stays: "Documents, photos, biometrics and exact birth date",
    shared: "Over 18 — yes, plus a consent receipt",
  },
];
---

<div class:list={["share-demo", className]}>
  <fieldset class="share-steps">
    <legend class="sr-only">Illustrated sharing flow — choose a step</legend>
    {
      states.map((state, index) => (
        <>
          <input
            class="share-input"
            type="radio"
            name={`${idPrefix}-step`}
            id={`${idPrefix}-${state.id}`}
            value={state.id}
            checked={index === 0}
          />
          <label class="share-step" for={`${idPrefix}-${state.id}`}>
            <span class="share-step-number" aria-hidden="true">{index + 1}</span>
            <span>{state.label}</span>
          </label>
        </>
      ))
    }
  </fieldset>

  <div class="share-grid">
    <div class="share-device" aria-hidden="true">
      <Phone label="Illustrated wallet sharing demonstration">
        <g class="share-screen share-screen--request">
          <rect x="15" y="58" width="290" height="46" fill="var(--color-navy)" />
          <path d="M36 70 45 73.4 V80 c0 5-3.7 8.6-9 10 -5.3-1.4-9-5-9-10 V73.4 Z" fill="none" stroke="#ffffff" stroke-width="2" />
          <path d="m32.5 80 3 3 6-7" stroke="#6ea3d8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <text x="56" y="86" font-family="Public Sans, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Sharing request</text>
          <circle cx="130" cy="120" r="4.5" fill="var(--color-action)" />
          <circle cx="146" cy="120" r="4.5" fill="var(--color-hairline)" />
          <circle cx="162" cy="120" r="4.5" fill="var(--color-hairline)" />
          <text x="160" y="140" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10.5" font-weight="600" fill="var(--color-muted)">Step 1 of 3</text>

          <text x="32" y="170" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="var(--color-ink)">A service is asking for proof</text>
          <rect x="32" y="188" width="256" height="56" rx="6" fill="var(--color-alt)" />
          <text x="46" y="210" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1" fill="var(--color-steel)">REQUESTED BY</text>
          <text x="46" y="230" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="var(--color-ink)">example-service.com.au</text>

          <text x="32" y="272" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">They will see</text>
          <rect x="32" y="284" width="256" height="44" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
          <text x="46" y="304" font-family="Public Sans, sans-serif" font-size="11.5" font-weight="700" fill="var(--color-ink)">Verification level — Standard</text>
          <text x="46" y="320" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-muted)">Scope-limited result</text>
          <rect x="32" y="336" width="256" height="44" rx="6" fill="#ffffff" stroke="var(--color-hairline)" />
          <text x="46" y="356" font-family="Public Sans, sans-serif" font-size="11.5" font-weight="700" fill="var(--color-ink)">Over 18 — yes</text>
          <text x="46" y="372" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-muted)">Yes or no only</text>

          <text x="32" y="408" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">They will never see</text>
          <g font-family="Public Sans, sans-serif" font-size="10.5" font-weight="600" fill="var(--color-body)">
            <rect x="40" y="420" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <path d="M42 420v-1.2a2.5 2.5 0 0 1 5 0V420" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <text x="60" y="427">Your documents</text>
            <rect x="40" y="444" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <path d="M42 444v-1.2a2.5 2.5 0 0 1 5 0V444" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <text x="60" y="451">Photos or biometric data</text>
            <rect x="40" y="468" width="9" height="7" rx="1.5" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <path d="M42 468v-1.2a2.5 2.5 0 0 1 5 0V468" fill="none" stroke="var(--color-steel)" stroke-width="1.6" />
            <text x="60" y="475">Exact birth date or address</text>
          </g>

          <rect x="32" y="492" width="256" height="34" rx="6" fill="var(--color-info-bg)" />
          <rect x="32" y="492" width="4" height="34" fill="var(--color-info-rule)" />
          <text x="48" y="513" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">Expires automatically in 30 days.</text>
          <rect x="32" y="536" width="256" height="42" rx="5" fill="var(--color-action)" />
          <text x="160" y="562" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="#ffffff">Approve (demo)</text>
          <rect x="32" y="588" width="256" height="36" rx="5" fill="none" stroke="var(--color-action)" stroke-width="2" />
          <text x="160" y="611" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-action)">Decline (demo)</text>
        </g>

        <g class="share-screen share-screen--proof">
          <rect x="15" y="58" width="290" height="46" fill="var(--color-navy)" />
          <path d="M36 70 45 73.4 V80 c0 5-3.7 8.6-9 10 -5.3-1.4-9-5-9-10 V73.4 Z" fill="none" stroke="#ffffff" stroke-width="2" />
          <path d="m32.5 80 3 3 6-7" stroke="#6ea3d8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <text x="56" y="86" font-family="Public Sans, sans-serif" font-size="15" font-weight="700" fill="#ffffff">One proof leaves</text>
          <circle cx="130" cy="120" r="4.5" fill="var(--color-action)" />
          <circle cx="146" cy="120" r="4.5" fill="var(--color-action)" />
          <circle cx="162" cy="120" r="4.5" fill="var(--color-hairline)" />
          <text x="160" y="140" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10.5" font-weight="600" fill="var(--color-muted)">Step 2 of 3</text>

          <text x="160" y="170" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="var(--color-ink)">Your data stays locked</text>
          <rect x="32" y="188" width="256" height="168" rx="8" fill="var(--color-alt)" stroke="var(--color-hairline)" />
          <text x="46" y="210" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1" fill="var(--color-steel)">STAYS ENCRYPTED</text>
          {
            ["Full name", "Date of birth", "Address", "Document number"].map((label, i) => (
              <g transform={`translate(46 ${220 + i * 32})`}>
                <rect x="0" y="0" width="228" height="26" rx="5" fill="#ffffff" stroke="var(--color-hairline)" />
                <text x="12" y="17" font-family="Public Sans, sans-serif" font-size="10.5" font-weight="600" fill="var(--color-body)">{label}</text>
                <rect x="196" y="8" width="10" height="8" rx="1.5" fill="none" stroke="var(--color-navy)" stroke-width="1.7" />
                <path d="M198 8V6.6a3 3 0 0 1 6 0V8" fill="none" stroke="var(--color-navy)" stroke-width="1.7" />
                <rect x="120" y="10" width="64" height="6" rx="3" fill="var(--color-hairline)" />
              </g>
            ))
          }
          <path class="share-flow" d="M160 366v22" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 7" />
          <path d="m152 380 8 10 8-10" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="48" y="400" width="224" height="82" rx="10" fill="#ffffff" stroke="var(--color-accent)" stroke-width="2.2" />
          <text x="66" y="424" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" letter-spacing="1" fill="var(--color-accent)">SHARED ANSWER</text>
          <circle cx="82" cy="454" r="13" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="2" />
          <path d="m75 454 5 5 9-11" stroke="var(--color-success-rule)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <text x="104" y="450" font-family="Public Sans, sans-serif" font-size="14" font-weight="800" fill="var(--color-ink)">Over 18 — yes</text>
          <text x="104" y="468" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-muted)">One answer · 30-day expiry</text>
          <rect x="32" y="498" width="256" height="40" rx="6" fill="var(--color-info-bg)" />
          <rect x="32" y="498" width="4" height="40" fill="var(--color-info-rule)" />
          <text x="48" y="522" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">The service can check the signature.</text>
          <rect x="32" y="550" width="256" height="40" rx="5" fill="var(--color-action)" />
          <text x="160" y="575" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="#ffffff">Share one answer (demo)</text>
          <text x="160" y="610" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-muted)">Demonstration only — nothing is sent.</text>
        </g>

        <g class="share-screen share-screen--receipt">
          <rect x="15" y="58" width="290" height="46" fill="var(--color-navy)" />
          <path d="M36 70 45 73.4 V80 c0 5-3.7 8.6-9 10 -5.3-1.4-9-5-9-10 V73.4 Z" fill="none" stroke="#ffffff" stroke-width="2" />
          <path d="m32.5 80 3 3 6-7" stroke="#6ea3d8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <text x="56" y="86" font-family="Public Sans, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Proof accepted</text>
          <circle cx="130" cy="120" r="4.5" fill="var(--color-action)" />
          <circle cx="146" cy="120" r="4.5" fill="var(--color-action)" />
          <circle cx="162" cy="120" r="4.5" fill="var(--color-action)" />
          <text x="160" y="140" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10.5" font-weight="600" fill="var(--color-muted)">Step 3 of 3</text>

          <text x="160" y="170" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="13" font-weight="700" fill="var(--color-ink)">The answer is verified</text>
          <rect x="32" y="188" width="256" height="92" rx="10" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.8" />
          <circle cx="160" cy="218" r="17" fill="#ffffff" stroke="var(--color-success-rule)" stroke-width="2.2" />
          <path d="m152 218 6 6 12-14" fill="none" stroke="var(--color-success-rule)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <text x="160" y="256" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="14" font-weight="800" fill="var(--color-ink)">Over 18 confirmed</text>
          <text x="160" y="272" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">Signature valid · request matched</text>

          <text x="32" y="310" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-ink)">What the service keeps</text>
          <rect x="32" y="322" width="256" height="92" rx="8" fill="#ffffff" stroke="var(--color-hairline)" />
          <text x="46" y="346" font-family="Public Sans, sans-serif" font-size="11.5" font-weight="700" fill="var(--color-ink)">One signed answer</text>
          <text x="46" y="364" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">Over 18 — yes · expires in 30 days</text>
          <text x="46" y="388" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">No documents, photos or biometrics</text>
          <rect x="32" y="430" width="256" height="48" rx="6" fill="var(--color-info-bg)" />
          <rect x="32" y="430" width="4" height="48" fill="var(--color-info-rule)" />
          <text x="48" y="452" font-family="Public Sans, sans-serif" font-size="10" font-weight="700" fill="var(--color-ink)">Consent receipt saved</text>
          <text x="48" y="468" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-body)">Review or revoke it any time.</text>
          <rect x="32" y="494" width="256" height="40" rx="5" fill="var(--color-action)" />
          <text x="160" y="519" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12.5" font-weight="700" fill="#ffffff">View consent (demo)</text>
          <rect x="32" y="544" width="256" height="36" rx="5" fill="none" stroke="var(--color-action)" stroke-width="2" />
          <text x="160" y="567" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="12" font-weight="700" fill="var(--color-action)">Replay demo</text>
          <text x="160" y="606" text-anchor="middle" font-family="Public Sans, sans-serif" font-size="10" fill="var(--color-muted)">Demonstration only — nothing is sent.</text>
        </g>
      </Phone>
    </div>

    <div class="share-panels">
      {
        states.map((state, index) => (
          <section class:list={["share-panel", `share-panel--${state.id}`]} aria-label={`Step ${index + 1} of 3: ${state.title}`}>
            <p class="share-kicker">Step {index + 1} of 3 · {state.label}</p>
            <h3>{state.title}</h3>
            <p class="share-body">{state.body}</p>
            <dl class="share-boundary">
              <div>
                <dt>Stays on this device</dt>
                <dd>{state.stays}</dd>
              </div>
              <div>
                <dt>Shared with the service</dt>
                <dd>{state.shared}</dd>
              </div>
            </dl>
          </section>
        ))
      }
    </div>
  </div>
  <p class="share-hint">Choose a step to walk through the illustrated consent exchange.</p>
</div>
