---
/**
 * Gov-pattern notice/alert panel: left rule + tinted surface + icon.
 */
interface Props {
  tone?: "info" | "warning" | "success";
  /** Optional bold lead-in, e.g. "Important". */
  title?: string;
  class?: string;
}
const { tone = "info", title, class: className } = Astro.props;

const tones = {
  info: { bg: "bg-info-bg", rule: "border-l-info-rule", icon: "var(--color-info-rule)" },
  warning: { bg: "bg-warn-bg", rule: "border-l-warn-rule", icon: "var(--color-warn)" },
  success: { bg: "bg-success-bg", rule: "border-l-success-rule", icon: "var(--color-success-rule)" },
} as const;
const t = tones[tone];
---

<div class:list={["border-l-4 rounded-r-tile px-5 py-4", t.bg, t.rule, className]} role={tone === "warning" ? "note" : undefined}>
  <div class="flex gap-3">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-0.5 flex-none">
      {
        tone === "success" ? (
          <>
            <circle cx="12" cy="12" r="10" stroke={t.icon} stroke-width="2" />
            <path d="m7.5 12.5 3 3 6-7" stroke={t.icon} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </>
        ) : tone === "warning" ? (
          <>
            <path d="M12 3 22 20H2Z" stroke={t.icon} stroke-width="2" stroke-linejoin="round" />
            <path d="M12 9.5v4.5" stroke={t.icon} stroke-width="2.2" stroke-linecap="round" />
            <circle cx="12" cy="17" r="1.3" fill={t.icon} />
          </>
        ) : (
          <>
            <circle cx="12" cy="12" r="10" stroke={t.icon} stroke-width="2" />
            <path d="M12 11v6" stroke={t.icon} stroke-width="2.2" stroke-linecap="round" />
            <circle cx="12" cy="7.5" r="1.3" fill={t.icon} />
          </>
        )
      }
    </svg>
    <div class="text-[0.98rem] text-body [&>p]:m-0 [&>p+p]:mt-2">
      {title && <p class="font-bold text-ink">{title}</p>}
      <slot />
    </div>
  </div>
</div>
