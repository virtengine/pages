---
interface Props {
  /** The footer places the supplied full-colour logo on a light brand tile. */
  variant?: "solid" | "reversed";
  markSize?: number;
  support?: boolean;
}

const { variant = "solid", markSize = 40, support = false } = Astro.props;
const logoHeight = Math.round(markSize * 0.82);
---

<span class:list={["inline-flex items-center", variant === "reversed" && "rounded-tile bg-paper px-3 py-2"]}>
  <img
    src="/brand/logo.png"
    width="1415"
    height="320"
    alt="identity.org.au"
    class="block h-auto w-auto max-w-[220px] max-[400px]:max-w-[170px]"
    style={`height:${logoHeight}px`}
  />
  {
    support && (
      <span class="sr-only">Identity Wallet · VirtEngine ecosystem</span>
    )
  }
</span>
