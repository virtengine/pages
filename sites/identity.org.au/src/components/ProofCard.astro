---
/**
 * ID-1 specimen card. One foil means genuine. Fields show a checkable claim,
 * never a document. The MRZ is a specimen, not a person.
 */
import Guilloche from "./Guilloche.astro";

interface Props {
  seed?: string;
  claim?: string;
  result?: string;
  level?: string;
  record?: string;
  status?: string;
}

const {
  seed = "IDAU-SPECIMEN-0001",
  claim = "Over 18",
  result = "Yes",
  level = "Standard",
  record = "IDAU-0001",
  status = "Verified",
} = Astro.props;
---

<article class="proof-card" data-proof-card aria-label="Specimen proof card. A sample of what a service receives: the claim, not the document.">
  <div class="proof-card-ground" aria-hidden="true">
    <Guilloche seed={seed} ink={0.55} focus="50% 48%" />
  </div>
  <div class="foil foil-wash" aria-hidden="true"></div>
  <div class="foil foil-core" aria-hidden="true"></div>
  <div class="proof-card-top">
    <p class="proof-kicker">identity.org.au · specimen</p>
    <p class="level-chip">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6.2 4.6 8.8 10 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>{status} · {level}</span>
    </p>
  </div>
  <dl class="proof-fields">
    <div>
      <dt>Claim</dt>
      <dd>{claim}</dd>
    </div>
    <div>
      <dt>Result</dt>
      <dd>{result}</dd>
    </div>
    <div>
      <dt>Record</dt>
      <dd>{record}</dd>
    </div>
    <div>
      <dt>Documents</dt>
      <dd>Not shared</dd>
    </div>
  </dl>
  <p class="mrz" aria-label="Specimen machine-readable zone. Not a real identity document. It records a sample claim and that documents were not shared.">
    <span>IDAUASPECIMEN&lt;&lt;PROOF</span><span>{`CLAIM<${claim.toUpperCase().replace(/[^A-Z0-9]/g, "")}`}</span><br />
    <span>{record.replace("-", "")}&lt;AUS</span><span>RESULT&lt;YES&lt;&lt;DOCS&lt;NONE</span>
  </p>
</article>

<script>
  /**
   * The light is treated as fixed in the room, not glued to the card. That one
   * decision gives both behaviours the brief asks for and keeps them from
   * fighting: scrolling carries the card past the light so the sheen travels
   * down it, and the pointer nudges that position locally. Both feed the same
   * two custom properties, so there is one light source, not two effects.
   *
   * Everything here is decoration. Every value on the card is already in the
   * DOM as text, so the card reads identically with no pointer, no script, or
   * reduced motion on.
   */
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (value: number, low: number, high: number) => Math.min(high, Math.max(low, value));

  for (const card of document.querySelectorAll<HTMLElement>("[data-proof-card]")) {
    if (card.dataset.proofCardWired === "true") continue;
    card.dataset.proofCardWired = "true";

    /** Where the pointer is asking the light to be, in card percent. */
    const to = { x: 50, y: 50 };
    /** Where the light actually is. Eases toward `to`, which is the lag. */
    const from = { x: 50, y: 50 };
    const tilt = { x: 0, y: 0 };
    /** Scroll contribution, in mask percent. Additive, so it never cancels
     *  the pointer the way an absolute scroll aim would. */
    let drift = 0;
    let frame = 0;

    const paint = () => {
      frame = 0;
      const ease = calm.matches ? 1 : 0.16;
      from.x += (to.x - from.x) * ease;
      from.y += (to.y - from.y) * ease;
      // Tilt reads the same pair, so the card leans away from the light the
      // way a physical card does.
      tilt.x += (to.y / 50 - 1 - tilt.x) * ease;
      tilt.y += (1 - to.x / 50 - tilt.y) * ease;

      // Snap once the gap stops being visible, so the glide lands on a real
      // resting value instead of asymptoting forever.
      const near = (a: number, b: number) => Math.abs(a - b) < 0.05;
      if (near(from.x, to.x)) from.x = to.x;
      if (near(from.y, to.y)) from.y = to.y;
      if (near(tilt.x, to.y / 50 - 1)) tilt.x = to.y / 50 - 1;
      if (near(tilt.y, 1 - to.x / 50)) tilt.y = 1 - to.x / 50;

      card.style.setProperty("--tilt-x", `${(tilt.x * 3.4).toFixed(2)}deg`);
      card.style.setProperty("--tilt-y", `${(tilt.y * 3.4).toFixed(2)}deg`);
      card.style.setProperty("--shift-x", `${(((to.x - 50) / 50) * -3).toFixed(2)}px`);
      card.style.setProperty("--shift-y", `${(((to.y - 50) / 50) * -2).toFixed(2)}px`);

      // The mask is larger than the card, so its position is expressed in the
      // mask's own space, not the card's, and can run past either edge to let
      // the band leave the card entirely.
      card.style.setProperty("--lx", `${(50 - (from.x - 50) * 1.15).toFixed(2)}%`);
      card.style.setProperty("--ly", `${(50 - (from.y - 50) * 1.15 + drift).toFixed(2)}%`);

      // Pointer events stop when the pointer stops, so input alone cannot
      // finish the glide. Hold the frame loop open until it lands.
      if (from.x !== to.x || from.y !== to.y) schedule();
    };

    function schedule() {
      if (!frame) frame = requestAnimationFrame(paint);
    }

    const aim = (clientX: number, clientY: number) => {
      const box = card.getBoundingClientRect();
      if (!box.width || !box.height) return;
      // Gain is set so a pointer anywhere near the card sweeps the sheen right
      // across it, and a pointer further out keeps travelling until the band
      // is off the card rather than parking at the border.
      const dx = (clientX - (box.left + box.width / 2)) / (box.width * 0.75);
      const dy = (clientY - (box.top + box.height / 2)) / (box.height * 0.75);
      to.x = clamp(50 + dx * 46, -22, 122);
      to.y = clamp(50 + dy * 46, -22, 122);
      schedule();
    };

    const rest = () => {
      to.x = 50;
      to.y = 50;
      schedule();
    };

    const onScroll = () => {
      const box = card.getBoundingClientRect();
      // Off screen: leave the last value alone rather than thrash the vars.
      if (box.bottom < -80 || box.top > window.innerHeight + 80) return;
      drift = ((box.top + box.height / 2 - window.innerHeight / 2) / window.innerHeight) * 90;
      schedule();
    };

    // Stable references: removeEventListener only matches the same function
    // object, so these cannot be inlined arrows.
    const onMove = (event: PointerEvent) => aim(event.clientX, event.clientY);

    const attach = () => {
      if (card.dataset.proofCardBound === "true") return;
      card.dataset.proofCardBound = "true";
      card.addEventListener("pointermove", onMove);
      card.addEventListener("pointerleave", rest);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    };

    const detach = () => {
      if (card.dataset.proofCardBound !== "true") return;
      delete card.dataset.proofCardBound;
      card.removeEventListener("pointermove", onMove);
      card.removeEventListener("pointerleave", rest);
      window.removeEventListener("scroll", onScroll);
      drift = 0;
      rest();
    };

    if (!calm.matches) {
      if (fine.matches) attach();
      fine.addEventListener("change", () => (fine.matches ? attach() : detach()));
    }
  }
</script>
