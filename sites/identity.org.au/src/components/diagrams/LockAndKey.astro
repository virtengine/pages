---
/**
 * Signature "lock and key" diagram: the journey of one verification through a
 * trusted processing unit. Grounded facts: pkg/enclave_runtime (SEV-SNP / SGX /
 * Nitro, hardware key derivation, vTPM sealing), x/enclave (on-chain attestation
 * verification, measurement records), BIOMETRIC_DATA_ADDENDUM (results only,
 * destruction). Flat duotone house style; CSS-only motion with reduced-motion kill.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 960 648"
  role="img"
  aria-label="Diagram of the lock and the key: your documents and biometrics are sealed with encryption on your own device, where the keys stay. The encrypted parcel travels unreadable to everyone. Before it can enter the trusted processing unit — a hardware-sealed vault — the chain checks the vault's measurement at an attestation gate. Inside, keys are forged in hardware and never exist outside, verification runs, and the raw data is destroyed. Only the result — a score and tier — leaves for the chain. Operators, providers and the foundation stand outside the vault with no access path: there is no operator door."
  class:list={["block w-full h-auto", className]}
  font-family="Public Sans, sans-serif"
>
  <!-- ================= zone A: your device ================= -->
  <g>
    <rect x="26" y="66" width="204" height="336" rx="8" fill="var(--color-navy)" opacity="0.08" transform="translate(5 5)" />
    <rect x="26" y="66" width="204" height="336" rx="8" fill="#ffffff" stroke="var(--color-hairline-strong)" stroke-width="1.5" />
    <rect x="26" y="66" width="204" height="40" rx="8" fill="var(--color-navy)" />
    <rect x="26" y="92" width="204" height="14" fill="var(--color-navy)" />
    <text x="44" y="91" font-size="14" font-weight="700" fill="#ffffff">1 · On your device</text>

    <!-- evidence: document + face -->
    <g font-size="11.5" fill="var(--color-body)">
      <rect x="42" y="120" width="172" height="52" rx="5" fill="var(--color-alt)" />
      <rect x="52" y="132" width="20" height="28" rx="2.5" fill="none" stroke="var(--color-steel)" stroke-width="1.7" />
      <path d="M56 139h12M56 145h12M56 151h8" stroke="var(--color-steel)" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="92" cy="141" r="7" fill="none" stroke="var(--color-steel)" stroke-width="1.7" />
      <path d="M83 158a9.5 9.5 0 0 1 18 0" fill="none" stroke="var(--color-steel)" stroke-width="1.7" stroke-linecap="round" />
      <text x="112" y="141" font-weight="700" fill="var(--color-ink)">Documents +</text>
      <text x="112" y="156" font-weight="700" fill="var(--color-ink)">biometrics</text>
    </g>

    <!-- big lock: sealed here -->
    <g>
      <rect x="42" y="184" width="172" height="102" rx="5" fill="var(--color-tint)" stroke="var(--color-info-rule)" stroke-width="1.3" />
      <rect x="103" y="222" width="50" height="40" rx="6" fill="var(--color-navy)" />
      <path d="M112 222v-12a16 16 0 0 1 32 0v12" fill="none" stroke="var(--color-navy)" stroke-width="6" />
      <circle cx="128" cy="238" r="5" fill="#6ea3d8" />
      <path d="M128 241v9" stroke="#6ea3d8" stroke-width="3.4" stroke-linecap="round" />
      <text x="128" y="278" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-ink)">Sealed before it moves</text>
    </g>

    <!-- key stays here -->
    <g>
      <rect x="42" y="298" width="172" height="88" rx="5" fill="var(--color-alt)" />
      <g transform="translate(58 322)">
        <circle cx="10" cy="10" r="8.5" fill="none" stroke="var(--color-action)" stroke-width="2.6" />
        <circle cx="10" cy="10" r="2.6" fill="var(--color-action)" />
        <path d="M17 17l17 17M28 28l6-6M33 33l5-5" stroke="var(--color-action)" stroke-width="2.6" stroke-linecap="round" />
      </g>
      <text x="112" y="330" font-size="11.5" font-weight="700" fill="var(--color-ink)">Your keys never</text>
      <text x="112" y="345" font-size="11.5" font-weight="700" fill="var(--color-ink)">leave this phone</text>
      <text x="112" y="362" font-size="10.5" fill="var(--color-muted)">Held in secure hardware</text>
      <text x="112" y="376" font-size="10.5" fill="var(--color-muted)">— not exportable</text>
    </g>
  </g>

  <!-- ================= zone B: transit ================= -->
  <g>
    <text x="308" y="150" text-anchor="middle" font-size="11" font-weight="700" letter-spacing="1" fill="var(--color-steel)">IN TRANSIT</text>
    <!-- rail -->
    <path d="M234 196 H388" stroke="var(--color-hairline-strong)" stroke-width="2" stroke-dasharray="7 6" fill="none" />
    <path d="m381 190 8 6-8 6" fill="none" stroke="var(--color-hairline-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <!-- travelling sealed parcel (CSS animated) -->
    <g class="lk-parcel">
      <rect x="248" y="172" width="46" height="34" rx="5" fill="var(--color-navy)" />
      <path d="M258 172v-7a13 13 0 0 1 26 0v7" fill="none" stroke="var(--color-navy)" stroke-width="4.6" />
      <circle cx="271" cy="186" r="3.6" fill="#6ea3d8" />
      <path d="M271 188.4v6" stroke="#6ea3d8" stroke-width="2.6" stroke-linecap="round" />
    </g>
    <!-- opaque-to-everyone note: crossed eye -->
    <g transform="translate(284 236)">
      <path d="M-12 8c4-6.5 9.5-10 16-10s12 3.5 16 10c-4 6.5-9.5 10-16 10S-8 14.5-12 8Z" transform="translate(-4 -8)" fill="none" stroke="var(--color-muted)" stroke-width="1.8" />
      <circle cx="0" cy="0" r="3.4" fill="none" stroke="var(--color-muted)" stroke-width="1.8" />
      <path d="M-15 12 15 -12" stroke="var(--color-muted)" stroke-width="2.2" stroke-linecap="round" />
    </g>
    <text x="308" y="272" text-anchor="middle" font-size="10.5" fill="var(--color-muted)">Unreadable to every</text>
    <text x="308" y="286" text-anchor="middle" font-size="10.5" fill="var(--color-muted)">network, carrier</text>
    <text x="308" y="300" text-anchor="middle" font-size="10.5" fill="var(--color-muted)">and server it crosses</text>
  </g>

  <!-- ================= zone C: the trusted processing unit ================= -->
  <g>
    <!-- depth shadow -->
    <rect x="396" y="46" width="336" height="392" rx="12" fill="var(--color-navy)" opacity="0.1" transform="translate(6 6)" />
    <!-- outer vault wall: double line -->
    <rect x="396" y="46" width="336" height="392" rx="12" fill="var(--color-navy)" />
    <rect x="404" y="54" width="320" height="376" rx="8" fill="none" stroke="var(--color-navy-hairline)" stroke-width="2" />
    <text x="564" y="80" text-anchor="middle" font-size="14.5" font-weight="700" fill="#ffffff">2 · The trusted processing unit</text>
    <text x="564" y="97" text-anchor="middle" font-size="10.5" fill="var(--color-navy-muted)">A hardware-sealed vault — AMD SEV-SNP · Intel SGX · AWS Nitro</text>

    <!-- "no operator door": hatched sealed wall segment, top-right -->
    <g>
      <rect x="620" y="46" width="88" height="14" fill="var(--color-navy)" />
      <path d="M624 60 634 46M636 60 646 46M648 60 658 46M660 60 670 46M672 60 682 46M684 60 694 46M696 60 706 46" stroke="var(--color-navy-hairline)" stroke-width="2" />
    </g>

    <!-- attestation gate on the left wall -->
    <g>
      <rect x="382" y="150" width="30" height="110" rx="5" fill="var(--color-navy-panel)" stroke="#6ea3d8" stroke-width="2" />
      <!-- measurement seal: concentric fingerprint arcs + pulse -->
      <g transform="translate(397 186)">
        <circle class="lk-gate-pulse" cx="0" cy="0" r="13" fill="none" stroke="#6ea3d8" stroke-width="1.6" opacity="0.5" />
        <circle cx="0" cy="0" r="9" fill="none" stroke="#6ea3d8" stroke-width="1.8" />
        <path d="M-4.5 0a4.5 4.5 0 0 1 9 0c0 3-1 5-2.6 6.6" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
        <path d="M0 -1.6v4" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
      </g>
      <path d="m392 232 4.5 4.5 8-9" fill="none" stroke="#7fd0a8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
    <text x="308" y="330" font-size="10.5" fill="var(--color-muted)" text-anchor="middle">
      <tspan x="308" dy="0">The attestation gate:</tspan>
      <tspan x="308" dy="14">the chain verifies the</tspan>
      <tspan x="308" dy="14">vault's exact measurement</tspan>
      <tspan x="308" dy="14">before any data enters</tspan>
    </text>

    <!-- inside the vault: three steps -->
    <g font-size="11.5">
      <!-- step: key forged inside -->
      <rect x="428" y="116" width="276" height="86" rx="6" fill="var(--color-navy-panel)" stroke="var(--color-navy-hairline)" />
      <g transform="translate(448 144)">
        <circle cx="10" cy="14" r="9" fill="none" stroke="#6ea3d8" stroke-width="2.6" />
        <circle cx="10" cy="14" r="2.8" fill="#6ea3d8" />
        <path d="M17.5 21.5 36 40M28 31.5l6.5-6.5M33.5 37l5.5-5.5" stroke="#6ea3d8" stroke-width="2.6" stroke-linecap="round" />
        <!-- anvil / forge base -->
        <path d="M2 44h34" stroke="var(--color-navy-hairline)" stroke-width="3" stroke-linecap="round" />
      </g>
      <text x="504" y="143" font-weight="700" fill="#ffffff">The key is forged inside</text>
      <text x="504" y="160" fill="var(--color-navy-muted)">Derived from the hardware itself,</text>
      <text x="504" y="175" fill="var(--color-navy-muted)">sealed to this vault — it never</text>
      <text x="504" y="190" fill="var(--color-navy-muted)">exists anywhere outside it</text>

      <!-- step: verification runs -->
      <rect x="428" y="212" width="276" height="66" rx="6" fill="var(--color-navy-panel)" stroke="var(--color-navy-hairline)" />
      <g transform="translate(450 230)">
        <circle cx="14" cy="14" r="13" fill="none" stroke="#7fd0a8" stroke-width="2.2" />
        <path d="m7.5 14.5 4.5 4.5 9-10" fill="none" stroke="#7fd0a8" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <text x="504" y="238" font-weight="700" fill="#ffffff">Verification runs</text>
      <text x="504" y="255" fill="var(--color-navy-muted)">Document checks, face match,</text>
      <text x="504" y="270" fill="var(--color-navy-muted)">liveness — scored in isolation</text>

      <!-- step: raw data destroyed -->
      <rect x="428" y="288" width="276" height="86" rx="6" fill="var(--color-navy-panel)" stroke="var(--color-warn-rule)" stroke-width="1.4" />
      <g transform="translate(450 306)">
        <rect x="0" y="0" width="30" height="13" rx="2.5" fill="none" stroke="var(--color-warn-rule)" stroke-width="2" />
        <path d="M5 13v14M11.5 13v18M18.5 13v14M25 13v18" stroke="var(--color-warn-rule)" stroke-width="2" stroke-linecap="round" />
        <path d="M7 6.5h16" stroke="var(--color-warn-rule)" stroke-width="2" stroke-linecap="round" />
      </g>
      <text x="504" y="314" font-weight="700" fill="#ffffff">Raw data is destroyed</text>
      <text x="504" y="331" fill="var(--color-navy-muted)">The vault keeps nothing: your</text>
      <text x="504" y="346" fill="var(--color-navy-muted)">documents and biometrics are</text>
      <text x="504" y="361" fill="var(--color-navy-muted)">destroyed when scoring ends</text>
    </g>

    <text x="564" y="412" text-anchor="middle" font-size="10.5" fill="var(--color-navy-muted)">No window · no console · no operator door — by design, not by policy</text>
  </g>

  <!-- ================= zone D: only the result leaves ================= -->
  <g>
    <path d="M732 196 H798" stroke="var(--color-success-rule)" stroke-width="2.5" fill="none" />
    <path d="m792 190 8 6-8 6" fill="none" stroke="var(--color-success-rule)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <text x="765" y="176" text-anchor="middle" font-size="10.5" font-weight="700" fill="var(--color-accent)">Result only</text>

    <rect x="804" y="120" width="138" height="176" rx="8" fill="var(--color-navy)" opacity="0.08" transform="translate(4 4)" />
    <rect x="804" y="120" width="138" height="176" rx="8" fill="#ffffff" stroke="var(--color-hairline-strong)" stroke-width="1.5" />
    <rect x="804" y="120" width="138" height="36" rx="8" fill="var(--color-navy)" />
    <rect x="804" y="142" width="138" height="14" fill="var(--color-navy)" />
    <text x="873" y="143" text-anchor="middle" font-size="12.5" font-weight="700" fill="#ffffff">3 · The chain</text>
    <!-- linked blocks -->
    <g transform="translate(830 172)">
      <rect x="0" y="0" width="24" height="18" rx="3" fill="none" stroke="var(--color-steel)" stroke-width="1.8" />
      <rect x="32" y="0" width="24" height="18" rx="3" fill="none" stroke="var(--color-steel)" stroke-width="1.8" />
      <rect x="64" y="0" width="24" height="18" rx="3" fill="none" stroke="var(--color-steel)" stroke-width="1.8" />
      <path d="M24 9h8M56 9h8" stroke="var(--color-steel)" stroke-width="1.8" />
    </g>
    <g>
      <rect x="818" y="206" width="110" height="42" rx="5" fill="var(--color-success-bg)" stroke="var(--color-success-rule)" stroke-width="1.2" />
      <text x="873" y="224" text-anchor="middle" font-size="11" font-weight="700" fill="var(--color-ink)">Score + tier</text>
      <text x="873" y="240" text-anchor="middle" font-size="10.5" fill="var(--color-body)">Pass / fail results</text>
    </g>
    <text x="873" y="268" text-anchor="middle" font-size="10.5" fill="var(--color-muted)">Never documents,</text>
    <text x="873" y="282" text-anchor="middle" font-size="10.5" fill="var(--color-muted)">never biometrics</text>
  </g>

  <!-- ================= zone E: everyone outside ================= -->
  <g>
    <text x="564" y="486" text-anchor="middle" font-size="11" font-weight="700" letter-spacing="1" fill="var(--color-steel)">OUTSIDE THE VAULT — NO ACCESS PATH EXISTS</text>
    {
      [
        { x: 448, label: "Operators" },
        { x: 564, label: "Providers" },
        { x: 680, label: "The foundation" },
      ].map((party) => (
        <g>
          <path d={`M${party.x} 508 V446`} stroke="var(--color-hairline-strong)" stroke-width="2" stroke-dasharray="4 5" fill="none" />
          <g transform={`translate(${party.x} 452)`}>
            <circle cx="0" cy="0" r="9" fill="#ffffff" stroke="var(--color-warn-rule)" stroke-width="2" />
            <path d="M-4 -4 4 4M4 -4 -4 4" stroke="var(--color-warn-rule)" stroke-width="2" stroke-linecap="round" />
          </g>
          <circle cx={party.x} cy="524" r="8" fill="none" stroke="var(--color-muted)" stroke-width="2" />
          <path d={`M${party.x - 13} 552a13 13 0 0 1 26 0`} fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" />
          <text x={party.x} y="574" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-ink)">{party.label}</text>
        </g>
      ))
    }
    <text x="564" y="600" text-anchor="middle" font-size="11" fill="var(--color-muted)">Designed so that no one — not operators, not providers, not the foundation — can open the processing environment</text>
  </g>

  <!-- caption -->
  <text x="480" y="634" text-anchor="middle" font-size="11.5" fill="var(--color-muted)">The lock seals on your device · the gate checks the vault before data enters · the key never exists outside the hardware · only the result leaves</text>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .lk-parcel {
      animation: lk-travel 5.5s ease-in-out infinite;
    }
    .lk-gate-pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: lk-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes lk-travel {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    82% {
      transform: translateX(92px);
      opacity: 1;
    }
    97%,
    100% {
      transform: translateX(104px);
      opacity: 0;
    }
  }
  @keyframes lk-pulse {
    0% {
      transform: scale(0.72);
      opacity: 0.75;
    }
    70% {
      transform: scale(1.25);
      opacity: 0;
    }
    100% {
      transform: scale(1.25);
      opacity: 0;
    }
  }
</style>
