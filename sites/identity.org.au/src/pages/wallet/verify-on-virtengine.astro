---
import Guide from "@layouts/Guide.astro";
import Alert from "@components/Alert.astro";
import Callout from "@components/Callout.astro";
import ServiceFigure from "@components/ServiceFigure.astro";
import Steps from "@components/Steps.astro";
import TableScroll from "@components/TableScroll.astro";
import VerifyFlow from "@components/diagrams/VerifyFlow.astro";
import { WALLET_NAV } from "@data/nav-sections";
import { TIERS } from "@data/tiers";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Wallet", href: "/wallet" },
  { name: "Verify on VirtEngine", href: "/wallet/verify-on-virtengine" },
];

const flowSteps = [
  {
    title: "Create your wallet",
    body: "Set up the Identity Wallet — the mobile app for capture, the web wallet at my.identity.org.au for management. Every wallet starts Unverified.",
    detail: ["No identity checks yet — just keys created on your device."],
  },
  {
    title: "Complete verification levels",
    body: "Work through the evidence steps your target level needs: document capture and liveness for Standard; hardware biometrics and device attestation for Trusted. Everything is encrypted on your device before it moves.",
    detail: [
      "Each step is consented separately, and you review before anything is submitted.",
      "You only climb as high as the actions you want actually require.",
    ],
  },
  {
    title: "The network scores and records",
    body: "Governance-approved verifiers process your encrypted evidence and the VEID module computes a composite score. Your tier — Basic, Standard, Trusted — is derived from that score and recorded on-chain.",
    detail: [
      "The chain records results and encrypted references, never readable evidence.",
      "Scoring logic is open source — the model is inspectable, not a black box.",
    ],
  },
  {
    title: "Choose whether to present a proof",
    body: "VEID is not a universal marketplace gate. Where supported, an individual offer may ask for a clearly disclosed proof; you can choose to meet it or select another offer.",
    detail: ["A proof request applies to that offer, not every marketplace action."],
  },
  {
    title: "Present the requested claim — not your documents",
    body: "When you choose an offer with a VEID requirement, present only the requested proof. The provider does not receive your original document image or full OCR output; do not assume every service uses VEID.",
  },
];
---

<Guide
  title="Verify on VirtEngine"
  metaTitle="Verify on VirtEngine: Tiers On-Chain | identity.org.au"
  description="How VEID keeps source identity documents on your device and lets you choose whether to present an offer-specific proof on VirtEngine."
  lede="VEID is an optional, privacy-preserving trust signal. Keep original identity document images on your device and choose whether to present a disclosed proof for a specific offer."
  eyebrow="The service"
  breadcrumbs={crumbs}
  sectionLabel="The wallet"
  sectionNav={WALLET_NAV}
>
  <div class="prose-service">
    <p>
      The VirtEngine network is a decentralised cloud marketplace: tenants deploy workloads,
      providers lease capacity, and the chain settles between them. VEID is not a general
      participation requirement. Where a deployed protocol and client support it, a provider
      may request a specific proof for an individual offer. You decide whether to provide that
      proof or choose another listing.
    </p>
  </div>

  <ServiceFigure
    rail="Wallet to marketplace"
    railRight="Offer-specific proof"
    scroll
    class="mt-8"
    caption="Original document images stay on your device; only separately approved data may be submitted, and any proof request is specific to an offer."
  >
    <VerifyFlow />
  </ServiceFigure>

  <div class="prose-service mt-10">
    <h2>The flow, end to end</h2>
  </div>
  <Steps steps={flowSteps} class="mt-6" />

  <div class="prose-service mt-10">
    <h2>What a provider can learn from a proof</h2>
  </div>
  <TableScroll label="What an offer-specific proof shares and keeps private" class="mt-5">
    <table class="table-gov">
      <caption class="sr-only">The limited information a provider may receive from a proof requested by an individual offer</caption>
      <thead>
        <tr>
          <th scope="col">Only if you present the requested proof</th>
          <th scope="col">Not included in that proof</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>The claim or threshold result requested by that offer</td>
          <td>Your original document images and full OCR output</td>
        </tr>
        <tr>
          <td>A proof that the requested threshold is met</td>
          <td>Your exact score history and unrelated attributes</td>
        </tr>
        <tr>
          <td>A zero-knowledge result for the specific question, where supported</td>
          <td>Biometric templates or raw biometric evidence</td>
        </tr>
        <tr>
          <td>Only the claim you separately approved for presentation</td>
          <td>Data from scopes you did not approve for that purpose</td>
        </tr>
      </tbody>
    </table>
  </TableScroll>

  <div class="prose-service mt-10">
    <h2>When an individual offer asks for a proof</h2>
    <p>
      VEID does not gate the marketplace as a whole. Where the active protocol and client
      support offer-specific requirements, a provider must disclose the requested claim and
      purpose before you commit. You can satisfy that request or choose a different listing.
      Sensitive protocol roles may have separate requirements from marketplace offers.
    </p>
  </div>
  <TableScroll label="Verification levels and possible scoped proofs" class="mt-5">
    <table class="table-gov">
      <caption class="sr-only">Examples of proofs that may be supported at each verification level; these are not universal marketplace permissions</caption>
      <thead>
        <tr>
          <th scope="col">Your tier</th>
          <th scope="col">Possible scoped use</th>
        </tr>
      </thead>
      <tbody>
        {
          TIERS.map((tier) => (
            <tr>
              <th scope="row">{tier.name}</th>
              <td>{tier.unlocks.join(" · ")}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </TableScroll>

  <Callout title="If an offer requests a higher-assurance proof" class="mt-8">
    <p>
      A supported offer must show its requested proof before you commit. Your wallet should
      explain what the proof means and what data it uses; you can decline and choose an offer
      without that requirement. See <a href="/get-started/verification-levels" class="link-plain">verification levels</a>
      for the evidence behind each tier.
    </p>
  </Callout>

  <Alert tone="info" title="Network status honesty" class="mt-8">
    <p>
      The VirtEngine network and the wallet are open-source infrastructure rolling out together.
      Offer-specific proof support depends on the active protocol and client; requirements may
      evolve through network governance. This page describes the policy model, and the
      <a href="https://docs.virtengine.com/veid/overview" rel="noopener" class="link-plain" target="_blank">technical documentation</a>
      tracks the current parameters.
    </p>
  </Alert>
</Guide>
