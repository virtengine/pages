---
import Base from "@layouts/Base.astro";
import Alert from "@components/Alert.astro";
import CardLink from "@components/CardLink.astro";
import ClosingBand from "@components/ClosingBand.astro";
import FactStrip from "@components/FactStrip.astro";
import Section from "@components/Section.astro";
import ServiceFigure from "@components/ServiceFigure.astro";
import ServiceHero from "@components/ServiceHero.astro";
import Steps from "@components/Steps.astro";
import CredentialScreen from "@components/phone/CredentialScreen.astro";
import WebPortalFrame from "@components/phone/WebPortalFrame.astro";
import { SITE } from "@data/site";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Wallet", href: "/wallet" },
];

const portalSteps = [
  {
    title: "See what services see",
    body: "Your verification level and available proofs, shown exactly as a requesting service would receive them.",
  },
  {
    title: "Approve or revoke",
    body: "Grant a tightly scoped consent, set its expiry, or revoke it at any time. Every decision is timestamped.",
  },
  {
    title: "Control sessions",
    body: "Review devices and browsers, end any session immediately, and recover on a new phone by re-verifying.",
  },
];
---

<Base
  title="The Identity Wallet service | identity.org.au"
  description="The Identity Wallet is the real service behind identity.org.au: a web wallet at my.identity.org.au and a mobile capture wallet that together let you verify once and prove things to services on the VirtEngine network — without handing over documents."
  breadcrumbs={crumbs}
>
  <ServiceHero
    crumbs={crumbs}
    eyebrow="The service"
    title="The Identity Wallet"
    lede="One verified identity, two wallet surfaces. Complete verification once on your phone, then manage credentials, consents and proofs from the web wallet at my.identity.org.au — and use your verification level everywhere the VirtEngine network is accepted."
    statusTone="info"
    statusLabel="Two surfaces · one identity"
  >
    <div slot="actions">
      <a href={SITE.walletPortal} class="btn-primary">
        Join the launch list
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10m0 0L8 3m4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="/get-started" class="btn-secondary">Set up from scratch</a>
    </div>
    <p class="mt-6 mb-0 text-[0.95rem] text-muted measure-narrow">
      Open-source reference software, rolling out with the VirtEngine network. Free to use.
      Not an Australian Government service.
    </p>
    <div slot="media">
      <ServiceFigure
        rail="Wallet home"
        railRight="Illustrated"
        caption="One credential card, the proofs it can share, and the consent activity where grants can be reviewed or revoked."
      >
        <CredentialScreen />
      </ServiceFigure>
    </div>
  </ServiceHero>

  <FactStrip
    label="Wallet facts"
    facts={[
      { label: "Capture", value: "Mobile wallet", href: "/wallet/mobile-wallet" },
      { label: "Manage", value: "Web wallet", href: "/wallet/web-wallet" },
      { label: "Network role", value: "Tier and score, never documents", href: "/wallet/verify-on-virtengine" },
    ]}
  />

  <div class="container-site">
    <Section
      index="01"
      eyebrow="Two surfaces, one identity"
      title="The mobile wallet captures. The web wallet manages."
      lede="Verification evidence — your document, your face, your phone's secure hardware — can only be captured on a mobile device. Everything after that moment works wherever you are signed in."
    >
      <div class="grid gap-4 md:grid-cols-2">
        <article class="border border-hairline rounded-tile bg-paper p-6">
          <p class="eyebrow">Capture + wallet</p>
          <h3 class="mt-2 text-[1.2rem]">Mobile wallet</h3>
          <p class="mt-2 text-[0.98rem] text-body">
            Guided document capture, selfie with active liveness, hardware biometrics and device
            integrity attestation — with everything encrypted on your phone before it moves.
          </p>
          <a href="/wallet/mobile-wallet" class="link-plain font-semibold">About the mobile wallet</a>
        </article>
        <article class="border border-hairline rounded-tile bg-paper p-6">
          <p class="eyebrow">Manage + present</p>
          <h3 class="mt-2 text-[1.2rem]">Web wallet — my.identity.org.au</h3>
          <p class="mt-2 text-[0.98rem] text-body">
            Your browser portal: see your verification level, present proofs to services, review
            every consent, and revoke anything — from any device you have signed in with.
          </p>
          <a href="/wallet/web-wallet" class="link-plain font-semibold">About the web wallet</a>
        </article>
      </div>
    </Section>
  </div>

  <div class="bg-alt border-y border-hairline">
    <div class="container-site">
      <Section
        index="02"
        eyebrow="my.identity.org.au"
        title="Everything you have shared, in one place you control"
        lede="The portal shows your verified identity the way services see it — a level, a set of proofs — alongside the parts only you can see: your consent ledger, your history, your sessions."
      >
        <div class="grid items-start gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <Steps steps={portalSteps} />
            <a href={SITE.walletPortal} class="btn-primary mt-8">Join the launch list</a>
          </div>
          <div class="lg:col-span-7 min-w-0">
            <ServiceFigure
              rail="Browser portal"
              railRight="Illustrated"
              scroll
              caption="The portal preview: credentials and proofs, consent history, and session controls — results and receipts, not evidence."
            >
              <WebPortalFrame />
            </ServiceFigure>
          </div>
        </div>
      </Section>
    </div>
  </div>

  <div class="container-site">
    <Section
      index="03"
      eyebrow="Why verify"
      title="Your verification is your pass on the VirtEngine network"
      lede="The VirtEngine network is a decentralised cloud marketplace. Actions on it — deploying workloads, leasing capacity, taking on sensitive roles — are gated by verification tiers. Completing verification makes you an approved client: providers and the marketplace see your tier and score, never your documents."
    >
      <div class="grid gap-4 md:grid-cols-2">
        <CardLink
          href="/wallet/verify-on-virtengine"
          tag="The full flow"
          title="Verify on VirtEngine"
          description="Wallet to chain to marketplace: how verification becomes approval, step by step, with the full diagram."
        />
        <CardLink
          href="/wallet/credentials"
          tag="Reference"
          title="Credentials and proofs"
          description="Every credential and proof the wallet can hold — what each one proves, and what it never reveals."
        />
        <CardLink
          href="/wallet/security"
          tag="Security model"
          title="Wallet security"
          description="On-device processing, encrypted payloads, key handling, revocation, and the lost-device path."
        />
        <CardLink
          href="/get-started/verification-levels"
          tag="Levels"
          title="Verification levels"
          description="Unverified, Basic, Standard and Trusted — the evidence behind each level and what it unlocks."
        />
      </div>
      <Alert tone="info" title="Where the service is up to" class="mt-10">
        <p>
          The Identity Wallet is working, open-source <strong>reference software</strong> rolling
          out with the VirtEngine network. my.identity.org.au is its wallet portal. There are no
          app-store listings and no government accreditation — and we will not claim either until
          they are true. What we publish is what the <a href="/about/open-source" class="link-plain">code does</a>.
        </p>
      </Alert>
    </Section>
  </div>

  <ClosingBand
    eyebrow="The Identity Wallet"
    title="One identity, two surfaces, no central copy."
    body="Capture once on your phone; manage and present from any browser. Your documents stay encrypted and your consent stays revocable."
  >
    <a href={SITE.walletPortal} class="btn-inverse">Join the launch list</a>
    <a href="/get-started" class="btn-inverse-ghost">Set up from scratch</a>
    <a href="/wallet/security" class="btn-inverse-ghost">Read the security model</a>
  </ClosingBand>
</Base>
