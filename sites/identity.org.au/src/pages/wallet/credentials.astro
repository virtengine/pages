---
import Guide from "@layouts/Guide.astro";
import Callout from "@components/Callout.astro";
import ZkShareScreen from "@components/phone/ZkShareScreen.astro";
import { WALLET_NAV } from "@data/nav-sections";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Wallet", href: "/wallet" },
  { name: "Credentials and proofs", href: "/wallet/credentials" },
];

const catalogue = [
  {
    name: "Verification level (tier)",
    proves: "That your identity has been verified to Basic, Standard or Trusted — a summary of all the evidence behind that level.",
    never: "The evidence itself: no documents, no biometrics, no score history, no personal details.",
  },
  {
    name: "Age-over proof",
    proves: "That your verified date of birth puts you at or above a threshold — over 18, over 21 — as a cryptographic yes.",
    never: "Your date of birth, your age, or anything else from your document.",
  },
  {
    name: "Residency proof",
    proves: "That your verified address is in a given country.",
    never: "Your address, suburb, or anything more precise than the country the service asked about.",
  },
  {
    name: "Score-range proof",
    proves: "That your verification score is at or above the threshold a service requires.",
    never: "Your exact score, or the signals and history that produced it.",
  },
  {
    name: "Verified claim (consented)",
    proves: "A specific fact read from your evidence — for example your verified name — shared deliberately, claim by claim.",
    never: "Any claim you did not explicitly approve for that specific request. Sharing one claim reveals nothing else.",
  },
  {
    name: "Consent receipt",
    proves: "That a specific consent was granted (or revoked) at a specific time, for a specific scope and purpose — an auditable record both sides can rely on.",
    never: "The content of the data the consent covered. Receipts record decisions, not data.",
  },
];
---

<Guide
  title="Credentials and proofs"
  metaTitle="Credentials and proofs — the catalogue | identity.org.au"
  description="Every credential and proof the Identity Wallet can hold — identity tiers, age-over proofs, attribute proofs, consent receipts — with a plain statement of what each proves and what it never reveals."
  lede="The wallet holds credentials; services receive proofs. This is the full catalogue — and for each entry, exactly what it proves and what it never reveals."
  eyebrow="The service"
  breadcrumbs={crumbs}
  sectionLabel="The wallet"
  sectionNav={WALLET_NAV}
>
  <div class="prose-service">
    <p>
      A <strong>credential</strong> is a verified fact held in your wallet — established once,
      during <a href="/get-started/set-up-your-wallet">verification</a>. A <strong>proof</strong>
      is what a service actually receives when you share: the smallest possible answer to its
      question, often a <a href="/insights/zero-knowledge-proofs-explained">zero-knowledge
      proof</a> that reveals nothing beyond a yes. The catalogue below is the complete set — and
      the “never reveals” column is the point.
    </p>
  </div>

  <div class="mt-8 overflow-x-auto">
    <table class="table-gov">
      <caption class="sr-only">
        Catalogue of wallet credentials and proofs: what each proves and what it never reveals
      </caption>
      <thead>
        <tr>
          <th scope="col">Credential or proof</th>
          <th scope="col">What it proves</th>
          <th scope="col">What it never reveals</th>
        </tr>
      </thead>
      <tbody>
        {
          catalogue.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              <td class="max-w-[26rem]">{row.proves}</td>
              <td class="max-w-[26rem]">{row.never}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-10 grid items-start gap-10 lg:grid-cols-12">
    <div class="prose-service lg:col-span-7">
      <h2>How a share actually happens</h2>
      <p>
        Every presentation follows the same shape. A service requests a specific proof with a
        stated purpose. Your wallet shows you the request in plain language — who is asking, what
        would be proven, what stays private — and you approve or decline. On approval, the proof
        is generated and the decision lands in your consent history with a timestamp and, where
        you chose one, an expiry.
      </p>
      <p>
        The walkthrough lives in <a href="/help/presenting-proofs-to-a-service">presenting proofs
        to a service</a>; the revocation side is covered in
        <a href="/help/revoking-consent">revoking consent</a>.
      </p>
      <h2>Why the catalogue is small</h2>
      <p>
        Six entries is not a limitation — it is the design. Each proof answers one class of
        question a service can legitimately need, and nothing in the system lets a service
        free-form collect around them. When services need more, they must ask claim by claim, and
        you see every ask. Data minimisation only works when the minimal path is also the easy
        path — the argument in full is in
        <a href="/insights/verification-tiers-and-proportionality">verification tiers and
        proportionality</a>.
      </p>
    </div>
    <div class="mx-auto w-full max-w-[260px] lg:col-span-5">
      <ZkShareScreen />
    </div>
  </div>

  <Callout title="One rule to remember" class="mt-8">
    <p>
      If a service asks you to email or upload your documents directly, that is outside the wallet
      and outside these guarantees — the wallet never needs you to hand over documents to prove
      something it can prove for you. See
      <a href="/help/recognising-scams-and-phishing" class="link-plain">recognising scams</a>.
    </p>
  </Callout>
</Guide>
