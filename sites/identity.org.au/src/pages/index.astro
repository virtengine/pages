---
import Base from "@layouts/Base.astro";
import Alert from "@components/Alert.astro";
import CardLink from "@components/CardLink.astro";
import ClosingBand from "@components/ClosingBand.astro";
import FactStrip from "@components/FactStrip.astro";
import MediaBand from "@components/media/MediaBand.astro";
import Section from "@components/Section.astro";
import ServiceFigure from "@components/ServiceFigure.astro";
import ServiceHero from "@components/ServiceHero.astro";
import Steps from "@components/Steps.astro";
import TableScroll from "@components/TableScroll.astro";
import ProofCard from "@components/ProofCard.astro";
import ZkShareScreen from "@components/phone/ZkShareScreen.astro";
import DataLifecycle from "@components/diagrams/DataLifecycle.astro";
import { SITE } from "@data/site";
import { TIERS } from "@data/tiers";
import { FEATURED_INSIGHTS } from "@data/insights";

const setupSteps = [
  {
    title: "Scan your identity document",
    body: "Front and back, guided by the camera. The app reads the details and you check them before anything is submitted.",
  },
  {
    title: "Take a selfie with liveness checks",
    body: "Blink, turn your head, smile — short challenges that prove a live person is present, not a photo.",
  },
  {
    title: "Review and submit — encrypted",
    body: "Everything is encrypted on your phone before it leaves. The network verifies your identity and issues your verification level.",
  },
];
---

<Base title={SITE.title} description={SITE.description} path="/" breadcrumbs={[{ name: "Home", href: "/" }]}>
  <ServiceHero
    eyebrow="The Identity Wallet service"
    title="Prove what matters. Keep the rest private."
    lede="The Identity Wallet keeps your identity on your phone, encrypted. When a service needs an answer, such as whether you are over 18, it gets the answer, never your documents."
  >
    <div slot="actions">
      <a href={SITE.walletPortal} class="btn-primary">
        Join the launch list
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10m0 0L8 3m4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="/get-started" class="btn-secondary">Set up your wallet</a>
    </div>
    <p class="mt-6 mb-0 text-[0.95rem] text-muted measure-narrow">
      Free, open source, and operated by a not-for-profit foundation. Independent of the
      Australian Government.
    </p>
    <div slot="media">
      <ProofCard seed="IDAU-HOME-001" />
      <p class="mt-3 mb-0 text-[0.8rem] text-muted">
        Specimen card. The guilloché is the printed ground; the foil catches the light and moves
        with you. The service receives the claim, not the document.
      </p>
    </div>
  </ServiceHero>

  <FactStrip
    label="Service facts"
    facts={[
      { label: "Launch list", value: "January 2027 updates", href: "/launch" },
      { label: "Licence", value: "Apache 2.0 open source", href: "/about/open-source" },
      { label: "Operator", value: "DETIO FOUNDATION LTD", href: "/about/who-runs-it" },
    ]}
  />

  <div class="container-site">
    <Section
      index="01"
      eyebrow="The service"
      title="One verified identity, two wallet surfaces"
      lede="Verify once on your phone; manage everything from the browser. Your verification level works everywhere the VirtEngine network is accepted — as an approved client, providers see your tier, never your documents."
    >
      <div class="grid gap-4 md:grid-cols-3">
        <CardLink
          href="/wallet/mobile-wallet"
          tag="Capture + wallet"
          title="Mobile wallet"
          description="Guided local document capture and OCR. Original scans stay on your phone; only separately approved derived data may be encrypted for submission."
        />
        <CardLink
          href="/wallet/web-wallet"
          tag="Manage + present"
          title="Web wallet — my.identity.org.au"
          description="Present proofs, review every consent, control your sessions — from any browser, passkey sign-in."
        />
        <CardLink
          href="/wallet"
          tag="Overview"
          title="The Identity Wallet service"
          description="What the service is, how the surfaces fit together, and how verification works on the network."
        />
      </div>
    </Section>
  </div>

  <div class="container-site">
    <Section
      index="02"
      eyebrow="Everyday uses"
      title="What you can do with the Identity Wallet"
    >
      <ol class="credential-index">
        <li>
          <a href="/get-started/set-up-your-wallet">
            <span>01</span>
            <span>
              <strong>Verify your identity once</strong>
              <em>Complete a guided verification on your phone, then reuse it everywhere the wallet is accepted.</em>
            </span>
          </a>
        </li>
        <li>
          <a href="/help/proving-your-age-without-your-documents">
            <span>02</span>
            <span>
              <strong>Prove your age without your documents</strong>
              <em>Answer whether you are over 18 with a cryptographic yes. Your birth date and documents stay private.</em>
            </span>
          </a>
        </li>
        <li>
          <a href="/help/using-your-wallet-with-a-service">
            <span>03</span>
            <span>
              <strong>Share with services on your terms</strong>
              <em>See exactly what a service is asking for, approve or decline, and set consent to expire.</em>
            </span>
          </a>
        </li>
        <li>
          <a href="/help/revoking-consent">
            <span>04</span>
            <span>
              <strong>Change your mind, any time</strong>
              <em>Every consent you grant can be revoked. Every use of your data is recorded where you can see it.</em>
            </span>
          </a>
        </li>
        <li>
          <a href="/get-started/verification-levels">
            <span>05</span>
            <span>
              <strong>Build a stronger verification level</strong>
              <em>Four levels, from Basic to Trusted, unlock more as your identity evidence gets stronger.</em>
            </span>
          </a>
        </li>
        <li>
          <a href="/help/deleting-your-identity">
            <span>06</span>
            <span>
              <strong>Leave, completely</strong>
              <em>Delete your identity data on a published timeline. Encryption keys are destroyed, so deletion is real.</em>
            </span>
          </a>
        </li>
      </ol>
    </Section>
  </div>

  <MediaBand
    slug="identity-liveness"
    layout="reverse"
    eyebrow="In everyday use"
    title="Prove the thing. Keep the document."
    lede="A selfie with a live challenge is how the wallet knows a real person is present. The photograph is evidence for one verification — never a profile picture, never shared with the services you use."
    caption="A live check in ordinary light: what the wallet needs is a moment of presence, not your archive."
  >
    <a href="/how-it-works" class="btn-secondary">See the full pipeline</a>
  </MediaBand>

  <div class="bg-alt border-y border-hairline">
    <div class="container-site">
      <Section
        index="03"
        eyebrow="Get started"
        title="Set up in about ten minutes"
        lede="You need a smartphone and a government-issued identity document. The wallet guides you through each step, and you review everything before it is submitted."
      >
        <div class="grid items-start gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <Steps steps={setupSteps} />
            <a href="/get-started/set-up-your-wallet" class="btn-primary mt-8">See the full setup guide</a>
          </div>
          <div class="lg:col-span-5">
            <ServiceFigure
              rail="Sharing pattern"
              railRight="One answer"
              caption="Zero-knowledge sharing in miniature: private fields stay locked, and one checkable answer leaves the phone."
            >
              <ZkShareScreen />
            </ServiceFigure>
          </div>
        </div>
      </Section>
    </div>
  </div>

  <div class="container-site">
    <Section
      index="04"
      eyebrow="Verification levels"
      title="Four levels. Services ask for what they need — no more."
    >
      <TableScroll label="Verification levels table">
        <table class="table-gov">
          <caption class="sr-only">Verification levels, what each is based on, and what it unlocks</caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">In plain terms</th>
              <th scope="col">Typical use</th>
            </tr>
          </thead>
          <tbody>
            {
              TIERS.map((tier) => (
                <tr>
                  <th scope="row">{tier.name}</th>
                  <td class="max-w-[34rem]">{tier.plain}</td>
                  <td class="max-w-[22rem]">{tier.unlocks[0]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </TableScroll>
      <a href="/get-started/verification-levels" class="link-plain mt-5 inline-block font-semibold">
        Verification levels in detail — what evidence each requires
      </a>
    </Section>
  </div>

  <div class="bg-alt border-y border-hairline">
    <div class="container-site">
      <Section
        index="05"
        eyebrow="Your data, in plain terms"
        title="Locked on your device. Processed in a vault no one can open."
        lede="Original document images stay on your device. The wallet processes them locally; only minimum, user-approved derived data may leave, encrypted for VEID verification."
      >
        <ServiceFigure
          rail="Data lifecycle"
          railRight="Five stages"
          caption="Original document images stay on your phone. Only minimum, user-approved derived data may leave, encrypted for VEID verification."
        >
          <DataLifecycle />
        </ServiceFigure>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          <a href="/privacy/trusted-processing" class="link-plain font-semibold">
            Trusted processing — the lock and the key
          </a>
          <a href="/privacy" class="link-plain font-semibold">Read the full privacy page</a>
        </div>
        <div class="mt-10">
          <TableScroll label="Where each category of identity data is stored">
            <table class="table-gov">
              <caption class="sr-only">Where each category of identity data is stored</caption>
              <thead>
                <tr>
                  <th scope="col">Your data</th>
                  <th scope="col">Where it lives</th>
                  <th scope="col">Who can read it</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Document scans and photos</th>
                  <td>Original images stay on your device; only approved derived data may be submitted encrypted</td>
                  <td>You control the image. The network receives no document scan.</td>
                </tr>
                <tr>
                  <th scope="row">Biometric templates</th>
                  <td>Encrypted before leaving your phone (X25519-XSalsa20-Poly1305)</td>
                  <td>Never shared with services. Never sold — prohibited regardless of consent.</td>
                </tr>
                <tr>
                  <th scope="row">Verification results</th>
                  <td>On the network — your level and pass/fail outcomes</td>
                  <td>Services you explicitly consent to, per request.</td>
                </tr>
                <tr>
                  <th scope="row">Consent records</th>
                  <td>Auditable history — every grant, every revocation, timestamped</td>
                  <td>You, in full. Services see only their own grants.</td>
                </tr>
              </tbody>
            </table>
          </TableScroll>
        </div>
      </Section>
    </div>
  </div>

  <div class="container-site">
    <Section
      index="06"
      eyebrow="Insights"
      title="Analysis on digital identity"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="measure">Evergreen explainers on fraud, architecture, cryptography, consent and rights.</p>
        <span class="flex flex-wrap gap-x-5 gap-y-1">
          <a href="/insights" class="link-plain font-semibold">All insights</a>
          <a href="/guides" class="link-plain font-semibold">Guides</a>
          <a href="/definitions" class="link-plain font-semibold">Definitions</a>
        </span>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          FEATURED_INSIGHTS.map((article) => (
            <a
              href={`/insights/${article.slug}`}
              class="group flex flex-col border border-hairline rounded-tile bg-paper p-6 no-underline hover:border-hairline-strong transition-colors"
            >
              <span class="block text-[0.72rem] font-bold uppercase tracking-[0.13em] text-steel">
                {article.topic}
              </span>
              <span class="mt-2 block text-[1.12rem] font-bold text-action underline decoration-transparent underline-offset-4 group-hover:decoration-current">
                {article.title}
              </span>
              <span class="mt-2 block text-[0.95rem] text-body">{article.summary}</span>
            </a>
          ))
        }
      </div>
    </Section>
  </div>

  <div class="container-site">
    <Section
      index="07"
      eyebrow="Trust"
      title="Why you can check our claims"
    >
      <div class="grid gap-6 md:grid-cols-3">
        <div class="border-t-4 border-navy pt-4">
          <h3 class="m-0 text-[1.1rem]">Open source</h3>
          <p class="mt-2 text-[0.98rem] text-body">
            Every line of the wallet and the network is public. Nothing on this site asks you to
            trust what you cannot inspect.
            <a href="/about/open-source" class="link-plain">About the code</a>
          </p>
        </div>
        <div class="border-t-4 border-navy pt-4">
          <h3 class="m-0 text-[1.1rem]">Not-for-profit foundation</h3>
          <p class="mt-2 text-[0.98rem] text-body">
            Operated by {SITE.foundation} (ACN {SITE.acn}), with a constitution that directs assets
            and income toward its public-benefit purposes.
            <a href="/about/who-runs-it" class="link-plain">Who runs it</a>
          </p>
        </div>
        <div class="border-t-4 border-navy pt-4">
          <h3 class="m-0 text-[1.1rem]">Patented method, public interest</h3>
          <p class="mt-2 text-[0.98rem] text-body">
            The verification method is Australian patent {SITE.patentId}, held inside the
            public-benefit structure. <a href="/about/patents" class="link-plain">The patent in plain terms</a>
          </p>
        </div>
      </div>
      <Alert tone="info" title="Honesty first" class="mt-10">
        <p>
          This wallet is a working, open-source <strong>reference implementation</strong> — the
          blueprint production wallets build on. There are no app-store listings, and we make no
          claims of government accreditation. What we publish here is what the code does.
        </p>
      </Alert>
    </Section>
  </div>

  <div class="bg-alt border-t border-hairline">
    <div class="container-site">
      <Section
        index="08"
        eyebrow="Support"
        title="Popular help topics"
      >
        <div class="grid gap-4 md:grid-cols-2">
          <CardLink href="/help/who-can-see-your-data" title="Who can see your data" />
          <CardLink href="/help/how-your-biometrics-are-protected" title="How your biometrics are protected" />
          <CardLink href="/help/recognising-scams-and-phishing" title="Recognising scams and phishing" />
          <CardLink href="/faq" title="Frequently asked questions" />
        </div>
      </Section>
    </div>
  </div>

  <ClosingBand
    eyebrow="Get your wallet"
    title="Your identity should not live in someone else's database."
    body="Join the launch list for the January 2027 rollout, follow the build in the open-source repository, or read exactly how your data is protected."
  >
    <a href={SITE.walletPortal} class="btn-inverse">Join the launch list</a>
    <a href="/get-started" class="btn-inverse-ghost">Set up your wallet</a>
    <a href="/privacy" class="btn-inverse-ghost">Read the privacy model</a>
  </ClosingBand>
</Base>
