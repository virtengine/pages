---
import Base from "@layouts/Base.astro";
import PageHeader from "@components/PageHeader.astro";
import Alert from "@components/Alert.astro";
import CardLink from "@components/CardLink.astro";
import { DEFINITIONS, getDefinition } from "@data/definitions";
import { SITE } from "@data/site";
import { articleNode, faqPageNode } from "@lib/schema";

export function getStaticPaths() {
  return DEFINITIONS.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = getDefinition(slug!)!;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Definitions", href: "/definitions" },
  { name: entry.term, href: `/definitions/${entry.slug}` },
];

const related = entry.related
  .map((slug) => getDefinition(slug))
  .filter((related) => related !== undefined);

const updatedDisplay = new Date(entry.updated).toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const canonical = new URL(`/definitions/${entry.slug}`, SITE.url).href;
const definitionSchema = articleNode({
  canonical,
  title: entry.term,
  description: entry.summary,
  dateModified: entry.updated,
  section: `Definitions · ${entry.group}`,
  type: "TechArticle",
  about: ["Digital identity", entry.group],
});
const definitionFaqSchema = faqPageNode(canonical, entry.faq);
---

<Base
  title={`${entry.term} — Definitions | identity.org.au`}
  description={entry.summary}
  breadcrumbs={crumbs}
  ogType="article"
  schema={[definitionSchema, definitionFaqSchema]}
  modifiedTime={entry.updated}
>
  <PageHeader crumbs={crumbs} eyebrow={`Definitions · ${entry.group}`} title={entry.term} lede={entry.summary} />

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <article>
      <p class="m-0 text-[0.9rem] text-muted">
        Identity.org.au editorial · Last updated {updatedDisplay}
      </p>
      {
        entry.sections.map((section) => (
          <section class="mt-8 first-of-type:mt-6">
            {section.heading && <h2 class="mt-0 mb-3 text-[1.4rem]">{section.heading}</h2>}
            <div class="prose-service">
              {section.paragraphs?.map((p) => <p set:html={p} />)}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              )}
            </div>
            {section.after && (
              <div class="prose-service">
                {section.after.map((p) => <p set:html={p} />)}
              </div>
            )}
            {section.callout && (
              <Alert tone={section.callout.tone} class="mt-5 max-w-[72ch]">
                <p>{section.callout.text}</p>
              </Alert>
            )}
          </section>
        ))
      }

      <section class="mt-12 border-t-2 border-navy pt-8">
        <h2 class="mt-0 mb-4 text-[1.4rem]">Quick answers</h2>
        <div class="grid gap-3">
          {
            entry.faq.map((item) => (
              <details class="details-gov">
                <summary>{item.question}</summary>
                <div>
                  <p class="m-0 text-body">{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </article>

    <aside class="lg:pt-2">
      <h2 class="mt-0 text-[0.85rem] font-bold uppercase tracking-[0.13em] text-muted">
        Related definitions
      </h2>
      <div class="mt-4 grid gap-3">
        {
          related.map((related) => (
            <CardLink href={`/definitions/${related.slug}`} title={related.term} />
          ))
        }
        <CardLink href="/definitions" title="All definitions" description="Every term, defined in one place." />
      </div>
      <div class="mt-8 border-t border-hairline pt-6 text-[0.95rem] text-body">
        <p class="m-0 font-bold text-ink">See it in practice</p>
        <p class="mt-2 mb-0">
          These ideas are implemented by the <a href="/wallet" class="link-plain">Identity Wallet
          service</a> — start with <a href="/how-it-works" class="link-plain">how it works</a>, or
          browse the <a href="/guides" class="link-plain">guides</a> for longer explainers.
        </p>
      </div>
    </aside>
  </div>
</Base>
