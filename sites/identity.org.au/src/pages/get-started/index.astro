---
import Guide from "@layouts/Guide.astro";
import CardLink from "@components/CardLink.astro";
import Alert from "@components/Alert.astro";
import FactStrip from "@components/FactStrip.astro";
import { GET_STARTED_NAV } from "@data/nav-sections";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Get started", href: "/get-started" },
];
---

<Guide
  title="Explore the reference wallet journey"
  metaTitle="Get Started: Set Up Your Wallet | identity.org.au"
  description="Set up your Identity Wallet: what you need, step-by-step setup, verification levels and fixes when something goes wrong. Start here."
  image="/media/wallet-in-hand-1200.webp"
  lede="This guide describes the reference capture flow. The production wallet is not available, and setup duration has not been established. Try the demo with fictional credentials first."
  eyebrow="Get started"
  breadcrumbs={crumbs}
  sectionLabel="In this guide"
  sectionNav={GET_STARTED_NAV}
>
  <FactStrip
    label="Setup facts"
    facts={[
      { label: "Status", value: "Reference journey", href: "/for-services/demo" },
      { label: "Need", value: "Phone + one document", href: "/get-started/what-you-need" },
      { label: "Levels", value: "Unverified to Trusted", href: "/get-started/verification-levels" },
    ]}
  />

  <div class="prose-service mt-8">
    <p>
      Your Identity Wallet is an app on your phone that holds <strong>verified claims</strong>
      about you — facts like your name and age that have been checked against real evidence. Once
      set up, you can prove things to services without handing over documents, and you decide what
      is shared every single time.
    </p>
  </div>

  <div class="mt-8 grid gap-4">
    <CardLink
      href="/get-started/what-you-need"
      tag="Before you start"
      title="What you need"
      description="The proposed capture requirements. Do not submit real identity evidence to the educational demo."
    />
    <CardLink
      href="/get-started/set-up-your-wallet"
      tag="Step by step"
      title="Set up your wallet"
      description="The full setup flow: local document scan and OCR, selfie and liveness, hardware biometrics, review, and separately approved derived-data submission."
    />
    <CardLink
      href="/get-started/verification-levels"
      tag="Reference"
      title="Verification levels"
      description="Unverified, Basic, Standard and Trusted — what each level requires and what it unlocks."
    />
    <CardLink
      href="/get-started/if-verification-fails"
      tag="Troubleshooting"
      title="If verification fails"
      description="Most failures are practical — lighting, glare, expired documents. How to fix each one."
    />
    <CardLink
      href="/get-started/lost-or-new-device"
      tag="Troubleshooting"
      title="Lost or new device"
      description="Your identity lives on the network, not just your phone. How to recover on a new device."
    />
  </div>

  <Alert tone="info" title="Reference implementation" class="mt-10">
    <p>
      The wallet app is open-source reference software — the working blueprint production wallets
      build on. There are no official app-store listings; get the code from the
      <a href="/about/open-source" class="link-plain">official repository</a>.
    </p>
  </Alert>
</Guide>
