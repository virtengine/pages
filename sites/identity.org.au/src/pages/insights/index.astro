---
import Base from "@layouts/Base.astro";
import PageHeader from "@components/PageHeader.astro";
import CardLink from "@components/CardLink.astro";
import StatusTag from "@components/StatusTag.astro";
import { INSIGHT_ARTICLES, INSIGHT_TOPICS, FEATURED_INSIGHTS } from "@data/insights";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Insights", href: "/insights" },
];

const rest = INSIGHT_ARTICLES.filter((a) => !FEATURED_INSIGHTS.includes(a));
---

<Base
  title="Insights — analysis on digital identity | identity.org.au"
  description="Evergreen analysis and explainers on digital identity: synthetic media and fraud, identity architecture, zero-knowledge cryptography, consent, and the human-rights stakes of identity infrastructure."
  breadcrumbs={crumbs}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow="Insights"
    title="Analysis on digital identity"
    lede="Plain-English, evergreen analysis of the identity landscape: what generative tools break, what architecture and cryptography fix, and what rights demand of the infrastructure. No invented statistics, no hype — arguments you can check."
  />

  <div class="container-site py-12">
    <section>
      <h2 class="mt-0 border-b-2 border-navy pb-3 text-[1.4rem]">Featured</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          FEATURED_INSIGHTS.map((article) => (
            <a
              href={`/insights/${article.slug}`}
              class="group flex flex-col border border-hairline rounded-tile bg-paper p-6 no-underline hover:border-hairline-strong hover:bg-alt transition-colors"
            >
              <span class="block text-[0.72rem] font-bold uppercase tracking-[0.13em] text-steel">
                {article.topic}
              </span>
              <span class="mt-2 block text-[1.15rem] font-bold text-action underline decoration-transparent underline-offset-4 group-hover:decoration-current">
                {article.title}
              </span>
              <span class="mt-2 block text-[0.95rem] text-body">{article.summary}</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      INSIGHT_TOPICS.map((topic) => {
        const articles = rest.filter((a) => a.topic === topic);
        if (articles.length === 0) return null;
        return (
          <section class="mt-12">
            <h2 class="mt-0 border-b-2 border-navy pb-3 text-[1.4rem]">{topic}</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {articles.map((article) => (
                <CardLink
                  href={`/insights/${article.slug}`}
                  tag={topic}
                  title={article.title}
                  description={article.summary}
                />
              ))}
            </div>
          </section>
        );
      })
    }

    <section class="mt-14 border border-hairline rounded-tile bg-alt px-6 py-6">
      <StatusTag tone="neutral">Editorial standards</StatusTag>
      <p class="mt-3 mb-0 text-body measure">
        Insights articles are written and maintained by the identity.org.au editorial function of
        the DETIO Foundation. They are evergreen analysis — no invented statistics, no fabricated
        case studies, no bylined personas. Where an article describes this service's behaviour,
        the claim is grounded in the <a href="/about/open-source" class="link-plain">open-source code</a>
        and published policies.
      </p>
    </section>
  </div>
</Base>
