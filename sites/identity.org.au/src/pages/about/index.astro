---
import Guide from "@layouts/Guide.astro";
import CardLink from "@components/CardLink.astro";
import { ABOUT_NAV } from "@data/nav-sections";
import { SITE } from "@data/site";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
];
---

<Guide
  title="About identity.org.au"
  metaTitle="About — identity.org.au"
  description="What identity.org.au is, the VEID technology behind it, the not-for-profit foundation that stewards it, the open-source code, and the patent — in plain terms."
  lede="Who runs this, what the technology is, and why you can check every claim we make."
  eyebrow="About"
  breadcrumbs={crumbs}
  sectionLabel="In this section"
  sectionNav={ABOUT_NAV}
>
  <div class="prose-service">
    <p>
      identity.org.au explains and documents the <strong>Identity Wallet</strong> — the
      privacy-preserving digital identity wallet of the VirtEngine ecosystem. It is an open-source
      community service stewarded by {SITE.foundation}, an Australian not-for-profit. It is
      <strong>not an Australian Government service</strong>, and this section exists so you can
      verify exactly who is behind it and how it works.
    </p>
  </div>

  <div class="mt-8 grid gap-4">
    <CardLink
      href="/about/what-is-identity-org-au"
      title="What is identity.org.au"
      description="What this service is, what it is not, and how it differs from government digital ID."
    />
    <CardLink
      href="/about/the-technology"
      title="The technology"
      description="VEID — the identity layer of the VirtEngine network — explained in plain language."
    />
    <CardLink
      href="/about/who-runs-it"
      title="Who runs it"
      description="DETIO FOUNDATION LTD: an Australian not-for-profit with a constitutional public-benefit lock."
    />
    <CardLink
      href="/about/open-source"
      title="Open source"
      description="Where the code lives, what licence it carries, and why openness is a security feature."
    />
    <CardLink
      href="/about/patents"
      title="Patents"
      description="Australian patent AU2024203136B2 in plain terms — and why it doesn't conflict with open source."
    />
  </div>
</Guide>
