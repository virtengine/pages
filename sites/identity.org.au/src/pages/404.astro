---
import Base from "@layouts/Base.astro";
import CardLink from "@components/CardLink.astro";
import Mark from "@components/brand/Mark.astro";
---

<Base
  title="Page not found | identity.org.au"
  description="The page you were looking for doesn't exist. Find your way back to the Identity Wallet guides, help centre and policies."
  path="/404"
>
  <div class="container-site py-20 text-center">
    <Mark size={64} class="mx-auto" />
    <p class="eyebrow mt-8 mb-0">Error 404</p>
    <h1 class="mt-2 text-[clamp(1.9rem,4vw,2.6rem)]">We can't find that page</h1>
    <p class="mx-auto mt-4 max-w-[48ch] text-[1.1rem] text-body">
      The address may have been typed incorrectly, or the page may have moved. Nothing about your
      data or wallet is affected.
    </p>
    <div class="mx-auto mt-10 grid max-w-[36rem] gap-4 text-left">
      <CardLink href="/" title="Home" description="Start from the beginning." />
      <CardLink href="/get-started" title="Get started" description="Set up your Identity Wallet." />
      <CardLink href="/help" title="Help centre" description="Plain-English articles about your data and wallet." />
      <CardLink href="/faq" title="FAQ" description="Straight answers to common questions." />
    </div>
  </div>
</Base>
