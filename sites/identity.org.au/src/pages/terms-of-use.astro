---
import Base from "@layouts/Base.astro";
import PageHeader from "@components/PageHeader.astro";
import Alert from "@components/Alert.astro";
import { SITE } from "@data/site";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Terms of use", href: "/terms-of-use" },
];
---

<Base
  title="Terms of use | identity.org.au"
  description="Terms of use for identity.org.au and a plain-language summary of the terms that govern the Identity Wallet and VEID: eligibility, consent, key responsibility, and blockchain realities."
  breadcrumbs={crumbs}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow="Policies"
    title="Terms of use"
    lede="Two things are covered here: using this website, and — in summary — the terms that govern the wallet and the VEID network."
  />

  <div class="container-site max-w-[62rem] py-12">
    <section class="prose-service">
      <h2 class="mt-0">Using this website</h2>
      <ul>
        <li>Content on identity.org.au is provided for general information. It explains open-source software and summarises its governing documents; it is not legal, financial or professional advice.</li>
        <li>You may link to, quote and reuse content from this site with attribution.</li>
        <li>We aim for accuracy and correct errors when found. Where this site summarises a governing document, the document in the <a href={SITE.github} rel="noopener">repository</a> is authoritative.</li>
        <li>This website has no accounts and collects no personal data — see <a href="/privacy">privacy</a>.</li>
      </ul>
    </section>

    <section class="prose-service mt-12">
      <h2 class="mt-0">The wallet and network terms, in plain language</h2>
      <p>
        Use of the VEID identity system and VirtEngine network is governed by the VirtEngine Terms
        of Service, published in full in the repository. The parts most relevant to wallet users:
      </p>

      <h3>Eligibility</h3>
      <ul>
        <li>You must be at least <strong>18 years old</strong> (or the age of majority where you live, if higher).</li>
        <li>You must have the legal capacity to enter a binding agreement, and your use must comply with the laws of your jurisdiction.</li>
      </ul>

      <h3>Identity verification is optional — with consequences you choose</h3>
      <ul>
        <li>Verification through VEID is voluntary. Some marketplace activities require verification, and services may set minimum levels — the same way some venues require ID.</li>
        <li>Biometric consent is separate, informed and revocable. See <a href="/help/revoking-consent">revoking consent</a>.</li>
      </ul>

      <h3>You are responsible for your keys</h3>
      <ul>
        <li>You are responsible for the confidentiality of your private keys and wallet credentials, and for activity conducted through your account.</li>
        <li><strong>Lost private keys cannot be recovered</strong> by anyone, and blockchain transactions cannot be reversed. Keep recovery material safe and offline — see <a href="/get-started/lost-or-new-device">lost or new device</a>.</li>
      </ul>

      <h3>Blockchain realities you accept</h3>
      <ul>
        <li>Transactions are final and irreversible once confirmed.</li>
        <li>Decentralised networks carry inherent risks: protocol bugs, consensus disruptions, network congestion, and evolving regulation.</li>
        <li>Records written to the chain are permanent — which is why personal data is never written to it in readable form.</li>
      </ul>

      <h3>Acceptable use</h3>
      <ul>
        <li>No unlawful use, no impersonation or synthetic identities, no attempts to defeat verification or liveness checks, and no interference with the network's operation.</li>
      </ul>
    </section>

    <Alert tone="info" title="The authoritative text" class="mt-12 max-w-[72ch]">
      <p>
        This page is a faithful plain-language summary, not a replacement. The complete VirtEngine
        Terms of Service, Privacy Policy and Biometric Data Addendum are versioned in the
        <a href={SITE.github} rel="noopener" class="link-plain">open-source repository</a> and
        govern in case of any difference.
      </p>
    </Alert>
  </div>
</Base>
