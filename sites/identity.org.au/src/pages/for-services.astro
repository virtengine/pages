---
import Base from "@layouts/Base.astro";
import ClosingBand from "@components/ClosingBand.astro";
import FactStrip from "@components/FactStrip.astro";
import Section from "@components/Section.astro";
import ServiceHero from "@components/ServiceHero.astro";
import CardLink from "@components/CardLink.astro";
import Callout from "@components/Callout.astro";
const crumbs = [{ name: "Home", href: "/" }, { name: "For services", href: "/for-services" }];
---
<Base title="Reusable Verification for Services | identity.org.au" description="Explore reusable, consent-based verification for an existing service. Try the fictional membership demo, review issuer trust and discuss a measured pilot." breadcrumbs={crumbs}>
  <ServiceHero crumbs={crumbs} eyebrow="For services" title="Reusable verification for your existing service" lede="Help users present trusted credentials and approve the information your service needs. Evaluate whether reuse can reduce repeated checks and unnecessary document collection." statusLabel="Reference software · pilot proposal">
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/for-services/demo" class="btn-primary">Try the demonstration</a>
      <a href="/for-services/pilot" class="btn-secondary">Review the pilot proposal</a>
    </div>
    <p class="mt-6 mb-0 text-muted measure-narrow">The demo uses fictional credentials. Production availability, independent assurance and government accreditation are separate milestones; none is established by this demonstration.</p>
  </ServiceHero>
  <FactStrip label="Pilot facts" facts={[
    { label: "First workflow", value: "Membership eligibility" },
    { label: "Trust", value: "Issuer accepted by each service", href: "/for-services/issuer-policy" },
    { label: "User control", value: "A decision for each request", href: "/for-services/demo" },
  ]} />
  <div class="container-site">
    <Section index="01" eyebrow="Evaluate" title="Start with one useful fact">
      <div class="grid gap-4 md:grid-cols-3">
        <CardLink href="/for-services/demo" tag="Interactive" title="Try two services" description="Approve or decline a fictional membership request. Explore expiry, revoked credentials, issuer trust and recovery." />
        <CardLink href="/for-services/pilot" tag="For discussion" title="Shape a measured pilot" description="One accountable issuer, two services and an agreed eligibility decision. Compare the result with your existing process." />
        <CardLink href="/for-services/pilot-integration" tag="Illustrative" title="Inspect the integration" description="Request and result examples, data boundaries and the production checks still required." />
      </div>
    </Section>
    <Section index="02" eyebrow="The proposed exchange" title="Receive the answer your workflow needs">
      <div class="prose-service">
        <p>For the proposed membership check, a service receives an active-membership answer, issuer verification material and a fresh request receipt. The presentation excludes names, member numbers, source documents, biometric evidence and another service's consent history.</p>
        <p>The production design must demonstrate those boundaries and agree lawful retention before enrolling participants.</p>
      </div>
      <Callout title="Less collection, with clear responsibilities" class="mt-6">
        <p>Reducing document copies can reduce exposure. Credentials, identifiers, logs and receipts still need protection. Your service remains responsible for its decision, lawful processing and retention. An identity credential does not replace financial due diligence.</p>
      </Callout>
    </Section>
    <Section index="03" eyebrow="Delivery" title="Build trust before extending access">
      <div class="prose-service">
        <ol>
          <li>Agree the exact claim and which issuers your service will accept.</li>
          <li>Complete the real-device issuance, authentication, consent and presentation flow.</li>
          <li>Validate issuer and holder binding, freshness, expiry and credential status.</li>
          <li>Provide alternatives, recovery and a clear retention notice.</li>
          <li>Measure the pilot before making savings, fraud or production-readiness claims.</li>
        </ol>
        <p>VEID can be evaluated as an identity layer without replacing your payment system. No bank, card network or other institution is presented as a confirmed partner.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 mt-6">
        <CardLink href="/for-services/issuer-policy" title="Proposed issuer policy" description="Authority, evidence, signing keys, status and complaints." />
        <CardLink href="/privacy/trusted-processing" title="Processing and its limits" description="The design goals, remaining evidence and privacy boundaries." />
      </div>
    </Section>
  </div>
  <ClosingBand eyebrow="Pilot discussion" title="Bring a real workflow. Agree what success means." body="Review the proposal and discussion pack before committing to integration. No production dependency is offered through this demonstration.">
    <a href="/for-services/pilot" class="btn-inverse">Discuss a pilot</a>
    <a href="/for-services/demo" class="btn-inverse-ghost">Try the demo</a>
  </ClosingBand>
</Base>
