---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import Card from "@components/Card.astro";
import CTA from "@components/CTA.astro";
import PlateFigure from "@components/art/PlateFigure.astro";
import VeidWalletDemo from "@components/art/VeidWalletDemo.astro";
import VeidPipeline from "@components/diagrams/VeidPipeline.astro";
import { SITE } from "@data/site";

const stages = [
  {
    step: "01",
    title: "Capture",
    body: "The VEID mobile wallet captures identity documents with OCR and a selfie, entirely on the user's device.",
  },
  {
    step: "02",
    title: "Liveness",
    body: "Active liveness challenges confirm a real, present human — not a photo, replay, or injection attack.",
  },
  {
    step: "03",
    title: "Hardware attestation",
    body: "Biometric hardware attestation (fingerprint or iris) plus device integrity checks — Play Integrity on Android, App Attest on iOS — bind the capture to trusted hardware.",
  },
  {
    step: "04",
    title: "Encrypted submission",
    body: "Identity scopes are sealed with public-key encryption and signed by both an approved client and the user before upload — only validator recipients can decrypt.",
  },
  {
    step: "05",
    title: "Consensus scoring",
    body: "Validators open the scopes only inside attested enclaves (x/enclave), score the evidence with shared machine-learning models, and commit an identity trust score to the ledger by consensus — the patented core of the protocol.",
  },
  {
    step: "06",
    title: "ZK verification",
    body: "Zero-knowledge proofs (x/veid/zk) let users prove facts about their verified identity — score thresholds, attributes — without revealing the underlying data.",
  },
];

const trusted = [
  {
    tag: "The vault",
    title: "A room built out of silicon",
    body: "Scoring runs in confidential VMs — AMD SEV-SNP, Intel SGX or AWS Nitro — where the processor encrypts memory itself. There is no operator login, no debug console, and no memory dump: no access path exists for the provider hosting the hardware, the foundation, or anyone else.",
  },
  {
    tag: "The gate",
    title: "Attestation before data",
    body: "Before any scope is released, the enclave produces a hardware-signed measurement of the exact code it is running. The chain verifies it on-chain in x/enclave against the approved record. If a single byte of code were different, the measurement would not match — and no data would be sent.",
  },
  {
    tag: "The key",
    title: "Forged inside the enclosure",
    body: "The key that opens a scope is derived inside the hardware from the hardware's own secrets and sealed to that exact enclave (vTPM sealing). There is no key to hand over — not to an operator, not to a provider, not in response to a demand.",
  },
];

const scenarios = [
  {
    id: "scn-age",
    tab: "Age-restricted service",
    question: "The service asks: is this person over 18?",
    proof: "proof verified · expires in 24 h",
    shared: [
      ["Over 18 — true", "the age band, not the birth date"],
      ["Proof is genuine", "signed by the validator consensus result"],
      ["Proof is unexpired", "issued moments ago to this verifier"],
      ["Bound to one purpose", "not reusable by other services"],
    ],
    hidden: [
      ["Full name", "never leaves the device"],
      ["Date of birth", "the exact date is not revealed"],
      ["Address", "not part of this scope"],
      ["Document number", "sealed on the handset"],
    ],
    foot: "Threshold proofs are the smallest useful disclosure: one bit of truth, nothing attached.",
  },
  {
    id: "scn-access",
    tab: "Marketplace access",
    question: "The counterparty asks: does this account clear the trust threshold?",
    proof: "gating result · verified",
    shared: [
      ["Trust score ≥ threshold — true", "the score itself stays hidden"],
      ["Account is VEID-verified", "approved-clients-only upload path"],
      ["Client signature valid", "the chain's approved-client list applied"],
      ["Bound to this lease", "not replayable against other orders"],
    ],
    hidden: [
      ["The score value", "hidden even from the counterparty"],
      ["Identity documents", "encrypted to validators only"],
      ["Biometrics and selfie", "never leave the capture device"],
      ["Location history", "outside the scope of this proof"],
    ],
    foot: "Providers verify tenants and tenants verify providers — both directions ask the same question and learn nothing more.",
  },
  {
    id: "scn-residency",
    tab: "Residency attribute",
    question: "The programme asks: is this operator resident in an accepted jurisdiction?",
    proof: "attribute proof · verified",
    shared: [
      ["Residency attribute — accepted", "jurisdiction class, not the address"],
      ["Proof is unexpired", "re-attested at the network's cadence"],
      ["Issued to this programme", "not a general disclosure"],
      ["Threshold list applied", "accepted jurisdictions are chain state"],
    ],
    hidden: [
      ["Exact address", "sealed on the device"],
      ["Tax identifiers", "never part of an attribute proof"],
      ["Document images", "decrypted only inside the validator network"],
      ["Other scopes", "a proof covers exactly one question"],
    ],
    foot: "Attribute proofs generalise the idea: any scope the network can verify can be proven without being shown.",
  },
];
---

<Base
  title="VEID (Verifiable Electronic Identity) Network — VirtEngine"
  description="VEID (Verifiable Electronic Identity) is VirtEngine's privacy-preserving decentralized identity layer: on-device capture, active liveness, biometric hardware attestation, validator consensus scoring, and zero-knowledge verification tiers."
  path="/veid"
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "VEID", href: "/veid" },
  ]}
>
  <PageHero
    eyebrow="Identity layer"
    title="Identity verified by consensus, revealed by proof"
    lede="VEID (Verifiable Electronic Identity) turns identity verification into a protocol function: encrypted identity scopes are scored by the validator set's shared machine-learning models, and users prove what matters with zero-knowledge proofs — nothing more."
    media="identity-liveness"
    mediaCaption="A real person, one active check — then only proofs travel."
    crumbs={[
      { name: "Home", href: "/" },
      { name: "VEID", href: "/veid" },
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href="https://identity.org.au">identity.org.au</CTA>
      <CTA href={SITE.docs} variant="secondary">VEID documentation</CTA>
    </div>
  </PageHero>

  <!-- ======================= THE WALLET (dark) ======================= -->
  <section class="band-night mt-16" id="wallet">
    <div class="container-site py-16 md:py-20">
      <div class="folio-head folio-head--night folio-head--split">
        <div>
          <div class="folio-coord"><span>Fig. 02</span><span>The capture wallet</span></div>
          <h2>The device does the sensitive work.</h2>
        </div>
        <p>
          Capture, liveness and attestation all happen on the handset. The network receives a
          sealed scope — never a document archive.
        </p>
      </div>

      <VeidWalletDemo class="reveal" />

      <p class="mt-10 max-w-3xl text-sm leading-relaxed text-night-muted">
        The wallet is a reference implementation — <code class="font-mono text-green">mobile/veid-capture-app/</code> in
        the protocol repository — and the consumer-facing identity programme is presented at
        <a class="text-green underline decoration-green/50 underline-offset-4 hover:decoration-green" href="https://identity.org.au">identity.org.au</a>.
      </p>
    </div>
  </section>

  <!-- ========================== PIPELINE ========================== -->
  <Section
    eyebrow="Pipeline"
    title="From device to ledger"
    lede="Six stages take a user from document capture to a consensus-committed trust score they can use across the marketplace."
  >
    <PlateFigure
      rail="Fig. 03 — the verification pipeline"
      railRight="Six stages"
      label="VEID verification pipeline diagram. On device, the VEID capture wallet performs four stages: capture (document OCR and selfie), liveness (active liveness challenge), attestation (fingerprint or iris biometric attestation and device integrity), and encrypt (identity scopes sealed with public-key encryption). The submission, signed by an approved client and the user, flows on-chain to the validator identity network, where validators decrypt with their keys, score identity with shared machine-learning models, and commit the trust score by consensus, using the veid, veidregistry, encryption, and mfa modules. Outputs feed three zero-knowledge verification surfaces: score threshold proofs that prove a score meets a threshold and reveal nothing else, attribute proofs for scopes like age or residency, and marketplace gating where providers and tenants verify each other."
      caption="fig 03 — capture → liveness → attestation → encryption → consensus scoring → zk tiers"
      class="reveal"
    >
      <VeidPipeline />
    </PlateFigure>

    <ol class="stage-grid">
      {
        stages.map((stage) => (
          <li class="stage-item reveal">
            <span class="stage-idx">Stage {stage.step}</span>
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ==================== TRUSTED PROCESSING ==================== -->
  <Section
    eyebrow="Trusted processing · x/enclave"
    title="Scoring happens where no operator can look"
    lede="Encrypted scopes are opened only inside hardware-sealed enclaves — confidential VMs whose attestation the chain verifies before any data is released to them."
  >
    <div class="grid gap-5 lg:grid-cols-3">
      {
        trusted.map((t) => (
          <Card title={t.title} tag={t.tag} class="reveal">
            {t.body}
          </Card>
        ))
      }
    </div>

    <div class="id-split mt-10">
      <div>
        <div class="prose-body space-y-4 text-base">
          <p>
            The three properties compound: there is no access path into the vault, the code inside
            is measured and attested before data arrives, and the key that opens a scope is sealed
            to that exact hardware. Raw documents and biometrics exist in readable form only on the
            user's device and inside the enclosure — the chain carries ciphertext, attestation
            records, and results.
          </p>
          <p>
            The same machinery serves confidential workloads in the marketplace: attested enclave
            capability is a verifiable provider attribute, and tenant secrets are delivered only
            after attestation verifies — proof first, secrets second, enforced by protocol
            machinery rather than provider goodwill.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-4">
          <CTA href="/trusted-processing">How trusted processing works</CTA>
          <CTA href="/modules/enclave" variant="secondary">x/enclave module</CTA>
          <CTA href="/modules/encryption" variant="ghost">x/encryption module</CTA>
        </div>
      </div>

      <div class="tp-boundary reveal" role="group" aria-label="What crosses the trusted processing boundary">
        <div class="tp-boundary-row">
          <span class="tp-boundary-key">Leaves the enclave</span>
          <p>Attestation records, a trust score, and pass/fail outcomes — written to chain state for verifiers and zero-knowledge proofs to build on.</p>
        </div>
        <div class="tp-boundary-row tp-boundary-row--sealed">
          <span class="tp-boundary-key">Stays sealed</span>
          <p>Documents, selfies, biometric templates, raw scopes, and the hardware-sealed keys that open them. Working copies are destroyed when scoring ends.</p>
        </div>
        <p class="tp-boundary-note">
          Attestation proves genuine hardware running exactly the approved code — nothing more.
          The other half is what that code does: verify, report, destroy. Both halves are open
          source.
        </p>
      </div>
    </div>
  </Section>

  <!-- ==================== WHAT A VERIFIER LEARNS ==================== -->
  <Section
    eyebrow="Selective disclosure"
    title="What a verifier learns — and what it never sees"
    lede="A zero-knowledge proof answers exactly one question. Pick a scenario to see the full accounting of what crosses the boundary."
  >
    <div class="verifier reveal">
      <nav class="verifier-tabs" aria-label="Verification scenarios">
        {
          scenarios.map((s, i) => (
            <a class:list={["verifier-tab", i === 0 && "verifier-tab--default"]} href={`#${s.id}`}>
              {s.tab}
            </a>
          ))
        }
      </nav>

      <div class="verifier-body">
        {
          scenarios.map((s, i) => (
            <section id={s.id} class:list={["verifier-panel", i === 0 && "verifier-panel--default"]} aria-label={s.tab}>
              <div class="verifier-question">
                <p>{s.question}</p>
                <span class="verifier-proof">{s.proof}</span>
              </div>
              <div class="verifier-columns">
                <div class="verifier-col verifier-col--shared">
                  <h3>Crosses the boundary</h3>
                  <ul>
                    {s.shared.map(([claim, note]) => (
                      <li>
                        <span>
                          <b>{claim}</b> — {note}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="verifier-col verifier-col--hidden">
                  <h3>Stays sealed on the device</h3>
                  <ul>
                    {s.hidden.map(([claim, note]) => (
                      <li>
                        <span>
                          <b>{claim}</b> — {note}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <p class="verifier-foot">{s.foot}</p>
            </section>
          ))
        }
      </div>
    </div>

    <div class="compare reveal">
      <div class="compare-card">
        <span class="compare-tag">Conventional verification</span>
        <h3>Hand over the document</h3>
        <p>
          A service photographs your ID, stores an archive it must then protect forever,
          and you lose track of which copies exist. Verification and data collection become
          the same act.
        </p>
      </div>
      <div class="compare-card compare-card--good">
        <span class="compare-tag">VEID verification</span>
        <h3>Hand over a proof</h3>
        <p>
          The network verifies once, by consensus, and you share proofs thereafter. The
          counterparty can check that a fact holds without ever receiving the data behind it.
        </p>
      </div>
    </div>
  </Section>

  <!-- ======================= DESIGN PRINCIPLES ======================= -->
  <Section eyebrow="Design principles" title="Privacy is the architecture, not a policy">
    <div class="grid gap-5 lg:grid-cols-3">
      <Card title="Encrypted end to end" tag="x/encryption" class="reveal">
        Raw identity data is never public on-chain. Scopes are public-key encrypted so
        only intended validator recipients can decrypt — in transit and at rest.
      </Card>
      <Card title="Approved clients only" tag="x/config" class="reveal">
        Validators verify that uploads were produced by an approved client interface and
        signed by the user. The approved-client list is chain configuration, governed
        on-chain.
      </Card>
      <Card title="Selective disclosure" tag="x/veid/zk" class="reveal">
        Zero-knowledge verification tiers mean a counterparty learns that your score
        clears a threshold or that an attribute holds — never the document, biometric,
        or score itself.
      </Card>
    </div>
  </Section>

  <!-- ========================= MARKETPLACE ========================= -->
  <Section eyebrow="In the marketplace" title="Why a cloud marketplace needs identity">
    <div class="prose-body reveal max-w-3xl space-y-4 text-base">
      <p>
        Marketplace access is identity-dependent by design: providers verify tenants
        before workloads land on their hardware, and tenants verify providers before
        trusting them with workloads — cutting fraud in both directions. Sensitive
        transactions, including account recovery, are additionally protected by on-chain
        multi-factor authentication (<code>x/mfa</code>). Validators are compensated for
        identity work through governance-controlled, conservative network incentives.
      </p>
      <p>
        The VEID wallet reference implementation lives in the protocol repository at
        <code>mobile/veid-capture-app/</code>. The consumer-facing identity programme is
        presented at <a href="https://identity.org.au">identity.org.au</a>.
      </p>
    </div>
    <div class="reveal mt-8 flex flex-wrap gap-4">
      <CTA href="/learn/what-is-veid">The full VEID explainer</CTA>
      <CTA href="/modules/veid" variant="secondary">x/veid module reference</CTA>
      <CTA href={SITE.github} variant="ghost">VEID source</CTA>
    </div>
  </Section>
</Base>
