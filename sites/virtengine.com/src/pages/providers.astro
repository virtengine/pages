---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import Card from "@components/Card.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@data/site";

const whyProvide = [
  {
    title: "Monetize idle capacity",
    body: "Turn unused racks, cloud headroom, or HPC cycles into revenue. The marketplace matches your capacity with tenant demand — publish list prices for direct orders, and set your own bid strategy for open ones.",
  },
  {
    title: "Settlement without invoicing",
    body: "Usage is metered, reported, and settled by the protocol. Payment releases from escrow automatically after the dispute window — no accounts receivable, no chasing customers.",
  },
  {
    title: "Choose your counterparty requirements",
    body: "VEID can provide a privacy-preserving trust signal. Providers may choose a clearly disclosed verification requirement for an individual offer; buyers can compare requirements and provider evidence before committing.",
  },
  {
    title: "Reputation that compounds",
    body: "Auditor-signed attributes, on-chain hardware benchmarks, and tenant reviews build a portable, tamper-evident track record that wins better-priced leases over time.",
  },
];

const daemonDuties = [
  { name: "Pricing & bid engine", detail: "Publishes your list prices, watches open orders on-chain, and places bids per your configured pricing and capacity rules." },
  { name: "Workload orchestration", detail: "Instantiates leased workloads through Kubernetes, or through SLURM / MOAB / Open OnDemand for HPC jobs." },
  { name: "Usage metering", detail: "Collects per-workload resource metrics on an hourly cadence and batches them into signed usage records." },
  { name: "Chain submission", detail: "Submits MsgRecordUsage batches with retry and backoff; reconciles against platform metrics and flags anomalies." },
];

const onboarding = [
  {
    step: "01",
    title: "Verify your identity",
    body: "VEID is optional for general marketplace participation. Where a provider chooses a specific verification requirement for an offer, disclose it before the order so each side can make an informed choice.",
  },
  {
    step: "02",
    title: "Register on-chain",
    body: "Create your provider record with attributes — region, hardware classes, certifications — via the x/provider module.",
  },
  {
    step: "03",
    title: "Deploy the provider daemon",
    body: "Install and configure the daemon against your Kubernetes cluster or HPC scheduler; connect your chain key, and set list prices and bid strategy.",
  },
  {
    step: "04",
    title: "Get audited & benchmarked",
    body: "Optional but valuable: auditor-signed attributes and published hardware benchmarks make your offers stand out to tenants that filter on them.",
  },
  {
    step: "05",
    title: "Bid, serve, settle",
    body: "Direct orders match your list prices; the daemon bids on open ones. Won leases run on your infrastructure, usage settles hourly, and escrow pays out after the 24-hour dispute window.",
  },
];
---

<Base
  title="Sell GPU & Cloud Capacity: Provider Guide | VirtEngine"
  description="Lease GPU, datacenter or HPC capacity into VirtEngine's DePIN marketplace. Escrow-backed pay with full agreed ACT payouts, daemon setup and onboarding steps."
  path="/providers"
  image="/media/provider-datacenter-1200.webp"
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Providers", href: "/providers" },
  ]}
>
  <PageHero
    eyebrow="For providers"
    title="Prepare to provide infrastructure"
    lede="A guide to the proposed provider role for datacenter operators, cloud providers, and HPC facilities. The network is not live; use this material to assess future participation."
    media="provider-technician"
    mediaCaption="Operator work on the supply side of the market."
    crumbs={[
      { name: "Home", href: "/" },
      { name: "Providers", href: "/providers" },
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href={`${SITE.docs}`}>Provider documentation</CTA>
      <CTA href="#onboarding" variant="secondary">Onboarding path</CTA>
    </div>
  </PageHero>

  <Section eyebrow="Why provide" title="What the protocol does for an operator">
    <div class="grid gap-5 sm:grid-cols-2">
      {whyProvide.map((item) => <Card title={item.title} class="reveal p-7">{item.body}</Card>)}
    </div>
  </Section>

  <Section
    eyebrow="Economics"
    title="Usage in, payment out"
    lede="Metered usage settles from escrow. Full money path lives in the canonical guides — not repeated here."
  >
    <p class="max-w-3xl text-sm leading-relaxed text-muted">
      Usage is metered hourly as signed records, passes a 24-hour dispute window, then settles from lease escrow
      at the full agreed amount. <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/escrow-and-settlement-explained">Escrow & settlement →</a>
      <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/provider-economics">Provider economics →</a>
    </p>
  </Section>

  <Section
    eyebrow="Provider daemon"
    title="One daemon between the chain and your infrastructure"
    lede="The provider daemon is the protocol's on-premises agent. You configure it; it handles the marketplace."
  >
    <ul class="grid gap-3 lg:grid-cols-2">
      {
        daemonDuties.map((duty) => (
          <li class="reveal flex gap-4 rounded-card border border-line bg-panel p-5">
            <svg viewBox="0 0 20 20" width="20" height="20" class="mt-0.5 shrink-0" fill="none" stroke="var(--color-green)" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="14" height="14" rx="4"></rect>
              <path d="M7 10.5 9 12.5 13.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <div>
              <h3 class="text-base font-semibold">{duty.name}</h3>
              <p class="mt-1 text-sm text-slate">{duty.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow="HPC"
    title="Supercomputing capacity is a first-class citizen"
    lede="If you run SLURM, MOAB, or Open OnDemand, the daemon's HPC integration executes on-chain jobs on your cluster — with usage reporting, state recovery, audit logging, and retry built in."
  >
    <div class="grid gap-5 lg:grid-cols-3">
      <Card title="Scheduler adapters" tag="slurm · moab · ood" class="reveal">
        Native adapters speak to your existing controller — munge or JWT auth for SLURM,
        with per-partition configuration. No re-platforming of your cluster.
      </Card>
      <Card title="Job lifecycle service" tag="x/hpc" class="reveal">
        On-chain HPC jobs are polled, dispatched, and tracked with configurable
        concurrency limits, timeouts, and crash-safe state recovery.
      </Card>
      <Card title="Audit trail" tag="usage · security" class="reveal">
        Job events, security events, and usage reports are logged to a dedicated audit
        log, and usage batches flow into the same settlement pipeline as cloud workloads.
      </Card>
    </div>
  </Section>

  <Section
    eyebrow="Requirements"
    title="What you need to bring"
  >
    <ul class="prose-body grid max-w-3xl gap-3 text-base">
      <li class="reveal flex gap-3"><span class="font-mono text-green-deep" aria-hidden="true">—</span> Infrastructure: a Kubernetes cluster, or an HPC cluster behind SLURM / MOAB / Open OnDemand.</li>
      <li class="reveal flex gap-3"><span class="font-mono text-green-deep" aria-hidden="true">—</span> A Linux (amd64/arm64) or macOS host for the <code>virtengine</code> binary and provider daemon.</li>
      <li class="reveal flex gap-3"><span class="font-mono text-green-deep" aria-hidden="true">—</span> A funded chain account and provider key for registration, bidding, and gas.</li>
      <li class="reveal flex gap-3"><span class="font-mono text-green-deep" aria-hidden="true">—</span> VEID is optional for general participation; any offer-specific verification requirement should be clear before an order.</li>
      <li class="reveal flex gap-3"><span class="font-mono text-green-deep" aria-hidden="true">—</span> Network reachability for tenants to consume the services you host.</li>
    </ul>
  </Section>

  <Section eyebrow="Onboarding" title="Readiness checklist" id="onboarding">
    <ul class="provider-readiness">
      <li><strong>Infrastructure</strong><span>✓ Kubernetes or HPC scheduler</span></li>
      <li><strong>Public endpoint</strong><span>✓ reachable by tenants</span></li>
      <li><strong>Metering</strong><span>✓ per-workload collection</span></li>
      <li><strong>VEID / organisation</strong><span>○ verify identity</span></li>
      <li><strong>Audit / benchmark</strong><span>○ optional attestation</span></li>
      <li><strong>Daemon configuration</strong><span>○ prices + keys</span></li>
    </ul>
  </Section>

  <Section eyebrow="Onboarding" title="The planned provider workflow">
    <ol class="grid gap-5 lg:grid-cols-5">
      {
        onboarding.map((step) => (
          <li class="reveal rounded-card border border-line bg-panel p-5">
            <p class="font-mono text-sm font-medium text-green-deep" aria-hidden="true">{step.step}</p>
            <h3 class="mt-2 text-base font-semibold">{step.title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <CTA href={SITE.docs}>Start with the provider docs</CTA>
      <CTA href="/learn/provider-economics" variant="secondary">Provider economics, explained</CTA>
      <CTA href="/network" variant="ghost">Check network status</CTA>
    </div>
  </Section>

  <Section eyebrow="By operator type" title="Solutions for your kind of capacity">
    <ul class="grid gap-3 sm:grid-cols-3">
      <li>
        <a href="/solutions/datacenter-operators" class="clip-corner group block h-full rounded-card border border-line bg-panel p-5 transition-colors hover:border-green-deep">
          <h3 class="text-base font-semibold text-ink group-hover:text-green-dark">Datacenter operators</h3>
          <p class="mt-1.5 text-sm text-slate">Turn provisioned-but-idle headroom into settled revenue.</p>
        </a>
      </li>
      <li>
        <a href="/solutions/gpu-compute-providers" class="clip-corner group block h-full rounded-card border border-line bg-panel p-5 transition-colors hover:border-green-deep">
          <h3 class="text-base font-semibold text-ink group-hover:text-green-dark">GPU compute providers</h3>
          <p class="mt-1.5 text-sm text-slate">Lease accelerator capacity with benchmark-backed offers.</p>
        </a>
      </li>
      <li>
        <a href="/solutions/hpc-clusters" class="clip-corner group block h-full rounded-card border border-line bg-panel p-5 transition-colors hover:border-green-deep">
          <h3 class="text-base font-semibold text-ink group-hover:text-green-dark">HPC clusters</h3>
          <p class="mt-1.5 text-sm text-slate">Monetize batch cycles through SLURM, MOAB, or Open OnDemand.</p>
        </a>
      </li>
    </ul>
  </Section>
</Base>
