---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import HowItWorks from "@components/HowItWorks.astro";
import RelatedMarketplacePages from "@components/marketplace/RelatedMarketplacePages.astro";
import { NETWORK_STATUS } from "@data/status";

const title = "Use Infrastructure Through VirtEngine: Tenant Guide";
const description =
  "The tenant journey on VirtEngine: verify identity, find services, choose direct order, bid or selector, fund escrow, run, observe and settle — with entry paths by workload.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "For tenants & buyers", href: "/tenants" },
];

const journey = [
  {
    label: "Verify",
    title: "Complete the applicable identity requirements",
    body: "VEID is not required for general marketplace participation. A provider may disclose a specific VEID requirement for an individual listing; tenants can choose offers that do not require it.",
    href: "/learn/what-is-veid",
    hrefLabel: "What is VEID?",
  },
  {
    label: "Find",
    title: "Browse the catalogue or describe requirements",
    body: "Start from a published offering, or describe category, region, specifications and a price cap when you want the engine to find eligible listings.",
    href: "/marketplace",
    hrefLabel: "Browse service types",
  },
  {
    label: "Choose",
    title: "Direct order, bid or selector",
    body: "Take a listed price, open the order to competing providers, or match by attributes. All three paths resolve on-chain.",
    href: "/learn/three-ways-to-buy",
    hrefLabel: "Three ways to buy",
  },
  {
    label: "Fund",
    title: "Escrow backs the order and lease",
    body: "Escrow is committed against the agreement — provably funded, and released only under settlement rules. Unspent balance returns to you.",
    href: "/learn/escrow-and-settlement-explained",
    hrefLabel: "Escrow & settlement",
  },
  {
    label: "Run",
    title: "The provider provisions the service",
    body: "The provider daemon routes the matched request into the provider's control plane and backend. Usage settles from escrow — full lifecycle in the guide.",
    href: "/learn/how-the-marketplace-works",
    hrefLabel: "Marketplace lifecycle",
  },
];

const entryPaths = [
  { label: "I need GPUs", href: "/marketplace/gpu-compute", note: "GPU machines, nodes, training allocations and inference endpoints." },
  { label: "I need a VM or private cloud", href: "/marketplace/iaas", note: "Infrastructure you control, from VMs to bare metal." },
  { label: "I need HPC", href: "/marketplace/hpc", note: "Scheduler-backed queues, allocations and job templates." },
  { label: "I need a managed platform", href: "/marketplace/paas", note: "Kubernetes, databases, runtimes and batch platforms." },
  { label: "I need software", href: "/marketplace/saas", note: "Seats, licences, subscriptions and support plans." },
  { label: "I need confidential compute", href: "/solutions/enterprises-confidential-compute", note: "Attested paths and enclave-backed workloads." },
];
---

<Base
  title={title}
  description={description}
  path="/tenants"
  image="/media/marketplace-hardware-1200.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="For tenants & buyers"
    title="Source infrastructure without committing to a single provider."
    lede="What are you looking for? Pick a workload below — then verify, find, choose, fund, run."
    crumbs={crumbs}
    media="marketplace-hardware"
    mediaCaption="Start from the workload, settle on one rail."
  >
    <CTA href="/marketplace">Explore the marketplace</CTA>
    <CTA href="/learn/how-the-marketplace-works" variant="secondary">How orders become leases</CTA>
    <div class="mk-page-hero-flag">
      <span class="mk-status">{NETWORK_STATUS.posture}</span>
      <span class="mk-flag">Illustrative examples throughout</span>
    </div>
  </PageHero>

  <Section eyebrow="Tenant journey" title="Five steps from requirement to running service">
    <HowItWorks id="tenant-journey" steps={journey} />
    <p class="mt-6 text-sm">Full protocol detail: <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/how-the-marketplace-works">Order → Match → Lease → Usage → Settlement →</a></p>
  </Section>

  <Section eyebrow="Entry paths" title="Start from the workload">
    <div class="mk-cards-3">
      {
        entryPaths.map((path) => (
          <a class="mk-category-card" href={path.href}>
            <h3>{path.label}</h3>
            <p class="mk-category-sub">{path.note}</p>
            <span class="mk-category-cta">Explore <span aria-hidden="true">→</span></span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Before you start" title="What a tenant needs">
    <div class="mk-cards-3">
      <article class="mk-order-col">
        <h3>Identity</h3>
        <p>The applicable identity requirements, so providers can verify who is on the other side of the lease.</p>
      </article>
      <article class="mk-order-col">
        <h3>Budget</h3>
        <p>Escrow funding for the order or lease. Funds are committed, not spent, until usage settles.</p>
      </article>
      <article class="mk-order-col">
        <h3>Requirements</h3>
        <p>Region, specifications, compliance or attestation needs — the inputs that make selector matching work.</p>
      </article>
    </div>
    <div class="mk-tech-note">
      <p>
        <strong>Under the hood:</strong> <a href="/veid">VEID identity</a>,{" "}
        <a href="/modules/escrow">x/escrow</a> for funds held against leases,{" "}
        <a href="/modules/settlement">x/settlement</a> for usage-to-payment, and{" "}
        <a href="/learn/marketplace-glossary">the marketplace glossary</a> for every term on this page.
      </p>
    </div>
  </Section>

  <Section eyebrow="Continue" title="Related pages" class="border-t border-line">
    <RelatedMarketplacePages
      eyebrow="Explore"
      title="Related destinations"
      links={[
        { label: "Marketplace overview", href: "/marketplace" },
        { label: "Three ways to buy", href: "/learn/three-ways-to-buy" },
        { label: "Anatomy of a listing", href: "/learn/anatomy-of-a-marketplace-listing" },
      ]}
    />
  </Section>
</Base>
