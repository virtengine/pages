---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SOLUTIONS } from "@data/solutions";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Solutions", href: "/solutions" },
];

const provide = SOLUTIONS.filter((s) =>
  ["gpu-compute-providers", "datacenter-operators", "hpc-clusters"].includes(s.slug),
);
const secure = SOLUTIONS.filter((s) =>
  ["validators", "staking-partners", "token-holders"].includes(s.slug),
);
const build = SOLUTIONS.filter((s) =>
  ["web3-developers", "enterprises-confidential-compute", "ai-ml-workloads", "cost-optimized-cloud"].includes(s.slug),
);

const groups = [
  {
    eyebrow: "Supply the network",
    title: "For operators with capacity to lease",
    lede: "Datacenters, GPU fleets, and HPC facilities earn settled revenue by serving on-chain leases.",
    items: provide,
  },
  {
    eyebrow: "Secure the network",
    title: "For validators, partners & token holders",
    lede: "Consensus plus the VEID Network — one bonded stake, layered rewards, honest risk disclosure.",
    items: secure,
  },
  {
    eyebrow: "Build & deploy on the network",
    title: "For developers, enterprises & workloads",
    lede: "Typed module surfaces for builders; verifiable confidentiality, GPU sourcing, and auction-set pricing for tenants.",
    items: build,
  },
];
---

<Base
  title="Solutions — who VirtEngine is for"
  description="How different audiences use VirtEngine: GPU and datacenter providers, HPC clusters, validators, staking partners, token holders, developers, enterprises, and AI/ML teams."
  path="/solutions"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Solutions"
    title="One protocol, many ways in"
    lede="VirtEngine serves both sides of the compute market and everyone securing it. Find the path that matches what you run, hold, or build — each page covers the problem, the protocol's answer, the economics, and the first steps."
    crumbs={crumbs}
  />

  {
    groups.map((group) => (
      <Section eyebrow={group.eyebrow} title={group.title} lede={group.lede}>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((sol) => (
            <li>
              <a
                href={`/solutions/${sol.slug}`}
                class="clip-corner group block h-full rounded-card border border-line bg-panel p-6 transition-colors hover:border-green-deep"
              >
                <h3 class="text-base font-semibold text-ink group-hover:text-green-dark">{sol.label}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate">{sol.title}</p>
                <p class="mt-3 font-mono text-xs text-muted">{sol.audience}</p>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section eyebrow="Not sure where to start?" title="Start with how the marketplace works">
    <div class="prose-body reveal max-w-3xl text-base">
      <p>
        Every solution above rests on the same five-stage lifecycle — order, bid, lease, usage,
        settlement. The <a href="/learn/how-the-marketplace-works">marketplace walkthrough</a>
        explains it end to end, and the <a href="/faq">FAQ</a> answers the most common questions
        from providers, stakers, and developers.
      </p>
    </div>
    <div class="reveal mt-8 flex flex-wrap gap-4">
      <CTA href="/learn">Browse the guides</CTA>
      <CTA href="/faq" variant="secondary">Read the FAQ</CTA>
    </div>
  </Section>
</Base>
