---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import GlanceStrip from "@components/GlanceStrip.astro";
import HowItWorks from "@components/HowItWorks.astro";
import FaqList from "@components/FaqList.astro";
import ProtocolDiagram from "@components/ProtocolDiagram.astro";
import { SOLUTIONS } from "@data/solutions";
import { media } from "@data/media";
import { SITE } from "@data/site";

export function getStaticPaths() {
  return SOLUTIONS.map((sol) => ({ params: { slug: sol.slug }, props: { sol } }));
}

const { sol } = Astro.props;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Solutions", href: "/solutions" },
  { name: sol.label, href: `/solutions/${sol.slug}` },
];

const others = SOLUTIONS.filter((s) => s.slug !== sol.slug).slice(0, 3);
---

<Base
  title={`${sol.title} — VirtEngine`}
  description={sol.metaDescription}
  path={`/solutions/${sol.slug}`}
  image={media[sol.media].src}
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow={`Solutions · ${sol.label}`}
    title={sol.title}
    lede={sol.intro}
    crumbs={crumbs}
    media={sol.media}
    mediaCaption={sol.mediaCaption}
  >
    <p class="mt-6 max-w-2xl border-l-2 border-green pl-4 text-sm text-muted">
      <strong class="font-semibold text-ink">Who this is for:</strong> {sol.audience}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <CTA href={SITE.docs}>Read the documentation</CTA>
      <CTA href={SITE.github} variant="secondary">Browse the source</CTA>
    </div>
  </PageHero>

  <Section eyebrow="At a glance" title={`The short version for ${sol.label.toLowerCase()}`}>
    <GlanceStrip items={sol.highlights} />
  </Section>

  <Section eyebrow="The problem" title={sol.problem.heading}>
    <div class="prose-body max-w-3xl space-y-5 text-base">
      {sol.problem.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section eyebrow="In one view" title="Audience-specific visual" lede="Each solution gets its own explanatory figure — not the same template art.">
    {sol.slug === "gpu-compute-providers" && (
      <div class="sol-visual sol-fleet" role="group" aria-label="Fleet utilisation dashboard: total, leased, idle GPUs, benchmark status, region and demand">
        <ul><li><strong>Total GPUs</strong><span>1,280</span></li><li><strong>Leased</strong><span>812</span></li><li><strong>Idle</strong><span>468 → offering</span></li><li><strong>Benchmark</strong><span>verified</span></li><li><strong>Region</strong><span>ap-southeast</span></li><li><strong>Demand</strong><span>high for A100 class</span></li></ul>
        <p>idle GPU → offering → lease → metering → payout</p>
      </div>
    )}
    {sol.slug === "datacenter-operators" && (
      <div class="sol-visual sol-racks" role="group" aria-label="Facility capacity topology publishing headroom to the market">
        <pre>Facility
├ Cluster A   62% used
├ Cluster B   34% used
└ GPU pod     48% used
          ↓ publish headroom
VirtEngine marketplace</pre>
      </div>
    )}
    {sol.slug === "hpc-clusters" && (
      <div class="sol-visual sol-queue" role="group" aria-label="Scheduler queue showing external jobs becoming submissions without replacing local policy">
        <ol><li>Queue: gpu — 14 pending</li><li>VirtEngine job → scheduler submission</li><li>Local policy unchanged</li><li><a href="/learn/hpc-on-virtengine">HPC guide →</a></li></ol>
      </div>
    )}
    {sol.slug === "enterprises-confidential-compute" && (
      <div class="sol-visual sol-enclave" role="group" aria-label="Attested enclave flow from encrypted secret to verified workload">
        <pre>Tenant secret
     ↓ encrypted
Attested enclave
     ↓ measurement proof
x/enclave
     ↓ verified
Workload released</pre>
      </div>
    )}
    {sol.slug === "ai-ml-workloads" && (
      <div class="sol-visual sol-selector" role="group" aria-label="Requirement selector matching training, inference and fine-tuning to capacity">
        <ul><li>Training / Inference / Fine-tuning</li><li>GPU memory ≥ X GB</li><li>Region + topology</li><li>→ matching capacity</li></ul>
      </div>
    )}
    {sol.slug === "cost-optimized-cloud" && (
      <div class="sol-visual sol-bids" role="group" aria-label="Competitive bidding exposing price competition without promising savings">
        <ul><li>Provider A — $1.42</li><li>Provider B — $1.29 · selected</li><li>Provider C — $1.51</li></ul>
        <p>Open bidding exposes competition per order — not a savings guarantee.</p>
      </div>
    )}
    {sol.slug === "validators" && (
      <div class="sol-visual sol-validator" role="group" aria-label="Validator with consensus and VEID duties">
        <pre>                VALIDATOR
                /       \
        CONSENSUS       VEID
        blocks          verification</pre>
        <p>bond → duties → rewards → slashing</p>
      </div>
    )}
    {sol.slug === "staking-partners" && (
      <div class="sol-visual sol-delegate" role="group" aria-label="Delegation state machine">
        <p>Delegate → Bonded → Rewards → Redelegate / Unbond</p>
      </div>
    )}
    {sol.slug === "token-holders" && (
      <div class="sol-visual sol-token" role="group" aria-label="Token utility map with risk context">
        <ul><li>escrow</li><li>staking</li><li>governance</li><li>network fees</li><li>protocol economics</li></ul>
        <p>Risk: delegated stake is slashable; unbonding takes 21 days. <a href="/learn/understanding-slashing">Slashing →</a></p>
      </div>
    )}
    {sol.slug === "web3-developers" && (
      <div class="sol-visual sol-code" role="group" aria-label="Module API surface over gRPC and REST">
        <pre>gRPC / REST
    │
 ┌──┼───────────┐
x/market
x/provider
x/escrow
x/veid
x/settlement</pre>
        <p>One code example in docs: query orders, submit bids, track leases. <a href="https://docs.virtengine.com">Docs ↗</a></p>
      </div>
    )}
  </Section>

  {
    sol.diagram && (
      <Section eyebrow="The mechanism" title="How the protocol carries it">
        <ProtocolDiagram diagram={sol.diagram} caption={sol.diagramCaption} class="reveal" />
      </Section>
    )
  }

  <Section eyebrow="How VirtEngine addresses it" title="Grounded in what the protocol actually does">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        sol.approach.map((sec, i) => (
          <div class="reveal clip-corner rounded-card border border-line bg-panel p-7">
            <p class="font-mono text-sm font-medium text-green-deep" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-2 text-lg font-semibold text-ink">{sec.heading}</h3>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-slate">
              {sec.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            {sec.bullets && (
              <ul class="tri-list mt-4 text-sm text-slate">
                {sec.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="How it works"
    title="The path through the protocol, step by step"
    lede="Select each step — the panel walks the sequence in order, from first action to settled outcome."
  >
    <HowItWorks id={sol.slug} steps={sol.flow} />
  </Section>

  <Section eyebrow="Economics" title={sol.economics.heading}>
    <div class="prose-body reveal max-w-3xl space-y-4 text-base">
      {sol.economics.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section eyebrow="Getting started" title="The path in">
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        sol.gettingStarted.map((step, i) => (
          <li class="reveal clip-corner rounded-card border border-line bg-panel p-5">
            <p class="font-mono text-sm font-medium text-green-deep" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-2 text-sm font-semibold text-ink">{step.step}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate">{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <CTA href={SITE.docs}>Read the documentation</CTA>
      <CTA href={SITE.github} variant="secondary">Browse the source</CTA>
    </div>
  </Section>

  <Section eyebrow="Questions" title={`Asked about ${sol.label.toLowerCase()}`}>
    <FaqList items={sol.faqs.slice(0, 3)} />
    <p class="mt-6 text-sm"><a class="font-semibold text-green-deep underline underline-offset-4" href="/faq">More questions → FAQ</a></p>
  </Section>

  <Section eyebrow="Related" title="Continue from here">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        sol.related.map((rel) => (
          <li>
            <a
              href={rel.href}
              class="clip-corner group flex items-center justify-between gap-4 rounded-card border border-line bg-panel px-5 py-4 transition-colors hover:border-green-deep"
            >
              <span class="text-sm font-medium text-ink group-hover:text-green-dark">{rel.label}</span>
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-green-deep">
                <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path>
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <p class="eyebrow">More solutions</p>
      <ul class="mt-4 flex flex-wrap gap-3">
        {
          others.map((o) => (
            <li>
              <a href={`/solutions/${o.slug}`} class="inline-block rounded-sm border border-line-strong px-4 py-2 text-sm font-medium text-slate transition-colors hover:border-green-deep hover:text-green-dark">
                {o.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Base>
