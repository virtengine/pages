---
import Base from "@layouts/Base.astro";
import Section from "@components/Section.astro";
---

<Base
  title="VirtEngine launch updates"
  description="Receive launch and release updates for the VirtEngine protocol."
  path="/launch"
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Launch updates", href: "/launch" }]}
>
  <Section
    eyebrow="Launch updates"
    title="Follow the VirtEngine launch"
    lede="Mainnet is planned for the January 2027 launch window. Join the list for confirmed release and network updates."
  >
    <div class="clip-corner max-w-2xl border border-line-strong bg-panel p-6 md:p-8">
      <h2 class="font-display text-2xl text-ink">Join the launch list</h2>
      <p class="prose-body mt-3">We will only send updates relevant to the protocol launch, releases and network availability.</p>
      <form id="launch-signup" class="mt-7" novalidate>
        <label for="launch-email" class="font-semibold text-ink">Email address</label>
        <input id="launch-email" name="email" type="email" autocomplete="email" required class="mt-2 block w-full rounded-sm border border-line-strong bg-paper px-4 py-3 text-ink" />
        <label class="mt-4 flex gap-3 text-sm text-slate">
          <input id="launch-consent" type="checkbox" required class="mt-1" />
          <span>I agree to receive VirtEngine launch updates. I can unsubscribe at any time.</span>
        </label>
        <div class="cf-turnstile mt-5" data-sitekey="0x4AAAAAAEGUAPwEOuNz9V6u" data-action="launch_signup"></div>
        <button type="submit" class="clip-corner mt-5 bg-green-deep px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-green-dark">Join the launch list</button>
        <p id="launch-form-note" class="mt-3 text-sm text-slate" aria-live="polite">Your email is securely added to the launch list.</p>
      </form>
    </div>
  </Section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.querySelector<HTMLFormElement>("#launch-signup");
    const email = document.querySelector<HTMLInputElement>("#launch-email");
    const consent = document.querySelector<HTMLInputElement>("#launch-consent");
    const note = document.querySelector<HTMLElement>("#launch-form-note");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!email?.checkValidity() || !consent?.checked) { note!.textContent = "Enter a valid email address and confirm that you agree to receive updates."; return; }
      const token = document.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value;
      if (!token) { note!.textContent = "Complete the security check before joining the list."; return; }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submit!.disabled = true; note!.textContent = "Adding you to the list…";
      try {
        const response = await fetch("https://foundation-forms-api.jonathan-f0b.workers.dev/v1/launch-signups", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email.value, consent: true, turnstileToken: token }) });
        if (!response.ok) throw new Error("Signup failed");
        form.reset(); note!.textContent = "You’re on the launch list. Thank you.";
      } catch { note!.textContent = "We could not add you right now. Please try again shortly."; }
      finally { submit!.disabled = false; window.turnstile?.reset(); }
    });
  </script>
</Base>
