---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import MarketplaceListingCard from "@components/marketplace/MarketplaceListingCard.astro";
import RelatedMarketplacePages from "@components/marketplace/RelatedMarketplacePages.astro";
import LifecycleRail from "@components/marketplace/LifecycleRail.astro";
import { NETWORK_STATUS } from "@data/status";

const title = "HPC & Batch Compute on VirtEngine";
const description =
  "Buy HPC and batch compute through VirtEngine: queues, node and GPU counts, job durations and scheduler-backed fulfilment on SLURM, MOAB or Open OnDemand, settled from signed usage.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Marketplace", href: "/marketplace" },
  { name: "HPC & batch", href: "/marketplace/hpc" },
];

const listings = [
  { title: "GPU Batch Queue", specs: ["4 GPUs", "32 CPU cores", "6-hour maximum job"], components: ["GPU-hour", "core-hour"], price: "Allocation-based" },
  { title: "CPU Cluster Allocation", specs: ["256 core-hours", "Shared queue", "Priority: standard"], components: ["core-hour"], price: "Allocation-based" },
  { title: "MPI Job Template", specs: ["Interconnect-aware", "Template defined", "Node count configurable"], components: ["node-hour"], price: "Per-job pricing" },
];

const moreListings = ["Interactive Session — on-demand Jupyter node"];

const schedulerPanel: [string, string][] = [
  ["Queue / partition", "which scheduler lane the job enters"],
  ["Node type", "CPU class, GPU class, interconnect"],
  ["CPU / GPU counts", "per-job or per-allocation limits"],
  ["Wall time", "maximum job duration before the queue ends it"],
  ["Region / facility", "where the cluster sits"],
  ["Storage", "scratch, project or parallel filesystem"],
];

const workloads = ["Simulation", "Rendering", "Research batch"];
---

<Base
  title={title}
  description={description}
  path="/marketplace/hpc"
  image="/media/hpc-supercomputer-1440.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Marketplace · HPC & batch"
    title="HPC & Batch Compute on VirtEngine"
    lede="Scheduler-backed capacity, bought from the catalogue. The listing describes the queue, the nodes, the GPUs and the job limits; the provider's scheduler runs the work."
    crumbs={crumbs}
  >
    <CTA href="/learn/hpc-on-virtengine">Read the HPC guide</CTA>
    <CTA href="/solutions/hpc-clusters" variant="secondary">For HPC facilities</CTA>
    <div class="mk-page-hero-flag">
      <span class="mk-status">{NETWORK_STATUS.posture}</span>
      <span class="mk-flag">Example listings are illustrative</span>
    </div>
    <div slot="art">
      <figure class="mk-viz">
        <div class="mk-viz-flow">
          <span>HPC offering</span>
          <i aria-hidden="true">↓</i>
          <span>Queue / partition</span>
          <i aria-hidden="true">↓</i>
          <span>Lease</span>
          <i aria-hidden="true">↓</i>
          <span>Provider daemon</span>
          <i aria-hidden="true">↓</i>
          <span>SLURM / scheduler</span>
          <i aria-hidden="true">↓</i>
          <span>Job</span>
        </div>
        <figcaption>The scheduler runs the job. The chain records the lease and settles signed usage.</figcaption>
      </figure>
    </div>
  </PageHero>

  <Section
    eyebrow="Listing"
    title="What an HPC listing exposes"
    lede="HPC offerings are catalogue products, not raw scheduler access. The provider publishes the constraints; the listing makes them visible before you order."
  >
    <table class="mk-matrix">
      <thead><tr><th>Field</th><th>What it fixes</th></tr></thead>
      <tbody>
        {schedulerPanel.map(([term, detail]) => (
          <tr><td>{term}</td><td>{detail}</td></tr>
        ))}
      </tbody>
    </table>
  </Section>

  <Section
    eyebrow="Catalogue"
    title="Example HPC listings"
    lede="Three illustrative products — example providers, example figures."
    class="border-y border-line bg-paper-soft"
  >
    <div class="mk-cards-4">
      {
        listings.map((listing) => (
          <MarketplaceListingCard
            serviceType="HPC"
            title={listing.title}
            region="Example facility"
            specs={listing.specs}
            components={listing.components}
            priceLabel={listing.price}
            compact
          />
        ))
      }
    </div>
    <details class="mk-more">
      <summary>More examples</summary>
      <ul class="mk-chip-row">
        {moreListings.map((m) => <li>{m}</li>)}
      </ul>
    </details>
  </Section>

  <Section eyebrow="Workloads" title="Typical HPC workloads">
    <ul class="mk-chip-row">
      {workloads.map((workload) => <li>{workload}</li>)}
    </ul>
  </Section>

  <Section eyebrow="Difference" title="How it differs from generic VM IaaS">
    <div class="mk-cards-2">
      <article class="mk-order-col">
        <h3>VM IaaS</h3>
        <p>You operate a machine: an OS, a network identity and everything above it, for as long as you keep it.</p>
      </article>
      <article class="mk-order-col">
        <h3>HPC listing</h3>
        <p>You submit work into a scheduler: queues, wall time and node classes replace machine ownership, and metering follows the job or allocation.</p>
      </article>
    </div>
    <div class="mk-tech-note">
      <p>
        <strong>Full architecture:</strong> the <a href="/learn/hpc-on-virtengine">HPC on VirtEngine guide</a> covers
        schedulers, workload patterns and cluster operations; <a href="/solutions/hpc-clusters">HPC cluster operators</a>
        covers the provider side; the <a href="/modules/hpc">x/hpc module</a> documents the job marketplace surface.
      </p>
    </div>
  </Section>

  <div class="container-site">
    <LifecycleRail aside={{ label: "Read the HPC guide", href: "/learn/hpc-on-virtengine" }} />
  </div>

  <Section eyebrow="Continue" title="Related pages" class="border-t border-line">
    <RelatedMarketplacePages
      eyebrow="Explore"
      title="Related destinations"
      links={[
        { label: "HPC on VirtEngine guide", href: "/learn/hpc-on-virtengine" },
        { label: "HPC cluster operators", href: "/solutions/hpc-clusters" },
        { label: "GPU & AI compute", href: "/marketplace/gpu-compute" },
      ]}
    />
  </Section>
</Base>
