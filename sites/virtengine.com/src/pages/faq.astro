---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { FAQ, FAQ_CATEGORIES } from "@data/faq";
import { SITE } from "@data/site";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "FAQ", href: "/faq" },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Base
  title="FAQ — VirtEngine questions, answered"
  description="Frequently asked questions about VirtEngine: what the protocol is, mainnet status, provider payments, HPC support, staking economics, slashing risk, VEID privacy, and building on the chain."
  path="/faq"
  breadcrumbs={crumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />
  <PageHero
    eyebrow="FAQ"
    title="Questions, answered from the source"
    lede="Every answer below is grounded in the protocol repository, its documentation, or the foundation's constitution — with links to go deeper."
    crumbs={crumbs}
  />

  {
    FAQ_CATEGORIES.map((cat) => (
      <Section eyebrow="FAQ" title={cat}>
        <div class="max-w-3xl space-y-4">
          {FAQ.filter((f) => f.category === cat).map((f) => (
            <details class="reveal clip-corner group rounded-card border border-line bg-panel">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 text-base font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {f.question}
                <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" class="shrink-0 text-green transition-transform group-open:rotate-180">
                  <polygon points="1,1 11,1 6,7" fill="currentColor" />
                </svg>
              </summary>
              <div class="border-t border-line px-6 py-4">
                <p class="text-sm leading-relaxed text-slate">{f.answer}</p>
                {f.links && (
                  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
                    {f.links.map((l) => (
                      <a href={l.href} class="text-sm font-medium text-green-deep underline decoration-green/50 underline-offset-2 hover:text-green-dark">
                        {l.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </Section>
    ))
  }

  <Section eyebrow="Still curious" title="Where the answers come from">
    <div class="prose-body reveal max-w-3xl text-base">
      <p>
        Everything above traces to a primary source: the
        <a href={SITE.github} rel="noopener">protocol repository</a>, the
        <a href={SITE.docs}>documentation site</a>, or the DETIO FOUNDATION constitution
        (covered on the <a href="/about">about page</a>). For deeper treatments, start with the
        <a href="/learn">guides</a> or the <a href="/modules">module reference</a>.
      </p>
    </div>
    <div class="reveal mt-8 flex flex-wrap gap-4">
      <CTA href="/learn">Browse the guides</CTA>
      <CTA href={`mailto:${SITE.email}`} variant="secondary">Ask us directly</CTA>
    </div>
  </Section>
</Base>
