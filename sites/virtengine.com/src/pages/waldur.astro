---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import ResponsibilityBoundary from "@components/marketplace/ResponsibilityBoundary.astro";
import WaldurInterfaceShowcase from "@components/marketplace/WaldurInterfaceShowcase.astro";
import OrderJourneyDemo from "@components/marketplace/OrderJourneyDemo.astro";
import ImplementationChecklist from "@components/marketplace/ImplementationChecklist.astro";
import RelatedMarketplacePages from "@components/marketplace/RelatedMarketplacePages.astro";
import { NETWORK_STATUS } from "@data/status";

const title = "Waldur + VirtEngine: Catalogue & Control Plane";
const description =
  "How Waldur's enterprise catalogue works with VirtEngine: publish IaaS, PaaS, SaaS and custom listings, fulfil through provider backends, and settle verified usage on-chain.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Waldur", href: "/waldur" },
];

const implemented = [
  "Waldur API client",
  "offering operations",
  "offering synchronisation",
  "order routing",
  "resource lifecycle handling",
  "callback verification",
  "usage submission",
  "provider-daemon integration",
];

const deployment = [
  "Waldur installation",
  "credentials and organisation IDs",
  "organisations and projects",
  "category mappings",
  "backend plugin",
  "TLS and callback configuration",
  "durable chain submission",
  "production certification",
  "infrastructure-specific configuration",
];

const upstreamGroups = [
  {
    label: "Available in Waldur upstream",
    tone: "upstream",
    items: [
      ["Cloud and cluster providers", "Waldur documents OpenStack, Rancher, Kubernetes, VMware, Azure, DigitalOcean, SLURM, MOAB and other provider modules."],
      ["OpenNebula site agent", "Waldur already documents an OpenNebula site-agent plugin; VirtEngine's first-class chain mapping is still planned."],
      ["Federation and identity", "Documented options include eduGAIN, eduTEAMS, Keycloak, LDAP, FreeIPA, MyAccessID and TARA."],
      ["Extensibility", "Remote offerings, custom scripts, OpenPortal and site-agent plugins provide routes for operator-specific services."],
    ],
  },
  {
    label: "VirtEngine roadmap",
    tone: "planned",
    items: [
      ["Proxmox VE", "A planned provider adapter and catalogue route. It is not presented here as a shipped Waldur or VirtEngine integration."],
      ["OpenNebula", "A planned first-class VirtEngine bridge using Waldur's existing site-agent capability, with lifecycle and usage mapped to chain state."],
      ["Production certification", "Each enabled backend still needs versioned profiles, end-to-end provisioning evidence, cleanup, quota and cost-control testing."],
    ],
  },
];

---

<Base title={title} description={description} path="/waldur" breadcrumbs={crumbs}>
  <PageHero
    eyebrow="Open-source cloud operations"
    title="Buy from providers you choose — settle on-chain"
    lede="Waldur is the enterprise catalogue and control plane for the VirtEngine market: publish IaaS, PaaS, SaaS and custom listings, order directly from chosen providers, and gate everything with approvals and compliance. VirtEngine turns each permitted order into a verifiable lease — escrowed, metered and settled on-chain."
    crumbs={crumbs}
    media="open-source-screen"
    mediaCaption="Catalogue and control plane, bridged on-chain."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href="https://waldur.com/">Explore Waldur</CTA>
      <CTA href="https://docs.waldur.com/" variant="secondary">Read Waldur documentation</CTA>
      <CTA href="https://github.com/virtengine/virtengine/tree/main/pkg/waldur" variant="ghost">Inspect the bridge code</CTA>
    </div>
    <div class="mk-page-hero-flag">
      <span class="mk-status">{NETWORK_STATUS.posture}</span>
    </div>
  </PageHero>

  <Section
    eyebrow="Demonstration"
    title="Try a full order on the marketplace"
    lede="The interactive order demo now lives where it belongs — on the marketplace hub. Browse the catalogue, configure a plan, buy direct, by bid or by selector, then deploy the lease and settle usage."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href="/marketplace#demo">Open the order demo</CTA>
      <CTA href="/learn/how-the-marketplace-works" variant="secondary">How the lifecycle works</CTA>
    </div>
  </Section>

  <Section
    eyebrow="Architecture"
    title="One marketplace, three layers"
    lede="VirtEngine treats the chain as the marketplace source of truth. Waldur remains the provider-operated control plane for fulfilment and infrastructure operations. The provider daemon keeps the two correlated."
    id="responsibilities"
  >
    <ResponsibilityBoundary />
    <p class="mt-6 max-w-4xl text-sm leading-relaxed text-muted">
      Waldur is developed independently by the Waldur community and OpenNode Cloud. VirtEngine consumes its
      public platform and client interfaces; it does not own or replace Waldur, and Waldur is not “running on
      the blockchain”.
    </p>
  </Section>

  <Section
    eyebrow="What users actually see"
    title="Waldur HomePort, area by area"
    lede="Four interface areas, and the responsibility split inside each one. Screenshots are Waldur's own, reproduced with attribution."
  >
    <WaldurInterfaceShowcase />
  </Section>

  <Section
    eyebrow="Walkthrough"
    title="Follow one order"
    lede="A fictional Managed GPU Workspace, from publication to settlement. Illustrative example — no step implies live production availability."
    class="border-y border-line bg-paper-soft"
  >
    <OrderJourneyDemo id="waldur" />
  </Section>

  <Section
    eyebrow="Catalogue"
    title="Fulfilled here, explained there."
    lede="Waldur fulfils IaaS, PaaS, SaaS and custom listings — the catalogue itself is owned by the marketplace hub. Direct ordering is what this catalogue fulfils end to end; open bids and selector matching are chain-side paths covered in the buying guide."
  >
    <p class="max-w-4xl text-sm leading-relaxed text-muted">
      Buying modes: <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/three-ways-to-buy">Three ways to buy →</a>
      Service types: <a class="font-semibold text-green-deep underline underline-offset-4" href="/marketplace#service-types">Marketplace catalogue →</a>
      Lifecycle: <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/how-the-marketplace-works">Order → Match → Lease → Usage → Settlement →</a>
    </p>
  </Section>

  <Section
    eyebrow="Enterprise control"
    title="Choose exactly who can serve you"
    lede="Waldur's catalogue controls decide which providers your teams can even see — the chain then records and settles whatever those controls permit."
    class="border-y border-line bg-paper-soft"
  >
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <article class="rounded-card border border-line bg-panel p-6">
        <p class="eyebrow">Catalogue scoping</p>
        <h3 class="mt-4 text-xl font-semibold">Private offerings and limited plans</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate">Providers can publish private offerings visible only to chosen customers, limit plans to specific organization groups, and restrict ordering to named project roles. What your teams can't see, they can't order.</p>
      </article>
      <article class="rounded-card border border-line bg-panel p-6">
        <p class="eyebrow">Dual approval</p>
        <h3 class="mt-4 text-xl font-semibold">Consumer and provider gates</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate">Every order passes two independent approvals: your side (consumer review, cost limits, purchase-order attachments) and the provider's side. Either side can require manual sign-off.</p>
      </article>
      <article class="rounded-card border border-line bg-panel p-6">
        <p class="eyebrow">Terms and compliance</p>
        <h3 class="mt-4 text-xl font-semibold">Contracts accepted per order</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate">Each offering carries its own terms of service, privacy policy and access policies, re-accepted whenever they change. Providers attach compliance checklists your teams answer and auditors can inspect.</p>
      </article>
      <article class="rounded-card border border-line bg-panel p-6">
        <p class="eyebrow">Verified counterparties</p>
        <h3 class="mt-4 text-xl font-semibold">Identity gating before matching</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate">Providers must clear VEID identity verification, minimum trust scores and compliance checks before they can publish; offerings can additionally demand score thresholds and multi-factor authentication from buyers.</p>
      </article>
    </div>
    <p class="mt-6 max-w-4xl text-sm leading-relaxed text-muted">
      A note on SLAs and liability, stated plainly: there is no on-chain SLA object, and the protocol cannot
      underwrite a provider's uptime. Commercial terms live where contracts live — in offering terms, descriptions
      and plans, accepted per order — while the chain independently verifies what money can verify: gated
      counterparties before matching, signed metering during service, escrowed funds, and rule-bound settlement.
      Legal liability stays with the provider organisations you chose; the protocol makes their performance
      auditable.
    </p>
  </Section>

  <Section
    eyebrow="Integration status"
    title="Implemented code, and what deployment still requires"
    lede="An upstream Waldur connector is not automatically a production-ready VirtEngine integration."
  >
    <ImplementationChecklist implemented={implemented} deployment={deployment} />
    <p class="mt-6 max-w-4xl text-sm leading-relaxed text-muted">
      “Implemented” means a code path exists in the repository; production availability still depends on provider
      configuration, credentials, backend compatibility and deployment certification. This status reflects the
      current repository and published Waldur documentation.
    </p>
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        upstreamGroups.map((group) => (
          <article class:list={["waldur-integration-card reveal", `waldur-${group.tone}`]}>
            <p class="waldur-status">{group.label}</p>
            <ul>
              {group.items.map(([name, detail]) => (
                <li><strong>{name}</strong><span>{detail}</span></li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <section class="night-scope border-y border-night-line">
    <div class="container-site grid gap-10 py-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div>
        <p class="eyebrow">Project stewardship</p>
        <h2 class="mt-5 font-display text-3xl text-night-text md:text-4xl">Developed and stewarded by OpenNode Cloud</h2>
        <p class="mt-5 leading-relaxed text-night-muted">
          OpenNode Cloud leads Waldur development, support and deployment services. Waldur is open source and is co-developed with the University of Tartu. VirtEngine consumes the public platform and client interfaces; it does not claim ownership of Waldur.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <CTA href="https://opennodecloud.com/">Visit OpenNode Cloud</CTA>
          <CTA href="https://github.com/waldur" variant="secondary" class="border-night-line-strong text-night-text hover:text-green">Waldur on GitHub</CTA>
        </div>
      </div>
      <div class="waldur-code-window" aria-label="Simplified integration configuration example">
        <div class="waldur-code-bar"><i></i><i></i><i></i><span>provider-daemon</span></div>
        <pre><code><span>source</span>      VirtEngine chain
<span>bridge</span>      provider daemon
<span>control</span>     Waldur MasterMind
<span>catalogue</span>   offerings → orders → resources
<span>feedback</span>    signed lifecycle + usage callbacks
<span>settlement</span>  on-chain escrow release</code></pre>
      </div>
    </div>
  </section>

  <Section
    eyebrow="Primary sources"
    title="Explore the platform directly"
    lede="Architecture and integration details on this page are grounded in the VirtEngine repository and Waldur's official material."
    class="border-t border-line"
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a class="waldur-source-link" href="https://waldur.com/"><strong>Waldur platform</strong><span>Features, use cases and organization showcase</span></a>
      <a class="waldur-source-link" href="https://docs.waldur.com/latest/admin-guide/architecture/"><strong>Architecture</strong><span>HomePort, MasterMind, workers and site agent</span></a>
      <a class="waldur-source-link" href="https://docs.waldur.com/latest/about/concepts/marketplace/"><strong>Marketplace model</strong><span>Offerings, orders, resources and accounting</span></a>
      <a class="waldur-source-link" href="https://docs.waldur.com/latest/integrations/"><strong>Integration catalogue</strong><span>Provider, identity and site-agent plugins</span></a>
      <a class="waldur-source-link" href="https://opennodecloud.com/products/waldur.html"><strong>OpenNode Cloud</strong><span>Development, deployment and support</span></a>
      <a class="waldur-source-link" href="https://github.com/virtengine/virtengine/tree/main/pkg/waldur"><strong>VirtEngine bridge</strong><span>Current integration source code</span></a>
    </div>
  </Section>

  <Section eyebrow="Continue" title="Related pages" class="border-t border-line">
    <RelatedMarketplacePages
      eyebrow="Explore"
      title="Related destinations"
      links={[
        { label: "Marketplace overview", href: "/marketplace" },
        { label: "How the marketplace works", href: "/learn/how-the-marketplace-works" },
        { label: "Three ways to buy", href: "/learn/three-ways-to-buy" },
      ]}
    />
  </Section>
</Base>
