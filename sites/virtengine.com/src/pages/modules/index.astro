---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { MODULE_DOMAINS, MODULES, modulesByDomain } from "@data/modules";
import { SITE } from "@data/site";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Modules", href: "/modules" },
];
---

<Base
  title="27 Cosmos Modules: Marketplace to Staking | VirtEngine"
  description="Complete reference to VirtEngine's 27 Cosmos SDK modules: marketplace, escrow, settlement, VEID identity, HPC and staking. See what each does."
  path="/modules"
  image="/media/open-source-screen-1200.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Module reference"
    title="Twenty-seven modules, one marketplace"
    lede="Everything the marketplace needs lives in x/ modules on the chain — matching, identity, payments, and quality control as consensus-executed state machines. Each module below links to a full reference page."
    crumbs={crumbs}
    media="open-source-screen"
    mediaCaption="Twenty-seven state machines, readable in the open."
  />

  <div class="container-site">
    <input id="mod-filter" class="mod-filter" type="search" placeholder="Filter modules — try escrow, VEID, market…" aria-label="Filter modules" />
  </div>

  {
    MODULE_DOMAINS.map((group) => (
      <Section eyebrow={group.domain} title={group.domain} lede={group.blurb}>
        <ul class="mod-tiles" data-mod-group>
          {modulesByDomain(group.domain).map((mod) => (
            <li data-mod-item data-search={`${mod.path} ${mod.name} ${mod.summary}`.toLowerCase()}>
              <a
                href={`/modules/${mod.slug}`}
              >
                <code>{mod.path}</code>
                <h3>{mod.name}</h3>
                <p>{mod.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section eyebrow="Go deeper" title="From reference to running code">
    <div class="prose-body reveal max-w-3xl text-base">
      <p>
        All {MODULES.length} modules ship in the single <code>virtengine</code> binary, developed in the open at
        <a href={SITE.github} target="_blank" rel="noopener">github.com/virtengine/virtengine</a> under <code>x/</code>.
        For message-level and API documentation, see <a href={SITE.docs} target="_blank" rel="noopener">docs.virtengine.com</a>;
        for the architectural view of how the domains fit together, start with the
        <a href="/protocol">protocol overview</a> or the
        <a href="/learn/how-the-marketplace-works">marketplace lifecycle guide</a>.
      </p>
    </div>
    <div class="reveal mt-8 flex flex-wrap gap-4">
      <CTA href="/protocol">Protocol architecture</CTA>
      <CTA href="/learn" variant="secondary">Guides &amp; explainers</CTA>
    </div>
  </Section>
  <script>
    const input = document.querySelector("#mod-filter");
    input?.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      document.querySelectorAll("[data-mod-item]").forEach((el) => {
        const hay = el.getAttribute("data-search") ?? "";
        el.style.display = !q || hay.includes(q) ? "" : "none";
      });
      document.querySelectorAll("[data-mod-group]").forEach((ul) => {
        const visible = Array.from(ul.querySelectorAll("[data-mod-item]")).some(
          (li) => li.style.display !== "none"
        );
        ul.closest("section").style.display = visible ? "" : "none";
      });
    });
  </script>
</Base>
