---
import Base from "@layouts/Base.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import FaqList from "@components/FaqList.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { MODULES, modulesByDomain } from "@data/modules";
import { SITE } from "@data/site";

export function getStaticPaths() {
  return MODULES.map((mod) => ({ params: { slug: mod.slug }, props: { mod } }));
}

const { mod } = Astro.props;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Modules", href: "/modules" },
  { name: mod.path, href: `/modules/${mod.slug}` },
];

const siblings = modulesByDomain(mod.domain).filter((m) => m.slug !== mod.slug).slice(0, 3);
const githubPath = `${SITE.github}/tree/main/${mod.path}`;
const docsPath = `${SITE.docs}/modules/${mod.slug}`;
---

<Base
  title={`${mod.path} — ${mod.name} module — VirtEngine`}
  description={`${mod.name} module reference: ${mod.summary}`}
  path={`/modules/${mod.slug}`}
  breadcrumbs={crumbs}
>
  <div class="container-site mod-ref-head">
    <Breadcrumbs crumbs={crumbs} class="mb-4" />
    <p class="mod-group">{mod.domain}</p>
    <h1 class="mod-title">{mod.path} — {mod.name}</h1>
    <p class="mod-purpose">{mod.summary}</p>
    <div class="mod-actions">
      <CTA href={githubPath}>Source ↗</CTA>
      <CTA href={SITE.docs} variant="secondary">Docs ↗</CTA>
    </div>
  </div>

  <Section eyebrow="Reference" title="What it does">
    <div class="prose-body max-w-3xl space-y-5 text-base">
      {mod.whatItDoes.map((para) => <p>{para}</p>)}
    </div>
    <p class="mod-why"><strong>Why it exists:</strong> {mod.whyItExists}</p>
  </Section>

  <Section eyebrow="State" title="Primary objects">
    <table class="mod-table">
      <thead><tr><th>Concept</th><th>Definition</th></tr></thead>
      <tbody>
        {mod.concepts.map((c) => (
          <tr><td><code>{c.term}</code></td><td>{c.def}</td></tr>
        ))}
      </tbody>
    </table>
  </Section>

  <Section eyebrow="Messages" title="Messages & queries">
    <p class="max-w-3xl text-sm leading-relaxed text-muted">
      Message and query surfaces are documented at implementation level in the
      <a href={docsPath}> module docs ↗</a> and the <a href={githubPath}>source ↗</a>.
      The objects above are the state those messages create and transition.
    </p>
  </Section>

  <Section eyebrow="Connections" title="Module interactions">
    <ul class="mod-graph">
      {mod.interactions.map((ix) => (
        <li>
          {ix.slug ? <a href={`/modules/${ix.slug}`}><code>{ix.label}</code></a> : <code>{ix.label}</code>}
          <span>{ix.how}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Flows" title="Core flow">
    <ol class="mod-flow">
      {mod.flow.map((s) => (
        <li><strong>{s.label} — {s.title}.</strong> {s.body}</li>
      ))}
    </ol>
  </Section>

  <Section eyebrow="Questions" title={`Asked about ${mod.path}`}>
    <FaqList items={mod.faqs.slice(0, 3)} />
    <p class="mt-6 text-sm"><a class="font-semibold text-green-deep underline underline-offset-4" href="/faq">More questions → FAQ</a></p>
  </Section>

  <Section eyebrow="Related" title="Related modules">
    <ul class="mod-related">
      {siblings.map((sib) => (
        <li><a href={`/modules/${sib.slug}`}><code>{sib.path}</code> — {sib.name} <span aria-hidden="true">→</span></a></li>
      ))}
      <li><a href="/modules">Full module reference →</a></li>
      <li><a href="/protocol">Protocol architecture →</a></li>
    </ul>
  </Section>
</Base>
