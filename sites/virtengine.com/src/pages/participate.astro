---
import Base from "@layouts/Base.astro";
import MediaBand from "@components/media/MediaBand.astro";
import {SITE} from "@data/site";

const paths = [
  {
    id: "learners",
    tab: "I want to learn",
    kicker: "01 / STUDENTS, RESEARCHERS & CURIOUS READERS",
    title: "Understand the system before using it.",
    body: "A cloud marketplace connects people who need computing resources with operators who can supply them. VirtEngine makes the agreement between them part of an open protocol. You do not need tokens, an account, or identity verification to read these resources.",
    steps: [
      "Read the five-stage marketplace guide: order, match, lease, usage, and settlement.",
      "Explore how identity and escrow fit into that agreement.",
      "Use the module reference to connect a concept to its implementation.",
    ],
    actions: [{ label: "Read the introductory guide →", href: "/learn/how-the-marketplace-works" }],
  },
  {
    id: "developers",
    tab: "I want to contribute",
    kicker: "02 / SOFTWARE & DOCUMENTATION CONTRIBUTORS",
    title: "Make the next contribution useful.",
    body: "The project publishes its implementation under Apache 2.0. A contribution can be a reproducible bug report, clearer documentation, a test, or a proposed improvement. Start by understanding the current code and its contribution instructions.",
    steps: [
      "Read the repository README and contribution guidance.",
      "Check existing issues before opening a new one.",
      "Explain the problem and the evidence; discuss larger changes before implementing them.",
    ],
    actions: [
      { label: "Explore the source on GitHub ↗", href: SITE.github },
      { label: "Understand the licence →", href: "/open-source" },
    ],
  },
  {
    id: "operators",
    tab: "I run infrastructure",
    kicker: "03 / PROVIDERS & VALIDATORS",
    title: "Prepare now. Participate after approval.",
    body: "The network is not live. Provider and validator pages explain the proposed operational model, not an available earning opportunity. Review the hardware, key management, integration, and security requirements before considering a future TestNet.",
    steps: [
      "Confirm the target network has an official launch decision.",
      "Review the requirements for your intended role.",
      "Use the published release and verification guidance when a network opens.",
    ],
    actions: [
      { label: "Review provider requirements →", href: "/providers" },
      { label: "Explore validator responsibilities →", href: "/staking" },
      { label: "Check network status →", href: "/network" },
    ],
  },
  {
    id: "collaborators",
    tab: "I want to collaborate",
    kicker: "04 / RESEARCH & PUBLIC-BENEFIT COLLABORATION",
    title: "Bring a question worth working on.",
    body: "If your work concerns open infrastructure, privacy, education, or access to computing, contact the Foundation with a short description of your interest and the problem you hope to address. Possible collaboration is a discussion, not an existing commitment or programme enrolment.",
    steps: [],
    actions: [{ label: "Contact the Foundation →", href: "/contact" }],
  },
];
---
<Base title="Get Involved: Learn, Build & Provide | VirtEngine" description="Get involved with VirtEngine: read free DePIN guides, contribute Apache 2.0 code and docs, or prepare as a GPU provider or validator for TestNet 2027." path="/participate" breadcrumbs={[{name:"Home",href:"/"},{name:"Get involved",href:"/participate"}]}>
<div class="container-site"><div class="content-hero"><p class="kicker">GET INVOLVED</p><h1>Your next step into<br/>an open project.</h1><p class="intro">Start with what you want to do. Learning and open-source contributions are possible today. Network participation depends on a future approved launch.</p></div>
<div class="pp">
  <input type="radio" name="participation-path" id="pp-all" checked class="sr-only" />
  {paths.map((p) => <input type="radio" name="participation-path" id={`pp-${p.id}`} class="sr-only" />)}
  <nav class="route-tabs" role="tablist" aria-label="Choose your participation path">
    <label for="pp-all">Show all paths</label>
    {paths.map((p) => <label for={`pp-${p.id}`}>{p.tab}</label>)}
  </nav>
  <div class="pp-panels">
    {paths.map((p) => (
      <section id={p.id} class="route-section pp-panel" data-pp={p.id}>
        <p class="kicker">{p.kicker}</p>
        <h2>{p.title}</h2>
        <p>{p.body}</p>
        {p.steps.length > 0 && <ol>{p.steps.map((s) => <li>{s}</li>)}</ol>}
        <div class="action-row">
          {p.actions.map((a) => <a class="button primary" href={a.href}>{a.label}</a>)}
        </div>
      </section>
    ))}
  </div>
</div>
<MediaBand layout="reverse" slug="open-source-screen" eyebrow="How contribution works" title="The repository is the invitation." lede="Read the code, reproduce a bug, improve the documentation — contribution happens in the open, under Apache 2.0, with issues and proposals visible to everyone." caption="Source open. Contributions welcome today." />
</div>
</Base>
