---
import BlogArchivePage from "@components/BlogArchivePage.astro";
import { ARCHIVE_PAGES } from "@data/blog";

export function getStaticPaths() {
  return ARCHIVE_PAGES.slice(1).map((posts, index) => ({
    params: { page: String(index + 2) },
    props: { posts, page: index + 2, totalPages: ARCHIVE_PAGES.length },
  }));
}

const { posts, page, totalPages } = Astro.props;
---

<BlogArchivePage posts={posts} page={page} totalPages={totalPages} />
