---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import BlogCard from "@components/BlogCard.astro";
import { CURRENT_POSTS, LEGACY_POSTS } from "@data/blog";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog" },
];
---

<Base
  title="Journal 2026: DePIN & Decentralized Cloud | VirtEngine"
  description="VirtEngine Journal 2026: DePIN, decentralized cloud and protocol design notes, plus the preserved 2015-2016 archive. Learn how open infrastructure evolves."
  path="/blog"
  image="/media/provider-technician-1200.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Journal & archive"
    title="Infrastructure markets, built in the open"
    lede="Current notes on protocol design, verifiable identity, provider operations, and settlement—together with the complete early VirtEngine blog archive."
    crumbs={crumbs}
    media="provider-technician"
    mediaCaption="Field notes from building an infrastructure market."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="rounded-card bg-green-deep px-5 py-3 text-sm font-semibold text-white hover:bg-green-dark" href="#latest">
        Read the latest
      </a>
      <a class="rounded-card border border-line-strong bg-panel px-5 py-3 text-sm font-semibold text-ink hover:border-green-deep" href="/blog/archive">
        Browse 64 historic posts
      </a>
    </div>
  </PageHero>

  <Section
    id="latest"
    eyebrow="Latest writing"
    title="The protocol in practice"
    lede="New articles from the VirtEngine Foundation about the system being built today."
  >
    <div class="grid gap-6 lg:grid-cols-3">
      {CURRENT_POSTS.map((article, i) => <BlogCard article={article} featured mediaIndex={i} />)}
    </div>
  </Section>

  <div class="border-y border-line bg-paper-soft">
    <Section
      eyebrow="Project history"
      title="The original VirtEngine blog, preserved"
      lede="All 64 articles from 2015–2016 have been migrated with their original titles, dates, and article text. They are retained as a historical record, not current technical guidance. Known migration links are repaired where possible; unavailable items are labelled."
    >
      <div class="grid gap-6 md:grid-cols-2">
        {LEGACY_POSTS.slice(0, 4).map((article, i) => <BlogCard article={article} mediaIndex={i + CURRENT_POSTS.length} />)}
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-5 border-t border-line-strong pt-8">
        <p class="max-w-2xl text-sm leading-7 text-slate">
          Historic pages on <span class="font-mono text-xs">blog.virtengine.com</span> permanently redirect to the matching article here, so saved links continue to work.
        </p>
        <a class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-green-deep hover:text-green-dark" href="/blog/archive">
          Open the complete archive →
        </a>
      </div>
    </Section>
  </div>
</Base>
