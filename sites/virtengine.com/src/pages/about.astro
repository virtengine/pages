---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import PartnerStrip from "@components/PartnerStrip.astro";
import { SITE } from "@data/site";

const timeline = [
  {
    period: "Origins",
    title: "VirtEngine by DET.io",
    body: "VirtEngine began under DET.io — Digital Elastic Technologies, Internet Organization — as a platform for offering cloud infrastructure services, before being re-founded as an open-source, on-chain marketplace protocol.",
  },
  {
    period: "Protocol",
    title: "A patented decentralized marketplace",
    body: "The protocol was rebuilt as a CometBFT/Cosmos SDK chain, partly derived from the Akash Network codebase, and its identity-verification consensus system is covered by granted Australian patent AU2024203136B2, in force until 12 May 2044.",
  },
  {
    period: "Stewardship",
    title: "DETIO FOUNDATION LTD",
    body: "The project identifies DETIO FOUNDATION LTD as its steward for the protocol software, reference implementations and token policy — a not-for-profit public company limited by guarantee (ACN 699 651 771) with a constitutional public-benefit lock. The Foundation does not operate the decentralised VEID network.",
  },
  {
    period: "Launch sequence",
    title: "January TestNet, March MainNet",
    body: "TestNet is planned for January 2027, followed by MainNet in March 2027. The intervening period is reserved for observation, remediation, re-testing, and final production approval. Availability will be confirmed through official launch announcements.",
  },
];
---

<Base
  title="About: Open Decentralized Cloud Mission | VirtEngine"
  description="About VirtEngine and DETIO FOUNDATION LTD (ACN 699 651 771): open education, privacy and secure infrastructure. Learn the mission and activities."
  path="/about"
  image="/media/learn-library-1200.webp"
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "About", href: "/about" },
  ]}
>
  <PageHero
    eyebrow="About"
    title="Open technology for public benefit"
    lede="DETIO FOUNDATION LTD stewards VirtEngine to advance open education, secure digital infrastructure, privacy, and equality of access. We publish the software and its design so people can study, challenge, and improve it."
    crumbs={[
      { name: "Home", href: "/" },
      { name: "About", href: "/about" },
    ]}
    media="closing-hands"
    mediaCaption="Open technology, stewarded for public benefit."
  />

  <Section eyebrow="Our purpose" title="Who this work is for">
    <div class="prose-body space-y-5 text-base">
      <p>VirtEngine is an open-source research and development project. Its learning resources serve students, researchers, and developers who want to understand infrastructure markets. Its protocol and integrations are intended to help infrastructure operators and people who need computing resources participate in a transparent marketplace.</p>
      <p>The Foundation's work includes open research, software, specifications, and reference implementations. The intended public benefit is greater access to secure digital infrastructure and greater ability to examine how it works. These are project aims, not claims of measured savings, completed deployments, or people already served.</p>
      <p>The network remains in development. Reading, reviewing code, and contributing are available now; production network services are not. <a href="/network">Read the current launch posture</a> before planning participation.</p>
      <p><a href="/activities">Explore our activities and public resources</a>, <a href="/participate">Find a way to contribute</a> or <a href="/contact">contact the Foundation</a> about the project.</p>
    </div>
  </Section>

  <PartnerStrip class="partner-strip--page" />

  <Section eyebrow="History" title="From DET.io to the foundation">
    <ol class="relative max-w-3xl space-y-10 border-l border-line pl-8">
      {
        timeline.map((item) => (
          <li class="reveal relative">
            <span class="absolute -left-[2.45rem] top-1.5 h-3 w-3 rounded-full border-2 border-green bg-paper" aria-hidden="true" />
            <p class="eyebrow">{item.period}</p>
            <h3 class="mt-1.5 text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="The foundation" title="DETIO FOUNDATION LTD">
    <div class="prose-body reveal max-w-3xl space-y-4 text-base">
      <p>
        DETIO FOUNDATION LTD ("Digital Elastic Technologies, Internet
        Organization") is an Australian not-for-profit
        <strong>public company limited by guarantee</strong>, ACN 699 651 771,
        established for charitable and public-benefit purposes: advancing education
        through open research and specifications, advancing public welfare through
        secure and affordable digital infrastructure, protecting human rights including
        privacy and equality of access, and advancing the security and safety of
        Australia through cyber security, identity safety, AI safety, and infrastructure
        resilience.
      </p>
      <p>
        The foundation stewards two flagship public-benefit technology programs:
        <strong>VirtEngine</strong> — this protocol, its software, standards, patent
        rights, reference implementations and token policy — and
        <strong>DSEMA</strong>, a patent-pending self-evolving multi-agent AI
        architecture. Its constitution forbids operating for private commercial
        interests or permitting private capture of the IP and digital assets it holds.
      </p>
      <p>
        The Foundation operates its own websites and reference services, including
        identity.org.au. VEID itself is decentralised protocol technology: validators who
        meet the network rules can join its operation, and the Foundation does not run a
        central VEID verification service.
      </p>
    </div>
  </Section>

  <Section eyebrow="Patent" title="AU2024203136B2">
    <div class="prose-body reveal max-w-3xl space-y-4 text-base">
      <p>
        Australian patent
        <a href={SITE.patentUrl} target="_blank" rel="noopener">{SITE.patentId}</a> covers the
        decentralized computing system at the heart of VirtEngine — including the
        blockchain control layer in which block-proposing validators decrypt and score
        encrypted identity data with machine-learning models and consensus validators
        independently verify those scores, the on-chain MFA module, the encrypted cloud
        marketplace, the provider daemon, and the staking network that doubles as the
        identity network. The <a href="/open-source">open-source page</a> explains how
        the patent interacts with the Apache 2.0 license.
      </p>
    </div>
  </Section>

  <Section eyebrow="Contact" title="Reach the project">
    <div class="grid max-w-3xl gap-5 sm:grid-cols-2">
      <div class="reveal rounded-card border border-line bg-panel p-7">
        <h3 class="text-base font-semibold">General &amp; licensing</h3>
        <p class="mt-2 font-mono text-sm">
          <a href={`mailto:${SITE.email}`} class="text-green-deep hover:text-green-deep">{SITE.email}</a>
        </p>
      </div>
      <div class="reveal rounded-card border border-line bg-panel p-7">
        <h3 class="text-base font-semibold">Development</h3>
        <p class="mt-2 font-mono text-sm">
          <a href={SITE.github} target="_blank" rel="noopener" class="text-green-deep hover:text-green-deep">github.com/virtengine</a>
        </p>
      </div>
    </div>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <CTA href="/open-source">The open-source project</CTA>
      <CTA href="https://det.io" variant="secondary">DETIO FOUNDATION</CTA>
    </div>
  </Section>
</Base>
