---
import Base from "@layouts/Base.astro";
import DiagramFrame from "@components/DiagramFrame.astro";
import FaqList from "@components/FaqList.astro";
import LifecycleFlow from "@components/diagrams/LifecycleFlow.astro";
import SettlementFlow from "@components/diagrams/SettlementFlow.astro";
import VeidPipeline from "@components/diagrams/VeidPipeline.astro";
import StakingDiagram from "@components/diagrams/StakingDiagram.astro";
import ArchitectureMap from "@components/diagrams/ArchitectureMap.astro";
import WaldurBridge from "@components/diagrams/WaldurBridge.astro";
import MarketplaceVisual from "@components/marketplace/MarketplaceVisual.astro";
import { LEARN } from "@data/learn";
import { GLOSSARY, GLOSSARY_TERMS } from "@data/glossary";
import { media } from "@data/media";
import { SITE } from "@data/site";
import type { LearnDiagram } from "@data/learn";

export function getStaticPaths() {
  return LEARN.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Learn", href: "/learn" },
  { name: guide.label, href: `/learn/${guide.slug}` },
];

/** Stable anchor ids for sections — journey step links are written to match. */
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

/** Short pill label for the on-page nav: "Stage 1 — Order: …" → "Stage 1". */
const navLabel = (heading: string) => heading.split("—")[0].split(":")[0].trim();

const diagrams: Record<LearnDiagram, { component: any; label: string }> = {
  lifecycle: {
    component: LifecycleFlow,
    label:
      "Marketplace lifecycle flow diagram in five stages: order (a tenant posts a deployment), match (a direct purchase at a listed price, an accepted bid, or an attribute match), lease (escrow is funded and the workload starts), usage (signed usage records are submitted), and settlement (escrow is released after the dispute window).",
  },
  settlement: {
    component: SettlementFlow,
    label:
      "Settlement flow diagram: on the provider side, a usage meter, scheduled hourly collector, settlement pipeline with anomaly detection, and chain submitter; on-chain, the settlement module, 24-hour dispute window, escrow, and payout of the agreed amount under the governed fee policy.",
  },
  veid: {
    component: VeidPipeline,
    label:
      "VEID verification pipeline diagram: on-device capture, liveness, biometric attestation, and encryption; on-chain validator identity network scoring encrypted scopes by consensus; zero-knowledge verification surfaces for score thresholds, attributes, and marketplace gating.",
  },
  staking: {
    component: StakingDiagram,
    label:
      "Staking topology diagram: delegators and staking partners delegate to the validator set; validators perform consensus, identity network, and governance duties; rewards flow back minus commission; misbehavior leads to slashing of bonded stake.",
  },
  architecture: {
    component: ArchitectureMap,
    label:
      "Layered architecture diagram: clients on top, the VirtEngine chain with its module domains in the middle, the provider daemon below, and Kubernetes, HPC schedulers, and confidential enclaves at the infrastructure layer.",
  },
  waldur: {
    component: WaldurBridge,
    label:
      "Waldur and VirtEngine integration diagram: the VirtEngine consensus layer exchanges offering, order, lease and settlement state with the provider daemon; the daemon synchronizes and reconciles the Waldur control plane, routes lifecycle actions, validates callbacks and reports usage.",
  },
};

const diagram = guide.diagram ? diagrams[guide.diagram] : null;
const hasVisuals = Boolean(guide.visuals && guide.visuals.length);
const hasJourney = Boolean(guide.journey && guide.journey.length);

const canonical = new URL(`/learn/${guide.slug}`, SITE.url).href;
const guideSchema = {
  "@type": "TechArticle",
  "@id": `${canonical}#article`,
  isPartOf: { "@id": `${canonical}#webpage` },
  mainEntityOfPage: { "@id": `${canonical}#webpage` },
  url: canonical,
  headline: guide.title,
  name: guide.title,
  description: guide.metaDescription,
  inLanguage: "en",
  author: { "@type": "Organization", name: SITE.name, url: SITE.url },
  publisher: { "@id": `${SITE.url}/#organization` },
  image: {
    "@type": "ImageObject",
    url: new URL(media[guide.media].src, SITE.url).href,
    width: 1200,
    height: 630,
  },
  articleSection: guide.kicker,
  proficiencyLevel: "Beginner",
  isAccessibleForFree: true,
};

const glossarySchema = guide.glossary
  ? {
      "@type": "DefinedTermSet",
      "@id": `${canonical}#glossary`,
      name: "VirtEngine marketplace glossary",
      description: guide.metaDescription,
      isPartOf: { "@id": `${canonical}#webpage` },
      hasDefinedTerm: GLOSSARY_TERMS.map((term) => ({
        "@type": "DefinedTerm",
        name: term.term,
        description: term.definition,
        url: `${canonical}#${term.id}`,
      })),
    }
  : null;
---

<Base
  title={`${guide.title} — VirtEngine`}
  description={guide.metaDescription}
  path={`/learn/${guide.slug}`}
  image={media[guide.media].src}
  breadcrumbs={crumbs}
  ogType="article"
  schema={[guideSchema, glossarySchema]}
>
  <div class="learn-progress" aria-hidden="true"><i></i></div>
  <div class="container-site learn-editorial">
    <nav class="learn-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/learn">Learn</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{guide.label}</span>
    </nav>
    <p class="learn-kicker">Learn · {guide.kicker}</p>
    <h1 class="learn-title">{guide.title}</h1>
    <p class="learn-lede">{guide.intro}</p>
    {guide.takeaways && guide.takeaways.length > 0 && (
      <aside class="learn-keypoints" aria-label="Key points">
        <p>Key points</p>
        <ul>
          {guide.takeaways.slice(0, 4).map((t) => <li>{t}</li>)}
        </ul>
      </aside>
    )}
  </div>

  {diagram && (
    <div class="container-site learn-figure">
      <h2 class="sr-only">Figures</h2>
      <DiagramFrame label={diagram.label} caption={guide.diagramCaption} class="reveal">
        <diagram.component />
      </DiagramFrame>
    </div>
  )}

  {hasVisuals && (
    <div class="container-site learn-figure">
      {!diagram && <h2 class="sr-only">Figures</h2>}
      <div class="mk-visual-stack">
        {guide.visuals!.map((visual, index) => (
          <MarketplaceVisual visual={visual} id={`${guide.slug}-${index}`} />
        ))}
      </div>
    </div>
  )}

  <div class="container-site learn-layout">
    <aside class="learn-toc" aria-label="On this page">
      <p>On this page</p>
      <ul>
        {guide.sections.map((section) => (
          <li><a href={`#${slugify(section.heading)}`}>{navLabel(section.heading)}</a></li>
        ))}
        <li><a href="#questions">Questions</a></li>
      </ul>
      {hasJourney && (
        <ul class="learn-journey-nav">
          {guide.journey!.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      )}
    </aside>

    <div class="learn-body">
      {guide.glossary && (
        <section class="learn-glossary" aria-label="Marketplace glossary">
          {GLOSSARY.map((group) => (
            <section aria-labelledby={`glossary-${group.id}`}>
              <h2 id={`glossary-${group.id}`}>{group.heading}</h2>
              <p>{group.intro}</p>
              <dl>
                {group.terms.map((term) => (
                  <div id={term.id}>
                    <dt>{term.term}</dt>
                    <dd>{term.definition}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </section>
      )}

      {guide.screenshots && (
        <section aria-label="Control plane screenshots">
          {guide.screenshots.slice(0, 2).map((shot) => (
            <figure class="learn-shot">
              <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
              <figcaption><strong>{shot.title}.</strong> {shot.caption}</figcaption>
            </figure>
          ))}
        </section>
      )}

      {guide.sections.map((section, si) => (
        <section id={slugify(section.heading)} aria-label={section.heading}>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((para) => <p>{para}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {si === 0 && hasJourney && (
            <ol class="learn-journey-inline">
              {guide.journey!.map((s) => (
                <li><a href={s.href}><strong>{s.label}</strong> — {s.title}</a></li>
              ))}
            </ol>
          )}
        </section>
      ))}

      <section id="questions" aria-label="Questions">
        <h2>Asked about {guide.label.toLowerCase()}</h2>
        <FaqList items={guide.faqs.slice(0, 3)} />
        <p><a href="/faq">More questions → FAQ</a></p>
      </section>

      {guide.sources && (
        <section aria-label="Sources">
          <h2>Sources</h2>
          <ul>
            {guide.sources.map((source) => (
              <li><a href={source.href}>{source.label}</a> — {source.detail}</li>
            ))}
          </ul>
        </section>
      )}

      <nav class="related-links" aria-label="Continue">
        <p>Continue</p>
        <ul>
          {guide.related.slice(0, 3).map((rel) => (
            <li><a href={rel.href}>{rel.label} →</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <script>
    const bar = document.querySelector(".learn-progress i");
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      if (bar && max > 0) bar.style.transform = `scaleX(${h.scrollTop / max})`;
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  </script>
</Base>
