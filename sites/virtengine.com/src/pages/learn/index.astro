---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import MediaFigure from "@components/media/MediaFigure.astro";
import { LEARN } from "@data/learn";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Learn", href: "/learn" },
];

const bySlug = (slug: string) => LEARN.find((g) => g.slug === slug);
const pick = (slugs: string[]) => slugs.map(bySlug).filter((g): g is NonNullable<typeof g> => Boolean(g));

const fundamentals = pick(["how-the-marketplace-works", "iaas-paas-saas-on-virtengine", "what-is-veid", "escrow-and-settlement-explained"]);
const marketplace = pick(["three-ways-to-buy", "anatomy-of-a-marketplace-listing", "marketplace-glossary"]);
const infrastructure = pick(["hpc-on-virtengine", "confidential-computing-on-virtengine"]);
const economics = pick(["tokenomics-explained", "understanding-slashing", "provider-economics", "governance-guide"]);
const network = pick(["mainnet-roadmap"]);

const groups = [
  { eyebrow: "Marketplace", title: "Buying modes, listings, vocabulary", items: marketplace },
  { eyebrow: "Infrastructure", title: "HPC and confidential computing", items: infrastructure },
  { eyebrow: "Economics & governance", title: "Money, risk, and control", items: economics },
  { eyebrow: "Network", title: "Status and roadmap", items: network },
].filter((g) => g.items.length > 0);
---
<Base
  title="Learn: Marketplace, Tokenomics & Cloud Guides | VirtEngine"
  description="Guides that explain how VirtEngine works — from the marketplace and service catalogue to identity, infrastructure, settlement and the MainNet roadmap."
  path="/learn"
  image="/media/learn-library-1200.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    media="learn-library"
    mediaCaption="Written to be checked, not skimmed."
    eyebrow="Learn"
    title="The protocol, explained properly"
    lede="Fewer, stronger guides — each with a distinct job. Start with fundamentals, go deeper where needed, use reference material for lookup."
    crumbs={crumbs}
  >
  </PageHero>

  <Section eyebrow="Fundamentals" title="Start with these four">
    <ul class="learn-map-feature">
      {
        fundamentals.map((guide) => (
          <li>
            <a href={`/learn/${guide.slug}`}>
              <MediaFigure slug={guide.media} ratio="16 / 9" sizes="(min-width: 1024px) 44vw, 100vw" />
              <div>
                <p class="learn-map-kicker">{guide.kicker}</p>
                <h3>{guide.title}</h3>
                <p>{guide.metaDescription}</p>
                <span class="learn-map-go">Read the guide <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    groups.map((group) => (
      <Section eyebrow={group.eyebrow} title={group.title}>
        <ul class="learn-map-list">
          {group.items.map((guide) => (
            <li>
              <a href={`/learn/${guide.slug}`}>
                <span>
                  <small>{guide.kicker}</small>
                  <strong>{guide.title}</strong>
                  <em>{guide.metaDescription}</em>
                </span>
                <span class="learn-map-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section eyebrow="Reference material" title="When you need the exact details">
    <div class="prose-body reveal max-w-3xl text-base">
      <p>
        The guides link into the <a href="/modules">module reference</a> — one page per on-chain
        module — and outward to <a href="https://docs.virtengine.com">docs.virtengine.com</a>
        for message-level documentation. The <a href="/marketplace">marketplace hub</a> covers the
        service catalogue and buying paths, and questions the guides don't answer may already be in
        the <a href="/faq">FAQ</a>.
      </p>
    </div>
    <div class="reveal mt-8 flex flex-wrap gap-4">
      <CTA href="/marketplace">Marketplace hub</CTA>
      <CTA href="/modules" variant="secondary">Module reference</CTA>
      <CTA href="/learn/marketplace-glossary" variant="secondary">Marketplace glossary</CTA>
      <CTA href="/faq" variant="ghost">FAQ</CTA>
    </div>
  </Section>
</Base>
