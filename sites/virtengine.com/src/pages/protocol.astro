---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import Card from "@components/Card.astro";
import CTA from "@components/CTA.astro";
import DiagramFrame from "@components/DiagramFrame.astro";
import ArchitectureMap from "@components/diagrams/ArchitectureMap.astro";
import LifecycleRail from "@components/marketplace/LifecycleRail.astro";
import { MODULE_GROUPS, SITE } from "@data/site";

const architectureLayers = [
  {
    id: "intent",
    n: "01",
    name: "Intent",
    stack: "wallet · CLI · application",
    input: "A signed instruction from a user, tenant or service.",
    output: "A transaction submitted to the network.",
    guarantee: "Only the holder of the keys can authorise the action — intent cannot be forged.",
  },
  {
    id: "coordination",
    n: "02",
    name: "Coordination",
    stack: "market · VEID · escrow",
    input: "Orders, bids, identity scopes and funded escrow.",
    output: "Matches, leases and settlement state.",
    guarantee: "Matching, identity gating and funds follow protocol rules — not a private operator's discretion.",
  },
  {
    id: "consensus",
    n: "03",
    name: "Consensus",
    stack: "27 protocol modules",
    input: "Transactions from every client and provider daemon.",
    output: "Ordered, replicated chain state.",
    guarantee: "Every validator executes the same modules under the same rules; the state is verifiable.",
  },
  {
    id: "execution",
    n: "04",
    name: "Execution",
    stack: "provider daemon · Waldur · Kubernetes · SLURM",
    input: "Lease events and lifecycle actions.",
    output: "Running resources and signed usage records.",
    guarantee: "The chain does not provision; the provider's control plane does, and reports back under signature.",
  },
];
---

<Base
  title="Protocol Architecture: Cosmos SDK Chain | VirtEngine"
  description="VirtEngine protocol architecture: CometBFT + Cosmos SDK chain with 27 modules for marketplace, VEID identity, escrow settlement, HPC and governance."
  path="/protocol"
  image="/media/hero-infrastructure-1440.webp"
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Protocol", href: "/protocol" },
  ]}
>
  <PageHero
    eyebrow="Protocol"
    title="One chain that runs a cloud marketplace end to end"
    lede="VirtEngine is a purpose-built blockchain: consensus, identity verification, resource exchange, and payment settlement in a single Go binary. Here is how it fits together."
    crumbs={[
      { name: "Home", href: "/" },
      { name: "Protocol", href: "/protocol" },
    ]}
    media="hero-infrastructure"
    mediaCaption="One binary: consensus, market, identity, settlement."
  >
  </PageHero>

  <Section
    eyebrow="Architecture"
    title="From client to cluster"
    lede="Four layers: clients sign transactions; the chain orders and executes them by consensus; provider daemons translate leases into running workloads; infrastructure delivers the compute."
  >
    <DiagramFrame
      label="Layered architecture diagram. Top layer: clients — the virtengine CLI, approved client interfaces, the VEID mobile wallet, and gRPC/REST endpoints. Second layer: the VirtEngine chain, a CometBFT consensus and Cosmos SDK application in a single binary whose validators also run the identity network; its modules group into marketplace (market, deployment, provider, resources, marketplace, hpc), identity (veid, veidregistry, mfa, cert, roles, encryption, enclave), economics (escrow, settlement, take, bme, oracle, staking, delegation), and quality (audit, benchmark, review, fraud, support, config). Third layer: the provider daemon, which watches orders, matches or bids, instantiates workloads, and meters and reports usage. Bottom layer: Kubernetes clusters, HPC schedulers (SLURM, MOAB, Open OnDemand), and confidential enclaves."
      caption="fig 01 — VirtEngine Suite: single `virtengine` binary, CometBFT consensus, Cosmos SDK application"
      class="reveal"
    >
      <ArchitectureMap />
    </DiagramFrame>

    <div class="arch-strip">
      {
        architectureLayers.map((layer, i) => (
          <input type="radio" name="arch-layer" id={`arch-${layer.id}`} checked={i === 0} class="sr-only" />
        ))
      }
      <div class="arch-nodes" role="tablist" aria-label="Protocol architecture layers">
        {
          architectureLayers.map((layer) => (
            <label class="arch-node" for={`arch-${layer.id}`}>
              <small>{layer.n}</small>
              <span>{layer.name}</span>
              <em>{layer.stack}</em>
            </label>
          ))
        }
      </div>
      {
        architectureLayers.map((layer) => (
          <div class="arch-detail" data-arch={layer.id}>
            <dl>
              <div><dt>Input</dt><dd>{layer.input}</dd></div>
              <div><dt>Output</dt><dd>{layer.output}</dd></div>
              <div><dt>Guarantee</dt><dd>{layer.guarantee}</dd></div>
            </dl>
          </div>
        ))
      }
      <p class="arch-signed">signed usage returns through the stack ↑</p>
    </div>
  </Section>

  <Section
    eyebrow="Module map"
    title="Twenty-seven modules, four domains"
    lede="Everything the marketplace needs lives in x/ modules on the chain — every module has a dedicated reference page."
  >
    <div class="space-y-10">
      {
        MODULE_GROUPS.map((group) => (
          <div class="reveal">
            <div class="mb-4 flex flex-col gap-1">
              <h3 class="text-xl font-semibold">{group.domain}</h3>
              <p class="max-w-2xl text-sm text-slate">{group.summary}</p>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {group.modules.map((mod) => (
                <li>
                  <a href={`/modules/${mod.name}`} class="clip-corner group flex items-baseline gap-3 rounded-md border border-line bg-panel px-4 py-3 transition-colors hover:border-green-deep">
                    <code class="shrink-0 font-mono text-[0.8rem] font-medium text-green-deep group-hover:text-green-dark">x/{mod.name}</code>
                    <span class="text-sm text-slate">{mod.role}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-10">
      <CTA href="/modules">Open the full module reference</CTA>
    </div>
  </Section>

  <Section
    eyebrow="Lifecycle"
    title="Order to settlement, on chain"
    lede="The five-stage marketplace lifecycle in brief. The canonical guide owns the full stage-by-stage explanation."
  >
    <LifecycleRail />
  </Section>

  <Section
    eyebrow="Economics"
    title="Tokenomics — detail lives in the guide"
    lede="Supply, issuance and rewards are owned by the tokenomics guide. This page keeps architecture only."
  >
    <p class="max-w-3xl text-sm leading-relaxed text-muted">
      Initial supply zero, identity-led issuance, governed parameters. <a class="font-semibold text-green-deep underline underline-offset-4" href="/learn/tokenomics-explained">Tokenomics explained →</a>
      Staking roles: <a class="font-semibold text-green-deep underline underline-offset-4" href="/staking">Staking overview →</a>
    </p>
  </Section>

  <Section
    eyebrow="Governance & security"
    title="Run by stakeholders, engineered defensively"
  >
    <div class="grid gap-5 lg:grid-cols-2">
      <Card title="On-chain governance" class="reveal p-8">
        Bonded stake governs the network: validators and delegators vote on parameter
        changes, upgrades, and chain configuration — including the list of approved
        client interfaces permitted to submit identity data. Economic parameters are
        chain state, adjustable by proposal rather than by decree.
      </Card>
      <Card title="Security posture" class="reveal p-8">
        Sensitive on-chain data is public-key encrypted end to end — only intended
        recipients can decrypt. Validators verify client and user signatures before
        scoring identity data. Slashing punishes consensus misbehavior, the fraud and
        audit modules police marketplace conduct, and the economic model is
        stress-tested against 51%, spam, long-range, and cartel attack scenarios.
      </Card>
    </div>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <CTA href={SITE.docs}>Read the protocol docs</CTA>
      <CTA href={SITE.github} variant="secondary">Browse the source</CTA>
    </div>
  </Section>
</Base>
