---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Section from "@components/Section.astro";
import FaqList from "@components/FaqList.astro";
import { DEFINITIONS, getDefinition } from "@data/definitions";
import { media } from "@data/media";
import { SITE } from "@data/site";
import { articleNode, faqPageNode } from "@lib/schema";

export function getStaticPaths() {
  return DEFINITIONS.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Definitions", href: "/definitions" },
  { name: entry.term, href: `/definitions/${entry.slug}` },
];

const related = entry.related
  .map((slug) => getDefinition(slug))
  .filter((related): related is NonNullable<typeof related> => related !== undefined);

const canonical = new URL(`/definitions/${entry.slug}`, SITE.url).href;
const definitionSchema = articleNode({
  canonical,
  title: entry.term,
  description: entry.summary,
  section: `Definitions · ${entry.group}`,
  type: "TechArticle",
  about: ["Cloud computing", entry.group],
});
const definitionFaqSchema = faqPageNode(canonical, entry.faq);
---

<Base
  title={`${entry.term} | VirtEngine`}
  description={entry.summary}
  path={`/definitions/${entry.slug}`}
  image={media[entry.media].src}
  breadcrumbs={crumbs}
  ogType="article"
  schema={[definitionSchema, definitionFaqSchema]}
>
  <PageHero
    eyebrow={`Definitions · ${entry.group}`}
    title={entry.term}
    lede={entry.summary}
    crumbs={crumbs}
    media={entry.media}
    mediaCaption={entry.mediaCaption}
  />

  {
    entry.sections.map((section, index) =>
      section.heading ? (
        <Section title={section.heading}>
          <div class="prose-body reveal max-w-3xl text-base">
            {section.paragraphs?.map((p) => <p set:html={p} />)}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            )}
            {section.after?.map((p) => <p set:html={p} />)}
          </div>
        </Section>
      ) : (
        <Section class={index === 0 ? "pb-0" : undefined}>
          <div class="prose-body reveal max-w-3xl text-base">
            {section.paragraphs?.map((p) => <p set:html={p} />)}
          </div>
        </Section>
      )
    )
  }

  <Section class="pb-0">
    <div class="max-w-3xl">
      <p class="eyebrow">In practice</p>
      <div class="prose-body mt-4 rounded-card border border-line bg-panel p-6 text-base">
        <p>{entry.practice}</p>
        <p class="mt-4">
          <a class="font-semibold text-green-deep underline underline-offset-4" href={entry.funnel.href}>
            {entry.funnel.label} →
          </a>
        </p>
      </div>
    </div>
  </Section>

  <Section>
    <div class="max-w-3xl">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-3 font-display text-3xl">Asked about {entry.term.replace(/\?$/, "").toLowerCase()}</h2>
      <div class="mt-8">
        <FaqList items={entry.faq} />
      </div>
      <p class="mt-6 text-sm">
        <a class="font-semibold text-green-deep underline underline-offset-4" href="/faq">More questions → FAQ</a>
      </p>
    </div>
  </Section>

  <Section>
    <div class="max-w-3xl">
      <p class="eyebrow">Related</p>
      <h2 class="mt-3 font-display text-3xl">Keep reading</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          related.map((rel) => (
            <li>
              <a
                href={`/definitions/${rel.slug}`}
                class="clip-corner block h-full rounded-card border border-line bg-panel p-5 transition-colors hover:border-green-deep focus-visible:border-green-deep"
              >
                <strong class="block text-base font-semibold text-ink">{rel.term}</strong>
                <span class="mt-1.5 block text-sm leading-relaxed text-slate">{rel.summary}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/definitions"
            class="clip-corner block h-full rounded-card border border-line bg-panel p-5 transition-colors hover:border-green-deep focus-visible:border-green-deep"
          >
            <strong class="block text-base font-semibold text-ink">All definitions</strong>
            <span class="mt-1.5 block text-sm leading-relaxed text-slate">
              Every cloud and marketplace term, defined in one place.
            </span>
          </a>
        </li>
      </ul>
      <p class="mt-8 text-sm text-slate">
        Longer explainers live in <a class="text-green-deep underline underline-offset-4" href="/learn">Learn</a>; the
        full vocabulary is in the <a class="text-green-deep underline underline-offset-4" href="/learn/marketplace-glossary">marketplace glossary</a>.
      </p>
    </div>
  </Section>
</Base>
