---
/**
 * SettlementLedger — Order → Bid → Lease → Usage → Settlement as a
 * travelling signal on a night ledger, not a flowchart of boxes.
 * Step through the stages to inspect each hop.
 */
const stages = [
  { id: "order", x: 36, name: "order", note: "jobs post in the open" },
  { id: "bid", x: 119, name: "bid", note: "offers bind under escrow" },
  { id: "lease", x: 202, name: "lease", note: "funds lock to signed usage" },
  { id: "usage", x: 285, name: "usage", note: "the daemon meters and signs" },
  { id: "settle", x: 368, name: "settle", note: "payout after the window" },
];

const readouts = {
  idle: "Hover a stage or step through the ledger. Usage becomes the bill.",
  order: "Jobs post on chain as open, biddable state.",
  bid: "Offers bind into a lease under escrow.",
  lease: "Lease funds lock against signed usage.",
  usage: "The provider daemon meters and signs usage.",
  settle: "After the 24h dispute window, settlement pays out.",
};
---

<figure class="lg-plot">
  <svg viewBox="0 0 460 300" class="h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path class="rail-cursor" d="M42 150 H410" stroke="#60cc5d" stroke-width="1.6" stroke-linecap="round"></path>
    <path d="M42 150 H410" stroke="#3a4a3c" stroke-width="1.2"></path>

    {
      stages.map((s, i) => (
        <g class="lg-stage" data-ls={s.id}>
          <line x1={s.x + 28} y1="142" x2={s.x + 28} y2="150" stroke="#3a4a3c" stroke-width="1" stroke-dasharray="2 3" />
          <rect x={s.x} y="86" width="56" height="56" rx="8" fill="#1e2a20" stroke={s.id === "settle" ? "#60cc5d" : "#3a4a3c"} />
          <circle cx={s.x + 28} cy="100" r="4" fill="#60cc5d" class="node-pulse" style={`animation-delay:-${i * 0.4}s`} />
          <text x={s.x + 28} y="122" text-anchor="middle" class="art-mono-xs" fill="#e9f0ea">{s.name}</text>
          <text x={s.x + 28} y="135" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="#7d8d7e">0{i + 1}</text>
        </g>
      ))
    }

    <g transform="translate(36,214)">
      <rect width="388" height="56" rx="8" fill="#182219" stroke="#3a4a3c"></rect>
      <text x="16" y="24" class="art-mono-xs" fill="#7d8d7e">escrow</text>
      <text x="16" y="42" font-family="var(--font-sans)" font-size="13" fill="#e9f0ea">24h dispute window · funds release to provider</text>
      <text x="372" y="34" text-anchor="end" class="art-mono-xs" fill="#79d6a3">0% take</text>
    </g>

    <text x="36" y="36" class="art-mono-xs" fill="#7d8d7e">x/escrow · x/settlement · x/take</text>
    <text x="36" y="58" font-family="var(--font-sans)" font-size="16" fill="#e9f0ea">Metered usage becomes the bill.</text>
  </svg>

  <div class="lg-stepper" role="group" aria-label="Ledger stages">
    {
      stages.map((s, i) => (
        <label class="lg-step" for={`lg-${s.id}`}>
          <input type="radio" name="lg-pick" id={`lg-${s.id}`} />
          <span>{String(i + 1).padStart(2, "0")} · {s.name}</span>
        </label>
      ))
    }
  </div>

  <p class="lg-read" aria-live="polite">
    {
      Object.entries(readouts).map(([id, text]) => (
        <span class:list={["lg-ri", `lg-ri--${id}`]}>{text}</span>
      ))
    }
  </p>
</figure>