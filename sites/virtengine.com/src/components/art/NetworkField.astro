---
/**
 * NetworkField — homepage hero, stacked vertically so labels stay readable.
 * 12s CSS loop: workload enters, verification, bids, lease, usage.
 */
import VImage from "@components/brand/VImage.astro";

const providers = [
  { name: "syd-01", region: "ap-southeast-2", bid: "0.42", status: "attested" },
  { name: "mel-gpu", region: "ap-southeast-2", bid: "0.39", status: "selected" },
  { name: "act-hpc", region: "ap-southeast-1", bid: "0.51", status: "attested" },
];
---

<svg
  class="network-field"
  viewBox="0 0 560 980"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <radialGradient id="nf-core" cx="0.48" cy="0.42" r="0.55">
      <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.28"></stop>
      <stop offset="48%" stop-color="#60cc5d" stop-opacity="0.08"></stop>
      <stop offset="100%" stop-color="#60cc5d" stop-opacity="0"></stop>
    </radialGradient>
    <pattern id="nf-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0 H0 V40" stroke="#253027" stroke-width="0.7"></path>
    </pattern>
    <filter id="nf-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>

  <rect width="560" height="980" fill="url(#nf-grid)" opacity="0.4"></rect>
  <rect width="560" height="980" fill="url(#nf-core)"></rect>

  <!-- workload -->
  <g class="nf-workload" transform="translate(48,48)">
    <rect width="464" height="118" rx="12" fill="#1e2a20" stroke="#3a4a3c" stroke-width="1.4"></rect>
    <text x="28" y="36" font-family="var(--font-mono)" font-size="14" letter-spacing="0.12em" fill="#a3b2a4">WORKLOAD</text>
    <text x="28" y="72" font-family="var(--font-sans)" font-size="28" font-weight="600" fill="#e9f0ea">8× GPU · 240 GB VRAM</text>
    <text x="28" y="98" font-family="var(--font-mono)" font-size="15" fill="#60cc5d">ap-southeast-2</text>
  </g>

  <path
    class="nf-path-in dash-march"
    d="M280 166 V 250"
    stroke="#60cc5d"
    stroke-width="2.2"
    stroke-linecap="round"
  ></path>
  <circle class="nf-packet" r="6" fill="#7ddd7a" filter="url(#nf-glow)"></circle>

  <!-- protocol core -->
  <g transform="translate(280,360)">
    <circle r="118" stroke="#3a4a3c" stroke-dasharray="3 10" opacity="0.75" class="spin-slow"></circle>
    <circle r="82" stroke="#60cc5d" stroke-opacity="0.4" stroke-width="1.6"></circle>
    <circle r="52" fill="#182219" stroke="#60cc5d" stroke-width="2"></circle>
    <g transform="translate(-22,-22)">
      <VImage x={0} y={0} h={44} />
    </g>
    <text y="152" text-anchor="middle" font-family="var(--font-mono)" font-size="15" letter-spacing="0.16em" fill="#e9f0ea">PROTOCOL LAYER</text>
  </g>

  <!-- verification -->
  <g class="nf-verify">
    <g transform="translate(36,248)">
      <rect width="210" height="44" rx="22" fill="#182219" stroke="#60cc5d" stroke-width="1.4"></rect>
      <circle cx="22" cy="22" r="6" fill="#60cc5d"></circle>
      <text x="38" y="28" font-family="var(--font-sans)" font-size="15" fill="#e9f0ea">Identity verified</text>
    </g>
    <g transform="translate(314,248)">
      <rect width="210" height="44" rx="22" fill="#182219" stroke="#60cc5d" stroke-width="1.4"></rect>
      <circle cx="22" cy="22" r="6" fill="#60cc5d"></circle>
      <text x="38" y="28" font-family="var(--font-sans)" font-size="15" fill="#e9f0ea">Capacity attested</text>
    </g>
    <g transform="translate(175,548)">
      <rect width="210" height="44" rx="22" fill="#182219" stroke="#60cc5d" stroke-width="1.4"></rect>
      <circle cx="22" cy="22" r="6" fill="#60cc5d"></circle>
      <text x="38" y="28" font-family="var(--font-sans)" font-size="15" fill="#e9f0ea">Escrow active</text>
    </g>
  </g>

  <!-- bids stacked -->
  {
    providers.map((p, i) => (
      <g class={`nf-bid ${i === 1 ? "nf-bid--win" : ""}`} transform={`translate(48, ${620 + i * 92})`}>
        <rect width="464" height="80" rx="10" fill="#1e2a20" stroke={i === 1 ? "#60cc5d" : "#3a4a3c"} stroke-width="1.6" />
        <text x="24" y="32" font-family="var(--font-mono)" font-size="16" fill="#7ddd7a">{p.name}</text>
        <text x="24" y="58" font-family="var(--font-sans)" font-size="15" fill="#a3b2a4">{p.region}</text>
        <text x="300" y="36" font-family="var(--font-sans)" font-size="22" font-weight="600" fill="#e9f0ea">${p.bid}/hr</text>
        <text x="300" y="60" font-family="var(--font-mono)" font-size="13" letter-spacing="0.12em" fill={i === 1 ? "#60cc5d" : "#7d8d7e"}>{p.status.toUpperCase()}</text>
      </g>
    ))
  }

  <path
    class="nf-lease"
    d="M280 478 V 612"
    stroke="#7ddd7a"
    stroke-width="2.4"
    stroke-linecap="round"
  ></path>

  <g class="nf-usage" transform="translate(48, 900)">
    <text font-family="var(--font-mono)" font-size="13" letter-spacing="0.14em" fill="#a3b2a4">USAGE</text>
    <text x="120" font-family="var(--font-mono)" font-size="22" fill="#79d6a3">00:14:22</text>
    <text x="280" font-family="var(--font-sans)" font-size="15" fill="#60cc5d">lease selected · metering</text>
  </g>
</svg>
