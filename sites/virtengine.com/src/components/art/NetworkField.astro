---
/**
 * NetworkField — motion graphic of a lease forming.
 * Hover/focus lights a stage (CSS :has). Click opens the matching page.
 * Zero JS.
 */
import VImage from "@components/brand/VImage.astro";
import { hits, overlays, readouts } from "@data/network";
---

<div class="nf-stage">
  <div class="nf-fighead">
    <p>Live instrument — a lease forming</p>
    <span>Order → match → escrow → settle · hover any stage</span>
  </div>
  <div class="nf-canvas">
    <svg
      class="network-field"
      viewBox="0 0 640 748"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <radialGradient id="nf-glow-core" cx="0.5" cy="0.45" r="0.55">
          <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.32"></stop>
          <stop offset="55%" stop-color="#60cc5d" stop-opacity="0.08"></stop>
          <stop offset="100%" stop-color="#60cc5d" stop-opacity="0"></stop>
        </radialGradient>
        <pattern id="nf-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M32 0 H0 V32" stroke="#253027" stroke-width="0.7"></path>
        </pattern>
        <filter id="nf-soft" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="b"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
        <clipPath id="nf-well-clip">
          <rect x="220" y="588" width="200" height="104" rx="10"></rect>
        </clipPath>
      </defs>

      <rect width="640" height="748" fill="url(#nf-grid)" opacity="0.35"></rect>
      <rect width="640" height="748" fill="url(#nf-glow-core)"></rect>

      <path class="nf-spine" d="M320 118 V 588" stroke="#3a4a3c" stroke-width="1.4"></path>

      <g class="nf-g nf-g-order">
        <rect x="232" y="28" width="176" height="86" rx="12" fill="#1e2a20" stroke="#3a4a3c" stroke-width="1.4"></rect>
        {
          Array.from({ length: 8 }).map((_, i) => (
            <rect
              class="nf-gpu"
              style={`--i:${i}`}
              x={248 + i * 20}
              y="48"
              width="14"
              height="46"
              rx="3"
              fill="#182219"
              stroke="#60cc5d"
              stroke-width="1.2"
            />
          ))
        }
        <text x="48" y="76" font-family="var(--font-mono)" font-size="13" letter-spacing="0.16em" fill="#7d8d7e">ORDER</text>
        <line x1="112" y1="71" x2="224" y2="71" stroke="#253027" stroke-width="1" stroke-dasharray="2 6"></line>
      </g>

      <circle class="nf-packet" r="7" fill="#7ddd7a" filter="url(#nf-soft)"></circle>

      <g class="nf-g nf-g-veid" transform="translate(78,168)">
        <circle class="nf-stamp" cx="48" cy="48" r="46" stroke="#60cc5d" stroke-width="1.6" fill="#182219"></circle>
        <circle cx="48" cy="48" r="32" stroke="#60cc5d" stroke-opacity="0.35" stroke-dasharray="3 6"></circle>
        <path d="M34 28 L62 28 L48 58 Z" fill="#60cc5d" opacity="0.9"></path>
        <text x="48" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="12" letter-spacing="0.14em" fill="#a3b2a4">VEID</text>
      </g>

      <g class="nf-g nf-g-attest" transform="translate(430,176)">
        <rect x="0" y="8" width="112" height="80" rx="10" fill="#182219" stroke="#60cc5d" stroke-width="1.6"></rect>
        <rect class="nf-slot" x="14" y="22" width="84" height="12" rx="2" fill="#60cc5d"></rect>
        <rect class="nf-slot" x="14" y="42" width="84" height="12" rx="2" fill="#3a4a3c"></rect>
        <rect class="nf-slot" x="14" y="62" width="84" height="12" rx="2" fill="#60cc5d"></rect>
        <text x="56" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="12" letter-spacing="0.14em" fill="#a3b2a4">ATTEST</text>
      </g>

      <g class="nf-g nf-core" transform="translate(320,340)">
        <circle r="92" stroke="#3a4a3c" stroke-dasharray="3 10" class="spin-slow"></circle>
        <circle r="64" stroke="#60cc5d" stroke-opacity="0.45" stroke-width="1.5"></circle>
        <circle r="42" fill="#182219" stroke="#60cc5d" stroke-width="2"></circle>
        <g transform="translate(-20,-20)">
          <VImage x={0} y={0} h={40} />
        </g>
      </g>

      <g class="nf-g nf-g-bids">
        <path class="nf-fan" d="M320 432 L140 472 M320 432 L320 472 M320 432 L500 472" stroke="#3a4a3c" stroke-width="1.2"></path>
        <g class="nf-node nf-bid-a" transform="translate(92,472)">
          <rect width="96" height="52" rx="8" fill="#1e2a20" stroke="#3a4a3c" stroke-width="1.4"></rect>
          <path d="M34 14 L62 14 L48 36 Z" fill="#7d8d7e"></path>
          <text x="48" y="74" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="#a3b2a4">0.42</text>
        </g>
        <g class="nf-node nf-bid-win nf-node--win" transform="translate(272,472)">
          <rect width="96" height="52" rx="8" fill="#1e2a20" stroke="#60cc5d" stroke-width="2"></rect>
          <path d="M34 14 L62 14 L48 36 Z" fill="#60cc5d"></path>
          <text x="48" y="74" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="#7ddd7a">0.39</text>
        </g>
        <g class="nf-node nf-bid-c" transform="translate(452,472)">
          <rect width="96" height="52" rx="8" fill="#1e2a20" stroke="#3a4a3c" stroke-width="1.4"></rect>
          <path d="M34 14 L62 14 L48 36 Z" fill="#7d8d7e"></path>
          <text x="48" y="74" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="#a3b2a4">0.51</text>
        </g>
        <text x="44" y="502" font-family="var(--font-mono)" font-size="13" letter-spacing="0.16em" fill="#7d8d7e">MATCH</text>
      </g>

      <g class="nf-g nf-g-escrow">
        <rect x="220" y="588" width="200" height="104" rx="10" fill="#121a14" stroke="#3a4a3c" stroke-width="1.5"></rect>
        <g clip-path="url(#nf-well-clip)">
          <rect class="nf-fill" x="220" y="588" width="200" height="104" fill="#60cc5d" opacity="0.3"></rect>
        </g>
        <text x="236" y="613" font-family="var(--font-mono)" font-size="12.5" letter-spacing="0.16em" fill="#a3b2a4">ESCROW</text>
        <text x="404" y="613" text-anchor="end" font-family="var(--font-mono)" font-size="11.5" letter-spacing="0.12em" fill="#7d8d7e">FEES</text>
        <line x1="236" y1="629" x2="404" y2="629" stroke="#253027" stroke-width="1"></line>
        <text x="320" y="667" text-anchor="middle" font-family="var(--font-sans)" font-size="28" font-weight="700" fill="#7ddd7a">governed</text>
        <text x="320" y="684" text-anchor="middle" font-family="var(--font-mono)" font-size="11" letter-spacing="0.06em" fill="#a3b2a4">protocol parameters</text>
      </g>

      <g class="nf-g nf-g-settle">
        <rect x="236" y="716" width="168" height="10" rx="5" fill="#1e2a20"></rect>
        <rect class="nf-usage" x="236" y="716" width="40" height="10" rx="5" fill="#60cc5d"></rect>
        <circle class="nf-tick" r="4" fill="#7ddd7a"></circle>
        <circle class="nf-tick nf-tick-b" r="4" fill="#7ddd7a"></circle>
        <text x="48" y="725" font-family="var(--font-mono)" font-size="13" letter-spacing="0.16em" fill="#7d8d7e">SETTLE</text>
        <line x1="118" y1="721" x2="228" y2="721" stroke="#253027" stroke-width="1" stroke-dasharray="2 6"></line>
      </g>

      <g class="nf-overlays">
        {overlays.map((o) =>
          o.kind === "circle" ? (
            <circle class="nf-ol" data-ol={o.id} cx={o.x} cy={o.y} r={o.r} />
          ) : (
            <rect class="nf-ol" data-ol={o.id} x={o.x} y={o.y} width={o.w} height={o.h} rx={o.rx ?? 0} />
          )
        )}
      </g>
    </svg>

    <nav class="nf-hits" aria-label="Protocol stages">
      {
        hits.map((h) => (
          <a
            class={`nf-hit nf-hit-${h.id}`}
            href={h.href}
            style={`left:${h.x}%;top:${h.y}%;width:${h.w}%;height:${h.h}%`}
          >
            {h.label}
          </a>
        ))
      }
    </nav>
  </div>

  <p class="nf-readout" aria-live="polite">
    <span class="nf-r nf-r-idle">{readouts.idle}</span>
    <span class="nf-r nf-r-touch">Tap a stage to open it.</span>
    {hits.map((h) => (
      <span class={`nf-r nf-r-${h.id}`}>{readouts[h.id]}</span>
    ))}
  </p>
</div>
