---
/**
 * VeidPhone — the VEID capture wallet as an SVG app mockup, in VirtEngine
 * brand colours. Each phone renders all three screens and switches between
 * them with zero JS; the parent supplies the caption text.
 */
interface Props {
  screen: "capture" | "liveness" | "proof";
  label: string;
  class?: string;
}

const { screen, label, class: className } = Astro.props;
const base = screen;
const SCREEN_BG = "#0c120e";

const screens = ["capture", "liveness", "proof"] as const;

const vault = [
  ["Full name", 236],
  ["Date of birth", 214],
  ["Address", 258],
  ["Document number", 236],
];

const dots = { capture: "01", liveness: "02", proof: "03" } as const;
---

<div class="vp-wrap">
  {
    screens.map((s) => (
      <input type="radio" name={`vp-${base}`} id={`vp-${base}-${s}`} data-vp={s} checked={s === screen} />
    ))
  }

  <svg
    viewBox="0 0 328 670"
    role="img"
    aria-label={label}
    class:list={["block h-auto w-full", className]}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id={`vp-glow-${base}-capture`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#7ddd7a" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`vp-glow-${base}-liveness`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#7ddd7a" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`vp-glow-${base}-proof`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#7ddd7a" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- body -->
    <rect x="11" y="14" width="312" height="652" rx="40" fill="#050906" opacity="0.55" />
    <rect x="4" y="4" width="312" height="652" rx="40" fill="var(--color-night-raised)" />
    <rect x="8" y="8" width="304" height="644" rx="36" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
    <rect x="15" y="15" width="290" height="630" rx="29" fill={SCREEN_BG} />
    <rect x="4" y="150" width="3" height="34" rx="1.5" fill="var(--color-night-line-strong)" />
    <rect x="4" y="196" width="3" height="58" rx="1.5" fill="var(--color-night-line-strong)" />
    <rect x="313" y="172" width="3" height="64" rx="1.5" fill="var(--color-night-line-strong)" />
    <circle cx="122" cy="30" r="3.2" fill="var(--color-night-line-strong)" />
    <rect x="136" y="27" width="48" height="6" rx="3" fill="var(--color-night-line)" />
    <rect x="262" y="43" width="12" height="6" rx="1.5" fill="var(--color-night-line-strong)" />
    <rect x="279" y="44" width="14" height="5" rx="1.5" fill="var(--color-night-line-strong)" />
    <rect x="36" y="42" width="26" height="9" rx="2" stroke="var(--color-night-line-strong)" stroke-width="1.6" />

    <!-- app header -->
    <rect x="16" y="58" width="288" height="44" fill="var(--color-night-panel)" />
    <path d="M38,70 L47,74 v7 c0,4.6-3.4,7.8-9,9.4 -5.6-1.6-9-4.8-9-9.4 v-7 Z" stroke="var(--color-green)" stroke-width="1.8" />
    <path d="M34,80 l3,3 6,-7" stroke="var(--color-green-bright)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="58" y="83" class="vp-title">VEID wallet</text>
    <text x="290" y="83" text-anchor="end" class="vp-mono">DEVICE</text>

    <g class="vp-screen vp-screen--capture">
      <text x="40" y="138" class="vp-h1">Capture your document</text>
      <text x="40" y="160" class="vp-sub">OCR runs on this device, not a server.</text>

      <circle cx="164" cy="320" r="128" fill={`url(#vp-glow-${base}-capture)`} />
      <rect x="40" y="186" width="248" height="184" rx="12" fill="var(--color-night-panel)" stroke="var(--color-night-line-strong)" />
      <path d="M52,212 v-14 h14 M276,212 v-14 h-14 M52,344 v14 h14 M276,344 v14 h-14" stroke="var(--color-green)" stroke-width="2" />
      <rect x="76" y="214" width="86" height="106" rx="6" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
      <circle cx="119" cy="246" r="15" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
      <path d="M100,306 c4,-20 34,-20 38,0" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
      <line x1="180" y1="226" x2="262" y2="226" stroke="var(--color-night-line-strong)" stroke-width="5" />
      <line x1="180" y1="246" x2="250" y2="246" stroke="var(--color-night-line-strong)" stroke-width="5" />
      <line x1="180" y1="266" x2="262" y2="266" stroke="var(--color-night-line-strong)" stroke-width="5" />
      <line x1="180" y1="286" x2="236" y2="286" stroke="var(--color-night-line-strong)" stroke-width="5" />

      <g>
        <path d="M44,404 l5,5 9,-10" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="66" y="410" class="vp-body">Document type detected</text>
        <path d="M44,440 l5,5 9,-10" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="66" y="446" class="vp-body">Front and back aligned</text>
        <circle cx="49" cy="474" r="6" stroke="var(--color-night-line-strong)" stroke-width="1.6" />
        <text x="66" y="482" class="vp-body-dim">Hold still while the shutter fires</text>
      </g>

      <rect x="40" y="532" width="248" height="52" rx="10" fill="var(--color-green)" />
      <text x="164" y="564" text-anchor="middle" class="vp-btn">Capture document</text>
      <text x="164" y="614" text-anchor="middle" class="vp-mono-dim">nothing is uploaded yet</text>
    </g>

    <g class="vp-screen vp-screen--liveness">
      <text x="40" y="138" class="vp-h1">Prove you are present</text>
      <text x="40" y="160" class="vp-sub">An active challenge, not a stored photo.</text>

      <circle cx="164" cy="318" r="124" fill={`url(#vp-glow-${base}-liveness)`} />
      <ellipse cx="164" cy="314" rx="92" ry="110" stroke="var(--color-green)" stroke-width="1.6" stroke-dasharray="4 8" />
      <circle cx="164" cy="284" r="40" stroke="var(--color-night-line-strong)" stroke-width="1.6" />
      <path d="M118,390 c8,-40 84,-40 92,0" stroke="var(--color-night-line-strong)" stroke-width="1.6" />
      <path d="M132,274 q10,-10 22,-2 M174,272 q10,-8 20,2" stroke="var(--color-green-bright)" stroke-width="2" stroke-linecap="round" />
      <path d="M150,324 q14,10 28,0" stroke="var(--color-green-bright)" stroke-width="2" stroke-linecap="round" />

      <rect x="96" y="436" width="136" height="34" rx="17" fill="var(--color-green-wash)" fill-opacity="0.12" stroke="var(--color-green)" stroke-opacity="0.6" />
      <text x="164" y="458" text-anchor="middle" class="vp-chip">slowly blink</text>

      <g>
        {
          [0, 1, 2].map((i) => (
            <g>
              <circle cx={116 + i * 48} cy="500" r="7" fill={i < 2 ? "var(--color-green)" : "none"} stroke={i < 2 ? "none" : "var(--color-night-line-strong)"} stroke-width="1.6" />
              <text x={116 + i * 48} y="528" text-anchor="middle" class="vp-mono-dim">{`0${i + 1}`}</text>
            </g>
          ))
        }
      </g>

      <rect x="40" y="532" width="248" height="52" rx="10" fill="var(--color-green)" />
      <text x="164" y="564" text-anchor="middle" class="vp-btn">Confirm liveness</text>
    </g>

    <g class="vp-screen vp-screen--proof">
      <text x="40" y="138" class="vp-h1">Share only what is needed</text>
      <text x="40" y="160" class="vp-sub">Prove the answer — keep the data.</text>

      <rect x="32" y="176" width="264" height="172" rx="12" fill="var(--color-night-panel)" stroke="var(--color-night-line-strong)" />
      <text x="46" y="198" class="vp-mono-dim">STAYS ON YOUR DEVICE · ENCRYPTED</text>
      {
        vault.map(([item, w], i) => (
          <g transform={`translate(46, ${208 + i * 36})`}>
            <rect x="0" y="0" width="236" height="28" rx="6" fill={SCREEN_BG} stroke="var(--color-night-line)" />
            <text x="12" y="19" class="vp-body-dim">{item}</text>
            <rect x="134" y="10" width={Number(w) - 186} height="8" rx="4" fill="var(--color-night-line-strong)" />
            <rect x="212" y="8" width="10" height="8" rx="1.5" stroke="var(--color-night-muted)" stroke-width="1.6" />
            <path d="M214,8 V6.6 a3,3 0 0 1 6,0 V8" stroke="var(--color-night-muted)" stroke-width="1.6" />
          </g>
        ))
      }

      <path d="M164,356 v18" stroke="var(--color-green)" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="2 7" />
      <path d="m156,370 8,10 8,-10" stroke="var(--color-green)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />

      <rect x="52" y="390" width="224" height="84" rx="12" fill="var(--color-night-panel)" stroke="var(--color-green)" stroke-width="2" />
      <text x="68" y="414" class="vp-mono-grn">SHARED WITH THE VERIFIER</text>
      <circle cx="86" cy="446" r="14" fill="var(--color-green-wash)" fill-opacity="0.14" stroke="var(--color-green)" stroke-width="1.8" />
      <path d="m79,446 5,5 9,-11" stroke="var(--color-green-bright)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      <text x="110" y="442" class="vp-proof">score ≥ threshold</text>
      <text x="110" y="460" class="vp-sub-sm">one fact · nothing else</text>

      <text x="48" y="502" class="vp-sub-sm">The verifier checks the proof is genuine</text>
      <text x="48" y="518" class="vp-sub-sm">without ever seeing your information.</text>

      <rect x="40" y="532" width="248" height="52" rx="10" fill="var(--color-green)" />
      <text x="164" y="564" text-anchor="middle" class="vp-btn">Share proof</text>
    </g>
  </svg>

  <div class="vp-dots" role="tablist" aria-label="Wallet screens">
    {
      screens.map((s) => (
        <label class="vp-dot" for={`vp-${base}-${s}`} data-vp-dot={s}>
          <i class="vp-dot-knob" aria-hidden="true"></i>
          <span>{dots[s]} · {s}</span>
        </label>
      ))
    }
  </div>
</div>

<style>
  .vp-wrap {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }
  .vp-wrap > input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .vp-screen {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease;
  }
  .vp-wrap:has(input[data-vp="capture"]:checked) .vp-screen--capture,
  .vp-wrap:has(input[data-vp="liveness"]:checked) .vp-screen--liveness,
  .vp-wrap:has(input[data-vp="proof"]:checked) .vp-screen--proof {
    opacity: 1;
    visibility: visible;
  }
  @supports not (selector(:has(*))) {
    .vp-screen { opacity: 0; visibility: hidden; }
    .vp-screen--capture { opacity: 1; visibility: visible; }
  }
  .vp-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
  }
  .vp-dot {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-night-line);
    border-radius: 999px;
    background: var(--color-night-panel);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-night-faint);
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }
  .vp-dot-knob {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-night-line-strong);
  }
  .vp-dot:hover {
    border-color: var(--color-green-deep);
    color: var(--color-night-text);
  }
  .vp-wrap:has(input[data-vp="capture"]:checked) .vp-dot[data-vp-dot="capture"],
  .vp-wrap:has(input[data-vp="liveness"]:checked) .vp-dot[data-vp-dot="liveness"],
  .vp-wrap:has(input[data-vp="proof"]:checked) .vp-dot[data-vp-dot="proof"] {
    border-color: var(--color-green);
    color: var(--color-green);
  }
  .vp-wrap:has(input[data-vp="capture"]:checked) .vp-dot[data-vp-dot="capture"] .vp-dot-knob,
  .vp-wrap:has(input[data-vp="liveness"]:checked) .vp-dot[data-vp-dot="liveness"] .vp-dot-knob,
  .vp-wrap:has(input[data-vp="proof"]:checked) .vp-dot[data-vp-dot="proof"] .vp-dot-knob {
    background: var(--color-green);
  }
  .vp-title {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    fill: var(--color-night-text);
  }
  .vp-h1 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
    fill: var(--color-night-text);
  }
  .vp-sub {
    font-family: var(--font-sans);
    font-size: 13.5px;
    fill: var(--color-night-muted);
  }
  .vp-sub-sm {
    font-family: var(--font-sans);
    font-size: 12.5px;
    fill: var(--color-night-muted);
  }
  .vp-body {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    fill: var(--color-night-text);
  }
  .vp-body-dim {
    font-family: var(--font-sans);
    font-size: 13.5px;
    fill: var(--color-night-muted);
  }
  .vp-btn {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: #0a100c;
  }
  .vp-proof {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: var(--color-night-text);
  }
  .vp-chip {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--color-green);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vp-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--color-night-faint);
  }
  .vp-mono-dim {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.09em;
    fill: var(--color-night-muted);
  }
  .vp-mono-grn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--color-green);
  }
</style>