---
/**
 * VeidScopes — identity as concentric evidence rings, not a portrait.
 * Encrypted scopes are dotted; consensus is a ring of validator marks.
 * Hover a scope card to trace its ring and read what crosses it.
 */
import VImage from "@components/brand/VImage.astro";

const validators = [0, 45, 90, 135, 180, 225, 270, 315].map((deg) => {
  const r = 118;
  const rad = ((deg - 90) * Math.PI) / 180;
  return { x: +(160 + r * Math.cos(rad)).toFixed(1), y: +(150 + r * Math.sin(rad)).toFixed(1) };
});

const scopes = [
  { id: "scope", key: "01 · scope", value: "liveness", y: 58, hot: false },
  { id: "evidence", key: "02 · evidence", value: "encrypted", y: 114, hot: false },
  { id: "consensus", key: "03 · consensus", value: "validator set", y: 170, hot: true },
  { id: "proof", key: "04 · proof", value: "zk threshold", y: 226, hot: false },
];

const readouts = {
  idle: "Hover a scope card to trace it around the ring.",
  scope: "Liveness is proven on device, in the camera plane.",
  evidence: "Scopes are sealed with public-key encryption.",
  consensus: "Validators score identity and commit by consensus.",
  proof: "Only a zero-knowledge proof crosses this ring.",
};
---

<figure class="vs-plot">
  <svg viewBox="0 0 420 300" class="h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <radialGradient id="veid-glow" cx="0.5" cy="0.48" r="0.5">
        <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.2"></stop>
        <stop offset="100%" stop-color="#7ddd7a" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="420" height="300" fill="url(#veid-glow)"></rect>

    <circle class="spin-slow" cx="160" cy="150" r="118" stroke="#3a4a3c" stroke-dasharray="2 7"></circle>
    <circle cx="160" cy="150" r="84" stroke="#60cc5d" stroke-opacity="0.45"></circle>
    <circle cx="160" cy="150" r="56" stroke="#60cc5d" stroke-dasharray="3 6" stroke-opacity="0.7" class="spin-rev"></circle>
    <circle cx="160" cy="150" r="28" fill="#182219" stroke="#60cc5d"></circle>
    <g transform="translate(144,134)">
      <VImage x={0} y={0} h={32} />
    </g>

    {
      validators.map((p, i) => (
        <circle cx={p.x} cy={p.y} r="4" fill="#60cc5d" class="node-pulse" style={`animation-delay:-${i * 0.35}s`} />
      ))
    }

    {
      scopes.map((s) => (
        <line class="vs-lead" x1="282" y1={s.y + 18} x2="291" y2={s.y + 18} stroke="#3a4a3c" stroke-dasharray="2 3" stroke-width="1" />
      ))
    }

    {
      scopes.map((s) => (
        <g class:list={["vs-card", s.hot && "vs-card--hot"]} data-vs={s.id}>
          <rect class="vs-frame" x="292" y={s.y} width="112" height="40" rx="7" fill="#1e2a20" stroke="#3a4a3c" stroke-width="1" />
          <rect class="vs-bar" x="294" y={s.y + 2} width="3" height="36" rx="1.5" fill="#3a4a3c" />
          <text x="304" y={s.y + 16} font-family="var(--font-mono)" font-size="10" letter-spacing="0.08em" fill="#7d8d7e">{s.key}</text>
          <text x="304" y={s.y + 31} font-family="var(--font-sans)" font-size="13" fill={s.hot ? "#7ddd7a" : "#e9f0ea"}>{s.value}</text>
        </g>
      ))
    }

    <text x="160" y="288" text-anchor="middle" class="art-mono-xs" fill="var(--color-muted)">raw identity never crosses this ring</text>
  </svg>

  {
    scopes.map((s) => (
      <>
        <input class="vs-input" type="radio" name="vs-pick" id={`vs-${s.id}`} />
        <label
          class="vs-hit"
          for={`vs-${s.id}`}
          aria-hidden="true"
          style={`left:${((292 / 420) * 100).toFixed(2)}%;top:${((s.y / 300) * 100).toFixed(2)}%;width:${((112 / 420) * 100).toFixed(2)}%;height:${((40 / 300) * 100).toFixed(2)}%`}
        ></label>
      </>
    ))
  }

  <p class="vs-read" aria-hidden="true">
    {
      Object.entries(readouts).map(([id, text]) => (
        <span class:list={["vs-r", `vs-r--${id}`]}>{text}</span>
      ))
    }
  </p>
</figure>