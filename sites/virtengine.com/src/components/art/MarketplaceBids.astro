---
/**
 * MarketplaceBids — a restrained marketplace instrument: one order, three
 * competing bids, one selected lease. Hover or select a bid to inspect it.
 */
const bids = [
  { id: "syd-01", region: "ap-southeast-2", price: "0.42", status: "attested", win: false },
  { id: "mel-gpu", region: "ap-southeast-2", price: "0.39", status: "selected", win: true },
  { id: "act-hpc", region: "ap-southeast-1", price: "0.51", status: "attested", win: false },
];

const readouts = {
  idle: "An open order in its bidding window — direct orders match at list price instead.",
  "syd-01": "0.42 / hr — attested. Above the accepted offer.",
  "mel-gpu": "0.39 / hr — accepted. The lease forms here.",
  "act-hpc": "0.51 / hr — attested, beyond the match.",
};
---

<div class="mk-board">
  <div class="mk-rail">
    <span>x/market</span>
    <span>order → match → lease</span>
  </div>
  <div class="mk-order">
    <small>open order</small>
    <strong>8× GPU · 240 GB VRAM</strong>
    <span>attributes · confidential=false · region=ap-southeast</span>
  </div>
  <ol class="mk-bids">
    {
      bids.map((b, i) => (
        <li>
          <input type="radio" name="mk-pick" id={`mk-${b.id}`} />
          <label class:list={["mk-bid", b.win && "mk-bid--win"]} for={`mk-${b.id}`} style={`--i:${i}`} data-mk={b.id}>
            <span class="mk-id">{b.id}</span>
            <span class="mk-region">{b.region}</span>
            <span class="mk-price">${b.price}/hr</span>
            <span class="mk-status">
              <i class="mk-dot" aria-hidden="true"></i>
              {b.status}
            </span>
          </label>
        </li>
      ))
    }
  </ol>
  <p class="mk-read" aria-live="polite">
    {
      Object.entries(readouts).map(([id, text]) => (
        <span class:list={["mk-ri", `mk-ri--${id}`]}>{text}</span>
      ))
    }
  </p>
  <div class="mk-lease">
    <i class="lamp"></i>
    <span>lease formed · escrow funded · governed settlement fees</span>
  </div>
</div>