---
/**
 * InfraKinds — four architectural silhouettes, same crop and grain.
 * Labels only. No people, no coins, no stock photography.
 */
const kinds = [
  {
    id: "gpu",
    label: "GPU compute",
    note: "dense accelerators",
  },
  {
    id: "hpc",
    label: "HPC",
    note: "scheduler-backed clusters",
  },
  {
    id: "cloud",
    label: "General cloud",
    note: "CPU · storage · region",
  },
  {
    id: "enclave",
    label: "Confidential workloads",
    note: "attested enclaves",
  },
] as const;
---

<div class="infra-kinds" aria-hidden="true">
  {
    kinds.map((k) => (
      <figure class={`infra-kind infra-kind--${k.id}`}>
        <svg viewBox="0 0 280 220" fill="none" xmlns="http://www.w3.org/2000/svg">
          {k.id === "gpu" && (
            <g stroke="#60cc5d" stroke-opacity="0.85">
              { [0, 1, 2, 3, 4].map((i) => (
                <g transform={`translate(${28 + i * 46}, 48)`}>
                  <path d="M8 96 L28 84 L48 96 L48 132 L28 144 L8 132 Z" fill="#1e2a20" stroke-width="1.3" />
                  <path d="M8 96 L28 84 L48 96 L28 108 Z" fill="#60cc5d" fill-opacity="0.12" />
                  <rect x="18" y="108" width="6" height="18" fill="#60cc5d" fill-opacity="0.55" stroke="none" />
                  <rect x="28" y="108" width="6" height="18" fill="#60cc5d" fill-opacity="0.28" stroke="none" />
                </g>
              )) }
            </g>
          )}
          {k.id === "hpc" && (
            <g>
              { [0, 1, 2].map((col) =>
                [0, 1, 2].map((row) => (
                  <rect
                    x={48 + col * 64}
                    y={40 + row * 42}
                    width="52"
                    height="34"
                    rx="3"
                    fill="#1e2a20"
                    stroke="#3a4a3c"
                  />
                ))
              ) }
              <path d="M48 178 H240" stroke="#60cc5d" stroke-width="1.4" />
              <circle cx="144" cy="178" r="4" fill="#60cc5d" />
            </g>
          )}
          {k.id === "cloud" && (
            <g stroke="#3a4a3c" stroke-width="1.3" stroke-linejoin="round">
              <path d="M40 58 L140 168 L240 58" />
              <path d="M70 58 L140 138 L210 58" />
              <path d="M100 58 L140 108 L180 58" />
              <path d="M40 58 H240" stroke="#60cc5d" />
              <circle cx="140" cy="168" r="5" fill="#60cc5d" stroke="none" />
            </g>
          )}
          {k.id === "enclave" && (
            <g>
              <rect x="86" y="42" width="108" height="132" rx="10" fill="#1e2a20" stroke="#60cc5d" />
              <rect x="104" y="62" width="72" height="72" rx="6" stroke="#3a4a3c" />
              <path d="M122 98 L140 114 L168 82" stroke="#60cc5d" stroke-width="2" />
              <text x="140" y="156" text-anchor="middle" class="art-mono-xs" fill="#7d8d7e">attested</text>
            </g>
          )}
        </svg>
        <figcaption>
          <strong>{k.label}</strong>
          <span>{k.note}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
