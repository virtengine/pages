          <rect x="36" y="520.2" width="9" height="8" rx="1.5" stroke="var(--color-night-muted)" stroke-width="1.4" />
          <path d="M38,520.2 v-2 a2.5,2.5 0 0 1 5,0 v2" stroke="var(--color-night-muted)" stroke-width="1.4" />
