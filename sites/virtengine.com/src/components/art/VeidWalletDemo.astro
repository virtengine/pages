          <text x="38" y="510" class="vwd-mono-sm">Sealed under keys held in the secure element.</text>

          <rect x="24" y="566" width="280" height="48" rx="8" stroke="var(--color-green)" stroke-width="1.6" />
          <text x="164" y="596" text-anchor="middle" class="vwd-btn-ghost">Run it again</text>
          <text x="164" y="636" text-anchor="middle" class="vwd-foot">nothing else was shared</text>
        </g>
      </svg>

      <label class="vwd-tap vwd-tap--to-liveness" for="vwd-step-2" aria-hidden="true"></label>
      <label class="vwd-tap vwd-tap--to-proof" for="vwd-step-3" aria-hidden="true"></label>
      <label class="vwd-tap vwd-tap--to-receipt" for="vwd-step-4" aria-hidden="true"></label>
      <label class="vwd-tap vwd-tap--to-capture" for="vwd-step-1" aria-hidden="true"></label>
    </div>

    <div class="vwd-rail">
      <fieldset class="vwd-steps">
        <legend class="sr-only">VEID wallet demo — choose a step</legend>
        {
          steps.map((s, i) => (
            <>
              <input
                class="vwd-input"
                type="radio"
                name="vwd-step"
                id={`vwd-step-${i + 1}`}
                checked={i === 0}
              />
              <label class="vwd-step" data-step={s.key} for={`vwd-step-${i + 1}`}>
                <i class="vwd-step-dot" aria-hidden="true" />
                <span>{s.n} · {s.label}</span>
              </label>
            </>
          ))
        }
        <input class="vwd-input" type="radio" name="vwd-step" id="vwd-step-4" />
        <label class="sr-only" for="vwd-step-4">Proof shared — receipt</label>
      </fieldset>

      <div class="vwd-panels">
        {
          steps.map((s) => (
            <section class:list={["vwd-panel", `vwd-panel--${s.key}`]} aria-label={`Step ${s.n} — ${s.label}`}>
              <p class="vwd-kicker">{s.n} · {s.kicker}</p>
              <h3 class="vwd-panel-title">{s.title}</h3>
              <p class="vwd-panel-body">{s.body}</p>

              <dl class="vwd-boundary">
                <div class="vwd-bound-row">
                  <dt>Stays on the handset</dt>
                  <dd>{s.stay}</dd>
                </div>
                <div class:list={["vwd-bound-row", "vwd-bound-row--cross", s.strong && "vwd-bound-row--strong"]}>
                  <dt>Crosses the boundary</dt>
                  <dd>{s.cross}</dd>
                </div>
              </dl>

              <div class="vwd-console">
                <div class="vwd-console-head">
                  <span class="vwd-console-led" aria-hidden="true" />
                  <span class="vwd-console-title">device console · on-handset</span>
                </div>
                <div class="vwd-console-body">
                  {s.log.map((line) => (
                    <p class:list={["vwd-log", line.ok && "vwd-log--ok"]}>
                      <span class="vwd-log-t">{line.t}</span>
                      <span class="vwd-log-mark" aria-hidden="true">{line.ok ? "✓" : "·"}</span>
                      <span class="vwd-log-msg">{line.msg}</span>
                    </p>
                  ))}
                </div>
              </div>
            </section>
          ))
        }
      </div>

      <p class="vwd-hint">tap a step above — or the button inside the app — to walk the flow</p>
    </div>
  </div>
</div>
