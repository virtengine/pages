---
/**
 * VeidWalletDemo — the VEID capture wallet as a working, zero-JS walkthrough.
 * One phone renders four states (capture → liveness → proof → receipt); the
 * in-app primary button and the step rail advance it through hidden radio
 * inputs, so the demo behaves like the app it describes. The rail carries the
 * per-step account of what stays on the handset and what crosses the boundary,
 * plus the on-device console log. No client JavaScript is used — state is
 * carried by `:has()` selectors, with a stacked fallback for engines without it.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const steps = [
  {
    n: "01",
    key: "capture",
    label: "Capture",
    kicker: "Capture",
    title: "Read on the handset",
    body: "Documents are read with OCR on the handset. Nothing is uploaded at capture time.",
    stay: "Document image · OCR text · 5 detected fields",
    cross: "Nothing — 0 B leaves the handset",
    strong: false,
    log: [
      { t: "09:41:02", msg: "camera.start · rear · 60 fps", ok: true },
      { t: "09:41:03", msg: "frame.quality · edges · glare · blur", ok: true },
      { t: "09:41:04", msg: "ocr.detect · type=AU_DL · confidence 0.98", ok: true },
      { t: "09:41:04", msg: "ocr.extract · 5 fields · on-device only", ok: true },
      { t: "09:41:05", msg: "upload · 0 B · nothing leaves the handset", ok: true },
    ],
  },
  {
    n: "02",
    key: "liveness",
    label: "Liveness",
    kicker: "Liveness + attestation",
    title: "Prove a present human",
    body: "An active challenge proves a present human; hardware attestation binds the capture to secure silicon.",
    stay: "Selfie frames · depth map · secure-element key",
    cross: "Nothing — frames are discarded",
    strong: false,
    log: [
      { t: "09:41:05", msg: "camera.start · front · face centred", ok: true },
      { t: "09:41:06", msg: "anti-spoof · depth · reflection · replay", ok: true },
      { t: "09:41:07", msg: "challenge.1 · blink · watching", ok: false },
      { t: "09:41:07", msg: "attestation · Play Integrity / App Attest", ok: true },
      { t: "09:41:07", msg: "key.bind · secure element · …A9F3", ok: true },
    ],
  },
  {
    n: "03",
    key: "proof",
    label: "Proof",
    kicker: "Prove without revealing",
    title: "Share the proof, not the data",
    body: "Name, date of birth, address and document number stay sealed on the device. Only the proof is shared.",
    stay: "Name · date of birth · address · document number",
    cross: "One threshold proof — no personal fields",
    strong: true,
    log: [
      { t: "09:41:12", msg: "scope.select · trust ≥ threshold · consent recorded", ok: false },
      { t: "09:41:13", msg: "zk.prove · circuit=veid-threshold · 1.8 s", ok: true },
      { t: "09:41:13", msg: "sign · holder key · …A9F3 · nonce 7C3A", ok: true },
      { t: "09:41:14", msg: "share → marketplace.virtengine.com", ok: true },
      { t: "09:41:14", msg: "payload · 1 assertion · 0 personal fields", ok: true },
      { t: "09:41:14", msg: "receipt.issued · expires 2026-10-19", ok: true },
    ],
  },
];

const vault = ["Full name", "Date of birth", "Address", "Document number"];
const sealed = [
  { label: "Name", x: 38, w: 54 },
  { label: "DOB", x: 100, w: 46 },
  { label: "Address", x: 154, w: 68 },
  { label: "Doc no.", x: 230, w: 62 },
];
---

<div class:list={["vwd", className]}>
  <div class="vwd-stage">
    <div class="vwd-device">
      <svg viewBox="0 0 328 670" class="vwd-svg" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
