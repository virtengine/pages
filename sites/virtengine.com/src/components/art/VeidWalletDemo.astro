        <!-- app header -->
        <rect x="15" y="58" width="290" height="44" fill="var(--color-night-panel)" />
        <path d="M38,70 L47,74 v7 c0,4.6-3.4,7.8-9,9.4 -5.6-1.6-9-4.8-9-9.4 v-7 Z" stroke="var(--color-green)" stroke-width="1.8" />
        <path d="M34,80 l3,3 6,-7" stroke="var(--color-green-bright)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="58" y="84" class="vwd-title">VEID wallet</text>
