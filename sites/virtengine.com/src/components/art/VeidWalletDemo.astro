          <circle cx="164" cy="292" r="104" fill="url(#vwd-glow-face)" />
          <circle class="vwd-ring" cx="164" cy="292" r="86" stroke="var(--color-green)" stroke-width="1.6" />
          <circle cx="164" cy="292" r="86" stroke="var(--color-green)" stroke-width="1.4" stroke-dasharray="3 7" />

          <ellipse cx="164" cy="286" rx="42" ry="50" fill="#0f1712" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
