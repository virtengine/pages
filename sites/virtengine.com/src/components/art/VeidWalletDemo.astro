        <!-- ======================= 4 · receipt ======================= -->
        <g class="vwd-screen vwd-screen--receipt">
          <text x="24" y="117" class="vwd-mono">STEP 3 / 3</text>
          <rect x="104" y="110" width="54" height="3" rx="1.5" fill="var(--color-green)" />
          <rect x="165" y="110" width="54" height="3" rx="1.5" fill="var(--color-green)" />
