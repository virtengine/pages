---
interface Props {
  class?: string;
  /** Display height in pixels. */
  size?: number;
  /** Show the original DET.io attribution beneath the wordmark. */
  byline?: boolean;
  onDark?: boolean;
}

import Mark from "@components/brand/Mark.astro";

const { class: className, size = 34, byline = false, onDark = false } = Astro.props;
const sourceWidth = 1423;
const sourceHeight = 362;
const markWidth = size * (376 / sourceHeight);
const wordmarkWidth = size * ((sourceWidth - 376) / sourceHeight);
const lockupWidth = size * (sourceWidth / sourceHeight);
const wordmarkClip = byline ? "inset(0)" : "inset(0 0 26.3% 0)";
---

<span
  class:list={["inline-flex shrink-0 items-center overflow-hidden whitespace-nowrap", className]}
  style={`width:${lockupWidth}px;height:${size}px;flex:0 0 auto`}
  role="img"
  aria-label={byline ? "VirtEngine by DET.io" : "VirtEngine"}
>
  <Mark size={markWidth} class="relative z-10 shrink-0 text-green" />
  <span
    class="relative h-full shrink-0 overflow-hidden"
    style={`width:${wordmarkWidth}px;clip-path:${wordmarkClip}`}
    aria-hidden="true"
  >
    <img
      src="/brand/virtengine-original.png"
      width={sourceWidth}
      height={sourceHeight}
      alt=""
      aria-hidden="true"
      decoding="async"
      class:list={["absolute top-0 max-w-none", onDark && "lockup-wordmark--light"]}
      style={`width:${lockupWidth}px;height:${size}px;left:-${markWidth}px`}
    />
  </span>
</span>

<style>
  .lockup-wordmark--light {
    filter: brightness(0) invert(1);
  }
</style>
