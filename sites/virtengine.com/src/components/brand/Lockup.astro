---
interface Props {
  class?: string;
  /** Display height in pixels. */
  size?: number;
  /** Show the original DET.io attribution beneath the wordmark. */
  byline?: boolean;
  onDark?: boolean;
}

import Mark from "@components/brand/Mark.astro";

const { class: className, size = 34, byline = false, onDark = false } = Astro.props;
const markSize = Math.round(size * 0.92);
const wordmarkSize = Math.max(18, Math.round(size * 0.48));
---

<span
  class:list={["inline-flex items-center gap-2", className]}
  style={`height:${size}px`}
  role="img"
  aria-label={byline ? "VirtEngine by DET.io" : "VirtEngine"}
>
  <Mark size={markSize} class="shrink-0 text-green" />
  <span class="flex flex-col leading-none">
    <span
      class:list={["font-display", onDark ? "text-night-text" : "text-slate"]}
      style={`font-size:${wordmarkSize}px`}>VirtEngine</span
    >
    {
      byline && (
        <span
          class:list={[
            "mt-1 text-right font-display text-[0.62rem] tracking-[0.08em]",
            onDark ? "text-night-muted" : "text-faint",
          ]}
        >
          by DET.io
        </span>
      )
    }
  </span>
</span>
