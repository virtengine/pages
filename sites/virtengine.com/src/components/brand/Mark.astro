---
/**
 * The original VirtEngine nested-V mark, traced from the canonical brand
 * artwork in public/brand/virtengine-original.png. Colored via `currentColor`.
 */
interface Props {
  class?: string;
  /** Rendered size in px (width; height keeps ratio). */
  size?: number;
  title?: string;
}

const { class: className, size = 32, title } = Astro.props;
const w = size;
const h = Math.round(size * (342 / 364));
---

<svg
  viewBox="0 0 364 342"
  width={w}
  height={h}
  class={className}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  fill="currentColor"
>
  {title && <title>{title}</title>}
  <path
    fill-rule="evenodd"
    d="M0 0h64l118 204L300 0h64L182 342zM56 52h252L182 280zM94 83h176L182 234z"
  ></path>
</svg>
