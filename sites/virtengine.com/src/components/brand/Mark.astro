---
/**
 * The official VirtEngine mark, cropped directly from the canonical PNG.
 * Never redraw or recolor this asset.
 */
interface Props {
  class?: string;
  /** Rendered size in px (width; height keeps ratio). */
  size?: number;
  title?: string;
}

const { class: className, size = 32, title } = Astro.props;
const w = size;
const h = Math.round(size * (362 / 376));
---

<img
  src="/brand/virtengine-icon.png?v=1"
  width={w}
  height={h}
  class={className}
  alt={title ?? ""}
  aria-hidden={title ? undefined : "true"}
  decoding="async"
/>
