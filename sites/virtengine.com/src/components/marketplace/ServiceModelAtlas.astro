---
/**
 * ServiceModelAtlas — what the catalogue can actually sell.
 *
 * Desktop: category rail on the left, an illustrative listing in the middle
 * and the fulfilment flow on the right. Mobile: the rail stacks, then the
 * selected panel. Data comes from SERVICE_MODELS so every service page,
 * navigation entry and Learn card reads the same model.
 */
import { SERVICE_MODELS } from "@data/market";
import type { ServiceModelId } from "@data/market";
import MarketplaceListingCard from "@components/marketplace/MarketplaceListingCard.astro";
import FulfilmentFlow from "@components/marketplace/FulfilmentFlow.astro";

interface Props {
  id?: string;
  class?: string;
}

const { id = "atlas", class: className } = Astro.props;

const protocolNodes: Record<ServiceModelId, string[]> = {
  iaas: ["Order", "Lease", "Usage", "Settlement"],
  paas: ["Order", "Lease", "Component usage", "Settlement"],
  saas: ["Order", "Lease / entitlement agreement", "Component usage", "Settlement"],
  hpc: ["Order / bid", "Lease", "Signed usage", "Settlement"],
  gpu: ["Order / bid", "Lease", "Metered usage", "Settlement"],
  storage: ["Order", "Lease", "Capacity & transfer usage", "Settlement"],
  managed: ["Order form", "Billable component", "Settlement"],
  custom: ["Custom offering", "Metered or fixed component", "Settlement"],
};

const providerNodes: Record<ServiceModelId, string[]> = {
  iaas: ["Provider daemon", "Waldur / provider API", "OpenStack · VMware · cloud"],
  paas: ["Provider integration", "Managed platform", "Platform endpoint"],
  saas: ["Provider fulfils access", "Account · seat · licence"],
  hpc: ["Scheduler adapter", "SLURM · MOAB · Open OnDemand", "Job · allocation"],
  gpu: ["Provider daemon", "GPU backend", "Node · endpoint"],
  storage: ["Provider backend", "Volume · bucket · archive"],
  managed: ["Provider approval", "Provider delivery"],
  custom: ["Provider approval / automation", "Fulfilment"],
};

const nodeKinds = Object.fromEntries(
  SERVICE_MODELS.map((model) => {
    const kinds: Record<string, "protocol" | "provider"> = {};
    for (const node of protocolNodes[model.id]) kinds[node] = "protocol";
    for (const node of providerNodes[model.id]) kinds[node] = "provider";
    return [model.id, kinds];
  }),
) as Record<ServiceModelId, Record<string, "protocol" | "provider">>;
---

<div class:list={["mk-atlas", className]}>
  {
    SERVICE_MODELS.map((model, index) => (
        <>
          <input
            class="mk-radio mk-atlas-radio"
            type="radio"
            name={`mk-atlas-${id}`}
            id={`mk-atlas-${id}-${model.id}`}
            checked={index === 0}
          />
          <label class="mk-atlas-tab" for={`mk-atlas-${id}-${model.id}`}>
            <span>
              <small>{model.subtitle}</small>
              <span>{model.label}</span>
            </span>
            <i aria-hidden="true">→</i>
          </label>
          <section class="mk-atlas-panel" aria-label={`${model.title} model`}>
            <div class="mk-atlas-head">
              <h3>{model.title}</h3>
              <p>{model.summary}</p>
            </div>
            <div class="mk-atlas-split">
              <div>
                <h4>Example listing</h4>
                <div class="mt-3">
                  <MarketplaceListingCard
                    serviceType={model.listing.serviceType}
                    title={model.listing.title}
                    provider={model.listing.provider}
                    region={model.listing.region}
                    specs={model.listing.specs}
                    components={model.listing.components}
                    priceLabel={model.listing.priceLabel}
                    badges={model.listing.badges}
                    compact
                  />
                </div>
                <div class="mk-atlas-block mt-5">
                  <h4>Examples</h4>
                  <ul class="mk-atlas-chips">
                    {model.examples.map((example) => <li>{example}</li>)}
                  </ul>
                </div>
                <div class="mk-atlas-block mt-5">
                  <h4>Billing models</h4>
                  <ul class="mk-atlas-chips">
                    {model.billingModels.map((billing) => <li>{billing}</li>)}
                  </ul>
                </div>
              </div>
              <div>
                <h4>Fulfilment path</h4>
                <div class="mt-3">
                  <FulfilmentFlow nodes={model.flow} kinds={nodeKinds[model.id]} caption={model.flowCaption} />
                </div>
                <div class="mk-atlas-block mt-5">
                  <h4>Provider implementation paths</h4>
                  <ul class="mk-atlas-chips">
                    {model.fulfilmentTargets.map((target) => <li>{target}</li>)}
                  </ul>
                </div>
                <a class="mk-atlas-cta" href={model.route}>
                  {model.cta} <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>
      </>
    ))
  }
</div>
