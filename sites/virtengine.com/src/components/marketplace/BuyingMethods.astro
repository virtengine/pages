---
/**
 * BuyingMethods — homepage "Three ways in. One market rail out." section.
 *
 * One interactive market diagram with three persistent layers:
 *   1. three entry routes (direct, bid, selector) converging on one MATCH node;
 *   2. the provider record — the evidence every provider carries
 *      (x/veid identity, x/provider attributes, x/audit signatures,
 *      x/benchmark measurements, x/review reputation);
 *   3. the shared rail: match → lease → usage → settlement → review, where the
 *      lease-bound review feeds back into the provider record.
 *
 * Switching route only swaps the request + mechanism stage. Each mode is
 * configuration for one engine: the script runs an explicit state sequence
 * per mode (idle → … → matched → lease_created → usage_active → settled →
 * reviewed, or a failure that stops before match). Provider requirements
 * (audited, benchmark floor, rating floor) change which providers can win, so
 * evidence visibly changes outcomes. Audit and benchmark constraints are
 * protocol match filters; the rating floor is presented as a client-side
 * screen over on-chain review data, matching how x/review is described.
 *
 * All providers, listings, bids and prices are sample data.
 */

interface Mode {
  id: "direct" | "bid" | "selector";
  n: string;
  name: string;
  hint: string;
  mechanism: string;
  claim: string;
  best: string;
  flow: string;
  idle: string;
}

interface Provider {
  name: string;
  region: string;
  hw: string;
  tier: string;
  audited: boolean;
  auditor: string | null;
  bench: number;
  rating: number;
  reviews: number;
}

const MODES: Mode[] = [
  {
    id: "direct",
    n: "01",
    name: "Direct order",
    hint: "Choose the exact listing",
    mechanism: "Fixed listing",
    claim: "You choose the listing.",
    best: "Best when you already know the provider or listing you want.",
    flow: "choose listing",
    idle: "Compare the two listings and their provider records, then choose one.",
  },
  {
    id: "bid",
    n: "02",
    name: "Open bid",
    hint: "Let providers compete",
    mechanism: "Price discovery",
    claim: "The market discovers the price.",
    best: "Best when capacity is interchangeable and providers should compete on price.",
    flow: "open to providers",
    idle: "Set a maximum and provider requirements, then open bidding.",
  },
  {
    id: "selector",
    n: "03",
    name: "Selector",
    hint: "Describe the outcome",
    mechanism: "Attribute matching",
    claim: "The market chooses the match.",
    best: "Best when requirements matter more than which provider fulfils them.",
    flow: "submit requirements",
    idle: "Describe what you need, then find eligible capacity.",
  },
];

const PROVIDERS: Record<string, Provider> = {
  A: { name: "Provider A", region: "ap-southeast", hw: "AMD EPYC 7763", tier: "III", audited: true, auditor: "Auditor North", bench: 1.05, rating: 4.6, reviews: 148 },
  B: { name: "Provider B", region: "ap-southeast", hw: "AMD EPYC 9654", tier: "III", audited: true, auditor: "Auditor North", bench: 1.18, rating: 4.8, reviews: 212 },
  C: { name: "Provider C", region: "ap-southeast", hw: "Intel Xeon 8480+", tier: "IV", audited: true, auditor: "Meridian Assurance", bench: 1.22, rating: 4.9, reviews: 96 },
  D: { name: "Provider D", region: "ap-southeast", hw: "Undisclosed", tier: "III", audited: false, auditor: null, bench: 0.71, rating: 3.2, reviews: 41 },
  E: { name: "Provider E", region: "eu-central", hw: "AMD EPYC 9554", tier: "III", audited: true, auditor: "Auditor North", bench: 1.1, rating: 4.7, reviews: 180 },
  F: { name: "Provider F", region: "eu-central", hw: "Intel Xeon 8468", tier: "IV", audited: true, auditor: "Meridian Assurance", bench: 1.3, rating: 4.4, reviews: 57 },
};

// Same spec, same region: one verified provider, one cheaper unverified one.
const LISTINGS = [
  { id: "GP-0421", provider: "B", name: "General Purpose VM", spec: "4 vCPU · 16 GB", region: "ap-southeast", price: 0.061 },
  { id: "GP-0388", provider: "D", name: "General Purpose VM", spec: "4 vCPU · 16 GB", region: "ap-southeast", price: 0.052 },
];

const BIDS = [
  { provider: "A", price: 0.072 },
  { provider: "B", price: 0.061 },
  { provider: "C", price: 0.085 },
  { provider: "D", price: 0.049 },
];
const BID_CAPS = [0.05, 0.07, 0.1];

// 18 sample listings. ap-southeast → 11; VM 4+ vCPU → 6; evidence → 5; ≤ $0.07 → 3.
const INVENTORY = [
  { name: "General Purpose VM", provider: "B", kind: "vm", vcpu: 4, mem: 16, region: "ap-southeast", price: 0.061 },
  { name: "General Purpose VM", provider: "A", kind: "vm", vcpu: 8, mem: 32, region: "ap-southeast", price: 0.066 },
  { name: "Compute Optimised VM", provider: "C", kind: "vm", vcpu: 8, mem: 16, region: "ap-southeast", price: 0.069 },
  { name: "Memory Optimised VM", provider: "A", kind: "vm", vcpu: 4, mem: 32, region: "ap-southeast", price: 0.078 },
  { name: "Burstable VM", provider: "D", kind: "vm", vcpu: 2, mem: 4, region: "ap-southeast", price: 0.041 },
  { name: "General Purpose VM", provider: "D", kind: "vm", vcpu: 4, mem: 16, region: "ap-southeast", price: 0.052 },
  { name: "Dense Compute VM", provider: "C", kind: "vm", vcpu: 16, mem: 64, region: "ap-southeast", price: 0.092 },
  { name: "GPU Instance", provider: "C", kind: "gpu", model: "A100", region: "ap-southeast", price: 2.1 },
  { name: "GPU Instance", provider: "B", kind: "gpu", model: "L4", region: "ap-southeast", price: 0.74 },
  { name: "Object Storage", provider: "D", kind: "storage", region: "ap-southeast", price: 0.021 },
  { name: "Managed Postgres", provider: "A", kind: "paas", region: "ap-southeast", price: 0.19 },
  { name: "General Purpose VM", provider: "E", kind: "vm", vcpu: 4, mem: 16, region: "eu-central", price: 0.058 },
  { name: "General Purpose VM", provider: "E", kind: "vm", vcpu: 8, mem: 32, region: "eu-central", price: 0.064 },
  { name: "Compute Optimised VM", provider: "F", kind: "vm", vcpu: 16, mem: 32, region: "eu-central", price: 0.081 },
  { name: "Burstable VM", provider: "F", kind: "vm", vcpu: 2, mem: 4, region: "eu-central", price: 0.039 },
  { name: "GPU Instance", provider: "F", kind: "gpu", model: "A100", region: "eu-central", price: 1.95 },
  { name: "Block Storage", provider: "E", kind: "storage", region: "eu-central", price: 0.018 },
  { name: "Managed Kubernetes", provider: "F", kind: "paas", region: "eu-central", price: 0.11 },
];

const SELECTOR_FIELDS = [
  { param: "kind", label: "Workload", options: [["vm", "VM · 4+ vCPU"], ["gpu", "GPU · A100"]] },
  { param: "region", label: "Region", options: [["ap-southeast", "ap-southeast"], ["eu-central", "eu-central"]] },
  { param: "scap", label: "Price cap", options: [["0.07", "≤ $0.07"], ["0.1", "≤ $0.10"]] },
];
const REQS = [
  { key: "audit", label: "Audited" },
  { key: "bench", label: "Bench ≥ 1.0×" },
  { key: "rating", label: "★ ≥ 4.5" },
];
const FILTERS = [
  { id: "region", label: "region" },
  { id: "compute", label: "compute" },
  { id: "evidence", label: "provider evidence" },
  { id: "cap", label: "price cap" },
];

// The provider record: what each module contributes and how a buyer uses it.
const RECORD = [
  { key: "veid", module: "veid", title: "Identity", desc: "Verified operator behind the listing", use: "Required to register" },
  { key: "attr", module: "provider", title: "Attributes", desc: "Region, hardware, claimed tier", use: "Filtered at match" },
  { key: "audit", module: "audit", title: "Audit", desc: "Auditor-signed claims, not self-assertion", use: "Orders can require it" },
  { key: "bench", module: "benchmark", title: "Benchmark", desc: "Measured performance — proves hardware matches its class", use: "Filter or compare" },
  { key: "rating", module: "review", title: "Reviews", desc: "Lease-bound reputation", use: "Screen & rank in your client" },
];

const RAIL = [
  { id: "match", name: "Match", note: "awaiting a route" },
  { id: "lease", name: "Lease", note: "escrow funded" },
  { id: "usage", name: "Usage", note: "metered runtime" },
  { id: "settle", name: "Settlement", note: "provider paid" },
  { id: "review", name: "Review", note: "feeds the provider record" },
];

const COMPARE = [
  ["Provider selected by", "Buyer", "Bid result", "Matching engine"],
  ["Price", "Listed", "Competitive", "Eligible listing"],
  ["Provider evidence", "You weigh it", "Requirements screen bids", "Requirements filter listings"],
  ["Negotiation", "None", "Bid window", "None"],
  ["Best for", "Known listing", "Commodity capacity", "Requirement-driven buying"],
];

const fmt = (p: number) => `$${p.toFixed(p < 1 ? 3 : 2)}`;
const chips = (p: Provider) => [
  { ev: "audit", text: p.audited ? `◆ Tier ${p.tier}` : "◇ Unaudited", weak: !p.audited },
  { ev: "bench", text: `${p.bench >= 1 ? "▲" : "▽"} ${p.bench.toFixed(2)}×`, weak: p.bench < 1 },
  { ev: "rating", text: `★ ${p.rating.toFixed(1)}`, weak: p.rating < 4.5 },
];
const first = MODES[0];
const payload = JSON.stringify({ modes: MODES, providers: PROVIDERS, listings: LISTINGS, inventory: INVENTORY, record: RECORD }).replace(/</g, "\\u003c");
---

<div class="bm-head folio-head folio-head--split">
  <div>
    <div class="folio-coord"><span>Buying</span></div>
    <h2>Three ways in. One market rail out.</h2>
  </div>
  <div>
    <p>Choose a listing, invite providers to compete, or describe what you need. Every provider carries a verifiable record — identity, audited claims, measured benchmarks and lease-bound reviews — and every successful match becomes the same lease.</p>
    <p class="bm-legend" aria-label="Lifecycle: order, match, lease, usage, settlement, review">Order <i>→</i> Match <i>→</i> Lease <i>→</i> Usage <i>→</i> Settlement <i>→</i> Review</p>
  </div>
</div>

<div class="mr" data-market-rail data-mode="direct" data-state="idle">
  <script type="application/json" set:html={payload} />

  <svg class="mr-wires" aria-hidden="true">
    {MODES.map((m) => <path class="mr-wire" data-wire={m.id} />)}
  </svg>

  <!-- entry routes -->
  <div class="mr-routes">
    <p class="mr-kicker">Entry route</p>
    <div class="mr-route-list" role="group" aria-label="Buying method">
      {
        MODES.map((m) => (
          <button type="button" class="mr-route" data-route={m.id} aria-pressed={m.id === first.id ? "true" : "false"}>
            <span class="mr-route-name"><span class="mr-route-n">{m.n}</span> — {m.name}</span>
            <span class="mr-route-hint">{m.hint}</span>
            <i class="mr-route-live" aria-hidden="true"></i>
          </button>
        ))
      }
    </div>
    <p class="mr-best" data-bind="best">{first.best}</p>
  </div>

  <!-- route-specific stage: request → mechanism -->
  <div class="mr-stage">
    <div class="mr-stage-head">
      <span class="mr-mech" data-bind="mechanism">{first.mechanism}</span>
      <span class="mr-claim" data-bind="claim">{first.claim}</span>
      <span class="mr-sample">Interactive example · sample data</span>
      <button type="button" class="mr-run" data-run>Run demo</button>
    </div>

    <div class="mr-stage-body">
      <div class="mr-request">
        <div data-panel="direct">
          <p class="mr-label">Catalogue</p>
          <div class="mr-listings">
            {
              LISTINGS.map((l, i) => {
                const p = PROVIDERS[l.provider];
                return (
                  <button type="button" class="mr-card mr-listing" data-param="listing" data-value={l.id} data-provider={l.provider} aria-pressed={i === 0 ? "true" : "false"}>
                    <span class="mr-label">{l.name}</span>
                    <strong>{l.spec}</strong>
                    <span class="mr-meta">{p.name}</span>
                    <span class="evs">{chips(p).map((c) => <span class="ev" data-ev={c.ev} data-weak={String(c.weak)}>{c.text}</span>)}</span>
                    <span class="mr-price">{fmt(l.price)} <small>/ vCPU-hr</small></span>
                  </button>
                );
              })
            }
          </div>
          <button type="button" class="mr-act" data-run>Choose listing</button>
        </div>

        <div data-panel="bid" hidden>
          <div class="mr-card">
            <p class="mr-label">Open order</p>
            <dl class="mr-fields">
              <div><dt>Compute</dt><dd>16 vCPU · ap-southeast</dd></div>
              <div>
                <dt>Maximum</dt>
                <dd class="mr-seg" role="group" aria-label="Maximum price per vCPU-hour">
                  {BID_CAPS.map((c) => (
                    <button type="button" class="mr-seg-btn" data-param="cap" data-value={String(c)} aria-pressed={c === 0.07 ? "true" : "false"}>{fmt(c).replace(/0$/, "")}</button>
                  ))}
                </dd>
              </div>
              <div>
                <dt>Provider</dt>
                <dd class="mr-seg" role="group" aria-label="Provider requirements">
                  {REQS.map((r) => <button type="button" class="mr-seg-btn mr-req" data-req={r.key} aria-pressed="true">{r.label}</button>)}
                </dd>
              </div>
              <div><dt>Bid window</dt><dd>30 min</dd></div>
            </dl>
          </div>
          <button type="button" class="mr-act" data-run>Open bidding</button>
        </div>

        <div data-panel="selector" hidden>
          <div class="mr-card">
            <p class="mr-label">What you need</p>
            <dl class="mr-fields">
              {
                SELECTOR_FIELDS.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd class="mr-seg" role="group" aria-label={f.label}>
                      {f.options.map(([value, text], i) => (
                        <button type="button" class="mr-seg-btn" data-param={f.param} data-value={value} aria-pressed={i === 0 ? "true" : "false"}>{text}</button>
                      ))}
                    </dd>
                  </div>
                ))
              }
              <div>
                <dt>Provider</dt>
                <dd class="mr-seg" role="group" aria-label="Provider requirements">
                  {REQS.map((r) => <button type="button" class="mr-seg-btn mr-req" data-req={r.key} aria-pressed="true">{r.label}</button>)}
                </dd>
              </div>
            </dl>
          </div>
          <button type="button" class="mr-act" data-run>Find eligible capacity</button>
        </div>
      </div>

      <div class="mr-flow" aria-hidden="true"><span data-bind="flow">{first.flow}</span></div>

      <div class="mr-mechanism">
        <div data-panel="direct">
          <div class="mr-ghost" data-ghost>Order appears here</div>
          <div class="mr-card mr-order" data-order>
            <p class="mr-label">Order</p>
            <strong>Listing #<span data-bind="order-id">{LISTINGS[0].id}</span></strong>
            <span class="mr-meta">Exact provider + plan · identity-gated</span>
          </div>
          <p class="mr-annot" data-order-note>Availability confirmed · no bidding required</p>
        </div>

        <div data-panel="bid" hidden>
          <div class="mr-ghost" data-ghost>Bids arrive here · 30 min window</div>
          <ul class="mr-bids">
            {
              BIDS.map((b) => {
                const p = PROVIDERS[b.provider];
                return (
                  <li class="mr-bid" data-price={b.price} data-provider={b.provider} tabindex="0">
                    <span class="mr-bid-name">{p.name}</span>
                    <span class="evs">{chips(p).map((c) => <span class="ev" data-ev={c.ev} data-weak={String(c.weak)}>{c.text}</span>)}</span>
                    <b>{fmt(b.price)}</b>
                    <em class="mr-bid-tag"></em>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div data-panel="selector" hidden>
          <div class="mr-filterbox">
            <div class="mr-stack" data-level="0">
              <i></i><i></i><i></i>
              <span class="mr-stack-face"><b data-bind="count">{INVENTORY.length}</b> <small data-bind="count-label">listings</small></span>
            </div>
            <ol class="mr-filters">
              {FILTERS.map((f) => (
                <li class="mr-filter" data-filter={f.id}><span>{f.label}</span><b>—</b></li>
              ))}
            </ol>
          </div>
        </div>

        <div class="mr-result" data-result hidden>
          <p class="mr-label" data-bind="result-label"></p>
          <strong data-bind="result-title"></strong>
          <span class="mr-meta" data-bind="result-meta"></span>
          <p class="mr-warn" data-bind="result-warn"></p>
        </div>
      </div>
    </div>

    <p class="mr-status" role="status" data-bind="status">{first.idle}</p>
  </div>

  <!-- the provider record: the evidence buyers use to tell providers apart -->
  <div class="mr-record">
    <p class="mr-record-head">
      <span>Provider record</span>
      <strong data-bind="rec-name">{PROVIDERS[LISTINGS[0].provider].name}</strong>
      <span class="mr-record-hint">Hover or focus any provider to inspect it</span>
    </p>
    <ol class="mr-cells">
      {
        RECORD.map((c) => (
          <li class="mr-cell" data-cell={c.key}>
            <a class="mr-cell-mod" href={`/modules/${c.module}`}>x/{c.module}</a>
            <strong><i class="mr-mark" aria-hidden="true"></i>{c.title}</strong>
            <span class="mr-cell-val" data-val>{c.desc}</span>
            <small>{c.use}</small>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- the shared rail: rendered once, identical for every route -->
  <div class="mr-rail">
    <p class="mr-rail-head"><span>Shared market rail</span><span>Identical after every match</span></p>
    <ol class="mr-track">
      {
        RAIL.map((s) => (
          <li class="mr-node" data-node={s.id}>
            <span class="mr-dot" aria-hidden="true"></span>
            <strong>{s.name}</strong>
            <small data-note>{s.note}</small>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<div class="bm-foot">
  <details class="bm-compare">
    <summary>Compare the three methods</summary>
    <div class="bm-compare-scroll">
      <table>
        <thead>
          <tr><th scope="col"><span class="sr-only">Attribute</span></th>{MODES.map((m) => <th scope="col">{m.name}</th>)}</tr>
        </thead>
        <tbody>
          {COMPARE.map(([k, ...v]) => (
            <tr><th scope="row">{k}</th>{v.map((c) => <td>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <a class="btn-quiet bm-guide" href="/learn/three-ways-to-buy">Full buying guide <span aria-hidden="true">→</span></a>
</div>

<script>
  type Step = [number, () => void];
  type Provider = { name: string; region: string; hw: string; tier: string; audited: boolean; auditor: string | null; bench: number; rating: number; reviews: number };
  type Listing = { name: string; provider: string; kind: string; vcpu?: number; mem?: number; model?: string; region: string; price: number };
  type Check = "audit" | "bench" | "rating";

  const root = document.querySelector<HTMLElement>("[data-market-rail]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const data = JSON.parse(root.querySelector("script[type='application/json']")!.textContent || "{}");
    const P: Record<string, Provider> = data.providers;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T>(s));
    const bind = (key: string, text: string) => $$(`[data-bind="${key}"]`).forEach((el) => (el.textContent = text));
    const fmt = (p: number) => `$${p.toFixed(p < 1 ? 3 : 2)}`;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const params: Record<string, string> = { listing: data.listings[0].id, cap: "0.07", kind: "vm", region: "ap-southeast", scap: "0.07" };
    const req: Record<Check, boolean> = { audit: true, bench: true, rating: true };
    let mode = "direct";
    let token = 0;
    let running = false;
    let finished = false;
    let pinned: string | null = data.listings[0].provider;
    let bumped: string | null = null;

    const nodes = $$(".mr-node");
    const matchNote = nodes[0].querySelector<HTMLElement>("[data-note]")!;
    const result = $("[data-result]");
    const modeOf = (id: string) => data.modes.find((m: { id: string }) => m.id === id);

    // ---- provider evidence ----
    const CHECKS: Record<Check, { ok: (p: Provider) => boolean; why: (p: Provider) => string; short: (p: Provider) => string }> = {
      audit: { ok: (p) => p.audited, why: () => "no audit signature", short: () => "unaudited" },
      bench: { ok: (p) => p.bench >= 1, why: (p) => `bench ${p.bench.toFixed(2)}× < 1.0×`, short: (p) => `${p.bench.toFixed(2)}× baseline` },
      rating: { ok: (p) => p.rating >= 4.5, why: (p) => `★ ${p.rating.toFixed(1)} < 4.5`, short: (p) => `★ ${p.rating.toFixed(1)}` },
    };
    const keys = Object.keys(CHECKS) as Check[];
    const failing = (p: Provider) => keys.filter((k) => req[k] && !CHECKS[k].ok(p));
    const weakness = (p: Provider) => keys.filter((k) => !CHECKS[k].ok(p)).map((k) => CHECKS[k].short(p)).join(" · ");
    const screened = () => mode !== "direct";

    function cell(key: string, value: string, state: string) {
      const el = $(`[data-cell="${key}"]`);
      el.dataset.state = state;
      el.querySelector("[data-val]")!.textContent = value;
    }

    /** Show one provider's record in the persistent strip (null = explain the fields). */
    function inspect(id: string | null) {
      const rec = $(".mr-record");
      rec.dataset.inspect = id || "";
      $('[data-cell="rating"]').classList.toggle("is-bump", Boolean(id) && id === bumped);
      if (!id) {
        bind("rec-name", "Every provider carries one");
        data.record.forEach((c: { key: string; desc: string }) => cell(c.key, c.desc, ""));
        return;
      }
      const p = P[id];
      const flag = (k: Check) => (CHECKS[k].ok(p) ? "ok" : screened() && req[k] ? "fail" : "weak");
      bind("rec-name", p.name);
      cell("veid", "Identity verified", "ok");
      cell("attr", `${p.hw} · ${p.region} · Tier ${p.tier} claimed`, "info");
      cell("audit", p.audited ? `Tier ${p.tier} signed · ${p.auditor}` : "Unsigned — tier is self-claimed", flag("audit"));
      cell("bench", `${p.bench.toFixed(2)}× network baseline`, flag("bench"));
      cell("rating", `★ ${p.rating.toFixed(1)} · ${p.reviews + (bumped === id ? 1 : 0)} lease-bound reviews`, flag("rating"));
    }

    function state(name: string, msg?: string) {
      root.dataset.state = name;
      if (msg) bind("status", msg);
    }

    /** Light the rail up to (and including) stage n; n = 0 clears it. */
    function reach(n: number) {
      nodes.forEach((node, i) => node.classList.toggle("is-on", i < n));
    }

    function showResult(kind: "ok" | "fail", label: string, title: string, meta: string, warn = "", provider = "") {
      result.hidden = false;
      result.dataset.kind = kind;
      result.dataset.warn = String(Boolean(warn));
      if (provider) result.dataset.provider = provider;
      else delete result.dataset.provider;
      bind("result-label", label);
      bind("result-title", title);
      bind("result-meta", meta);
      bind("result-warn", warn);
    }

    function matched(id: string, label: string, title: string, meta: string, note: string, warn: string, status: string) {
      pinned = id;
      inspect(id);
      showResult("ok", label, title, meta, warn, id);
      matchNote.textContent = note;
      reach(1);
      state("matched", status);
    }

    function fail(label: string, hint: string, status: string) {
      showResult("fail", label, "Stopped before match", hint);
      nodes[0].classList.add("is-fail");
      matchNote.textContent = "no match";
      state("no_match", status);
    }

    const lifecycle = (): Step[] => [
      [450, () => { reach(2); state("lease_created", "Lease created · escrow funded"); }],
      [450, () => { reach(3); state("usage_active", "Usage metered against the lease"); }],
      [450, () => { reach(4); state("settled", "Escrow settles · provider paid"); }],
      [450, () => {
        reach(5);
        bumped = pinned;
        inspect(pinned);
        state("reviewed", `Lease-bound review recorded · feeds ${pinned ? P[pinned].name : "the provider"}'s record`);
      }],
    ];

    const plans: Record<string, () => Step[]> = {
      direct() {
        const l = data.listings.find((x: { id: string }) => x.id === params.listing);
        const p = P[l.provider];
        const weak = weakness(p);
        return [
          [300, () => state("listing_selected", `Listing ${l.id} selected · ${p.name}`)],
          [400, () => { bind("order-id", l.id); state("order_created", "Order created · exact provider + plan"); }],
          [350, () => matched(
            l.provider,
            "Matched",
            `${l.name} · ${p.name}`,
            `${fmt(l.price)} / vCPU-hr · listed price`,
            `${fmt(l.price)} · listed price`,
            weak ? `Direct orders aren't screened: ${weak}. The record is there for you to weigh.` : "",
            "Match confirmed — no bidding required",
          )],
          ...lifecycle(),
        ];
      },

      bid() {
        const cap = Number(params.cap);
        const rows = $$<HTMLElement>(".mr-bid");
        const price = (r: HTMLElement) => Number(r.dataset.price);
        const reasons = (r: HTMLElement) => {
          const p = P[r.dataset.provider!];
          return [...(price(r) > cap ? ["over cap"] : []), ...failing(p).map((k) => CHECKS[k].why(p))];
        };
        const win = rows.filter((r) => reasons(r).length === 0).sort((a, b) => price(a) - price(b))[0];

        const steps: Step[] = [[300, () => state("order_open", `Order open · maximum ${fmt(cap)} / vCPU-hr`)]];
        rows.forEach((row, i) => {
          steps.push([i === 0 ? 300 : 240, () => {
            row.classList.add("is-in");
            state("receiving_bids", `Bid received · ${P[row.dataset.provider!].name} at ${fmt(price(row))}`);
          }]);
        });
        steps.push([350, () => {
          rows.forEach((row) => {
            const why = reasons(row);
            const p = P[row.dataset.provider!];
            row.classList.toggle("is-out", why.length > 0);
            row.classList.toggle("is-over", price(row) > cap);
            row.querySelector(".mr-bid-tag")!.textContent = why.join(" · ");
            row.querySelectorAll<HTMLElement>(".ev").forEach((ev) => ev.classList.toggle("is-fail", failing(p).includes(ev.dataset.ev as Check)));
          });
          state("evaluating_bids", "Bids checked against price cap and provider requirements");
        }]);
        if (!win) {
          steps.push([300, () => fail("No eligible bids", "Raise the maximum price, relax a provider requirement, or widen the bid window.", "No bid meets the cap and provider requirements")]);
          return steps;
        }
        const p = P[win.dataset.provider!];
        const weak = weakness(p);
        steps.push([300, () => {
          win.classList.add("is-win");
          win.querySelector(".mr-bid-tag")!.textContent = "lowest eligible offer";
          matched(
            win.dataset.provider!,
            "Matched",
            p.name,
            `${fmt(price(win))} / vCPU-hr · winning bid`,
            `${fmt(price(win))} · winning bid`,
            weak ? `Won on price with weak evidence: ${weak}. Turn provider requirements on to screen it out.` : "",
            `Lowest eligible offer wins · ${p.name}`,
          );
        }]);
        return [...steps, ...lifecycle()];
      },

      selector() {
        const cap = Number(params.scap);
        const inv: Listing[] = data.inventory;
        const byRegion = inv.filter((l) => l.region === params.region);
        const byCompute = byRegion.filter((l) => (params.kind === "vm" ? l.kind === "vm" && (l.vcpu || 0) >= 4 : l.kind === "gpu" && l.model === "A100"));
        const byEvidence = byCompute.filter((l) => failing(P[l.provider]).length === 0);
        const byCap = byEvidence.filter((l) => l.price <= cap);
        const best = [...byCap].sort((a, b) => a.price - b.price)[0];
        const counts = [byRegion.length, byCompute.length, byEvidence.length, byCap.length];
        const dropped = [...new Set(byCompute.filter((l) => !byEvidence.includes(l)).map((l) => P[l.provider].name))];
        const notes = [
          `Region · ${counts[0]} listings in ${params.region}`,
          `Compute · ${counts[1]} match the workload`,
          keys.some((k) => req[k])
            ? dropped.length ? `Provider evidence · screened out ${dropped.join(", ")}` : "Provider evidence · every provider passes"
            : "Provider evidence · no requirements set",
          `Price cap · ${counts[3]} eligible at ${fmt(cap)} or less`,
        ];
        const filters = $$(".mr-filter");
        const stack = $(".mr-stack");

        const steps: Step[] = [[300, () => state("requirements_submitted", `Requirements submitted · ${inv.length} listings in market`)]];
        filters.forEach((f, i) => {
          steps.push([250, () => {
            f.classList.add("is-on");
            f.querySelector("b")!.textContent = String(counts[i]);
            stack.dataset.level = String(i + 1);
            bind("count", String(counts[i]));
            bind("count-label", i === filters.length - 1 ? "eligible" : "listings");
            state("filtering", notes[i]);
          }]);
        });
        if (!best) {
          steps.push([300, () => fail("No eligible listing", "Increase the price cap or change a requirement.", "No listing meets every requirement")]);
          return steps;
        }
        const p = P[best.provider];
        const spec = best.kind === "vm" ? `${best.vcpu} vCPU · ${best.mem} GB` : `${best.model}`;
        const unit = best.kind === "vm" ? "vCPU-hr" : "GPU-hr";
        const weak = weakness(p);
        steps.push([300, () => state("ranking", `Ranking ${byCap.length} eligible listings by price`)]);
        steps.push([300, () => matched(
          best.provider,
          "Best eligible match",
          `${best.name} · ${p.name}`,
          `${spec} · ${best.region} · ${fmt(best.price)} / ${unit}`,
          `${fmt(best.price)} · best eligible`,
          weak ? `Matched with weak evidence: ${weak}. Add provider requirements to exclude it.` : "",
          "Engine selected the best eligible listing",
        )]);
        return [...steps, ...lifecycle()];
      },
    };

    /** Return the active mode to its idle state and cancel any running demo. */
    function reset() {
      token++;
      running = false;
      finished = false;
      bumped = null;
      root.dataset.running = "false";
      reach(0);
      nodes[0].classList.remove("is-fail");
      matchNote.textContent = "awaiting a route";
      result.hidden = true;
      $$(".mr-bid").forEach((r) => {
        r.classList.remove("is-in", "is-out", "is-over", "is-win");
        r.querySelector(".mr-bid-tag")!.textContent = "";
      });
      $$(".mr-bid .ev").forEach((ev) => ev.classList.remove("is-fail"));
      $$(".mr-filter").forEach((f) => {
        f.classList.remove("is-on");
        f.querySelector("b")!.textContent = "—";
      });
      $(".mr-stack").dataset.level = "0";
      bind("count", String(data.inventory.length));
      bind("count-label", "listings");
      bind("order-id", params.listing);
      $(".mr-run").textContent = "Run demo";
      pinned = mode === "direct" ? data.listings.find((l: { id: string }) => l.id === params.listing).provider : null;
      inspect(pinned);
      state("idle", modeOf(mode).idle);
    }

    async function run() {
      reset();
      const mine = token;
      running = true;
      root.dataset.running = "true";
      for (const [ms, fn] of plans[mode]()) {
        if (!reduce.matches) await wait(ms);
        if (mine !== token) return;
        fn();
      }
      running = false;
      finished = true;
      root.dataset.running = "false";
      $(".mr-run").textContent = "Replay";
    }

    /** Inputs changed: a completed (or running) demo replays with the new input. */
    function changed() {
      if (finished || running) run();
      else reset();
    }

    function setMode(id: string) {
      if (id === mode) return;
      mode = id;
      const m = modeOf(id);
      root.dataset.mode = id;
      $$(".mr-route").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.route === id)));
      $$("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== id));
      bind("best", m.best);
      bind("mechanism", m.mechanism);
      bind("claim", m.claim);
      bind("flow", m.flow);
      reset();
      drawWires();
    }

    root.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("button");
      if (!t || !root.contains(t)) return;
      if (t.dataset.route) {
        setMode(t.dataset.route);
        t.scrollIntoView({ block: "nearest", inline: "nearest", behavior: reduce.matches ? "auto" : "smooth" });
      } else if (t.dataset.param) {
        params[t.dataset.param] = t.dataset.value!;
        $$(`[data-param="${t.dataset.param}"]`).forEach((b) => b.setAttribute("aria-pressed", String(b === t)));
        changed();
      } else if (t.dataset.req) {
        const k = t.dataset.req as Check;
        req[k] = !req[k];
        $$(`[data-req="${k}"]`).forEach((b) => b.setAttribute("aria-pressed", String(req[k])));
        changed();
      } else if (t.hasAttribute("data-run")) run();
    });

    // Inspecting: any element carrying a provider shows that provider's record.
    const inspectFrom = (e: Event) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-provider]");
      inspect(el && root.contains(el) ? el.dataset.provider! : pinned);
    };
    root.addEventListener("pointerover", inspectFrom);
    root.addEventListener("focusin", inspectFrom);
    root.addEventListener("pointerleave", () => inspect(pinned));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) inspect(pinned);
    });

    // Convergence wires: each route button → the shared MATCH node.
    const svg = $<SVGSVGElement>(".mr-wires");
    function drawWires() {
      if (getComputedStyle(svg).display === "none") return;
      const box = root.getBoundingClientRect();
      const dot = nodes[0].querySelector(".mr-dot")!.getBoundingClientRect();
      const ex = dot.left - box.left;
      const ey = dot.top + dot.height / 2 - box.top;
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      $$(".mr-route").forEach((b) => {
        const r = b.getBoundingClientRect();
        const sx = r.right - box.left;
        const sy = r.top + r.height / 2 - box.top;
        const mid = sx + (ex - sx) * 0.55;
        const path = svg.querySelector<SVGPathElement>(`[data-wire="${b.dataset.route}"]`)!;
        path.setAttribute("d", `M${sx} ${sy} C${mid} ${sy} ${mid} ${ey} ${ex} ${ey}`);
        path.classList.toggle("is-active", b.dataset.route === mode);
      });
    }
    new ResizeObserver(drawWires).observe(root);
    drawWires();
    inspect(pinned);
  }
</script>

<style>
