const stepIcons: string[] = [
  '<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5h5a3 3 0 0 1 3 3V17a2 2 0 0 0-2-2H3z"/><path d="M17 4.5h-5a3 3 0 0 0-3 3V17a2 2 0 0 1 2-2h6z"/></svg>',
  '<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 3.5h2l1.6 8.2h8.6l1.8-6.2H5.4"/><circle cx="7" cy="15.5" r="1.3"/><circle cx="14" cy="15.5" r="1.3"/></svg>',
  '<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="2.6"/><path d="M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.6 1.6M13.7 13.7l1.6 1.6M15.3 4.7l-1.6 1.6M6.3 13.7l-1.6 1.6"/></svg>',
  '<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 16.5V11M10 16.5V5M16 16.5V8.5"/><path d="M2.5 16.5h15"/></svg>',
  '<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 2.5h10v15l-2.5-1.6-2.5 1.6-2.5-1.6L5 17.5z"/><path d="M8 7.5h4M8 10.5h4"/></svg>',
];

const steps = [
  { title: "Browse", note: "Explore the catalogue", href: "/marketplace#service-types" },
  { title: "Order", note: "Self-serve or assisted", href: "/learn/three-ways-to-buy" },
  { title: "Provision", note: "Automated delivery", href: "/learn/how-the-marketplace-works" },
  { title: "Use", note: "Track usage and limits", href: "/learn/escrow-and-settlement-explained" },
  { title: "Settle", note: "One consistent model", href: "/learn/escrow-and-settlement-explained" },
];

function categoryRoute(id: string): string {
  return SERVICE_MODEL_BY_ID[id as keyof typeof SERVICE_MODEL_BY_ID]?.route ?? "/marketplace";
}

function categoryCta(id: string, label: string): string {
  return SERVICE_MODEL_BY_ID[id as keyof typeof SERVICE_MODEL_BY_ID]?.cta ?? `Explore ${label}`;
}
---

<section class:list={["sms", className]}>
  <header class="sms-head">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="sms-title">{title}</h2>
    </div>
    <div class="sms-intro">
      <p class="sms-intro-title">{introTitle}</p>
      <p>{intro}</p>
    </div>
  </header>

  <div class="sms-grid">
    {
      SERVICE_CATEGORIES.map((category, index) => {
        const route = categoryRoute(category.id);
        const cta = categoryCta(category.id, category.label);
        return (
          <article class="sms-card">
            <a
              class="sms-card-cover"
              href={route}
              aria-label={`${category.name} — ${category.tagline} (${cta})`}
            />
            <div class="sms-card-top">
              <span class="sms-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="sms-tag">{category.label}</span>
            </div>
            <div class="sms-figure" set:html={figures[category.id]} aria-hidden="true" />
            <h3>{category.name}</h3>
            <p class="sms-tagline">{category.tagline}</p>
            <ul class="sms-chips">
              {category.examples.slice(0, 4).map((example) => <li>{example}</li>)}
            </ul>
            <p class="sms-card-cta" aria-hidden="true">
              {cta} <span>→</span>
            </p>
          </article>
        );
      })
    }
  </div>

  <div class="sms-converge" aria-hidden="true">
    <svg viewBox="0 0 1200 92" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax meet">
      <defs>
        <marker id="sms-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#23683f"></path>
        </marker>
      </defs>
      <path d="M150 2 C150 58 470 30 596 76" stroke="#c6d0c8" stroke-width="1.2" marker-end="url(#sms-arrow)"></path>
      <path d="M450 2 C450 58 520 30 597 76" stroke="#c6d0c8" stroke-width="1.2" marker-end="url(#sms-arrow)"></path>
      <path d="M750 2 C750 58 680 30 603 76" stroke="#c6d0c8" stroke-width="1.2" marker-end="url(#sms-arrow)"></path>
      <path d="M1050 2 C1050 58 730 30 604 76" stroke="#c6d0c8" stroke-width="1.2" marker-end="url(#sms-arrow)"></path>
    </svg>
  </div>

  <a class="sms-pill" href="/marketplace#service-types" aria-label="One catalogue — all service models, one marketplace. Explore service types.">
    <span class="sms-pill-icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4.5h5a3 3 0 0 1 3 3V17a2 2 0 0 0-2-2H3z"/><path d="M17 4.5h-5a3 3 0 0 0-3 3V17a2 2 0 0 1 2-2h6z"/></svg>
    </span>
    <strong>One catalogue</strong>
    <i aria-hidden="true" />
    <span>All service models, one marketplace</span>
  </a>

  <ol class="sms-rail" aria-label="From catalogue to settlement">
    {
      steps.map((step, index) => (
        <li class="sms-step">
          <a class="sms-step-link" href={step.href} aria-label={`${step.title} — ${step.note}`}>
            <span class="sms-step-icon" set:html={stepIcons[index]} aria-hidden="true" />
            <span class="sms-step-copy">
              <strong>{step.title}</strong>
              <small>{step.note}</small>
            </span>
          </a>
          {index < steps.length - 1 && <i class="sms-step-arrow" aria-hidden="true">→</i>}
        </li>
      ))
    }
  </ol>

  <div class="sms-foot">
    <p>
      <span class="sms-foot-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2.5 18 7l-8 4.5L2 7z"/><path d="M2.5 12 10 16.2 17.5 12"/></svg>
      </span>
      {footnote}
    </p>
    <a class="sms-cta" href={ctaHref}>{ctaLabel} <span aria-hidden="true">→</span></a>
  </div>
</section>
