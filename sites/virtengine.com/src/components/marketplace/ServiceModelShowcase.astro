---
/**
 * ServiceModelShowcase — "IaaS, PaaS, SaaS — and custom listings."
 *
 * Four illustrated catalogue cards (IaaS, PaaS, SaaS, custom) converging into
 * a single catalogue, followed by the five-step order flow. All figures are
 * original inline SVG drawn from the brand geometry; they are decorative and
 * every card's meaning is carried by its heading, tagline and chips.
 */
import { SERVICE_CATEGORIES } from "@data/market";

interface Props {
  eyebrow?: string;
  title?: string;
  introTitle?: string;
  intro?: string;
  footnote?: string;
  ctaHref?: string;
  ctaLabel?: string;
  class?: string;
}

const {
  eyebrow = "Catalogue",
  title = "IaaS, PaaS, SaaS — and custom listings.",
  introTitle = "One catalogue. Multiple service models.",
  intro = "Infrastructure, managed platforms, software plans and provider-defined services — all in one place, with the same ordering and settlement flow.",
  footnote = "Infrastructure depth stays first-class: GPU fleets, HPC schedulers and confidential enclaves sit alongside general cloud.",
  ctaHref = "/marketplace",
  ctaLabel = "Explore the catalogue",
  class: className,
} = Astro.props;

