---
/**
 * WaldurHeroVisual — the Waldur page hero figure.
 *
 * Left: an illustrative HomePort-style marketplace window. Middle: the
 * provider daemon bridge with its reconciliation duties. Right: the protocol
 * state panel and the offering → order → lease → usage → settlement sequence.
 * The figure states the relationship plainly: Waldur is the control plane,
 * the daemon translates, the chain holds verifiable market and settlement
 * state. Waldur is not "running on the blockchain".
 */
import { NETWORK_STATUS } from "@data/status";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const offerings = [
  {
    type: "GPU Compute",
    title: "A100 GPU node",
    provider: "Example provider",
    plan: "Limit-based plan",
    region: "ap-southeast",
    price: "$0.39 / GPU-hr",
    badge: "listed",
  },
  {
    type: "Managed Kubernetes",
    title: "Rancher cluster",
    provider: "Example provider",
    plan: "Component plan",
    region: "Sydney · AU",
    price: "usage-priced",
    badge: "listed",
  },
  {
    type: "Private Cloud",
    title: "OpenStack tenant",
    provider: "Example provider",
    plan: "Reserved plan",
    region: "Frankfurt · EU",
    price: "monthly",
    badge: "limited",
  },
];

const duties = [
  ["Offering sync", "✓"],
  ["Order routing", "✓"],
  ["Lifecycle callback", "✓"],
  ["Usage reporting", "✓"],
  ["Reconciliation", "✓"],
];

const modules = ["x/provider", "x/marketplace", "x/market", "x/escrow", "x/settlement"];
const sequence = ["Offering", "Order", "Lease", "Usage", "Settlement"];
---

<figure class:list={["mk-whv", className]}>
  <p class="mk-whv-flag">
    <span>Illustrative Waldur marketplace interface</span>
    <span>{NETWORK_STATUS.posture}</span>
  </p>

  <div class="mk-whv-row">
    <div class="mk-whv-window">
      <div class="mk-whv-bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span>HomePort · Marketplace</span>
      </div>
      <div class="mk-whv-window-body">
        <p class="mk-whv-search" aria-hidden="true">
          <span>⌕ Search offerings…</span>
          <span>Project: Research Platform ▾</span>
        </p>
        <ul class="mk-whv-selects" aria-label="Illustrative catalogue filters">
          <li>Category: Compute</li>
          <li>Region: any</li>
          <li>Plan: any</li>
        </ul>
        <div class="mk-whv-cards">
          {
            offerings.map((offering) => (
              <article class="mk-whv-card">
                <small>{offering.type}</small>
                <strong>{offering.title}</strong>
                <span>{offering.provider}</span>
                <em>{offering.plan} · {offering.region}</em>
                <em>{offering.price}</em>
                <span class="mk-whv-badge">{offering.badge}</span>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mk-whv-bridge">
      <p class="mk-whv-panel-title">Provider daemon</p>
      <ul>
        {duties.map(([duty, mark]) => <li><span>{duty}</span><b aria-hidden="true">{mark}</b></li>)}
      </ul>
      <div class="mk-whv-packets" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="mk-whv-bridge-foot">signed events · API calls</p>
    </div>

    <div class="mk-whv-chain">
      <p class="mk-whv-panel-title">VirtEngine chain</p>
      <ul class="mk-whv-modules">
        {modules.map((module) => <li>{module}</li>)}
      </ul>
      <ol class="mk-whv-seq" aria-label="Protocol state sequence">
        {sequence.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </div>

  <figcaption class="mk-whv-caption">
    The service control plane, reconciled with protocol state.
  </figcaption>
</figure>
