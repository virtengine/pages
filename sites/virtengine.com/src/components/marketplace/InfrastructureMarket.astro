---
/**
 * InfrastructureMarket — "supply becomes market state".
 *
 * Left: physical infrastructure islands. Middle: the protocol exchange.
 * Right: tenant demand. The figure carries the homepage statement:
 * VirtEngine is not the cloud; it is the market independent infrastructure
 * can join.
 *
 * Interactive: every provider, market-state and tenant node links to the
 * page that owns it, so the diagram reads as a map rather than a poster.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const providers: [string, string, string][] = [
  ["GPU cluster", "accelerator capacity", "/marketplace/gpu-compute"],
  ["HPC facility", "scheduler-backed", "/marketplace/hpc"],
  ["Regional cloud", "general compute", "/marketplace/iaas"],
  ["Confidential node", "attested enclave", "/solutions/enterprises-confidential-compute"],
];

const tenants: [string, string, string][] = [
  ["AI training", "GPU-hours", "/solutions/ai-ml-workloads"],
  ["Simulation", "job queue", "/marketplace/hpc"],
  ["Virtual machines", "regional", "/marketplace/iaas"],
  ["Private workload", "confidential", "/solutions/enterprises-confidential-compute"],
];

const marketState: [string, string][] = [
  ["Identity", "/veid"],
  ["Capacity", "/marketplace"],
  ["Order", "/learn/how-the-marketplace-works"],
  ["Lease", "/learn/how-the-marketplace-works"],
  ["Usage", "/learn/escrow-and-settlement-explained"],
  ["Settlement", "/learn/escrow-and-settlement-explained"],
];
---

<div class:list={["mk-market", className]}>
  <div class="mk-market-col mk-market-col--providers">
    <h3>Providers</h3>
    <ul>
      {
        providers.map(([name, note, href]) => (
          <li>
            <a class="mk-market-node" href={href}>
              <span class="mk-market-dot" aria-hidden="true" />
              {name}
              <small>{note}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mk-market-core">
    <h3><a href="/marketplace">Market</a></h3>
    <p>
      Orders meet offerings on-chain. Every step becomes protocol state — not a private arrangement between
      two companies that have never met.
    </p>
    <ul>
      {marketState.map(([item, href]) => (
        <li>
          <a href={href}>{item}</a>
        </li>
      ))}
    </ul>
    <p class="mk-market-more"><a href="/protocol">Explore the protocol →</a></p>
  </div>

  <div class="mk-market-col mk-market-col--tenants">
    <h3>Tenants</h3>
    <ul>
      {
        tenants.map(([name, note, href]) => (
          <li>
            <a class="mk-market-node" href={href}>
              <span class="mk-market-dot" aria-hidden="true" />
              {name}
              <small>{note}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
<p class="mk-market-statement">
  <strong>VirtEngine is not the cloud. It is the market independent infrastructure can join.</strong>
</p>
