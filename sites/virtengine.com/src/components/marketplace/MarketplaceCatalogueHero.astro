---
/**
 * MarketplaceCatalogueHero — the mixed-catalogue window used as the
 * marketplace hub hero. Deliberately not all compute: the breadth of the
 * catalogue is the message.
 */
import MarketplaceListingCard from "@components/marketplace/MarketplaceListingCard.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const listings = [
  {
    type: "IaaS",
    title: "GPU Virtual Machine",
    region: "Sydney · AU",
    specs: ["1 × GPU", "16 vCPU", "64 GB RAM"],
    components: ["GPU-hour"],
    price: "$0.39 / GPU-hour",
  },
  {
    type: "PaaS",
    title: "Managed Kubernetes",
    region: "ap-southeast",
    specs: ["3 control-plane nodes", "autoscaling workers"],
    components: ["vCPU-hour", "storage GB-month"],
    price: "Component-priced",
  },
  {
    type: "HPC",
    title: "GPU Batch Queue",
    region: "AU research facility",
    specs: ["4 GPUs", "32 CPU cores", "6-hour max job"],
    components: ["GPU-hour", "core-hour"],
    price: "Allocation-based",
  },
  {
    type: "PaaS",
    title: "PostgreSQL Cluster",
    region: "Frankfurt · EU",
    specs: ["3 nodes", "Automated backups"],
    components: ["node-hour", "storage GB-month"],
    price: "Component-priced",
  },
  {
    type: "SaaS",
    title: "Analytics Software Plan",
    region: "Region-independent",
    specs: ["10 seats", "Standard support"],
    components: ["seat-month"],
    price: "$50 / seat / month",
  },
  {
    type: "Storage",
    title: "Object Storage",
    region: "Sydney · AU",
    specs: ["S3-compatible", "Versioning"],
    components: ["storage GB-month", "egress GB"],
    price: "$0.02 / GB-month",
  },
  {
    type: "Managed",
    title: "Support Hours",
    region: "Remote delivery",
    specs: ["20-hour block", "Provider-approved"],
    components: ["engineering-hour"],
    price: "Fixed-fee block",
  },
];
---

<div class:list={["mk-catalogue", className]}>
  <div class="mk-catalogue-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span>Catalogue · illustrative interface</span>
  </div>
  <div class="mk-catalogue-body">
    <ul class="mk-catalogue-filters">
      <li data-active>All services</li>
      <li>IaaS</li>
      <li>PaaS</li>
      <li>SaaS</li>
      <li>HPC</li>
      <li>Storage</li>
      <li>Custom</li>
    </ul>
    <div class="mk-catalogue-grid">
      {
        listings.map((listing) => (
          <MarketplaceListingCard
            serviceType={listing.type}
            title={listing.title}
            region={listing.region}
            specs={listing.specs}
            components={listing.components}
            priceLabel={listing.price}
            titleTag="p"
            compact
          />
        ))
      }
    </div>
    <p class="mk-catalogue-foot">
      <span>Example listings across the catalogue — not live availability.</span>
      <a href="/marketplace">Explore service types →</a>
    </p>
  </div>
</div>
