---
import { SUPPORT } from "@data/partners";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["support-ex", className]} aria-labelledby="support-title">
  <div class="container-site">
    <header class="support-head">
      <p class="tag">Acknowledgements</p>
      <h2 id="support-title">With support from</h2>
      <p>
        We have received support from, or partnered with, the organisations below.
        Programs, grants, and memberships helped build the software. The VirtEngine
        network is still in development and is not live.
      </p>
    </header>

    <div class="support-board">
      {
        SUPPORT.map((org, i) => (
          <input type="radio" name="support-org" id={`support-${org.id}`} checked={i === 0} />
        ))
      }

      <div class="support-stage">
        {
          SUPPORT.map((org) => (
            <article class={`support-panel support-panel--${org.id}`} data-for={org.id}>
              <div class="support-copy">
                <p class="support-chip">
                  <img src={org.logo} alt="" width="120" height="32" />
                </p>
                <p class="support-role">{org.role}</p>
                <p class="support-body">{org.body}</p>
                <ul class="support-facts tri-list">
                  {org.facts.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class="btn-solid" href={org.href} rel={org.href.startsWith("http") ? "noopener" : undefined}>
                  {org.ctaLabel}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="support-tabs" role="tablist" aria-label="Organisations that have supported the project">
        {
          SUPPORT.map((org) => (
            <label class="support-tab" for={`support-${org.id}`} title={org.name}>
              <img src={org.logo} alt={org.logoAlt} width="140" height="36" />
            </label>
          ))
        }
      </div>
    </div>
  </div>
</section>
