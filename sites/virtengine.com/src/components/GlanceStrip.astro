---
/**
 * GlanceStrip — three "at a glance" facts rendered as cards. Static, but
 * gives long pages a scannable entry point right under the hero.
 */
export interface GlanceItem {
  kicker: string;
  title: string;
  body: string;
}

interface Props {
  items: GlanceItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={["grid gap-4 md:grid-cols-3", className]}>
  {
    items.map((g) => (
      <li class="reveal clip-corner rounded-card border border-line bg-panel p-6">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-green-deep">{g.kicker}</p>
        <h3 class="mt-2 text-base font-semibold text-ink">{g.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate">{g.body}</p>
      </li>
    ))
  }
</ul>
