---
interface Props {
  value: string;
  label: string;
  /** Cite the source of the figure, shown in mono small print */
  source?: string;
}

const { value, label, source } = Astro.props;
---

<div class="clip-corner rounded-card border border-line bg-panel p-6">
  <p class="font-display text-3xl tracking-tight text-green-deep md:text-4xl">{value}</p>
  <p class="mt-1.5 text-sm font-medium text-ink">{label}</p>
  {source && <p class="mt-2 font-mono text-[0.68rem] text-faint">{source}</p>}
</div>
