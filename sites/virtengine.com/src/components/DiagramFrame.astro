---
/**
 * Dark "engineering plate" frame for technical figures. The night-scope
 * class remaps the diagram components' color variables to green-on-night.
 */
interface Props {
  /** Full text alternative for the diagram (required for accessibility) */
  label: string;
  caption?: string;
  class?: string;
}

const { label, caption, class: className } = Astro.props;
---

<figure
  class:list={[
    "diagram-frame night-scope clip-corner overflow-hidden rounded-frame border border-night-line p-3 sm:p-5 md:p-10",
    className,
  ]}
>
  <div role="img" aria-label={label}>
    <slot />
  </div>
  {caption && <figcaption class="mt-4 border-t border-night-line pt-3 font-mono text-xs text-night-muted">{caption}</figcaption>}
</figure>

<style>
  .diagram-frame > div { min-width: 0; }
  .diagram-frame :global(svg) { display: block; width: 100%; height: auto; margin-inline: auto; }
  @media (min-width: 1024px) { .diagram-frame :global(svg) { min-width: min(100%, 920px); } }
  @media (max-width: 767px) { .diagram-frame :global(svg) { min-width: 0 !important; max-width: 100%; } }
</style>
