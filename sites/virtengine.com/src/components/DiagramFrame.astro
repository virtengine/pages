---
/**
 * Dark "engineering plate" frame for technical figures. The night-scope
 * class remaps the diagram components' color variables to green-on-night.
 */
interface Props {
  /** Full text alternative for the diagram (required for accessibility) */
  label: string;
  caption?: string;
  class?: string;
}

const { label, caption, class: className } = Astro.props;
---

<figure
  class:list={[
    "night-scope clip-corner overflow-x-auto rounded-frame border border-night-line p-4 md:p-8",
    className,
  ]}
>
  <div role="img" aria-label={label}>
    <slot />
  </div>
  {caption && <figcaption class="mt-4 border-t border-night-line pt-3 font-mono text-xs text-night-muted">{caption}</figcaption>}
</figure>
