---
const surfaces = [
  {
    id: "market",
    number: "01",
    label: "Marketplace",
    kicker: "OPEN CAPACITY",
    title: "Find the machine that fits the work.",
    body: "Post a workload in the open. Independent providers bid against the same order, and the winning lease becomes verifiable protocol state.",
    cards: [
      { code: "x/market", title: "Open orders", copy: "Workloads described once, visible to every eligible provider.", href: "/learn/how-the-marketplace-works", cta: "Read the market flow" },
      { code: "x/provider", title: "Attested capacity", copy: "A bid counts when the machine behind it can prove what it offers.", href: "/providers", cta: "Prepare to provide" },
      { code: "x/hpc", title: "HPC workloads", copy: "Scheduler-backed capacity can join the same order and lease lifecycle.", href: "/learn/hpc-on-virtengine", cta: "Explore HPC" },
    ],
  },
  {
    id: "identity",
    number: "02",
    label: "Identity",
    kicker: "VEID / TRUST",
    title: "Prove the fact. Keep the secret.",
    body: "Encrypted identity scopes are evaluated by validators. Participants can prove eligibility without turning a central service into the keeper of every detail.",
    cards: [
      { code: "x/veid", title: "Identity scopes", copy: "Separate the fact a service needs from the raw identity behind it.", href: "/veid", cta: "See VEID" },
      { code: "x/veid/zk", title: "Selective proof", copy: "Score thresholds and attributes can be proven with less disclosure.", href: "/learn/what-is-veid", cta: "Read the explainer" },
      { code: "x/enclave", title: "Trusted processing", copy: "Attested execution paths for workloads that need a stronger boundary.", href: "/trusted-processing", cta: "Inspect the boundary" },
    ],
  },
  {
    id: "settlement",
    number: "03",
    label: "Settlement",
    kicker: "METERED USAGE",
    title: "Usage becomes a receipt, not a guess.",
    body: "Provider daemons sign usage records, escrow holds the agreed funds, and a dispute window gives the protocol a clean path from work performed to payment released.",
    cards: [
      { code: "x/escrow", title: "Funds held", copy: "Lease value sits against the workload while it is running.", href: "/learn/escrow-and-settlement-explained", cta: "Follow the funds" },
      { code: "x/settlement", title: "Signed usage", copy: "Metered records become billable line items after the dispute window.", href: "/learn/escrow-and-settlement-explained", cta: "Read settlement" },
      { code: "x/take", title: "0% marketplace take", copy: "The protocol policy does not deduct a marketplace commission.", href: "/learn/tokenomics-explained", cta: "See the policy" },
    ],
  },
  {
    id: "source",
    number: "04",
    label: "Source",
    kicker: "OPEN BY DEFAULT",
    title: "Build the binary. Read the chain.",
    body: "The chain, modules, provider daemon, and documentation ship from the open repository. The network is not live yet; the design is available to inspect now.",
    cards: [
      { code: "make", title: "One repository", copy: "A documented build path for the protocol and its surrounding tools.", href: "/open-source", cta: "Browse open source" },
      { code: "27 modules", title: "Read the surfaces", copy: "Marketplace, identity, economics, quality, and governance in one map.", href: "/modules", cta: "Open module reference" },
      { code: "docs", title: "Learn in context", copy: "Repository-grounded explainers for tenants, providers, and validators.", href: "/learn", cta: "Open the library" },
    ],
  },
] as const;
---

<section class="protocol-entry" aria-labelledby="protocol-entry-title">
  <div class="protocol-entry-grid" aria-hidden="true"></div>
  <div class="protocol-entry-glow protocol-entry-glow--one" aria-hidden="true"></div>
  <div class="protocol-entry-glow protocol-entry-glow--two" aria-hidden="true"></div>

  <div class="container-site protocol-entry-inner">
    <div class="protocol-entry-rail">
      <span>VirtEngine / protocol surfaces</span>
      <span>Interactive entrance / 01</span>
    </div>

    <div class="protocol-entry-intro">
      <div>
        <p class="protocol-entry-kicker"><i aria-hidden="true"></i> The open infrastructure network</p>
        <h1 id="protocol-entry-title">A market you can<br /><em>inspect</em> as it moves.</h1>
      </div>
      <p class="protocol-entry-intro-copy">
        Move through the protocol’s core surfaces. Choose a signal below to see what
        enters the network, what gets verified, and where the record settles.
      </p>
    </div>

    <div class="protocol-entry-console">
      <div class="protocol-entry-signal" aria-hidden="true">
        <svg class="protocol-entry-map" viewBox="0 0 900 420" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
          <defs>
            <pattern id="entry-grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0H0V36" stroke="#3a4a3c" stroke-opacity=".38" stroke-width="1" />
            </pattern>
            <radialGradient id="entry-core-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#7ddd7a" stop-opacity=".3" />
              <stop offset=".55" stop-color="#60cc5d" stop-opacity=".08" />
              <stop offset="1" stop-color="#60cc5d" stop-opacity="0" />
            </radialGradient>
            <filter id="entry-blur" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="8" />
            </filter>
          </defs>
          <rect width="900" height="420" fill="url(#entry-grid)" />
          <ellipse cx="450" cy="206" rx="244" ry="160" fill="url(#entry-core-glow)" filter="url(#entry-blur)" />
          <path class="entry-map-line entry-map-line--market" d="M450 210 126 94M450 210 774 94M450 210 126 326M450 210 774 326" />
          <path class="entry-map-line entry-map-line--identity" d="M450 210 186 210M450 210 714 210" />
          <path class="entry-map-line entry-map-line--settlement" d="M450 210 450 56M450 210 450 364" />
          <path class="entry-map-line entry-map-line--source" d="M450 210 250 92M450 210 650 92M450 210 250 328M450 210 650 328" />
          <circle class="entry-map-orbit" cx="450" cy="210" r="132" />
          <circle class="entry-map-orbit entry-map-orbit--outer" cx="450" cy="210" r="180" />
          <circle class="entry-map-ping entry-map-ping--a" cx="126" cy="94" r="7" />
          <circle class="entry-map-ping entry-map-ping--b" cx="774" cy="94" r="7" />
          <circle class="entry-map-ping entry-map-ping--c" cx="126" cy="326" r="7" />
          <circle class="entry-map-ping entry-map-ping--d" cx="774" cy="326" r="7" />
          <circle class="entry-map-ping entry-map-ping--e" cx="186" cy="210" r="7" />
          <circle class="entry-map-ping entry-map-ping--f" cx="714" cy="210" r="7" />
          <circle class="entry-map-ping entry-map-ping--g" cx="450" cy="56" r="7" />
          <circle class="entry-map-ping entry-map-ping--h" cx="450" cy="364" r="7" />
          <circle class="entry-map-core" cx="450" cy="210" r="54" />
          <circle cx="450" cy="210" r="38" stroke="#60cc5d" stroke-opacity=".5" />
          <path d="M428 193h44l-22 36-22-36Z" fill="#60cc5d" />
          <path d="M450 205v14" stroke="#0a100c" stroke-width="3" stroke-linecap="round" />
          <text x="450" y="297" text-anchor="middle" class="entry-map-label">ONE VERIFIABLE PROTOCOL</text>
          <text x="450" y="326" text-anchor="middle" class="entry-map-sub">COMPUTE / IDENTITY / SETTLEMENT</text>
        </svg>
        <span class="protocol-entry-signal-note protocol-entry-signal-note--tl">independent capacity</span>
        <span class="protocol-entry-signal-note protocol-entry-signal-note--tr">validator set</span>
        <span class="protocol-entry-signal-note protocol-entry-signal-note--bl">signed usage</span>
        <span class="protocol-entry-signal-note protocol-entry-signal-note--br">open repository</span>
      </div>

      <div class="protocol-entry-controls" role="radiogroup" aria-label="VirtEngine protocol surfaces">
        {surfaces.map((surface) => (
          <label class="protocol-entry-tab">
            <input type="radio" name="protocol-entry-surface" value={surface.id} checked={surface.id === "market"} />
            <span class="protocol-entry-tab-number">{surface.number}</span>
            <span class="protocol-entry-tab-label">{surface.label}</span>
            <span class="protocol-entry-tab-mark" aria-hidden="true">↗</span>
          </label>
        ))}
      </div>

      <div class="protocol-entry-readout">
        {surfaces.map((surface) => (
          <div class:list={["protocol-entry-readout-copy", `protocol-entry-readout-copy--${surface.id}`]}>
            <p>{surface.kicker}</p>
            <h2>{surface.title}</h2>
            <span>{surface.body}</span>
          </div>
        ))}
      </div>

      <div class="protocol-entry-panels">
        {surfaces.map((surface) => (
          <div class:list={["protocol-entry-panel", `protocol-entry-panel--${surface.id}`]}>
            {surface.cards.map((card, index) => (
              <a class="protocol-entry-card" href={card.href}>
                <span class="protocol-entry-card-top"><b>{String(index + 1).padStart(2, "0")}</b><code>{card.code}</code></span>
                <span class="protocol-entry-card-title">{card.title}</span>
                <span class="protocol-entry-card-copy">{card.copy}</span>
                <span class="protocol-entry-card-cta">{card.cta}<b aria-hidden="true">↗</b></span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="protocol-entry-footer">
      <span><i aria-hidden="true"></i> Network status: not live</span>
      <a href="#capabilities">Continue through the protocol <b aria-hidden="true">↓</b></a>
    </div>
  </div>
</section>

<style>
  .protocol-entry {
    --entry-bg: #0a100c;
    --entry-panel: #111b14;
    --entry-raised: #18251b;
    --entry-line: #314235;
    --entry-muted: #9caf9f;
    --entry-text: #edf5ed;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--entry-text);
    background: var(--entry-bg);
    min-height: min(900px, calc(100svh - 88px));
    border-bottom: 1px solid #2b3c30;
  }
  .protocol-entry-grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: .2;
    background-image: linear-gradient(to right, transparent 0, transparent calc(50% - 0.5px), #7ddd7a calc(50% - 0.5px), #7ddd7a 50%, transparent 50%, transparent 100%);
    background-size: 100% 100%;
    pointer-events: none;
  }
  .protocol-entry-grid::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0, transparent 35px, #3a4a3c 36px);
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }
  .protocol-entry-glow {
    position: absolute;
    z-index: -2;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    filter: blur(50px);
    opacity: .14;
    pointer-events: none;
  }
  .protocol-entry-glow--one { left: 8%; top: 24%; background: #60cc5d; }
  .protocol-entry-glow--two { right: 4%; bottom: 4%; background: #b8e8be; opacity: .08; }
  .protocol-entry-inner { position: relative; padding-block: 1.25rem 1rem; }
  .protocol-entry-rail,
  .protocol-entry-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #809482;
    font: 500 .69rem/1.4 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .protocol-entry-rail { border-bottom: 1px solid #28392d; padding-bottom: .95rem; }
  .protocol-entry-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 23rem);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 5.25rem) 2rem;
  }
  .protocol-entry-kicker {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin: 0 0 1.05rem;
    color: #7ddd7a;
    font: 500 .7rem/1.3 var(--font-mono);
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .protocol-entry-kicker i,
  .protocol-entry-footer i {
    display: block;
    width: .55rem;
    height: .48rem;
    background: #60cc5d;
    clip-path: polygon(0 0,100% 0,50% 100%);
  }
  .protocol-entry-intro h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--entry-text);
    font: 400 clamp(2.6rem, 5.8vw, 5.5rem)/.96 var(--font-display);
    letter-spacing: -.025em;
  }
  .protocol-entry-intro h1 em { color: #7ddd7a; font-style: normal; }
  .protocol-entry-intro-copy {
    max-width: 23rem;
    margin: 0 0 .3rem;
    color: var(--entry-muted);
    font-size: .98rem;
    line-height: 1.75;
  }
  .protocol-entry-console { position: relative; }
  .protocol-entry-signal {
    position: relative;
    overflow: hidden;
    min-height: clamp(17rem, 35vw, 27rem);
    border: 1px solid #2e4033;
    border-radius: var(--radius-frame);
    background: #0b130e;
    box-shadow: 0 24px 70px -34px #000;
  }
  .protocol-entry-signal::before,
  .protocol-entry-signal::after {
    content: "";
    position: absolute;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-top: 1px solid #7ddd7a;
  }
  .protocol-entry-signal::before { left: 16px; top: 16px; border-left: 1px solid #7ddd7a; }
  .protocol-entry-signal::after { right: 16px; bottom: 16px; border-right: 1px solid #7ddd7a; border-bottom: 1px solid #7ddd7a; }
  .protocol-entry-map { display: block; width: 100%; height: 100%; min-height: inherit; }
  .entry-map-line { stroke: #314235; stroke-width: 1.25; stroke-dasharray: 4 8; opacity: .72; transition: stroke .18s ease, opacity .18s ease, stroke-width .18s ease; }
  .entry-map-line--identity { stroke-dasharray: 2 10; }
  .entry-map-line--settlement { stroke-dasharray: 1 7; }
  .entry-map-line--source { stroke-dasharray: 1 12; }
  .entry-map-orbit { stroke: #52705a; stroke-width: 1; stroke-dasharray: 2 9; opacity: .55; animation: entry-orbit 22s linear infinite; transform-origin: 50% 50%; }
  .entry-map-orbit--outer { stroke: #2b3b2f; stroke-dasharray: 2 15; animation-direction: reverse; animation-duration: 35s; }
  .entry-map-core { fill: #18251b; stroke: #60cc5d; stroke-width: 1.5; }
  .entry-map-ping { fill: #18251b; stroke: #637f6a; stroke-width: 1.5; transition: fill .18s ease, stroke .18s ease, r .18s ease; }
  .entry-map-label { fill: #d9e9da; font: 500 12px var(--font-mono); letter-spacing: .15em; }
  .entry-map-sub { fill: #76907b; font: 500 9px var(--font-mono); letter-spacing: .18em; }
  @keyframes entry-orbit { to { transform: rotate(360deg); } }
  .protocol-entry-signal-note { position: absolute; z-index: 2; color: #718a76; font: .62rem/1.2 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .protocol-entry-signal-note--tl { left: 2.2rem; top: 1.4rem; }
  .protocol-entry-signal-note--tr { right: 2.2rem; top: 1.4rem; }
  .protocol-entry-signal-note--bl { left: 2.2rem; bottom: 1.4rem; }
  .protocol-entry-signal-note--br { right: 2.2rem; bottom: 1.4rem; }
  .protocol-entry-controls {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: .25rem;
    width: fit-content;
    max-width: 100%;
    margin: -1.4rem auto 0;
    padding: .28rem;
    border: 1px solid #48604d;
    border-radius: .42rem;
    background: #132017;
    box-shadow: 0 14px 30px -18px #000;
    scrollbar-width: none;
  }
  .protocol-entry-controls::-webkit-scrollbar { display: none; }
  .protocol-entry-tab { display: flex; align-items: center; gap: .55rem; cursor: pointer; padding: .7rem .95rem; border-radius: .25rem; color: #8fa895; transition: background-color .18s ease, color .18s ease; }
  .protocol-entry-tab input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .protocol-entry-tab-number { color: #5f7865; font: .65rem var(--font-mono); }
  .protocol-entry-tab-label { font-size: .87rem; font-weight: 500; }
  .protocol-entry-tab-mark { color: #759279; font-size: 1rem; opacity: 0; transform: translate(-3px, 3px); transition: opacity .18s ease, transform .18s ease; }
  .protocol-entry-tab:hover { color: #eaf3eb; background: #1b2a1f; }
  .protocol-entry-tab:has(input:checked) { color: #0a100c; background: #60cc5d; }
  .protocol-entry-tab:has(input:checked) .protocol-entry-tab-number { color: #1f5a35; }
  .protocol-entry-tab:has(input:checked) .protocol-entry-tab-mark { color: #1f5a35; opacity: 1; transform: none; }
  .protocol-entry-tab:has(input:focus-visible) { outline: 2px solid #7ddd7a; outline-offset: 2px; }
  .protocol-entry-readout { display: grid; grid-template-columns: 1fr; margin-top: 1.55rem; }
  .protocol-entry-readout-copy { grid-area: 1 / 1; max-width: 40rem; opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity .18s ease, visibility .18s ease, transform .18s ease; }
  .protocol-entry-readout-copy p { margin: 0 0 .45rem; color: #7ddd7a; font: 500 .68rem var(--font-mono); letter-spacing: .14em; }
  .protocol-entry-readout-copy h2 { margin: 0; color: #edf5ed; font: 400 clamp(1.7rem, 3vw, 2.45rem)/1.05 var(--font-display); }
  .protocol-entry-readout-copy span { display: block; max-width: 39rem; margin-top: .65rem; color: #9caf9f; font-size: .92rem; line-height: 1.65; }
  .protocol-entry-panels { display: grid; grid-template-columns: 1fr; margin-top: 1.4rem; }
  .protocol-entry-panel { grid-area: 1 / 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(5px); transition: opacity .18s ease, visibility .18s ease, transform .18s ease; }
  .protocol-entry-card { position: relative; display: flex; min-height: 10.2rem; flex-direction: column; padding: 1rem 1.05rem .9rem; border: 1px solid #2e4033; border-radius: var(--radius-card); color: #dbe8dc; background: rgba(18, 31, 21, .86); transition: border-color .18s ease, background-color .18s ease; }
  .protocol-entry-card::after { content: ""; position: absolute; right: -1px; top: -1px; width: 10px; height: 10px; border-top: 1px solid #60cc5d; border-right: 1px solid #60cc5d; clip-path: polygon(0 0,100% 0,100% 100%); }
  .protocol-entry-card:hover { border-color: #60cc5d; background: #182a1c; }
  .protocol-entry-card-top { display: flex; align-items: center; justify-content: space-between; gap: .6rem; color: #749079; }
  .protocol-entry-card-top b { color: #60cc5d; font: .65rem var(--font-mono); }
  .protocol-entry-card code { font: .62rem var(--font-mono); letter-spacing: .05em; }
  .protocol-entry-card-title { margin-top: 1.25rem; color: #edf5ed; font-size: 1.02rem; font-weight: 600; }
  .protocol-entry-card-copy { display: block; margin-top: .42rem; color: #9caf9f; font-size: .82rem; line-height: 1.55; }
  .protocol-entry-card-cta { display: flex; justify-content: space-between; gap: .5rem; margin-top: auto; padding-top: .85rem; color: #7ddd7a; font: 500 .65rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .protocol-entry-card-cta b { font-size: 1rem; font-weight: 400; line-height: .7; }
  .protocol-entry-footer { margin-top: 1.2rem; padding-top: .9rem; border-top: 1px solid #28392d; }
  .protocol-entry-footer > span { display: flex; align-items: center; gap: .55rem; }
  .protocol-entry-footer > span i { background: #9a6700; clip-path: none; border-radius: 50%; width: .45rem; height: .45rem; }
  .protocol-entry-footer a { color: #b9d2bc; }
  .protocol-entry-footer a:hover { color: #7ddd7a; }
  .protocol-entry-footer a b { display: inline-block; margin-left: .4rem; color: #60cc5d; font-size: 1rem; font-weight: 400; }

  .protocol-entry-console:has(input[value="market"]:checked) .protocol-entry-readout-copy--market,
  .protocol-entry-console:has(input[value="identity"]:checked) .protocol-entry-readout-copy--identity,
  .protocol-entry-console:has(input[value="settlement"]:checked) .protocol-entry-readout-copy--settlement,
  .protocol-entry-console:has(input[value="source"]:checked) .protocol-entry-readout-copy--source,
  .protocol-entry-console:has(input[value="market"]:checked) .protocol-entry-panel--market,
  .protocol-entry-console:has(input[value="identity"]:checked) .protocol-entry-panel--identity,
  .protocol-entry-console:has(input[value="settlement"]:checked) .protocol-entry-panel--settlement,
  .protocol-entry-console:has(input[value="source"]:checked) .protocol-entry-panel--source { opacity: 1; visibility: visible; pointer-events: auto; transform: none; }
  .protocol-entry-console:has(input[value="market"]:checked) .entry-map-line--market,
  .protocol-entry-console:has(input[value="identity"]:checked) .entry-map-line--identity,
  .protocol-entry-console:has(input[value="settlement"]:checked) .entry-map-line--settlement,
  .protocol-entry-console:has(input[value="source"]:checked) .entry-map-line--source { stroke: #60cc5d; stroke-width: 2; opacity: 1; filter: drop-shadow(0 0 4px rgba(96, 204, 93, .55)); }
  .protocol-entry-console:has(input[value="market"]:checked) .entry-map-ping--a,
  .protocol-entry-console:has(input[value="market"]:checked) .entry-map-ping--b,
  .protocol-entry-console:has(input[value="market"]:checked) .entry-map-ping--c,
  .protocol-entry-console:has(input[value="market"]:checked) .entry-map-ping--d,
  .protocol-entry-console:has(input[value="identity"]:checked) .entry-map-ping--e,
  .protocol-entry-console:has(input[value="identity"]:checked) .entry-map-ping--f,
  .protocol-entry-console:has(input[value="settlement"]:checked) .entry-map-ping--g,
  .protocol-entry-console:has(input[value="settlement"]:checked) .entry-map-ping--h,
  .protocol-entry-console:has(input[value="source"]:checked) .entry-map-ping--a,
  .protocol-entry-console:has(input[value="source"]:checked) .entry-map-ping--b,
  .protocol-entry-console:has(input[value="source"]:checked) .entry-map-ping--c,
  .protocol-entry-console:has(input[value="source"]:checked) .entry-map-ping--d { fill: #60cc5d; stroke: #7ddd7a; }

  @media (max-width: 760px) {
    .protocol-entry { min-height: auto; }
    .protocol-entry-inner { padding-block: .9rem 1.1rem; }
    .protocol-entry-rail { font-size: .6rem; }
    .protocol-entry-intro { display: block; padding-block: 2.8rem 1.5rem; }
    .protocol-entry-intro h1 { max-width: 10ch; font-size: clamp(2.65rem, 12vw, 4.5rem); }
    .protocol-entry-intro-copy { margin-top: 1.35rem; font-size: .9rem; }
    .protocol-entry-signal { min-height: 14rem; }
    .protocol-entry-map { min-height: 14rem; }
    .protocol-entry-signal-note { font-size: .52rem; }
