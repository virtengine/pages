---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted">
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <svg viewBox="0 0 8 8" width="7" height="7" aria-hidden="true" class="text-green">
              <polygon points="1,1 7,1 4,7" fill="currentColor" />
            </svg>
          )}
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class="text-slate">{crumb.name}</span>
          ) : (
            <a href={crumb.href} class="transition-colors hover:text-green-dark">{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
