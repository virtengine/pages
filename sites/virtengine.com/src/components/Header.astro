---
import { NAV_GROUPS, NAV_SEARCH } from "@data/navigation";
import { SITE } from "@data/site";
import Lockup from "@components/brand/Lockup.astro";
import "../styles/navigation.css";
const current=Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const active=(href:string)=>href.split('#')[0]===current;
---
<header class="site-header mega-header" id="site-navigation">
<div class="container-site header-row">
<a class="nav-brand" href="/" aria-label="VirtEngine home"><Lockup size={52} /></a>
<button id="nav-toggle" class="mega-mobile-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
<nav id="primary-navigation" class="mega-navigation" aria-label="Primary">
{NAV_GROUPS.map(group=><details class="mega-group" data-nav-group={group.id}>
<summary id={`trigger-${group.id}`} aria-controls={`menu-${group.id}`} class:list={["mega-trigger",{'contains-current':group.categories.some(c=>c.links.some(l=>active(l.href)))}]}>{group.label}<svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg></summary>
<div class="mega-panel" id={`menu-${group.id}`}>
<div class="container-site mega-inner">
<div class="mega-panel-head"><div><span class="nav-eyebrow">EXPLORE / {group.label.toUpperCase()}</span><p>{group.overview.description}</p></div><a href={group.overview.href}>{group.overview.label} <span aria-hidden="true">↗</span></a></div>
<div class="mega-body"><div class="mega-categories" aria-label={`${group.label} topics`}>
{group.categories.map((cat,i)=><button type="button" class="mega-category" id={`tab-${group.id}-${cat.id}`} data-category={cat.id} aria-controls={`panel-${group.id}-${cat.id}`}><span>{cat.label}<b aria-hidden="true">→</b></span><small>{cat.description}</small></button>)}
</div><div class="mega-content">{group.categories.map(cat=><section id={`panel-${group.id}-${cat.id}`} class="mega-topic" data-topic={cat.id} aria-labelledby={`tab-${group.id}-${cat.id}`}><div class="mega-links"><h2>{cat.label}</h2><ul>{cat.links.map(item=><li><a href={item.href} aria-current={active(item.href)?'page':undefined}><span>{item.label}<b aria-hidden="true">↗</b></span><small>{item.description}</small></a></li>)}</ul></div><aside class="mega-feature"><span class="nav-eyebrow">A USEFUL NEXT STEP</span><h3>{cat.feature.label.replace(' ↗','')}</h3><p>{cat.feature.description}</p><a href={cat.feature.href}>Explore this topic <span aria-hidden="true">→</span></a><div class="mega-status"><span>IN DEVELOPMENT</span><p>Read, learn, and contribute today.<br/>The network is not live.</p><a href="/network">See network status →</a></div></aside></section>)}</div></div>
<div class="mega-bottom"><a href="/participate">Not sure where to start? <strong>Find your path →</strong></a><button type="button" data-close-menu>Close menu <span aria-hidden="true">×</span></button></div>
</div></div></details>)}
<details class="mega-group mega-search-group" data-nav-group="search"><summary class="mega-trigger search-trigger" id="trigger-search" aria-controls="menu-search"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><span>Find a page</span></summary><div class="mega-panel" id="menu-search"><div class="container-site search-inner"><label for="navigation-search">Where would you like to go?</label><div class="search-input-row"><input type="search" id="navigation-search" placeholder="Search topics, guides, modules…" autocomplete="off" /><button type="button" id="clear-navigation-search">Clear</button><button type="button" data-close-menu aria-label="Close page search">Close ×</button></div><p id="search-count" role="status" aria-live="polite">Popular destinations</p><ul id="navigation-results">{NAV_SEARCH.slice(0,6).map(l=><li><a href={l.href}><span>{l.label}</span><small>{l.description}</small></a></li>)}</ul><p id="search-empty" hidden>No pages match. Try “identity”, “HPC”, “escrow”, or <a href="/contact">contact the Foundation</a>.</p><noscript><p>Type-to-search requires JavaScript. All topic menus and their links work without it.</p></noscript></div></div></details>
</nav>
<a class="mega-github" href={SITE.github} aria-label="VirtEngine source on GitHub">
  <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.68 7.68 0 0 1 8 4.77c.68.003 1.36.092 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
</a>
<a class="mega-involve" href="/protocol">Explore VirtEngine</a>
</div>
<script type="application/json" id="navigation-index" set:html={JSON.stringify(NAV_SEARCH).replace(/</g,'\u003c')} />
</header><div class="nav-scrim" hidden aria-hidden="true"></div>
<script>
import { initNavigation } from "../scripts/navigation";
initNavigation();
</script>
