---
/**
 * VEID verification pipeline, instrument edition: the capture wallet (device),
 * the validator identity network (chain), and the zero-knowledge surfaces
 * (off chain). Sparse by design — one line of detail per stage.
 * Decorative inside PlateFigure — the frame carries the role and the text
 * alternative.
 */
import VImage from "@components/brand/VImage.astro";

const stages = [
  { x: 28, title: "capture", line: "document OCR · selfie" },
  { x: 202, title: "liveness", line: "active challenge" },
  { x: 376, title: "attest", line: "biometrics · device" },
  { x: 550, title: "encrypt", line: "public-key sealed" },
];

const tiers = [
  { x: 28, title: "score ≥ T", note: "threshold proved" },
  { x: 268, title: "attribute", note: "age · residency" },
  { x: 508, title: "gating", note: "marketplace access" },
];

const HX = 140;
const HY = 356;
const rad = Math.PI / 180;
const pt = (r: number, deg: number) => ({
  x: +(HX + r * Math.cos(deg * rad)).toFixed(1),
  y: +(HY + r * Math.sin(deg * rad)).toFixed(1),
});
const hexPts = [270, 330, 30, 90, 150, 210].map((a) => pt(52, a));
const hexPath = hexPts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x},${p.y}`).join(" ") + " Z";
---

<svg viewBox="0 0 720 580" class="diagram-svg h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <marker id="veid-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L8 4 L0 8 Z" fill="#60cc5d" />
    </marker>
    <radialGradient id="veid-ring" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#7ddd7a" stop-opacity="0.26" />
      <stop offset="100%" stop-color="#7ddd7a" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- ============ phase 1: on device ============ -->
  <text x="28" y="36" class="art-mono-sm" fill="var(--color-night-muted)">phase 1 · on device — the veid capture wallet</text>

  {
    stages.map((s, i) => (
      <g transform={`translate(${s.x},60)`}>
        <rect width="150" height="88" rx="10" fill="var(--color-night-raised)" stroke="var(--color-night-line-strong)" />
        <text x="16" y="32" class="art-mono-xs" fill="var(--color-green)">
          {String(i + 1).padStart(2, "0")} {s.title}
        </text>
        <text x="16" y="60" font-family="var(--font-sans)" font-size="14" fill="var(--color-night-muted)">
          {s.line}
        </text>
        {i < stages.length - 1 && (
          <path class="dash-march" d="M154,44 H 168" stroke="var(--color-green)" stroke-width="1.5" marker-end="url(#veid-arrow)" />
        )}
      </g>
    ))
  }

  <path class="dash-march" d="M625,152 V 204" stroke="var(--color-green)" stroke-width="1.5" marker-end="url(#veid-arrow)" />
  <text x="617" y="184" text-anchor="end" class="art-mono-xs" fill="var(--color-night-muted)">
    signed by approved client + user
  </text>

  <!-- ============ phase 2: on chain ============ -->
  <text x="28" y="238" class="art-mono-sm" fill="var(--color-night-muted)">phase 2 · on chain — the validator identity network</text>
  <rect x="28" y="258" width="664" height="184" rx="12" fill="var(--color-green)" fill-opacity="0.07" stroke="var(--color-green)" stroke-opacity="0.45" />

  <circle cx={HX} cy={HY} r="88" fill="url(#veid-ring)" />
  <path d={hexPath} stroke="var(--color-green)" stroke-width="1.5" stroke-opacity="0.85" />
  {
    hexPts.map((p, i) => (
      <circle
        cx={p.x}
        cy={p.y}
        r="4.5"
        fill="var(--color-night-panel)"
        stroke="var(--color-green-bright)"
        stroke-width="1.4"
        class="breathe"
        style={`animation-delay:-${i * 0.6}s`}
      />
    ))
  }
  <circle cx={HX} cy={HY} r="30" stroke="var(--color-green)" stroke-width="1.3" class="pulse-ring" />
  <VImage x={HX - 20} y={HY - 19} h={38} />
  <text x={HX} y="432" text-anchor="middle" class="art-mono-xs" fill="var(--color-green)">consensus commit</text>

  <g font-family="var(--font-sans)" font-size="15" fill="var(--color-night-muted)">
    <text x="292" y="330">validators decrypt the scopes with their keys</text>
    <text x="292" y="360">shared machine-learning models score identity</text>
    <text x="292" y="390">the trust result is committed by consensus</text>
  </g>

  <!-- ============ phase 3: off chain ============ -->
  <path class="dash-march" d="M360,448 V 476" stroke="var(--color-green)" stroke-width="1.5" marker-end="url(#veid-arrow)" />
  <text x="28" y="498" class="art-mono-sm" fill="var(--color-night-muted)">phase 3 · off chain — zero-knowledge proofs</text>

  {
    tiers.map((t, i) => (
      <g transform={`translate(${t.x},510)`}>
        <rect width="184" height="52" rx="9" fill="var(--color-night-raised)" stroke={i === 0 ? "var(--color-green)" : "var(--color-night-line-strong)"} stroke-opacity={i === 0 ? 0.8 : 1} />
        <text x="16" y="23" class="art-mono-xs" fill={i === 0 ? "var(--color-green)" : "var(--color-night-text)"}>
          {t.title}
        </text>
        <text x="16" y="41" font-family="var(--font-sans)" font-size="13" fill="var(--color-night-muted)">
          {t.note}
        </text>
      </g>
    ))
  }
</svg>
