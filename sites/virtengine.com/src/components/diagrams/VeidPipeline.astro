---
/**
 * VEID verification pipeline: capture → liveness → hardware attestation →
 * encrypted submission → validator ML scoring → ZK verification tiers.
 * Decorative inside DiagramFrame — the frame carries the aria-label.
 */
const stages = [
  { x: 12, title: "capture", lines: ["document OCR", "selfie capture"] },
  { x: 180, title: "liveness", lines: ["active liveness", "challenge"] },
  { x: 348, title: "attestation", lines: ["fingerprint / iris", "device integrity"] },
  { x: 516, title: "encrypt", lines: ["public-key sealed", "identity scopes"] },
];
---

<svg viewBox="0 0 680 320" class="diagram-svg h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <marker id="veid-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L8 4 L0 8 Z" fill="var(--color-teal)"></path>
    </marker>
  </defs>

  <text x="12" y="26" font-family="var(--font-display)" font-weight="600" font-size="13" fill="var(--color-text)">On device — VEID capture wallet</text>

  {
    stages.map((s, i) => (
      <g transform={`translate(${s.x},42)`}>
        <rect width="152" height="66" rx="10" fill="var(--color-panel-raised)" stroke="var(--color-hairline-strong)" stroke-width="1.3" />
        <text x="14" y="24" font-family="var(--font-mono)" font-size="11" fill="var(--color-teal-bright)">
          {String(i + 1).padStart(2, "0")} {s.title}
        </text>
        {s.lines.map((line, j) => (
          <text x="14" y={42 + j * 15} font-family="var(--font-sans)" font-size="10" fill="var(--color-text-muted)">
            {line}
          </text>
        ))}
        {i < stages.length - 1 && (
          <path class="flow-dash" d="M156 33 H 164" stroke="var(--color-teal)" stroke-width="1.6" marker-end="url(#veid-arrow)" style={`animation-delay:-${i * 0.3}s`} />
        )}
      </g>
    ))
  }

  <path class="flow-dash" d="M592 108 V 148" stroke="var(--color-teal)" stroke-width="1.6" marker-end="url(#veid-arrow)" style="animation-delay:-1s"></path>
  <text x="580" y="134" text-anchor="end" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">signed by approved client + user</text>

  <!-- chain band -->
  <rect x="12" y="152" width="656" height="80" rx="10" fill="var(--color-teal-dim)" fill-opacity="0.28" stroke="var(--color-teal)" stroke-opacity="0.6"></rect>
  <text x="28" y="178" font-family="var(--font-display)" font-weight="600" font-size="13" fill="var(--color-teal-glow)">On chain — validator VEID Network</text>
  <text x="28" y="198" font-family="var(--font-sans)" font-size="10.5" fill="var(--color-text-muted)">validators decrypt with their keys, score identity with shared ML models, and commit the trust score by consensus</text>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--color-teal-bright)">
    <text x="28" y="220">x/veid</text>
    <text x="98" y="220">x/veidregistry</text>
    <text x="218" y="220">x/encryption</text>
    <text x="328" y="220">x/mfa</text>
  </g>

  <path class="flow-dash" d="M340 232 V 262" stroke="var(--color-teal)" stroke-width="1.6" marker-end="url(#veid-arrow)" style="animation-delay:-1.4s"></path>

  <!-- ZK tiers -->
  <g font-family="var(--font-mono)" font-size="10.5">
    <rect x="12" y="266" width="200" height="42" rx="8" fill="var(--color-panel-raised)" stroke="var(--color-hairline-strong)"></rect>
    <text x="28" y="284" fill="var(--color-teal-bright)">zk: score threshold</text>
    <text x="28" y="299" fill="var(--color-text-muted)" font-family="var(--font-sans)">prove score &#8805; T, reveal nothing else</text>

    <rect x="228" y="266" width="200" height="42" rx="8" fill="var(--color-panel-raised)" stroke="var(--color-hairline-strong)"></rect>
    <text x="244" y="284" fill="var(--color-teal-bright)">zk: attribute proofs</text>
    <text x="244" y="299" fill="var(--color-text-muted)" font-family="var(--font-sans)">age / residency scopes</text>

    <rect x="444" y="266" width="224" height="42" rx="8" fill="var(--color-panel-raised)" stroke="var(--color-hairline-strong)"></rect>
    <text x="460" y="284" fill="var(--color-teal-bright)">marketplace gating</text>
    <text x="460" y="299" fill="var(--color-text-muted)" font-family="var(--font-sans)">providers &amp; tenants verify each other</text>
  </g>
</svg>
