---
/**
 * EnclaveLock — trusted processing, the lock-and-key figure for virtengine.com.
 * Encrypted identity scopes reach an attestation gate; the chain verifies the
 * enclave's measurement (x/enclave) before any data is released. Inside the
 * confidential VM (AMD SEV-SNP / Intel SGX / AWS Nitro) the scoring service
 * runs as measured code with keys derived and sealed in hardware; operator,
 * provider and foundation access paths are blocked. Only results leave.
 * Decorative inside PlateFigure — the frame carries the text alternative.
 */
---

<svg viewBox="0 0 880 540" class="diagram-svg h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <marker id="tp-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L8 4 L0 8 Z" fill="#60cc5d" />
    </marker>
    <marker id="tp-block" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="10" markerHeight="10">
      <path d="M2 2 L10 10 M10 2 L2 10" stroke="#ffd064" stroke-width="2.4" stroke-linecap="round" />
    </marker>
  </defs>

  <!-- ============ phase labels ============ -->
  <g font-family="var(--font-mono)" font-size="10" letter-spacing="0.8" fill="var(--color-night-faint)">
    <text x="32" y="30">ON DEVICE · SEALED</text>
    <text x="286" y="30">ON CHAIN · THE GATE</text>
    <text x="500" y="30">IN HARDWARE</text>
    <text x="32" y="326">RESULTS ONLY · CHAIN STATE</text>
  </g>

  <!-- ============ source: encrypted scopes ============ -->
  <g>
    <rect x="32" y="48" width="210" height="112" rx="9" fill="var(--color-night-raised)" stroke="var(--color-night-line-strong)" stroke-width="1.4" />
    <text x="48" y="76" font-family="var(--font-sans)" font-size="13.5" font-weight="600" fill="var(--color-night-text)">Encrypted identity scopes</text>
    <g font-family="var(--font-mono)" font-size="10" fill="var(--color-night-muted)">
      <text x="48" y="102">documents · liveness</text>
      <text x="48" y="118">biometric attestation</text>
      <text x="48" y="138">sealed before upload</text>
      <text x="48" y="152" fill="var(--color-green-bright)">x/encryption envelopes</text>
    </g>
  </g>

  <!-- ============ the attestation gate ============ -->
  <g>
    <rect x="286" y="48" width="182" height="196" rx="9" fill="var(--color-green)" fill-opacity="0.06" stroke="var(--color-green)" stroke-opacity="0.75" stroke-width="1.6" />
    <text x="302" y="76" font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="var(--color-green)">01 · ATTESTATION GATE</text>
    <g font-family="var(--font-sans)" font-size="11.5" fill="var(--color-night-muted)">
      <text x="302" y="102">The enclave signs the exact</text>
      <text x="302" y="120">code it runs — measured.</text>
    </g>
    <g font-family="var(--font-mono)" font-size="9" fill="var(--color-night-muted)">
      <text x="302" y="146">verified on-chain · x/enclave</text>
      <text x="302" y="162">SGX · SEV-SNP · Nitro</text>
      <text x="302" y="178">VCEK → ASK → ARK · TCB</text>
    </g>
    <text x="302" y="222" font-family="var(--font-mono)" font-size="11" letter-spacing="0.8" fill="var(--color-green)">NO PROOF → NO DATA</text>
  </g>

  <!-- data flows -->
  <path class="dash-march" d="M242,104 H280" stroke="var(--color-green)" stroke-width="1.6" marker-end="url(#tp-arrow)" />
  <path class="dash-march" d="M468,104 H494" stroke="var(--color-green)" stroke-width="1.6" marker-end="url(#tp-arrow)" />

  <!-- ============ the vault: confidential VM ============ -->
  <g>
    <rect x="500" y="36" width="348" height="224" rx="12" fill="var(--color-green)" fill-opacity="0.05" stroke="var(--color-green)" stroke-opacity="0.5" stroke-width="1.6" />
    <!-- lock on the border -->
    <g transform="translate(706 20)">
      <rect x="0" y="14" width="48" height="34" rx="7" fill="var(--color-night-raised)" stroke="var(--color-green)" stroke-width="1.8" />
      <path d="M10 14 V8 a14 14 0 0 1 28 0 V14" stroke="var(--color-green)" stroke-width="4.5" />
      <circle cx="24" cy="28" r="4.5" fill="var(--color-green)" />
      <path d="M24 31 V39" stroke="var(--color-green)" stroke-width="3.2" stroke-linecap="round" />
    </g>
    <text x="524" y="76" font-family="var(--font-sans)" font-size="15" font-weight="600" fill="var(--color-night-text)">Trusted processing unit</text>
    <text x="524" y="96" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">confidential VM — AMD SEV-SNP · Intel SGX · AWS Nitro</text>

    <rect x="524" y="112" width="300" height="48" rx="8" fill="var(--color-night-panel)" stroke="var(--color-night-line-strong)" stroke-width="1.3" />
    <text x="540" y="134" font-family="var(--font-mono)" font-size="10.5" fill="var(--color-green-bright)">VEID scoring service + ML models</text>
    <text x="540" y="150" font-family="var(--font-mono)" font-size="9" fill="var(--color-night-muted)">liveness · face match · document checks</text>

    <rect x="524" y="172" width="300" height="48" rx="8" fill="var(--color-night-panel)" stroke="var(--color-night-line-strong)" stroke-width="1.3" />
    <g transform="translate(538 188)" stroke="var(--color-green-bright)" stroke-width="2" stroke-linecap="round">
      <circle cx="7" cy="8" r="5.5" />
      <path d="M12.5 8 H30 M24 8 V13 M28 8 V12" />
    </g>
    <text x="578" y="196" font-family="var(--font-mono)" font-size="10.5" fill="var(--color-green-bright)">keys derived + sealed in hardware</text>
    <text x="578" y="211" font-family="var(--font-mono)" font-size="9" fill="var(--color-night-muted)">vTPM sealing · memory encrypted by the CPU</text>

    <text x="674" y="248" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-faint)">no operator login · no console · no memory dump</text>
  </g>

  <!-- ============ blocked access paths ============ -->
  <g>
    <g stroke="#ffd064" stroke-width="1.4" stroke-dasharray="5 5">
      <path d="M572,350 V268" marker-end="url(#tp-block)" />
      <path d="M684,350 V268" marker-end="url(#tp-block)" />
      <path d="M796,350 V268" marker-end="url(#tp-block)" />
    </g>
    <rect x="524" y="354" width="96" height="34" rx="6" fill="var(--color-night-raised)" stroke="var(--color-night-line-strong)" stroke-width="1.2" />
    <text x="572" y="375" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">operator</text>
    <rect x="636" y="354" width="96" height="34" rx="6" fill="var(--color-night-raised)" stroke="var(--color-night-line-strong)" stroke-width="1.2" />
    <text x="684" y="375" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">provider</text>
    <rect x="748" y="354" width="96" height="34" rx="6" fill="var(--color-night-raised)" stroke="var(--color-night-line-strong)" stroke-width="1.2" />
    <text x="796" y="375" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">foundation</text>
    <text x="684" y="414" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="0.8" fill="#ffd064">NO INSPECTION PATH INTO THE ENCLAVE — FOR ANYONE</text>
  </g>

  <!-- ============ results out ============ -->
  <path class="dash-march" d="M500,228 C432,252 356,300 288,390" stroke="var(--color-green)" stroke-width="1.6" marker-end="url(#tp-arrow)" />
  <text x="404" y="310" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-night-faint)">results out</text>
  <g>
    <rect x="32" y="340" width="248" height="104" rx="9" fill="var(--color-night-raised)" stroke="var(--color-green)" stroke-opacity="0.7" stroke-width="1.5" />
    <text x="48" y="368" font-family="var(--font-sans)" font-size="13.5" font-weight="600" fill="var(--color-night-text)">Only results leave</text>
    <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">
      <text x="48" y="392">trust score · pass / fail —</text>
      <text x="48" y="408">written to chain state,</text>
      <text x="48" y="426" fill="var(--color-green-bright)">never raw biometric data</text>
    </g>
  </g>

  <text x="440" y="506" text-anchor="middle" font-family="var(--font-sans)" font-size="11.5" fill="var(--color-night-muted)">Attestation proves the exact measured code is running before any data is released to it — trust is verified, not assumed.</text>
</svg>
