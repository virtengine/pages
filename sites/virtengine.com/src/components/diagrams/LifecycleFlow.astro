---
/**
 * Marketplace lifecycle: order → bid → lease → usage → settlement.
 * Decorative inside DiagramFrame — the frame carries the aria-label.
 */
const stages = [
  { x: 10, name: "order", note: "tenant posts\ndeployment" },
  { x: 138, name: "bid", note: "providers\ncompete" },
  { x: 266, name: "lease", note: "escrow funded,\nworkload starts" },
  { x: 394, name: "usage", note: "signed usage\nrecords" },
  { x: 522, name: "settlement", note: "escrow released\nafter dispute window" },
];
---

<svg viewBox="0 0 640 215" class="diagram-svg h-auto w-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <marker id="lc-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 L8 4 L0 8 Z" fill="var(--color-teal)"></path>
    </marker>
  </defs>

  {
    stages.map((s, i) => (
      <g transform={`translate(${s.x},46)`}>
        <rect
          width="108"
          height="56"
          rx="10"
          fill={i === 2 ? "var(--color-teal-dim)" : "var(--color-panel-raised)"}
          stroke={i === 2 ? "var(--color-teal)" : "var(--color-hairline-strong)"}
          stroke-width="1.3"
        />
        <text x="54" y="24" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-teal-bright)">
          {String(i + 1).padStart(2, "0")}
        </text>
        <text x="54" y="42" text-anchor="middle" font-family="var(--font-display)" font-weight="600" font-size="14" fill="var(--color-text)">
          {s.name}
        </text>
        {s.note.split("\n").map((line, j) => (
          <text x="54" y={126 - 46 + j * 14} text-anchor="middle" font-family="var(--font-sans)" font-size="10" fill="var(--color-text-muted)">
            {line}
          </text>
        ))}
        {i < stages.length - 1 && (
          <path class="flow-dash" d={`M112 28 H 124`} stroke="var(--color-teal)" stroke-width="1.6" marker-end="url(#lc-arrow)" style={`animation-delay:-${i * 0.3}s`} />
        )}
      </g>
    ))
  }

  <!-- escrow return path -->
  <path
    class="flow-dash"
    d="M576 106 V 180 H 64 V 110"
    stroke="var(--color-teal)"
    stroke-width="1.3"
    opacity="0.5"
    marker-end="url(#lc-arrow)"
    style="animation-delay:-1.2s"
  ></path>
  <text x="320" y="200" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">
    agreed payment to provider &#183; 0% marketplace commission &#183; remaining escrow back to tenant
  </text>
</svg>
