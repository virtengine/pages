---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import { SITE } from "@data/site";
---

<Base
  title="DET.io updates | det.io"
  description="Receive occasional updates on DET.io research programs, releases and collaboration opportunities."
  path="/launch"
>
  <PageHero
    eyebrow="Updates"
    title="Stay close to the work"
    lede="Get occasional updates on research, releases and opportunities to work with the DET.io Foundation."
  />
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl rounded-frame border border-hairline bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold">Join the update list</h2>
      <p class="prose-inst mt-3">We send considered updates, not a newsletter every week. You can unsubscribe at any time.</p>
      <form id="launch-signup" class="mt-7" novalidate>
        <label for="launch-email" class="font-display font-semibold text-ink">Email address</label>
        <input id="launch-email" name="email" type="email" autocomplete="email" required class="mt-2 block w-full rounded-md border border-hairline-strong bg-paper px-4 py-3 text-ink" />
        <label class="mt-4 flex gap-3 text-sm text-text-muted">
          <input id="launch-consent" type="checkbox" required class="mt-1" />
          <span>I agree to receive updates from {SITE.legalName}. I can unsubscribe at any time.</span>
        </label>
        <div class="cf-turnstile mt-5" data-sitekey="0x4AAAAAAEGUAPwEOuNz9V6u" data-action="launch_signup"></div>
        <button type="submit" class="mt-5 rounded-md bg-blue-deep px-5 py-2.5 font-display text-sm font-semibold text-white transition-colors hover:bg-blue-mid">Join the update list</button>
        <p id="launch-form-note" class="mt-3 text-sm text-text-muted" aria-live="polite">Your email is securely added to the update list.</p>
      </form>
    </div>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.querySelector<HTMLFormElement>("#launch-signup");
    const email = document.querySelector<HTMLInputElement>("#launch-email");
    const consent = document.querySelector<HTMLInputElement>("#launch-consent");
    const note = document.querySelector<HTMLElement>("#launch-form-note");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!email?.checkValidity() || !consent?.checked) { note!.textContent = "Enter a valid email address and confirm that you agree to receive updates."; return; }
      const token = document.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value;
      if (!token) { note!.textContent = "Complete the security check before joining the list."; return; }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submit!.disabled = true; note!.textContent = "Adding you to the list…";
      try {
        const response = await fetch("https://foundation-forms-api.jonathan-f0b.workers.dev/v1/launch-signups", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email.value, consent: true, turnstileToken: token }) });
        if (!response.ok) throw new Error("Signup failed");
        form.reset(); note!.textContent = "You’re on the update list. Thank you.";
      } catch { note!.textContent = "We could not add you right now. Please try again shortly."; }
      finally { submit!.disabled = false; window.turnstile?.reset(); }
    });
  </script>
</Base>
