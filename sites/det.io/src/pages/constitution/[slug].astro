---
import Base from "@layouts/Base.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import PageHero from "@components/PageHero.astro";
import ClauseRef from "@components/ClauseRef.astro";
import CTA from "@components/CTA.astro";
import { CONSTITUTION_TOPICS, getConstitutionTopic } from "@data/constitution";

export function getStaticPaths() {
  return CONSTITUTION_TOPICS.map((topic) => ({ params: { slug: topic.slug } }));
}

const { slug } = Astro.params;
const topic = getConstitutionTopic(slug!)!;
const index = CONSTITUTION_TOPICS.findIndex((t) => t.slug === topic.slug);
const prev = CONSTITUTION_TOPICS[index - 1];
const next = CONSTITUTION_TOPICS[index + 1];
const relatedTopics = topic.related
  .map((s) => getConstitutionTopic(s))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Constitution", href: "/constitution" },
  { name: topic.title, href: `/constitution/${topic.slug}` },
];
---

<Base
  title={`${topic.title} — DETIO constitution explained | det.io`}
  description={topic.summary}
  path={`/constitution/${topic.slug}`}
  breadcrumbs={breadcrumbs}
  ogType="article"
>
  <Breadcrumbs crumbs={breadcrumbs} />
  <PageHero eyebrow={`Constitution · ${topic.source}`} title={topic.title} lede={topic.question}>
    <p class="prose-inst max-w-3xl text-[1.02rem]">{topic.summary}</p>
  </PageHero>

  <div class="container-site grid gap-12 py-14 lg:grid-cols-[1fr_18rem] md:py-20">
    <article class="grid content-start gap-12">
      {
        topic.sections.map((section, i) => (
          <section class="rule-double reveal grid gap-4 pt-6">
            <p class="eyebrow">
              <span class="mr-3 text-text-soft">{String(i + 1).padStart(2, "0")}</span>
              {topic.title}
            </p>
            <h2 class="text-2xl font-bold md:text-3xl">{section.heading}</h2>
            <p class="flex flex-wrap gap-1.5">
              {section.clauses.map((c) => (
                <ClauseRef id={c} />
              ))}
            </p>
            {section.body.map((paragraph) => (
              <p class="prose-inst max-w-3xl">{paragraph}</p>
            ))}
          </section>
        ))
      }

      <aside class="reveal rounded-frame border-l-4 border-sky bg-sky-wash p-6 md:p-8">
        <p class="font-mono text-xs font-medium tracking-[0.18em] text-blue-deep uppercase">Why this matters</p>
        <p class="prose-inst mt-3 max-w-3xl text-[1.02rem]">{topic.whyItMatters}</p>
      </aside>

      <nav aria-label="Constitution topics" class="flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-6">
        {
          prev ? (
            <a href={`/constitution/${prev.slug}`} class="group inline-flex items-center gap-2 font-display text-sm font-semibold text-blue-deep">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 8H3M7 4L3 8l4 4" />
              </svg>
              <span class="underline decoration-hairline-strong underline-offset-4 group-hover:decoration-blue-deep">{prev.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/constitution/${next.slug}`} class="group inline-flex items-center gap-2 text-right font-display text-sm font-semibold text-blue-deep">
              <span class="underline decoration-hairline-strong underline-offset-4 group-hover:decoration-blue-deep">{next.title}</span>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="grid content-start gap-6">
      <div class="rounded-card border border-hairline bg-surface p-5">
        <h2 class="font-mono text-xs font-medium tracking-[0.18em] text-text-soft uppercase">Related topics</h2>
        <ul class="mt-4 grid gap-3">
          {
            relatedTopics.map((related) => (
              <li>
                <a href={`/constitution/${related.slug}`} class="font-display text-sm font-semibold text-blue-deep underline decoration-hairline-strong underline-offset-4 hover:decoration-blue-deep">
                  {related.title}
                </a>
                <p class="mt-1 text-xs leading-relaxed text-text-soft">{related.source}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-card border border-hairline bg-surface p-5">
        <h2 class="font-mono text-xs font-medium tracking-[0.18em] text-text-soft uppercase">About this explorer</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          Plain-language summary of the signed constitution of DETIO FOUNDATION LTD.
          Educational, not legal advice; the instrument prevails.
        </p>
        <div class="mt-4">
          <CTA href="/constitution" variant="ghost">All ten topics</CTA>
        </div>
      </div>
    </aside>
  </div>
</Base>
