---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import TeachingVisual from '@components/teaching/TeachingVisual.astro';
import ArchitectureRoles from '@components/architecture/ArchitectureRoles.astro';
import MaturityLadder from '@components/architecture/MaturityLadder.astro';
import CapabilityMatrix from '@components/architecture/CapabilityMatrix.astro';
import RelatedWork from '@components/architecture/RelatedWork.astro';
import { LEARNING_SOURCES } from '@data/learning';
import { ARCHITECTURE_REVIEWED, ARCHITECTURE_REVIEWED_ISO, CENTRAL_QUESTION } from '@data/architecture';
import { articleNode } from '@lib/schema';
const breadcrumbs=[{name:'Home',href:'/'},{name:'Research',href:'/research'},{name:'Human–machine symbiosis',href:'/research/human-machine-symbiosis'}];
const questions=[
  { title:'Integration → end-to-end accountability', question:'Can one task be carried from mandate to challenge with a record that answers every audit question, without exposing the person behind it?', test:'Run the end-to-end task on a test network with a prototype mandate. Attack each handoff: forged mandates, gate bypass, replayed attestation, settlement unlinked to its mandate, and a captured dispute route.', streams:['multi-agent-safety','confidential-computing','protocol-governance-design'], metric:'Audit questions answerable; handoffs where evidence breaks; time to detect.' },
  { title:'Identity → fair eligibility', question:'Can one person receive an eligible allocation without excessive disclosure or exclusion?', test:'Measure duplicate enrolments, false rejections, recovery abuse, credential coercion, and access barriers across populations.', streams:['decentralized-identity','privacy-preserving-verification'], metric:'False acceptance / rejection; recovery success; linkability.' },
  { title:'Compute → enforceable limits', question:'Can resource and privacy policies remain effective on independent hardware?', test:'Attempt sandbox escape, forged usage, compromised attestation, egress abuse, and requests above resource ceilings. Separate attestation from proof of computation correctness.', streams:['confidential-computing','multi-agent-safety'], metric:'Unauthorised executions; detection; legitimate-task blocking.' },
  { title:'Governance → human agency', question:'Can people meaningfully challenge decisions and resist capture as agents gain wealth or influence?', test:'Evaluate compromised keys, voting concentration, coercion, persuasive agents, captured clients, and inaccessible appeals. Distinguish Foundation, network, and DSEMA authority.', streams:['protocol-governance-design'], metric:'Effective challenge; recovery time; decision concentration.' },
  { title:'Performance → useful work', question:'Can reputation reward work people value without being gamed or entrenched?', test:'Challenge agents and evaluators with held-out tasks, correlated errors, collusion, reward hacking, and entry by new specialists.', streams:['incentive-mechanism-design','multi-agent-safety'], metric:'Held-out quality; correlated failure; newcomer access.' },
  { title:'Issuance → real access', question:'Does an identity-linked allocation retain useful purchasing capacity as machine productivity changes?', test:'Model price responses, VE/VCC conversion, useful service supply, allocation activity rules, and distribution across households. Compare identity issuance with wage income and other transfer designs under explicit assumptions.', streams:['incentive-mechanism-design'], metric:'Purchasable services per person; exclusion; concentration.' },
  { title:'Engineering → reliable evidence', question:'Which lessons from an operating agent workflow transfer to the wider research architecture?', test:'Use Bosun’s experimental engineering track to reproduce scope loss, review bypass, failed checks, and recovery errors. Publish versioned evidence before generalising to DSEMA.', streams:['multi-agent-safety','privacy-preserving-verification'], metric:'Accepted correct changes; recovery reliability; audit completeness.' },
];
const labels:Record<string,string>={'decentralized-identity':'Decentralized identity','privacy-preserving-verification':'Privacy-preserving verification','incentive-mechanism-design':'Incentive mechanisms','multi-agent-safety':'Multi-agent safety','confidential-computing':'Confidential computing','protocol-governance-design':'Protocol governance'};
const contents=[['question','The question'],['map','The parts'],['end-to-end','One task, end to end'],['maturity','What is established'],['combinations','What combining adds'],['permission','Permission'],['economics','The economic hypothesis'],['limits','Limits'],['research-agenda','Research agenda'],['related-work','Related work'],['evidence','Evidence']];
---
<Base title="Human–Machine Symbiosis: One Research Architecture | det.io" description="Can people stay in authority as AI gains autonomy? How DET.io's identity, agent, compute and governance research combine, what is built, and what must be tested." path="/research/human-machine-symbiosis" breadcrumbs={breadcrumbs} ogType="article" modifiedTime={ARCHITECTURE_REVIEWED_ISO} schema={[articleNode({canonical:'https://det.io/research/human-machine-symbiosis',title:'Human–machine symbiosis',description:'A research synthesis: one architecture for keeping human authority verifiable as machine systems gain autonomy.',section:'Research synthesis',type:'TechArticle'})]}>
  <div class="learning-page">
    <Breadcrumbs crumbs={breadcrumbs}/><PageHero eyebrow="Portfolio-wide research synthesis" title="Can people stay in authority as machines gain autonomy?" lede="Autonomous AI systems increasingly need three things: identity, resources, and permission to act. DET.io’s four programs propose one architecture for granting all three under verifiable human authority. Each part is published. The combined system is a hypothesis we are setting out to test."><p class="teach-kicker">Open hypothesis · Proposed designs and public source · Reviewed {ARCHITECTURE_REVIEWED}</p><p class="record-actions"><a class="btn-press" href="#end-to-end">Try one task, end to end</a><a href="#maturity">See what is established →</a></p>
      <nav aria-label="On this page"><ul class="on-this-page">{contents.map(([id,label])=><li><a href={`#${id}`}>{label}</a></li>)}</ul></nav>
    </PageHero>

    <section id="question" class="container-site record-section" aria-labelledby="question-title"><p class="folio">01 · The research question</p><h2 id="question-title">Not how people use AI. How people and AI share the rules.</h2>
      <p class="record-stand">{CENTRAL_QUESTION}</p>
      <div class="research-questions mt-8">
        <article><h3>A systems question, not an interface question.</h3><p>Most work on human–AI interaction asks how a person directs a model. This research asks something institutional: under what enforceable structures of identity, authority, resources, and accountability could autonomous systems operate alongside people?</p></article>
        <article><h3>Why the parts must be studied together.</h3><p>An identity system, a compute market, an agent architecture, and a governance process each solve a narrower problem. The guarantees this research cares about — an accountable mandate, an enforced limit, an auditable record, a route to challenge — depend on handoffs between them. They cannot be evaluated one component at a time.</p></article>
        <article><h3>Integration can be original even when parts are not.</h3><p>Many of the techniques used here have established precedents, which the <a href="#related-work">related-work section</a> credits. The contribution being tested is the binding: whether this combination produces guarantees that the separate techniques do not.</p></article>
        <article><h3>Neither side holds unchecked control.</h3><p>The architecture constrains machines through gates and containment. It also constrains whoever operates them, through open source, independent providers, public records, delayed amendment, and a Foundation that cannot privatise the work.</p></article>
      </div>
    </section>

    <section id="map" class="container-site record-section" aria-labelledby="map-title"><p class="folio">02 · Four parts, one architecture</p><h2 id="map-title">Each program answers a different part of the question.</h2>
      <p class="record-stand">Each part is useful on its own. Each also depends on the others for something it cannot provide itself.</p>
      <div class="mt-8"><ArchitectureRoles/></div>
      <p class="record-actions"><a href="/learn/connected-research">Explore the interactive dependency map →</a></p>
    </section>

    <section id="end-to-end" class="container-site record-section" aria-labelledby="e2e-title"><p class="folio">03 · The integration test</p><h2 id="e2e-title">One task, from mandate to challenge.</h2>
      <p class="record-stand">This is the test that would show the whole does something the parts cannot. Follow the task through six handoffs, then switch a part off and see which questions the record can no longer answer.</p>
      <div class="mt-8"><TeachingVisual kind="end-to-end"/></div>
      <p class="record-actions"><a href="/learn/end-to-end-accountability">Read the guide to this walkthrough →</a></p>
    </section>

    <section id="maturity" class="container-site record-section" aria-labelledby="maturity-title"><p class="folio">04 · What is established, and what is a hypothesis</p><h2 id="maturity-title">Every claim names the level it has reached.</h2>
      <p class="record-stand">Six levels of evidence, from weakest to strongest. The two dashed levels — integrated end to end and independently validated — have not been reached by any part of the architecture.</p>
      <div class="mt-8"><MaturityLadder/></div>
    </section>

    <section id="combinations" class="container-site record-section" aria-labelledby="combinations-title"><p class="folio">05 · What combining adds</p><h2 id="combinations-title">Six combinations, and what each would make possible.</h2>
      <p class="record-stand">If the architecture matters, it is because of combinations like these. Each row states why neither part is enough alone, where it stands today, and what evidence would move it forward.</p>
      <div class="mt-8"><CapabilityMatrix/></div>
    </section>

    <section id="permission" class="container-site record-section" aria-labelledby="permission-title"><p class="folio">06 · Control beyond economics</p><h2 id="permission-title">A useful task still needs permission.</h2>
      <p class="record-stand">Step two of the end-to-end task is where autonomy meets authority. In the proposed DSEMA design, an action must pass three independent gates, and passing one never substitutes for another.</p>
      <ol class="safety-gates safety-gates--static"><li><span class="gate-number">01</span><h3 class="text-lg font-semibold">Authority</h3><p>Is the action inside the mandate a person granted? Usefulness or profit does not create permission.</p></li><li><span class="gate-number">02</span><h3 class="text-lg font-semibold">Resource ceiling</h3><p>Is it within budget? Funding or reputation cannot raise the ceiling without the policy process.</p></li><li><span class="gate-number">03</span><h3 class="text-lg font-semibold">Containment</h3><p>Can it run only where it is watched? Enforcement must bind scheduling, credentials, and network access.</p></li></ol>
      <p class="record-actions"><a class="btn-press" href="/learn/agent-safety">Try the gates with four scenarios →</a><a href="/research/dsema">Read the DSEMA design</a></p>
    </section>

    <section id="economics" class="container-site record-section" aria-labelledby="economics-title"><p class="folio">07 · The economic hypothesis</p><h2 id="economics-title">If machines do more of the work, how do people keep a claim on it?</h2>
      <p class="record-stand">Authority is one half of the question. The other is economic: whether people remain beneficiaries of machine production when their labour becomes less scarce. The proposed issuance model connects eligibility to verified people. DSEMA’s agent-standing design connects reputation to recorded performance.</p>
      <div class="library-grid mt-8"><article class="guide-card"><h3>Human participation</h3><p>The proposed VirtEngine policy begins at zero supply, ties new issuance to verified human eligibility, and specifies a governed 14:1 human/Foundation allocation split. Activity requirements still apply; an allocation is not an unconditional or guaranteed living income.</p><a href={LEARNING_SOURCES.token.href}>Read the proposed issuance policy →</a></article><article class="guide-card"><h3>Machine participation</h3><p>DSEMA studies task performance as a basis for agent reputation and allocation. Its published design does not describe an equivalent issuance entitlement simply for creating an agent. That distinction does not prohibit funding from owners, reserves, or outside infrastructure.</p><a href={LEARNING_SOURCES.reputation.href}>Read the agent incentive research →</a></article></div>
      <p class="record-stand mt-8">The synthesis: eligible people could receive units, express demand, and purchase services; agents could fulfil valued tasks and acquire resources from providers. This could reduce dependence on wage competition. It does not yet establish lasting human control, adequate access, stable prices, or a self-sustaining equilibrium.</p>
    </section>
    <section class="container-site pb-14" aria-label="Trace the economic hypothesis"><h2 class="sr-only">The proposed economic loop</h2><TeachingVisual kind="economic-loop"/></section>
    <Section number="07a" eyebrow="Try the distinction" title="A monetary claim needs something to buy." lede="Change a condition in this deliberately simple model. The calculation exposes why issuance, price, and physical supply must be studied together."><TeachingVisual kind="economy"/></Section>
    <Section number="07b" eyebrow="Test the economic link" title="Follow net flows. Test who keeps control." lede="A possible human-rooted machine economy requires more than personhood verification or payment for compute. Compare the mechanisms that could sustain—or undo—the link."><TeachingVisual kind="coupling"/><p class="record-actions"><a href="/learn/economic-invariants">Read the guide to these conditions →</a></p></Section>
    <section id="implementation" class="container-site record-section" aria-labelledby="implementation-title"><p class="folio">07c · Implementation evidence · Reviewed 3 October 2026</p><h2 id="implementation-title">What the code establishes today.</h2><div class="research-questions mt-8"><article><h3>Conversion is still pending.</h3><p>The <a href={LEARNING_SOURCES.implementation.href}>BME message handlers</a> return pending records. They do not execute the proposed oracle-priced conversion or complete its collateral and circuit-breaker logic. The credit is now named VirtEngine Compute Credit (VCC / uvcc), separate from native VE / uve; a denomination rename does not implement redemption or stable value.</p></article><article><h3>Gross burning is not net consumption.</h3><p>The <a href={LEARNING_SOURCES.billing.href}>billing routine</a> transfers funds to the provider and can burn a settlement fee. The <a href={LEARNING_SOURCES.defaults.href}>default fee burn is zero</a>. Generic bank mint/burn helpers exist, but the checked paths do not establish permanent destruction of every service payment. Refunds and native reissuance would also have to enter the ledger.</p></article><article><h3>Control needs separate protection.</h3><p>Published policy reserves primary eligibility for people; it does not prove that people retain their keys, purchasing power, or future benefits. The <a href={LEARNING_SOURCES.capture.href}>Idena case study</a> motivates testing capture through genuine participants. Restrictions on selling or delegating future eligibility are possibilities to evaluate, including their inclusion and recovery costs.</p></article><article><h3>Institutional and monetary authority differ.</h3><p>The Foundation’s public-benefit protections constrain that institution. Stake-weighted network voting and <a href={LEARNING_SOURCES.policygovernance.href}>issuance-policy authority</a> have a separate scope. Human consent requirements, delay, review, and protected monetary invariants could be compared as safeguards; none is claimed here as an implemented guarantee.</p></article></div>
      <p class="record-stand mt-8">If machine production displaces much of wage income, people would need another route to claims on useful output. Personhood-rooted primary issuance could be one candidate. <a href={LEARNING_SOURCES.postlabour.href}>Research on work and income distribution</a> supplies a reason to study this scenario, not evidence that DET.io’s mechanism succeeds. Compare transfers, broad capital ownership, and resource-market mechanisms on purchasing capacity, inclusion, concentration, resource costs, and freedom to exit.</p>
    </section>

    <section id="limits" class="container-site record-section" aria-labelledby="limits-title"><p class="folio">08 · Scope and limits</p><h2 id="limits-title">What the architecture does not claim.</h2>
      <div class="research-questions mt-8"><article><h3>Outside systems remain outside.</h3><p>An agent with external financing, its own hardware, or accumulated reserves can operate without this architecture. The proposed controls constrain neither all AI nor all economic activity, only what runs through them.</p></article><article><h3>Scarcity and capture remain possible.</h3><p>Compute, energy, housing, and other real resources remain scarce. Concentrated providers, token holdings, coercion, or inaccessible identity checks could undermine broad benefit even if every rule works exactly as designed.</p></article><article><h3>Three different governance layers.</h3><p>The Foundation’s signed constitution binds institutional stewardship. Network consensus governs protocol parameters. DSEMA’s constitutional controls are a proposed agent architecture. They have different authority and enforcement; none establishes universal AI safety.</p></article><article><h3>Economic dependence is not alignment.</h3><p>Automation can displace tasks and also create or complement work. <a href={LEARNING_SOURCES.tasks.href}>Task-based labour research</a> and <a href={LEARNING_SOURCES.work.href}>IMF AI research</a> motivate testing distribution under changing labour demand; they do not show that human labour will disappear. An agent that depends on people for income is not thereby safe.</p></article></div>
    </section>

    <section id="research-agenda" class="container-site record-section" aria-labelledby="agenda-title"><p class="folio">09 · A testable research agenda</p><h2 id="agenda-title">Seven questions. One shared objective.</h2><p class="record-stand">The objective is durable human agency and access to useful production. The first question tests the whole architecture; the rest test its handoffs. These are proposed investigations, with no new empirical results claimed.</p><div class="research-questions mt-8">{questions.map((q,i)=><article><span class="teach-kicker">0{i+1} / Research question</span><h3>{q.title}</h3><p><strong>{q.question}</strong></p><p>{q.test}</p><p class="teach-kicker">Measure: {q.metric}</p><p>{q.streams.map((s,j)=><Fragment>{j>0?' · ':''}<a href={`/research/${s}`}>{labels[s]}</a></Fragment>)}</p></article>)}</div>
      <p class="record-actions"><a class="btn-press" href="/contact">Collaborate on a question</a><a href="/research/nist-ai-rmf">See how the agenda maps to the NIST AI RMF →</a></p>
    </section>

    <section id="related-work" class="container-site record-section" aria-labelledby="related-title"><p class="folio">10 · Related work</p><h2 id="related-title">Others are working on parts of this. Here is how the proposal differs.</h2>
      <p class="record-stand">Novelty is not assumed. Each entry credits the existing work, states how the DET.io proposal differs, and says what DET.io has not yet shown.</p>
      <div class="mt-8"><RelatedWork/></div>
    </section>

    <section id="evidence" class="container-site record-section" aria-labelledby="evidence-title"><p class="folio">11 · Evidence and interpretation</p><h2 id="evidence-title">What supports the synthesis?</h2><ul class="evidence-register mt-8">{Object.entries(LEARNING_SOURCES).map(([key,s])=><li><a href={s.href}>{s.label}</a><small>{['tasks','work','person','capture','postlabour'].includes(key)?'External primary research: context and challenges; not validation of DET.io’s combined mechanism.':['implementation','billing','defaults'].includes(key)?'Repository implementation evidence: reviewed source paths, with pending integration and defaults distinguished from completed execution.':key==='safety'||key==='reputation'?'Published DET.io research account: proposed architecture with specification references; not proof of operational enforcement.':key==='bosun'?'Public software artifacts: experimental implementation, distinct from full DSEMA.':key==='governance'?'Institutional instrument: Foundation responsibilities, distinct from network or agent control.':'Published protocol documentation: proposed policy or design, not live availability.'}</small></li>)}</ul><p class="record-stand mt-8">The integrated-architecture, symbiosis, and post-labour interpretations on this page are DET.io research framing derived from these separate materials. Integration, adversarial testing, and independent evaluation remain necessary before stronger claims are made.</p><p class="record-actions"><a class="btn-press" href="/learn">Learn through the interactive guides →</a><a href="/contact">Discuss a defined research question</a></p></section>
  </div>
</Base>
