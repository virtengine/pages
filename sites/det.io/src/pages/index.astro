---
import Base from "@layouts/Base.astro";
import RegisterMark from "@components/brand/RegisterMark.astro";
import HeroLattice from "@components/diagrams/HeroLattice.astro";
import ProgramVirtArt from "@components/diagrams/ProgramVirtArt.astro";
import ProgramDsemaArt from "@components/diagrams/ProgramDsemaArt.astro";
import ProgramBosunArt from "@components/diagrams/ProgramBosunArt.astro";
import ProgramIdentityArt from "@components/diagrams/ProgramIdentityArt.astro";
import { PURPOSES, SITE } from "@data/site";

const programs = [
  {
    name: "VirtEngine",
    plate: "01",
    area: "Open infrastructure",
    status: "In development",
    href: "/research/virtengine",
    cta: "Study the protocol",
    body: "An open cloud marketplace protocol. Study how resource requests, provider bids, identity, and payments fit together.",
    src: "research/virtengine",
    art: ProgramVirtArt,
  },
  {
    name: "DSEMA",
    plate: "02",
    area: "Accountable AI",
    status: "Research architecture",
    href: "/research/dsema",
    cta: "Read the open questions",
    body: "Research into multi-agent AI that can evolve under verifiable controls. Explore the design questions around oversight and safety.",
    src: "research/dsema",
    art: ProgramDsemaArt,
  },
  {
    name: "Bosun",
    plate: "03",
    area: "Open-source engineering",
    status: "Experimental software",
    href: "/research/bosun",
    cta: "Inspect the source",
    body: "An open-source orchestrator for AI coding agents. Examine how work is coordinated, reviewed, and recovered under human supervision.",
    src: "research/bosun",
    art: ProgramBosunArt,
  },
  {
    name: "Identity & VEID",
    plate: "04",
    area: "Privacy and digital rights",
    status: "Protocol research",
    href: "/research/identity",
    cta: "Explore encrypted identity",
    body: "Verifiable identity with less disclosure. Explore encrypted verification, consent, and how services could use proofs of attributes.",
    src: "research/identity",
    art: ProgramIdentityArt,
  },
];

const waysIn = [
  { tag: "For learners", title: "Understand an idea.", body: "Follow a guide, explore a research question, and inspect its evidence.", href: "/participate#learn" },
  { tag: "For developers", title: "Make something better.", body: "Improve a guide, report a reproducible issue, or contribute code.", href: "/participate#contribute" },
  { tag: "For collaborators", title: "Bring a useful question.", body: "Discuss research that connects technical work to a public need.", href: "/participate#collaborate" },
];
---

<Base
  title="DET.io: Australian Open Tech Research Nonprofit"
  description="DETIO FOUNDATION LTD (ACN 699 651 771): Australian nonprofit researching decentralized cloud, AI safety and privacy. Open-source software for public benefit."
  path="/"
>
  <section class="record-mast" aria-labelledby="record-title">
    <div class="container-site record-mast-inner">
      <div>
        <p class="folio">
          <RegisterMark />
          <span>№ 001 · DET.IO · FIELD RECORD</span>
        </p>
        <span class="record-rule" aria-hidden="true"></span>
        <h1 id="record-title">Technology for a more open future.</h1>
        <p class="record-lede">
          Our mission is to advance education, protect digital rights, and improve access to secure, resilient digital infrastructure.
        </p>
        <p class="record-copy">
          DETIO FOUNDATION LTD develops open research, software, and learning resources in distributed computing, privacy, and accountable AI. For people who want to understand, question, and improve technology.
        </p>
        <div class="record-actions">
          <a class="btn-press" href="/activities">See the work</a>
          <a class="record-link" href="/mission">Why we exist</a>
        </div>
      </div>
      <aside class="evidence-col" aria-label="Record evidence">
        <dl class="evidence-list">
          <div>
            <dt>Entity</dt>
            <dd>Public company limited by guarantee</dd>
          </div>
          <div>
            <dt>ACN</dt>
            <dd>{SITE.acn}</dd>
          </div>
          <div>
            <dt>Clause</dt>
            <dd><a href="/mission">cl 6.1</a></dd>
          </div>
          <div>
            <dt>Patent</dt>
            <dd><a href={SITE.patentVeUrl}>{SITE.patentVe}</a></dd>
          </div>
        </dl>
        <figure class="plate">
          <p class="plate-kicker"><span>Plate 01</span><span>Field record</span></p>
          <div class="plate-art" aria-hidden="true"><HeroLattice /></div>
          <figcaption><span>Four connected programs</span><span>src: research/index</span></figcaption>
        </figure>
      </aside>
    </div>
  </section>

  <section class="container-site record-section" aria-labelledby="f-what">
    <p class="folio"><RegisterMark /><span>File 01 · What we do</span></p>
    <h2 id="f-what">Ideas become useful when people can examine them.</h2>
    <p class="record-stand">
      We connect technical research with public resources. Learners can study the ideas, developers can inspect the software, and researchers can challenge the design.
    </p>
    <div class="record-columns">
      <article>
        <p class="folio">01 · Learn</p>
        <h3>Publish open knowledge</h3>
        <p>Guides, specifications, and technical explanations make infrastructure and AI research easier to understand and evaluate.</p>
        <a href="/activities#education">Start learning</a>
      </article>
      <article>
        <p class="folio">02 · Build</p>
        <h3>Develop in the open</h3>
        <p>Open-source software makes the implementation available for review, reuse, and improvement by other developers.</p>
        <a href="/activities#software">Browse the work</a>
      </article>
      <article>
        <p class="folio">03 · Question</p>
        <h3>Research trust and safety</h3>
        <p>We examine privacy, verification, governance, and human oversight through published designs and experimental tools.</p>
        <a href="/activities#safety">Read the questions</a>
      </article>
    </div>
  </section>

  <section class="container-site record-section" aria-labelledby="f-programs">
    <p class="folio"><RegisterMark /><span>File 02 · Programs</span></p>
    <h2 id="f-programs">Four ways to work towards that purpose.</h2>
    <p class="record-stand"><a class="record-link" href="/research">All research topics</a></p>
    <div class="program-explorer" data-program-tabs>
      <div class="program-tabs" role="tablist" aria-label="Research programs">
        {programs.map((p, i) => (
          <button
            class="program-tab"
            id={`program-tab-${p.plate}`}
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`program-panel-${p.plate}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="program-tab-index">{p.plate}</span>
            <span class="program-tab-name" data-preserve-acronym>{p.name}</span>
            <span class="program-tab-arrow" aria-hidden="true">↗</span>
          </button>
        ))}
      </div>
      {programs.map((p, i) => {
        const Art = p.art;
        return (
          <section
            class="program-panel plate"
            id={`program-panel-${p.plate}`}
            role="tabpanel"
            aria-labelledby={`program-tab-${p.plate}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div class="program-panel-top plate-kicker"><span>Plate {p.plate} · {p.area}</span><span>{p.status}</span></div>
            <div class="program-panel-main">
              <figure class="program-figure" aria-label={`${p.name} research diagram`}>
                <div class="plate-art"><Art /></div>
                <figcaption>FIG {p.plate} <span aria-hidden="true">/</span> {p.area}</figcaption>
              </figure>
              <div class="program-copy">
                <p class="program-meta"><span>PROGRAM {p.plate}</span><span class="program-status">{p.status}</span></p>
                <h3 data-preserve-acronym>{p.name}</h3>
                <p class="program-description">{p.body}</p>
                <a class="program-action" href={p.href}>{p.cta}<span aria-hidden="true">↗</span></a>
                <p class="program-source">Open materials <span>·</span> {p.src}</p>
              </div>
            </div>
          </section>
        );
      })}
    </div>
    <p class="status-note">Status: in development. Open materials are available today. Research goals are not claims of deployed services or measured impact.</p>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>("[data-program-tabs]").forEach((explorer) => {
      const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[role='tab']"));
      const panels = Array.from(explorer.querySelectorAll<HTMLElement>("[role='tabpanel']"));
      const activate = (index: number, moveFocus = false) => {
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[i].hidden = !selected;
        });
        if (moveFocus) tabs[index].focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(next, true);
        });
      });
    });
  </script>

  <section class="night-band" aria-labelledby="f-charter">
    <div class="container-site record-section">
      <p class="folio">File 03 · Constitution</p>
      <h2 id="f-charter">Four purposes, written into the constitution.</h2>
      <p class="record-stand" style="color:var(--color-night-muted)">
        Every program must advance at least one of these purposes. The wording below is condensed from the signed instrument.
      </p>
      <ol class="charter-list">
        {
          PURPOSES.map((p) => (
            <li>
              <a href="/mission">
                <span>cl {p.clause}</span>
                <strong>{p.name}</strong>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-site record-section" aria-labelledby="f-code">
    <p class="folio"><RegisterMark /><span>File 04 · Source</span></p>
    <h2 id="f-code">Clone it. Read it. Challenge it.</h2>
    <p class="record-stand">
      Everything we publish is inspectable. Start from the repositories. The protocol, the agent orchestrator, and the documentation are public.
    </p>
    <figure class="plate" style="margin-top:1.5rem">
      <p class="plate-kicker"><span>Plate 05</span><span>Public repositories</span></p>
      <pre class="program-copy" style="margin:0;font-family:var(--font-mono);font-size:0.82rem;line-height:1.7;overflow-x:auto"><code>git clone {SITE.github}.git
git clone {SITE.bosunGithub}.git</code></pre>
      <figcaption>
        <span>VirtEngine · Bosun</span>
        <span>
          <a href={SITE.github}>VirtEngine</a>
          · <a href={SITE.bosunGithub}>Bosun</a>
          · <a href="https://docs.virtengine.com">Docs</a>
        </span>
      </figcaption>
    </figure>
  </section>

  <section class="container-site record-section" aria-labelledby="f-way">
    <p class="folio"><RegisterMark /><span>File 05 · Participation</span></p>
    <h2 id="f-way">Start with what you want to do.</h2>
    <p class="record-stand">You can read our resources and contribute to open-source work without becoming a member of the Foundation.</p>
    <ol class="contents">
      {
        waysIn.map((w) => (
          <li>
            <a href={w.href}>
              <span>{w.tag}</span>
              <span><strong>{w.title}</strong><em>{w.body}</em></span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="record-stand">
      <a class="record-link" href="/foundation/who-we-are">Meet the Foundation</a>
      · <a class="record-link" href="/governance">How decisions are made</a>
      · <a class="record-link" href="/constitution">Read the constitution</a>
      · <a class="record-link" href="/transparency">Check the public record</a>
    </p>
  </section>

  <section class="container-site record-section" aria-labelledby="f-close">
    <p class="folio">Contact</p>
    <h2 id="f-close">Good research starts with a clear question.</h2>
    <p class="record-stand">Tell us what you are investigating and who it could help.</p>
    <p class="record-actions"><a class="btn-press" href="/contact">Contact the Foundation</a></p>
    <p class="colophon">
      Colophon. Type: Instrument Serif, Archivo, IBM Plex Mono. Stock #f1efe9, ink #14171c, spot #1a6f97.
      Annotation red is status only. Sources: constitution cl 6.1, ACN {SITE.acn}, patent {SITE.patentVe}.
      Reviewed 2026-09-25.
    </p>
  </section>
</Base>
