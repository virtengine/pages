---
import Base from "@layouts/Base.astro";
import HeroLattice from "@components/diagrams/HeroLattice.astro";
import ProgramVirtArt from "@components/diagrams/ProgramVirtArt.astro";
import ProgramDsemaArt from "@components/diagrams/ProgramDsemaArt.astro";
import ProgramBosunArt from "@components/diagrams/ProgramBosunArt.astro";
import ProgramIdentityArt from "@components/diagrams/ProgramIdentityArt.astro";
import Ticker from "@components/Ticker.astro";
import { PURPOSES, SITE } from "@data/site";

const programs = [
  { name: "VirtEngine", area: "Open infrastructure", status: "In development", href: "/research/virtengine", cta: "Study the protocol →", body: "An open cloud marketplace protocol. Study how resource requests, provider bids, identity, and payments fit together.", art: ProgramVirtArt },
  { name: "DSEMA", area: "Accountable AI", status: "Research architecture", href: "/research/dsema", cta: "Read the open questions →", body: "Research into multi-agent AI that can evolve under verifiable controls. Explore the design questions around oversight and safety.", art: ProgramDsemaArt },
  { name: "Bosun", area: "Open-source engineering", status: "Experimental software", href: "/research/bosun", cta: "Inspect the source →", body: "An open-source orchestrator for AI coding agents. Examine how work is coordinated, reviewed, and recovered under human supervision.", art: ProgramBosunArt },
  { name: "Identity & VEID", area: "Privacy & digital rights", status: "Protocol research", href: "/research/identity", cta: "Explore encrypted identity →", body: "Verifiable identity with less disclosure. Explore encrypted verification, consent, and how services could use proofs of attributes.", art: ProgramIdentityArt },
];

const waysIn = [
  { tag: "For learners", title: "Understand an idea.", body: "Follow a guide, explore a research question, and inspect its evidence.", starts: "Guides · Research questions · Evidence trails", href: "/participate#learn" },
  { tag: "For developers", title: "Make something better.", body: "Improve a guide, report a reproducible issue, or contribute code.", starts: "Source code · Documentation · Reproducible issues", href: "/participate#contribute" },
  { tag: "For collaborators", title: "Bring a useful question.", body: "Discuss research that connects technical work to a public need.", starts: "A defined question · A public-benefit aim", href: "/participate#collaborate" },
];
---
<Base title="DET.io: Australian Open Tech Research Nonprofit" description="DETIO FOUNDATION LTD (ACN 699 651 771): Australian nonprofit researching decentralized cloud, AI safety and privacy. Open-source software for public benefit." path="/">
  <section class="f-hero grain-host">
    <p class="f-ghost" aria-hidden="true">Field record · № 001</p>
    <div class="container-site f-hero-grid">
      <div>
        <p class="f-kicker"><i aria-hidden="true"></i> Australian not-for-profit · Open research</p>
        <h1>Technology for a more <em>open</em> <span class="outline">future.</span></h1>
        <p class="f-lede">Our mission is to advance education, protect digital rights, and improve access to secure, resilient digital infrastructure.</p>
        <p class="f-copy">DETIO FOUNDATION LTD develops open research, software, and learning resources in distributed computing, privacy, and accountable AI — for people who want to understand, question, and improve technology.</p>
        <div class="f-actions">
          <a class="btn-hard" href="/activities">See the work <span aria-hidden="true">↗</span></a>
          <a class="f-link" href="/mission">Why we exist →</a>
          <span class="stamp">Public benefit · Locked</span>
        </div>
        <p class="f-reg">Public company limited by guarantee · ACN {SITE.acn}</p>
      </div>
      <figure class="f-plate">
        <div class="f-plate-head"><span>Field plate 01</span><span>Four connected programs</span></div>
        <div class="f-plate-art" aria-hidden="true"><HeroLattice /></div>
        <div class="f-perforation" aria-hidden="true"></div>
        <figcaption class="f-plate-foot"><span>Open knowledge · Accountable systems</span><a href="/research">Research portfolio →</a></figcaption>
      </figure>
    </div>
  </section>

  <Ticker
    items={["Open research", "Open software", "Public benefit", "Education", "Privacy & digital rights", "Infrastructure resilience", "Technology safety"]}
    label="What the Foundation works on"
  />

  <section class="container-site f-section" aria-labelledby="f-what">
    <div class="f-sec-head">
      <div>
        <p class="f-index">File 01 / What we do</p>
        <h2 id="f-what">Ideas become useful when people can examine them.</h2>
      </div>
      <p>We connect technical research with public resources. Learners can study the ideas, developers can inspect the software, and researchers can challenge the design.</p>
    </div>
    <div class="f-columns">
      <article>
        <p class="bignum" aria-hidden="true">01</p>
        <p class="f-index">Learn</p>
        <h3>Publish open knowledge</h3>
        <p>Guides, specifications, and technical explanations make infrastructure and AI research easier to understand and evaluate.</p>
        <a href="/activities#education">Start learning →</a>
      </article>
      <article>
        <p class="bignum" aria-hidden="true">02</p>
        <p class="f-index">Build</p>
        <h3>Develop in the open</h3>
        <p>Open-source software makes the implementation available for review, reuse, and improvement by other developers.</p>
        <a href="/activities#software">Browse the work →</a>
      </article>
      <article>
        <p class="bignum" aria-hidden="true">03</p>
        <p class="f-index">Question</p>
        <h3>Research trust &amp; safety</h3>
        <p>We examine privacy, verification, governance, and human oversight through published designs and experimental tools.</p>
        <a href="/activities#safety">Read the questions →</a>
      </article>
    </div>
  </section>

  <section class="container-site f-section" aria-labelledby="f-programs">
    <div class="f-sec-head">
      <div>
        <p class="f-index">File 02 / Our programs</p>
        <h2 id="f-programs">Four ways to work towards that purpose.</h2>
      </div>
      <p><a class="f-link" href="/research">Explore all research topics ↗</a></p>
    </div>
    <div class="f-files">
      {programs.map((p, i) => {
        const Art = p.art;
        return (
          <article class="f-file">
            <div class="f-file-visual" aria-hidden="true">
              <Art />
            </div>
            <div class="f-file-body">
              <p class="f-index">0{i + 1} / Program file</p>
              <p style="margin-top:0.7rem"><span class="f-tag">{p.area}</span><span class="f-status">{p.status}</span></p>
              <h3><a href={p.href}>{p.name}<span aria-hidden="true">↗</span></a></h3>
              <p>{p.body}</p>
              <p style="margin-top:1rem"><a class="f-link" href={p.href}>{p.cta}</a></p>
            </div>
          </article>
        );
      })}
    </div>
    <p class="f-note">Open materials are available today. Research goals are not claims of deployed services or measured impact. <a href="/activities#progress">Read the current status of our work.</a></p>
  </section>

  <section class="charter-band" aria-labelledby="f-charter">
    <div class="container-site charter-grid">
      <div>
        <p class="f-index">The charter behind the work</p>
        <h2 id="f-charter">Four purposes, written into the constitution.</h2>
        <p>Every program must advance at least one of these purposes <span class="clause-chip">cl 6.1</span>. The wording below is condensed from the signed instrument.</p>
      </div>
      <ol>
        {PURPOSES.map((p) => (
          <li>
            <a href="/mission">
              <span class="clause-chip">{p.clause}</span>
              <strong>{p.name}</strong>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="f-terminal-band" aria-labelledby="f-code">
    <div class="halftone" aria-hidden="true"></div>
    <div class="container-site f-terminal-grid">
      <div>
        <p class="f-index">Field kit / Take the work with you</p>
        <h2 id="f-code">Clone it. Read it. Challenge it.</h2>
        <p>Everything we publish is inspectable. Start from the repositories — the protocol, the agent orchestrator, and the documentation are all public.</p>
        <div class="term-links">
          <a href={SITE.github}>VirtEngine source ↗</a>
          <a href={SITE.bosunGithub}>Bosun source ↗</a>
          <a href="https://docs.virtengine.com" target="_blank" rel="noopener noreferrer">Technical docs ↗</a>
        </div>
      </div>
      <div class="term" role="region" aria-label="Repository clone commands">
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span style="margin-left:.4rem">detio — field terminal</span></div>
        <pre><code><span class="c"># the open infrastructure protocol</span>
<span class="p">$</span> git clone {SITE.github}.git

<span class="c"># the open-source agent orchestrator</span>
<span class="p">$</span> git clone {SITE.bosunGithub}.git</code></pre>
      </div>
    </div>
  </section>

  <section class="container-site f-section" aria-labelledby="f-foundation">
    <div class="f-gov grain-host">
      <div style="position:relative;z-index:2">
        <p class="f-index">File 03 / The Foundation</p>
        <h2 id="f-foundation">A public purpose. A framework for accountability.</h2>
        <p>Our constitution defines how the Foundation can use its resources, make decisions, and protect its public-benefit purposes. Explore those rules and the evidence available today.</p>
        <a class="btn-hard" href="/foundation/who-we-are">Meet the Foundation ↗</a>
      </div>
      <div class="f-paths" style="position:relative;z-index:2">
        <a href="/governance"><span>01</span><div><h3>How decisions are made</h3><p>Board responsibilities, membership, and consent requirements.</p></div><b aria-hidden="true">↗</b></a>
        <a href="/constitution"><span>02</span><div><h3>Read the constitution</h3><p>Ten plain-language topics with references to the underlying clauses.</p></div><b aria-hidden="true">↗</b></a>
        <a href="/transparency"><span>03</span><div><h3>Check our public record</h3><p>Published resources, funding disclosures, and reporting status.</p></div><b aria-hidden="true">↗</b></a>
      </div>
    </div>
  </section>

  <section class="container-site f-section" aria-labelledby="f-way">
    <div class="f-sec-head">
      <div>
        <p class="f-index">File 04 / Find your way in</p>
        <h2 id="f-way">Start with what you want to do.</h2>
      </div>
      <p>You can read our resources and contribute to open-source work without becoming a member of the Foundation.</p>
    </div>
    <div class="f-stubs">
      {waysIn.map((w) => (
        <a class="f-stub" href={w.href}>
          <span class="f-stub-top"><span>{w.tag}</span></span>
          <span class="f-stub-body" style="display:block"><h3>{w.title}</h3><p>{w.body}</p><p class="f-stub-starts">{w.starts}</p></span>
          <span class="f-stub-foot" aria-hidden="true">✦ →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-site" aria-labelledby="f-close">
    <div class="f-closing grain-host">
      <div style="position:relative;z-index:2">
        <p class="f-index">Let’s make the work useful</p>
        <h2 id="f-close">Good research starts with a clear question.</h2>
        <p>Tell us what you are investigating and who it could help.</p>
      </div>
      <a class="btn-hard btn-hard--ink" href="/contact" style="position:relative;z-index:2">Contact the Foundation ↗</a>
    </div>
  </section>

  <div style="margin-top:clamp(3rem,6vw,4.5rem)">
    <Ticker
      variant="sky"
      items={["DETIO Foundation Ltd", "ACN 699 651 771", "Not-for-profit", "Technology for public benefit"]}
      label="Foundation identity"
    />
  </div>
</Base>
