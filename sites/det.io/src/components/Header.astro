---
import { NAV } from "@data/site";
import Lockup from "@components/brand/Lockup.astro";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => current === href || (href !== "/" && current.startsWith(href + "/"));
---

<header class="sticky top-0 z-50 border-b border-hairline bg-paper/92 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="DET.io Foundation home">
      <Lockup size={36} foundation />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                  isCurrent(item.href)
                    ? "text-blue-deep underline decoration-2 underline-offset-8"
                    : "text-text-muted hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href="/launch"
        class="rounded-md bg-blue-deep px-3.5 py-1.5 font-display text-sm font-semibold text-white transition-colors hover:bg-blue-mid"
      >
        Updates
      </a>
      <a
        href="https://virtengine.com"
        rel="noopener"
        class="rounded-md border border-hairline-strong bg-surface px-3.5 py-1.5 font-display text-sm font-semibold text-ink transition-colors hover:border-blue-deep hover:text-blue-deep"
      >
        virtengine.com
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md border border-hairline-strong text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation menu"
    >
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path class="icon-open" d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15"></path>
        <path class="icon-close hidden" d="M4 4l12 12M16 4L4 16"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Primary mobile" hidden class="border-t border-hairline bg-paper lg:hidden">
    <ul class="container-site flex flex-col gap-1 py-4">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2.5 font-display text-base font-medium",
                isCurrent(item.href) ? "text-blue-deep" : "text-text-muted hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 px-3 pb-2">
        <a
          href="/launch"
          class="mb-2 block rounded-md border border-blue-deep px-4 py-2.5 text-center font-display text-sm font-semibold text-blue-deep"
        >
          Get updates
        </a>
        <a
          href="https://virtengine.com"
          rel="noopener"
          class="block rounded-md bg-blue-deep px-4 py-2.5 text-center font-display text-sm font-semibold text-white"
        >
          virtengine.com
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Minimal mobile-nav toggle; the site is otherwise zero client JS.
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation menu" : "Close navigation menu");
    if (nav) nav.hidden = open;
    toggle.querySelector(".icon-open")?.classList.toggle("hidden", !open);
    toggle.querySelector(".icon-close")?.classList.toggle("hidden", open);
  });
</script>
