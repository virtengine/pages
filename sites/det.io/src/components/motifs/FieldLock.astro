---
/**
 * FieldLock — the public-benefit lock as a standalone motif for callouts,
 * constitution references, and footer-adjacent trust marks. Decorative.
 */
interface Props {
  size?: number;
}

const { size = 40 } = Astro.props;
---

<svg
  viewBox="0 0 48 56"
  width={size}
  height={size * 1.1667}
  fill="none"
  aria-hidden="true"
  class="field-lock"
>
  <circle cx="24" cy="24" r="21" fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="2"></circle>
  <rect x="13" y="20" width="22" height="17" rx="3.5" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
  <path d="M18 20 V14 a6 6 0 0 1 12 0 V20" stroke="var(--color-blue-deep)" stroke-width="2" fill="none"></path>
  <circle cx="24" cy="26" r="2.2" fill="var(--color-blue-deep)"></circle>
  <path d="M24 28.5 V33" stroke="var(--color-blue-deep)" stroke-width="2" stroke-linecap="round"></path>
  <text x="24" y="52" text-anchor="middle" font-family="var(--font-mono)" font-size="7" letter-spacing="1.5" fill="var(--color-steel)">6.1 LOCK</text>
</svg>

<style>
  .field-lock {
    flex-shrink: 0;
  }
</style>
