---
interface Props {
  /** Full text alternative for the diagram (required for accessibility) */
  label: string;
  caption?: string;
  class?: string;
}

const { label, caption, class: className } = Astro.props;
---

<figure
  class:list={[
    "diagram-frame overflow-hidden rounded-frame border border-hairline bg-gradient-to-b from-surface to-vellum p-3 sm:p-5 md:p-10",
    className,
  ]}
>
  <div role="img" aria-label={label}>
    <slot />
  </div>
  {caption && <figcaption class="mt-4 border-t border-hairline pt-3 font-mono text-xs text-text-soft">{caption}</figcaption>}
</figure>

<style>
  .diagram-frame > div { min-width: 0; }
  .diagram-frame :global(svg) { display: block; width: 100%; height: auto; margin-inline: auto; }

  @media (min-width: 1024px) {
    .diagram-frame :global(svg) { min-width: min(100%, 940px); }
  }

  @media (max-width: 767px) {
    .diagram-frame :global(svg) { min-width: 0 !important; max-width: 100%; }
  }
</style>
