---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  rel?: string;
}

const { href, variant = "primary", rel } = Astro.props;

const classes = {
  primary: "btn-hard btn-hard--sm",
  secondary: "btn-hard btn-hard--sm btn-hard--paper",
  ghost: "f-link",
}[variant];
---

<a href={href} rel={rel} class={classes}>
  <slot />
  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 8h10M9 4l4 4-4 4"></path>
  </svg>
</a>
