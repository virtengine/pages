---
import RegisterMark from "@components/brand/RegisterMark.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Unused. The seal motif was decorative and is not part of The Record. */
  seal?: boolean;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="q-hero">
  <div class="container-site relative grid gap-4 py-14 md:py-20">
    <p class="folio">
      <RegisterMark />
      <span>{eyebrow}</span>
    </p>
    <span class="record-rule" aria-hidden="true"></span>
    <h1 class="q-hero-title max-w-3xl">{title}</h1>
    {lede && <p class="prose-inst max-w-2xl text-lg">{lede}</p>}
    <slot />
  </div>
</div>
