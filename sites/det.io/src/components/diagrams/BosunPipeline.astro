---
/**
 * Bosun orchestration lifecycle: task boards feed the supervisor/planner,
 * which routes work across a weighted executor pool; results pass PR gates
 * (CI, review, auto-rebase, merge on green); the observe/recover band —
 * autofix, circuit breakers, heartbeat stale-claim reclaim — closes the loop
 * back to the board, with operators in control via Telegram and the Mini App.
 * Wrapped by DiagramFrame which carries the label.
 */
---

<svg viewBox="0 0 880 560" class="h-auto w-full min-w-[680px]" fill="none" aria-hidden="true">
  <defs>
    <marker id="bp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- operator band -->
  <text x="40" y="34" font-family="var(--font-mono)" font-size="11" letter-spacing="2" fill="var(--color-text-soft)">OPERATORS — HUMANS IN COMMAND</text>
  <path d="M40 44 H840" stroke="var(--color-hairline)" stroke-width="1"></path>
  <g>
    <rect x="250" y="58" width="180" height="52" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="340" y="80" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Telegram bot</text>
    <text x="340" y="98" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">30+ commands · sentinel</text>
  </g>
  <g>
    <rect x="450" y="58" width="180" height="52" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="540" y="80" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Mini App dashboard</text>
    <text x="540" y="98" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">+ optional WhatsApp</text>
  </g>
  <g stroke="var(--color-steel)" stroke-width="1.3" stroke-dasharray="3 5">
    <path d="M340 110 V150"></path>
    <path d="M540 110 V150"></path>
  </g>

  <!-- task board -->
  <g>
    <rect x="40" y="154" width="190" height="120" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="135" y="178" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Task board</text>
    <g stroke="var(--color-hairline-strong)" stroke-width="1">
      <line x1="103" y1="188" x2="103" y2="262"></line>
      <line x1="166" y1="188" x2="166" y2="262"></line>
    </g>
    <g fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="0.9">
      <rect x="52" y="196" width="40" height="14" rx="3"></rect>
      <rect x="52" y="216" width="40" height="14" rx="3"></rect>
      <rect x="52" y="236" width="40" height="14" rx="3"></rect>
      <rect x="114" y="196" width="40" height="14" rx="3"></rect>
      <rect x="114" y="216" width="40" height="14" rx="3"></rect>
      <rect x="178" y="196" width="40" height="14" rx="3" fill="var(--color-sky-wash)" stroke="var(--color-blue-mid)"></rect>
    </g>
    <text x="135" y="292" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">kanban · GitHub Issues ·</text>
    <text x="135" y="306" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">Projects v2 · Jira — 2-way sync</text>
  </g>

  <!-- supervisor -->
  <g>
    <rect x="300" y="164" width="200" height="100" rx="10" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2.2"></rect>
    <text x="400" y="196" text-anchor="middle" font-family="var(--font-display)" font-size="14" font-weight="600" fill="var(--color-ink)">Supervisor</text>
    <text x="400" y="216" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-blue-deep)">plans · decomposes · routes</text>
    <text x="400" y="234" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">weighted distribution</text>
    <text x="400" y="250" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">failover · cooldowns</text>
  </g>

  <!-- executor pool -->
  <g>
    <rect x="570" y="146" width="270" height="136" rx="10" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="705" y="170" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Executor pool</text>
    <g font-family="var(--font-mono)" font-size="10">
      <rect x="586" y="184" width="112" height="26" rx="5" fill="var(--color-vellum)" stroke="var(--color-blue-mid)" stroke-width="1.2"></rect>
      <text x="642" y="201" text-anchor="middle" fill="var(--color-ink)">copilot</text>
      <rect x="712" y="184" width="112" height="26" rx="5" fill="var(--color-vellum)" stroke="var(--color-blue-mid)" stroke-width="1.2"></rect>
      <text x="768" y="201" text-anchor="middle" fill="var(--color-ink)">claude</text>
      <rect x="586" y="218" width="112" height="26" rx="5" fill="var(--color-vellum)" stroke="var(--color-blue-mid)" stroke-width="1.2"></rect>
      <text x="642" y="235" text-anchor="middle" fill="var(--color-ink)">codex</text>
      <rect x="712" y="218" width="112" height="26" rx="5" fill="var(--color-vellum)" stroke="var(--color-blue-mid)" stroke-width="1.2"></rect>
      <text x="768" y="235" text-anchor="middle" fill="var(--color-ink)">opencode</text>
    </g>
    <text x="705" y="266" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">optional container isolation</text>
  </g>

  <!-- PR gates band -->
  <g>
    <rect x="300" y="330" width="540" height="96" rx="10" fill="var(--color-surface)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
    <text x="320" y="358" font-family="var(--font-display)" font-size="13.5" font-weight="600" fill="var(--color-ink)">PR gates</text>
    <g font-family="var(--font-mono)" font-size="10">
      <rect x="320" y="372" width="116" height="38" rx="6" fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="1.1"></rect>
      <text x="378" y="395" text-anchor="middle" fill="var(--color-ink)">create PR</text>
      <rect x="448" y="372" width="116" height="38" rx="6" fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="1.1"></rect>
      <text x="506" y="390" text-anchor="middle" fill="var(--color-ink)">monitor CI</text>
      <text x="506" y="403" text-anchor="middle" fill="var(--color-text-soft)">auto-rebase</text>
      <rect x="576" y="372" width="116" height="38" rx="6" fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="1.1"></rect>
      <text x="634" y="390" text-anchor="middle" fill="var(--color-ink)">review gate</text>
      <text x="634" y="403" text-anchor="middle" fill="var(--color-text-soft)">mandatory</text>
      <rect x="704" y="372" width="116" height="38" rx="6" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="1.4"></rect>
      <text x="762" y="390" text-anchor="middle" fill="var(--color-ink)">merge</text>
      <text x="762" y="403" text-anchor="middle" fill="var(--color-blue-deep)">on green only</text>
    </g>
    <g stroke="var(--color-blue-mid)" stroke-width="1.3" class="flow-dash" marker-end="url(#bp-arrow)">
      <path d="M436 391 H444"></path>
      <path d="M564 391 H572"></path>
      <path d="M692 391 H700"></path>
    </g>
  </g>

  <!-- observe / recover band -->
  <g>
    <rect x="40" y="466" width="800" height="60" rx="10" fill="var(--color-night)" opacity="0.045"></rect>
    <rect x="40" y="466" width="800" height="60" rx="10" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1.3" stroke-dasharray="5 5"></rect>
    <text x="60" y="492" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Observe &amp; recover</text>
    <text x="60" y="512" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">execution ledger · autofix patterns · circuit breakers · heartbeat stale-claim reclaim · escalate to operator</text>
  </g>

  <!-- flows -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#bp-arrow)">
    <path d="M230 210 H296"></path>
    <path d="M500 200 Q535 190 566 190"></path>
    <path d="M705 282 Q705 300 660 320 Q640 328 620 328"></path>
  </g>
  <g stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#bp-arrow)" style="animation-delay: -1.1s">
    <path d="M570 426 V462"></path>
    <path d="M48 462 Q48 380 48 278"></path>
  </g>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">
    <text x="240" y="200">claim task</text>
    <text x="508" y="180">route</text>
    <text x="582" y="450">observe</text>
    <text x="66" y="356">re-queue · update board</text>
  </g>
</svg>
