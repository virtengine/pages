---
/**
 * Abstract "decentralized systems" hero artwork: a node lattice converging
 * on the foundation seal — capital and control kept structurally apart from
 * the protected center. Decorative only; parent supplies the text alternative.
 */
---

<svg viewBox="0 0 560 480" class="h-auto w-full" fill="none" aria-hidden="true">
  <!-- faint lattice field -->
  <g stroke="var(--color-hairline)" stroke-width="1">
    <path d="M60 90 L170 60 L280 96 L390 58 L500 92"></path>
    <path d="M40 220 L150 180 L280 214 L410 178 L520 216"></path>
    <path d="M60 372 L180 400 L280 356 L390 402 L500 370"></path>
    <path d="M60 90 L40 220 L60 372"></path>
    <path d="M170 60 L150 180 L180 400"></path>
    <path d="M390 58 L410 178 L390 402"></path>
    <path d="M500 92 L520 216 L500 370"></path>
    <path d="M280 96 L280 214 M280 356 L280 300"></path>
  </g>

  <!-- connective spokes into the seal -->
  <g stroke="var(--color-hairline-strong)" stroke-width="1.2">
    <path d="M150 180 L226 216"></path>
    <path d="M410 178 L334 216"></path>
    <path d="M180 400 L232 300"></path>
    <path d="M390 402 L328 300"></path>
    <path d="M280 214 L280 186"></path>
  </g>

  <!-- animated flows toward the center -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash">
    <path d="M60 90 Q160 140 224 210"></path>
    <path d="M500 92 Q400 140 336 210"></path>
    <path d="M60 372 Q170 330 228 288"></path>
    <path d="M500 370 Q390 330 332 288"></path>
  </g>

  <!-- peripheral nodes -->
  <g fill="var(--color-sky)">
    <circle cx="60" cy="90" r="5" class="node-pulse"></circle>
    <circle cx="170" cy="60" r="3.5" class="node-pulse" style="animation-delay: -0.6s"></circle>
    <circle cx="280" cy="96" r="4" class="node-pulse" style="animation-delay: -1.2s"></circle>
    <circle cx="390" cy="58" r="3.5" class="node-pulse" style="animation-delay: -1.8s"></circle>
    <circle cx="500" cy="92" r="5" class="node-pulse" style="animation-delay: -2.4s"></circle>
    <circle cx="150" cy="180" r="4" class="node-pulse" style="animation-delay: -0.9s"></circle>
    <circle cx="410" cy="178" r="4" class="node-pulse" style="animation-delay: -2.1s"></circle>
    <circle cx="40" cy="220" r="3.5" class="node-pulse" style="animation-delay: -1.5s"></circle>
    <circle cx="520" cy="216" r="3.5" class="node-pulse" style="animation-delay: -2.7s"></circle>
    <circle cx="60" cy="372" r="5" class="node-pulse" style="animation-delay: -0.3s"></circle>
    <circle cx="180" cy="400" r="3.5" class="node-pulse" style="animation-delay: -1.1s"></circle>
    <circle cx="280" cy="356" r="4" class="node-pulse" style="animation-delay: -1.9s"></circle>
    <circle cx="390" cy="402" r="3.5" class="node-pulse" style="animation-delay: -2.5s"></circle>
    <circle cx="500" cy="370" r="5" class="node-pulse" style="animation-delay: -0.7s"></circle>
  </g>

  <!-- central foundation seal -->
  <g>
    <circle cx="280" cy="252" r="86" fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="2.4"></circle>
    <circle cx="280" cy="252" r="76" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1"></circle>
    <circle cx="280" cy="252" r="96" fill="none" stroke="var(--color-hairline)" stroke-width="1" class="ring-breathe"></circle>

    <!-- hex network mark -->
    <g stroke="var(--color-blue-deep)" stroke-width="2.2" fill="none">
      <path d="M280 204 L321 228 L321 276 L280 300 L239 276 L239 228 Z"></path>
      <path d="M280 204 V238 M321 228 L292 245 M321 276 L292 259 M280 300 V266 M239 276 L268 259 M239 228 L268 245"></path>
    </g>
    <g fill="var(--color-blue-deep)">
      <circle cx="280" cy="204" r="5"></circle>
      <circle cx="321" cy="228" r="5"></circle>
      <circle cx="321" cy="276" r="5"></circle>
      <circle cx="280" cy="300" r="5"></circle>
      <circle cx="239" cy="276" r="5"></circle>
      <circle cx="239" cy="228" r="5"></circle>
    </g>
    <circle cx="280" cy="252" r="8" fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="2.4"></circle>

    <!-- lock keyhole under the seal: the public-benefit lock -->
    <g transform="translate(280 344)">
      <rect x="-14" y="-8" width="28" height="22" rx="4" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
      <path d="M-8 -8 V-14 a8 8 0 0 1 16 0 V-8" stroke="var(--color-blue-deep)" stroke-width="2" fill="none"></path>
      <circle cx="0" cy="1" r="2.6" fill="var(--color-blue-deep)"></circle>
      <path d="M0 3 V8" stroke="var(--color-blue-deep)" stroke-width="2" stroke-linecap="round"></path>
    </g>
  </g>

  <!-- caption chips -->
  <g font-family="var(--font-mono)" font-size="10.5" fill="var(--color-text-soft)">
    <text x="34" y="46" letter-spacing="1.5">DECENTRALIZED INFRASTRUCTURE</text>
    <text x="392" y="452" letter-spacing="1.5">HELD FOR PUBLIC BENEFIT</text>
  </g>
</svg>
