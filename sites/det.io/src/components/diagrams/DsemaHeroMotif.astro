---
/**
 * Animated hero motif for the DSEMA program page: five specialized agents
 * over the on-chain control plane, with the two improvement loops sketched
 * as circulating dashes. Pure CSS animation (flow-dash / node-pulse /
 * ring-breathe) — collapses under prefers-reduced-motion. Decorative:
 * aria-hidden, the hero copy carries the meaning.
 */
---

<svg viewBox="0 0 760 250" class="h-auto w-full max-w-3xl" fill="none" aria-hidden="true">
  <defs>
    <marker id="hm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- agent row -->
  <g font-family="var(--font-mono)" font-size="9.5">
    {
      [
        { x: 60, label: "code", pulse: false },
        { x: 200, label: "research", pulse: false },
        { x: 340, label: "data", pulse: true },
        { x: 480, label: "manager", pulse: false },
        { x: 620, label: "spawned", pulse: false, dashed: true },
      ].map((a) => (
        <g class={a.pulse ? "node-pulse" : undefined}>
          <rect
            x={a.x}
            y="26"
            width="86"
            height="44"
            rx="7"
            fill="var(--color-surface)"
            stroke="var(--color-hairline-strong)"
            stroke-width="1.4"
            stroke-dasharray={a.dashed ? "5 4" : undefined}
          />
          <circle cx={a.x + 16} cy="48" r="4.5" fill="var(--color-sky)" />
          <text x={a.x + 30} y="52" fill="var(--color-ink)">{a.label}</text>
        </g>
      ))
    }
  </g>

  <!-- peer links between agents -->
  <g stroke="var(--color-hairline-strong)" stroke-width="1" stroke-dasharray="2 5">
    <path d="M146 48 H200"></path>
    <path d="M286 48 H340"></path>
    <path d="M426 48 H480"></path>
    <path d="M566 48 H620"></path>
  </g>

  <!-- flows down to the chain -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.4" class="flow-dash" marker-end="url(#hm-arrow)">
    <path d="M103 70 V128"></path>
    <path d="M383 70 V128"></path>
    <path d="M663 70 V128"></path>
  </g>
  <text x="392" y="106" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">performance records</text>

  <!-- chain plate -->
  <g>
    <rect x="40" y="132" width="680" height="54" rx="9" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
    <text x="60" y="165" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Blockchain control plane</text>
    <g font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">
      <text x="266" y="164">registry</text>
      <text x="352" y="164">performance log</text>
      <text x="490" y="164">tasking</text>
      <text x="572" y="164">governance</text>
    </g>
    <circle cx="700" cy="159" r="6" fill="none" stroke="var(--color-blue-deep)" stroke-width="1.6" class="ring-breathe"></circle>
  </g>

  <!-- loop 1: verified ADAPT back to an agent -->
  <path d="M540 186 Q540 216 500 216 H120 Q84 216 84 190 Q84 96 100 76" stroke="var(--color-blue-mid)" stroke-width="1.4" class="flow-dash" marker-end="url(#hm-arrow)"></path>
  <text x="240" y="236" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-blue-deep)">verified ADAPT instruction — LoRA fine-tune, on the record</text>

  <!-- constitutional guard -->
  <g>
    <rect x="596" y="200" width="148" height="30" rx="5" fill="var(--color-surface)" stroke="var(--color-amber-deep)" stroke-width="1.3" stroke-dasharray="6 4"></rect>
    <text x="670" y="219" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" letter-spacing="1" fill="var(--color-amber-deep)">SAFETY LAYER</text>
    <path d="M670 200 V186" stroke="var(--color-amber-deep)" stroke-width="1.2" stroke-dasharray="3 4"></path>
  </g>
</svg>
