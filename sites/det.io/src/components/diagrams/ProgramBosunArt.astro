---
/**
 * Program-card artwork for Bosun: a kanban task board feeding a supervisor
 * that routes work across an executor pool, gated by PR checks, with the
 * observe/recover loop returning to the board. Decorative (card art).
 */
---

<svg viewBox="0 0 420 180" class="h-auto w-full" fill="none" aria-hidden="true">
  <defs>
    <marker id="pba" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- task board -->
  <g>
    <rect x="16" y="42" width="88" height="96" rx="6" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="60" y="60" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink)">task board</text>
    <g stroke="var(--color-hairline-strong)" stroke-width="1">
      <line x1="45" y1="66" x2="45" y2="130"></line>
      <line x1="75" y1="66" x2="75" y2="130"></line>
    </g>
    <g fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="0.8">
      <rect x="22" y="72" width="18" height="10" rx="2"></rect>
      <rect x="22" y="86" width="18" height="10" rx="2"></rect>
      <rect x="22" y="100" width="18" height="10" rx="2"></rect>
      <rect x="51" y="72" width="18" height="10" rx="2"></rect>
      <rect x="51" y="86" width="18" height="10" rx="2"></rect>
      <rect x="81" y="72" width="18" height="10" rx="2" fill="var(--color-sky-wash)" stroke="var(--color-blue-mid)"></rect>
    </g>
  </g>

  <!-- supervisor core -->
  <g>
    <rect x="150" y="66" width="96" height="48" rx="8" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
    <text x="198" y="87" text-anchor="middle" font-family="var(--font-display)" font-size="11.5" font-weight="600" fill="var(--color-ink)">supervisor</text>
    <text x="198" y="102" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-blue-deep)">plan · route · recover</text>
  </g>

  <!-- executor pool -->
  <g font-family="var(--font-mono)" font-size="9">
    <rect x="288" y="34" width="76" height="24" rx="5" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="326" y="49" text-anchor="middle" fill="var(--color-ink)">copilot</text>
    <rect x="288" y="66" width="76" height="24" rx="5" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="326" y="81" text-anchor="middle" fill="var(--color-ink)">claude</text>
    <rect x="288" y="98" width="76" height="24" rx="5" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="326" y="113" text-anchor="middle" fill="var(--color-ink)">codex</text>
  </g>

  <!-- PR gate -->
  <g>
    <circle cx="394" cy="78" r="15" fill="var(--color-surface)" stroke="var(--color-blue-deep)" stroke-width="1.8"></circle>
    <path d="M387.5 78.5l4 4 8-9" stroke="var(--color-blue-deep)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    <text x="394" y="52" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-text-soft)">pr gate</text>
  </g>

  <!-- flows -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.5" class="flow-dash" marker-end="url(#pba)">
    <path d="M106 90 H146"></path>
    <path d="M248 76 Q266 60 284 48"></path>
    <path d="M248 90 H284"></path>
    <path d="M248 104 Q266 108 284 110"></path>
  </g>
  <g stroke="var(--color-blue-mid)" stroke-width="1.5" class="flow-dash" marker-end="url(#pba)" style="animation-delay: -0.9s">
    <path d="M366 78 H377"></path>
    <path d="M394 95 Q394 156 210 158 Q80 158 62 142"></path>
  </g>

  <g font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">
    <text x="112" y="82">claim</text>
    <text x="252" y="46">route</text>
    <text x="140" y="174">observe · recover · merge on green</text>
  </g>

  <!-- operator strip -->
  <rect x="150" y="24" width="96" height="1.6" fill="var(--color-steel)" opacity="0.55"></rect>
  <text x="198" y="18" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-text-soft)">operator: telegram · mini app</text>
</svg>
