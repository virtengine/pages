---
/**
 * Trusted processing — the lock-and-key figure. Encrypted identity scopes
 * reach an attestation gate; only if the enclave's measurement is
 * verified on-chain (x/enclave) is data released into the confidential
 * VM (SEV-SNP / SGX / Nitro), drawn as a night-navy vault with a lock.
 * Keys are derived and sealed in hardware (vTPM); operator, provider and
 * foundation access paths are blocked; only results (trust score,
 * pass/fail) leave. Text alternative carried by DiagramFrame.
 */
---

<svg viewBox="0 0 880 520" class="h-auto w-full min-w-[720px]" fill="none" aria-hidden="true">
  <defs>
    <marker id="tp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
    <marker id="tp-block" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="9" markerHeight="9">
      <path d="M2 2 L10 10 M10 2 L2 10" stroke="var(--color-amber-deep)" stroke-width="2.2" stroke-linecap="round"></path>
    </marker>
  </defs>

  <!-- source: sealed data -->
  <g>
    <rect x="40" y="96" width="200" height="96" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <text x="140" y="126" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Encrypted identity scopes</text>
    <text x="140" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">documents · liveness · biometric</text>
    <text x="140" y="161" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">hardware attestation — encrypted</text>
    <text x="140" y="176" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">in the wallet before upload</text>
  </g>

  <!-- attestation gate -->
  <g>
    <rect x="286" y="60" width="152" height="180" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-blue-deep)" stroke-width="2"></rect>
    <text x="362" y="88" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Attestation gate</text>
    <g font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">
      <text x="362" y="110" text-anchor="middle">enclave produces a signed</text>
      <text x="362" y="124" text-anchor="middle">measurement of its exact code</text>
      <text x="362" y="146" text-anchor="middle" fill="var(--color-blue-deep)">verified on-chain — x/enclave</text>
      <text x="362" y="162" text-anchor="middle">SGX · SEV-SNP · Nitro verifiers</text>
      <text x="362" y="178" text-anchor="middle">AMD KDS cert chain</text>
      <text x="362" y="192" text-anchor="middle">VCEK → ASK → ARK · TCB checks</text>
    </g>
    <text x="362" y="222" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" letter-spacing="0.8" fill="var(--color-blue-deep)">NO PROOF → NO DATA</text>
  </g>

  <path d="M240 144 H282" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#tp-arrow)"></path>
  <path d="M438 144 H484" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#tp-arrow)"></path>
  <text x="443" y="132" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">released only</text>
  <text x="443" y="145" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">after proof</text>

  <!-- the vault: confidential VM -->
  <g>
    <rect x="488" y="52" width="352" height="256" rx="12" fill="var(--color-night)" stroke="var(--color-navy)" stroke-width="2.5"></rect>
    <!-- lock on the border -->
    <g transform="translate(640 32)">
      <rect x="0" y="14" width="48" height="36" rx="7" fill="var(--color-sky)" stroke="var(--color-night)" stroke-width="2"></rect>
      <path d="M10 14 V8 a14 14 0 0 1 28 0 V14" stroke="var(--color-sky)" stroke-width="5" fill="none"></path>
      <circle cx="24" cy="30" r="5" fill="var(--color-night)"></circle>
      <path d="M24 33 V41" stroke="var(--color-night)" stroke-width="3.5" stroke-linecap="round"></path>
    </g>
    <text x="664" y="106" text-anchor="middle" font-family="var(--font-display)" font-size="13.5" font-weight="600" fill="var(--color-night-text)">Trusted processing unit</text>
    <text x="664" y="124" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-night-muted)">confidential VM — AMD SEV-SNP · Intel SGX · AWS Nitro</text>

    <rect x="512" y="140" width="304" height="44" rx="7" fill="var(--color-night-panel)" stroke="var(--color-night-hairline)" stroke-width="1.4"></rect>
    <text x="664" y="158" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-sky-bright)">VEID scoring service + ML models</text>
    <text x="664" y="174" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-night-muted)">liveness · face match · document checks — measured code</text>

    <!-- key chip -->
    <rect x="512" y="196" width="304" height="44" rx="7" fill="var(--color-night-panel)" stroke="var(--color-night-hairline)" stroke-width="1.4"></rect>
    <g transform="translate(528 208)" stroke="var(--color-sky-bright)" stroke-width="2.2" stroke-linecap="round">
      <circle cx="8" cy="10" r="6" fill="none"></circle>
      <path d="M13 10 H34 M27 10 V16 M32 10 V15"></path>
    </g>
    <text x="576" y="215" font-family="var(--font-mono)" font-size="10" fill="var(--color-sky-bright)">keys derived + sealed in hardware</text>
    <text x="576" y="230" font-family="var(--font-mono)" font-size="9" fill="var(--color-night-muted)">vTPM sealing · memory encrypted by the CPU</text>

    <text x="664" y="270" text-anchor="middle" font-family="var(--font-sans)" font-size="9.8" fill="var(--color-night-muted)">designed so that no one — including operators —</text>
    <text x="664" y="286" text-anchor="middle" font-family="var(--font-sans)" font-size="9.8" fill="var(--color-night-muted)">can open the processing environment</text>
  </g>

  <!-- blocked access paths -->
  <g font-family="var(--font-mono)" font-size="9.5">
    <g stroke="var(--color-amber-deep)" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#tp-block)">
      <path d="M540 396 Q560 360 580 316"></path>
      <path d="M664 396 V316"></path>
      <path d="M788 396 Q768 360 748 316"></path>
    </g>
    <rect x="484" y="400" width="112" height="34" rx="6" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="540" y="421" text-anchor="middle" fill="var(--color-text-muted)">host operator</text>
    <rect x="608" y="400" width="112" height="34" rx="6" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="664" y="421" text-anchor="middle" fill="var(--color-text-muted)">provider</text>
    <rect x="732" y="400" width="112" height="34" rx="6" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></rect>
    <text x="788" y="421" text-anchor="middle" fill="var(--color-text-muted)">foundation</text>
    <text x="664" y="458" text-anchor="middle" fill="var(--color-amber-deep)" letter-spacing="0.8">NO INSPECTION PATH INTO THE ENCLAVE — FOR ANYONE</text>
  </g>

  <!-- results out -->
  <path d="M488 276 Q420 276 340 276 Q260 276 220 300" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#tp-arrow)"></path>
  <g>
    <rect x="40" y="304" width="200" height="88" rx="9" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="1.8"></rect>
    <text x="140" y="332" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--color-ink)">Only results leave</text>
    <text x="140" y="352" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">trust score · pass / fail</text>
    <text x="140" y="367" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">written to chain state —</text>
    <text x="140" y="382" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">never raw biometric data</text>
  </g>

  <text x="440" y="504" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" fill="var(--color-text-muted)">Attestation proves the exact measured code is running before any data is released to it — trust is verified, not assumed.</text>
</svg>
