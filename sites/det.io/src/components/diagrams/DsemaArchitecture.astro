---
/**
 * DSEMA architecture, faithful to the v1.0.5 specification (§2.1 FIG.1):
 * a heterogeneous collective of specialized AI agents over a peer-to-peer
 * network; a blockchain orchestration layer (agent registry, performance
 * log, tasking, governance contracts) as the active control plane; the
 * off-chain Performance Evaluation and Model Adaptation modules forming
 * the Individual Agent Improvement Loop; the Meta-Cognitive Governance
 * Module forming the second loop; and the Decentralized Knowledge
 * Repository, Autonomous Reputation System, and Constitutional Safety
 * Layer. Wrapped by DiagramFrame which carries the text alternative.
 */
---

<svg viewBox="0 0 920 640" class="h-auto w-full min-w-[760px]" fill="none" aria-hidden="true">
  <defs>
    <marker id="ds-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
    <marker id="ds-guard" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-amber-deep)"></path>
    </marker>
  </defs>

  <!-- agent collective -->
  <text x="40" y="34" font-family="var(--font-mono)" font-size="11" letter-spacing="2" fill="var(--color-text-soft)">SPECIALIZED AGENT COLLECTIVE — HETEROGENEOUS MODELS, DID PER AGENT</text>
  <path d="M40 44 H880" stroke="var(--color-hairline)" stroke-width="1"></path>

  <g font-family="var(--font-mono)" font-size="10">
    <g>
      <rect x="70" y="62" width="130" height="58" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
      <text x="135" y="86" text-anchor="middle" fill="var(--color-ink)">agent · code</text>
      <text x="135" y="104" text-anchor="middle" fill="var(--color-text-soft)">did:dsema:a1</text>
    </g>
    <g>
      <rect x="230" y="62" width="130" height="58" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
      <text x="295" y="86" text-anchor="middle" fill="var(--color-ink)">agent · research</text>
      <text x="295" y="104" text-anchor="middle" fill="var(--color-text-soft)">did:dsema:a2</text>
    </g>
    <g>
      <rect x="390" y="62" width="130" height="58" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
      <text x="455" y="86" text-anchor="middle" fill="var(--color-ink)">agent · data</text>
      <text x="455" y="104" text-anchor="middle" fill="var(--color-text-soft)">did:dsema:a3</text>
    </g>
    <g>
      <rect x="550" y="62" width="140" height="58" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
      <text x="620" y="86" text-anchor="middle" fill="var(--color-ink)">manager agent</text>
      <text x="620" y="104" text-anchor="middle" fill="var(--color-text-soft)">DAG task split</text>
    </g>
    <g>
      <rect x="720" y="62" width="130" height="58" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4" stroke-dasharray="6 5"></rect>
      <text x="785" y="86" text-anchor="middle" fill="var(--color-ink)">spawned agent</text>
      <text x="785" y="104" text-anchor="middle" fill="var(--color-text-soft)">bootstrapped</text>
    </g>
  </g>
  <text x="70" y="142" font-family="var(--font-sans)" font-size="10.5" fill="var(--color-text-soft)">each agent: generative model + sandboxed secure execution environment + verifiable credentials</text>

  <!-- task execution down to evaluation -->
  <path d="M295 120 V180" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <text x="306" y="160" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">task execution</text>

  <!-- evaluation module -->
  <g>
    <rect x="160" y="184" width="270" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="295" y="210" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Performance Evaluation Module</text>
    <text x="295" y="230" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">structured metrics · off-chain compute</text>
  </g>

  <!-- record to chain -->
  <path d="M295 246 V306" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <text x="306" y="284" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">append performance record</text>

  <!-- orchestration layer -->
  <g>
    <rect x="70" y="310" width="780" height="118" rx="10" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2.2"></rect>
    <text x="90" y="338" font-family="var(--font-display)" font-size="14.5" font-weight="600" fill="var(--color-ink)">Blockchain Orchestration Layer — active control plane, not a passive ledger</text>
    <g font-family="var(--font-mono)" font-size="10.5">
      <rect x="90" y="354" width="170" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="175" y="376" text-anchor="middle" fill="var(--color-ink)">agent registry</text>
      <text x="175" y="394" text-anchor="middle" fill="var(--color-text-soft)">DIDs · model hashes</text>

      <rect x="280" y="354" width="170" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="365" y="376" text-anchor="middle" fill="var(--color-ink)">performance log</text>
      <text x="365" y="394" text-anchor="middle" fill="var(--color-text-soft)">append-only · roll-ups</text>

      <rect x="470" y="354" width="170" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="555" y="376" text-anchor="middle" fill="var(--color-ink)">tasking contract</text>
      <text x="555" y="394" text-anchor="middle" fill="var(--color-text-soft)">DAG sub-tasks</text>

      <rect x="660" y="354" width="170" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="745" y="376" text-anchor="middle" fill="var(--color-ink)">governance</text>
      <text x="745" y="394" text-anchor="middle" fill="var(--color-text-soft)">proposals · votes</text>
    </g>
  </g>

  <!-- verified instruction to adaptation -->
  <path d="M640 428 V486" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <text x="652" y="464" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">verified ADAPT instruction</text>

  <!-- adaptation module -->
  <g>
    <rect x="500" y="490" width="280" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="640" y="516" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Model Adaptation Module</text>
    <text x="640" y="536" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">LoRA fine-tune · RL · prompt routing</text>
  </g>

  <!-- loop back up to agents -->
  <path d="M780 521 Q866 521 866 300 Q866 128 856 121" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <text x="860" y="568" font-family="var(--font-mono)" font-size="10" fill="var(--color-blue-deep)" text-anchor="end">loop 1 — individual improvement</text>

  <!-- meta-cognitive module -->
  <g>
    <rect x="140" y="490" width="280" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="280" y="516" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Meta-Cognitive Governance Module</text>
    <text x="280" y="536" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-soft)">collective KPIs → structural proposals</text>
  </g>
  <path d="M280 428 V486" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <path d="M140 521 Q46 521 46 380 Q46 372 66 372" stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ds-arrow)"></path>
  <text x="70" y="568" font-family="var(--font-mono)" font-size="10" fill="var(--color-blue-deep)">loop 2 — meta-cognitive adaptation</text>

  <!-- side systems: knowledge repo + reputation -->
  <g>
    <rect x="520" y="184" width="160" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="600" y="208" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Knowledge</text>
    <text x="600" y="224" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Repository</text>
    <text x="600" y="240" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">shared memory · vector index</text>
  </g>
  <g>
    <rect x="710" y="184" width="160" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="790" y="208" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Reputation</text>
    <text x="790" y="224" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">System</text>
    <text x="790" y="240" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">merit-based task allocation</text>
  </g>
  <path d="M600 246 V306" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-dasharray="3 5"></path>
  <path d="M790 246 V306" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-dasharray="3 5"></path>

  <!-- constitutional safety layer -->
  <g>
    <rect x="70" y="596" width="780" height="34" rx="6" fill="var(--color-surface)" stroke="var(--color-amber-deep)" stroke-width="1.6" stroke-dasharray="8 5"></rect>
    <text x="460" y="618" text-anchor="middle" font-family="var(--font-mono)" font-size="11" letter-spacing="1.5" fill="var(--color-amber-deep)">CONSTITUTIONAL SAFETY LAYER — HIGH-STAKES ACTIONS VALIDATED AGAINST IMMUTABLE ON-CHAIN RULES</text>
  </g>
  <path d="M460 596 V556" stroke="var(--color-amber-deep)" stroke-width="1.4" stroke-dasharray="4 5" marker-end="url(#ds-guard)"></path>
</svg>
