---
/**
 * Program-card artwork for the Identity (VEID) program: a device capturing
 * identity evidence, an encrypted scope crossing to the chain hex where
 * validators score it, and a zero-knowledge proof presented outward.
 * Decorative (card art).
 */
---

<svg viewBox="0 0 420 180" class="h-auto w-full" fill="none" aria-hidden="true">
  <defs>
    <marker id="pia" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- device -->
  <g>
    <rect x="30" y="36" width="62" height="108" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <rect x="38" y="48" width="46" height="62" rx="4" fill="var(--color-sky-wash)" stroke="var(--color-hairline)" stroke-width="1"></rect>
    <!-- face outline -->
    <circle cx="61" cy="71" r="11" stroke="var(--color-blue-deep)" stroke-width="1.5"></circle>
    <path d="M46 100 Q61 84 76 100" stroke="var(--color-blue-deep)" stroke-width="1.5"></path>
    <!-- fingerprint arcs -->
    <g stroke="var(--color-steel)" stroke-width="1.1">
      <path d="M53 126 a8 8 0 0 1 16 0"></path>
      <path d="M56.5 126 a4.5 4.5 0 0 1 9 0"></path>
    </g>
    <text x="61" y="160" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-text-soft)">on-device</text>
  </g>

  <!-- encrypted scope envelope -->
  <g>
    <rect x="128" y="72" width="66" height="36" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-deep)" stroke-width="1.6"></rect>
    <path d="M152 88v-5a9 9 0 0 1 18 0v5" stroke="var(--color-blue-deep)" stroke-width="1.6"></path>
    <rect x="149" y="88" width="24" height="14" rx="3" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="1.6"></rect>
    <text x="161" y="122" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-text-soft)">encrypted scope</text>
  </g>

  <!-- chain hex with validators -->
  <g>
    <path d="M262 48 L300 70 L300 112 L262 134 L224 112 L224 70 Z" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2"></path>
    <g fill="var(--color-blue-deep)">
      <circle cx="262" cy="48" r="3.2" class="node-pulse"></circle>
      <circle cx="300" cy="70" r="3.2" class="node-pulse" style="animation-delay: -0.7s"></circle>
      <circle cx="300" cy="112" r="3.2" class="node-pulse" style="animation-delay: -1.4s"></circle>
      <circle cx="262" cy="134" r="3.2" class="node-pulse" style="animation-delay: -2.1s"></circle>
      <circle cx="224" cy="112" r="3.2" class="node-pulse" style="animation-delay: -2.8s"></circle>
      <circle cx="224" cy="70" r="3.2" class="node-pulse" style="animation-delay: -3.5s"></circle>
    </g>
    <text x="262" y="86" text-anchor="middle" font-family="var(--font-display)" font-size="11.5" font-weight="600" fill="var(--color-ink)">consensus</text>
    <text x="262" y="101" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-blue-deep)">score, not data</text>
    <text x="262" y="158" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-text-soft)">x/veid validators</text>
  </g>

  <!-- ZK proof out -->
  <g>
    <rect x="328" y="66" width="82" height="48" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <text x="369" y="86" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-ink)">proof</text>
    <text x="369" y="100" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-blue-deep)">attribute only</text>
    <text x="369" y="130" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-text-soft)">zero-knowledge</text>
  </g>

  <!-- flows -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.5" class="flow-dash" marker-end="url(#pia)">
    <path d="M96 90 H124"></path>
    <path d="M198 90 H219"></path>
    <path d="M304 90 H330"></path>
  </g>

  <g font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">
    <text x="98" y="82">capture</text>
  </g>
</svg>
