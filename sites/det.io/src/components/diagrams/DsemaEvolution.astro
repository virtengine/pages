---
/**
 * The DSEMA evolution engine as a five-station cycle: monitor → trigger →
 * adapt → validate → select (fork or cull). Each station is a
 * data-step group so the page's stepper island can highlight it
 * (.stage-live / .is-active added by JS — without JS the whole loop
 * renders at full strength). Text alternative carried by DiagramFrame.
 */
---

<svg viewBox="0 0 880 470" class="h-auto w-full min-w-[720px]" fill="none" aria-hidden="true" data-evolution-svg>
  <defs>
    <marker id="ev-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- center annotation -->
  <g>
    <circle cx="440" cy="235" r="58" fill="var(--color-vellum)" stroke="var(--color-hairline-strong)" stroke-width="1.3"></circle>
    <circle cx="440" cy="235" r="66" fill="none" stroke="var(--color-hairline)" stroke-width="1" class="ring-breathe"></circle>
    <text x="440" y="228" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">every cycle</text>
    <text x="440" y="243" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">recorded</text>
    <text x="440" y="258" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">on-chain</text>
  </g>

  <!-- ring arrows -->
  <g stroke="var(--color-blue-mid)" stroke-width="1.6" class="flow-dash" marker-end="url(#ev-arrow)">
    <path d="M262 116 Q300 88 336 78"></path>
    <path d="M544 78 Q580 88 618 116"></path>
    <path d="M730 196 Q736 250 706 300"></path>
    <path d="M600 372 Q520 404 358 394"></path>
    <path d="M172 340 Q136 260 158 168"></path>
  </g>

  <!-- 1 · monitor -->
  <g class="io-stage" data-step="1">
    <rect x="37" y="51" width="230" height="122" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="42" y="56" width="220" height="112" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <circle cx="66" cy="80" r="12" fill="var(--color-blue-deep)"></circle>
    <text x="66" y="84.5" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#ffffff">1</text>
    <text x="90" y="85" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Monitor</text>
    <text x="152" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">evaluation module scores</text>
    <text x="152" y="127" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">every task execution</text>
    <text x="152" y="142" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">M = ⟨outcome quality</text>
    <text x="152" y="157" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">efficiency contribution⟩</text>
  </g>

  <!-- 2 · trigger -->
  <g class="io-stage" data-step="2">
    <rect x="325" y="18" width="230" height="122" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="330" y="23" width="220" height="112" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <circle cx="354" cy="47" r="12" fill="var(--color-blue-deep)"></circle>
    <text x="354" y="51.5" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#ffffff">2</text>
    <text x="378" y="52" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Trigger</text>
    <text x="440" y="79" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">on-chain guard: performance</text>
    <text x="440" y="94" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">shift beyond threshold ∧</text>
    <text x="440" y="109" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">reputation above minimum</text>
    <text x="440" y="124" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-blue-deep)">→ signed ADAPT event</text>
  </g>

  <!-- 3 · adapt -->
  <g class="io-stage" data-step="3">
    <rect x="613" y="51" width="230" height="122" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="618" y="56" width="220" height="112" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <circle cx="642" cy="80" r="12" fill="var(--color-blue-deep)"></circle>
    <text x="642" y="84.5" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#ffffff">3</text>
    <text x="666" y="85" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Adapt</text>
    <text x="728" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">LoRA fine-tune in sandbox</text>
    <text x="728" y="127" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">(rank-16 deltas) · RLHF ·</text>
    <text x="728" y="142" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">prompt routing — learning</text>
    <text x="728" y="157" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">rate tied to on-chain metrics</text>
  </g>

  <!-- 4 · validate -->
  <g class="io-stage" data-step="4">
    <rect x="593" y="295" width="230" height="122" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="598" y="300" width="220" height="112" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <circle cx="622" cy="324" r="12" fill="var(--color-blue-deep)"></circle>
    <text x="622" y="328.5" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#ffffff">4</text>
    <text x="646" y="329" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Validate</text>
    <text x="708" y="356" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">correctness gate: test suite</text>
    <text x="708" y="371" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">runs in the gVisor sandbox;</text>
    <text x="708" y="386" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">candidate benchmarked</text>
    <text x="708" y="401" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">against the incumbent</text>
  </g>

  <!-- 5 · select -->
  <g class="io-stage" data-step="5">
    <rect x="115" y="295" width="250" height="122" rx="9" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="120" y="300" width="240" height="112" rx="9" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <circle cx="144" cy="324" r="12" fill="var(--color-blue-deep)"></circle>
    <text x="144" y="328.5" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#ffffff">5</text>
    <text x="168" y="329" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Select — fork or cull</text>
    <text x="240" y="356" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">pass → hot-swap new version,</text>
    <text x="240" y="371" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">register weight hash on-chain</text>
    <text x="240" y="386" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">fail → rollback; persistent</text>
    <text x="240" y="401" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">laggards culled by percentile</text>
  </g>
</svg>
