---
/**
 * The VirtEngine marketplace lifecycle as one map: tenant and provider
 * over the chain, provider daemon and clusters below, with six stage
 * groups (order → bid → lease → deploy → usage → settlement) as
 * data-stage groups the page's stepper island can highlight
 * (.stage-live / .is-active added by JS — without JS the whole
 * lifecycle renders at full strength). Text alternative carried by
 * DiagramFrame.
 */
---

<svg viewBox="0 0 880 620" class="h-auto w-full min-w-[720px]" fill="none" aria-hidden="true" data-lifecycle-svg>
  <defs>
    <marker id="lc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-blue-mid)"></path>
    </marker>
  </defs>

  <!-- static base map -->
  <text x="40" y="34" font-family="var(--font-mono)" font-size="11" letter-spacing="2" fill="var(--color-text-soft)">MARKETPLACE LIFECYCLE — ORDER TO SETTLEMENT</text>
  <path d="M40 44 H840" stroke="var(--color-hairline)" stroke-width="1"></path>

  <g>
    <rect x="80" y="60" width="220" height="66" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <text x="190" y="88" text-anchor="middle" font-family="var(--font-display)" font-size="13.5" font-weight="600" fill="var(--color-ink)">Tenant</text>
    <text x="190" y="108" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">needs compute · VEID-verified</text>
  </g>
  <g>
    <rect x="580" y="60" width="220" height="66" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <text x="690" y="88" text-anchor="middle" font-family="var(--font-display)" font-size="13.5" font-weight="600" fill="var(--color-ink)">Provider</text>
    <text x="690" y="108" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">leases capacity · VEID-verified</text>
  </g>

  <g>
    <rect x="60" y="240" width="760" height="140" rx="10" fill="var(--color-sage)" stroke="var(--color-blue-deep)" stroke-width="2.2"></rect>
    <text x="82" y="270" font-family="var(--font-display)" font-size="14" font-weight="600" fill="var(--color-ink)">VirtEngine chain — CometBFT consensus · Cosmos SDK · single binary</text>
    <g font-family="var(--font-mono)" font-size="10">
      <rect x="82" y="286" width="168" height="74" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="166" y="310" text-anchor="middle" fill="var(--color-ink)">order book</text>
      <text x="166" y="328" text-anchor="middle" fill="var(--color-text-soft)">x/market</text>
      <text x="166" y="344" text-anchor="middle" fill="var(--color-text-soft)">x/deployment</text>

      <rect x="268" y="286" width="168" height="74" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="352" y="310" text-anchor="middle" fill="var(--color-ink)">identity gate</text>
      <text x="352" y="328" text-anchor="middle" fill="var(--color-text-soft)">x/veid · x/mfa</text>
      <text x="352" y="344" text-anchor="middle" fill="var(--color-text-soft)">trust-score thresholds</text>

      <rect x="454" y="286" width="168" height="74" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="538" y="310" text-anchor="middle" fill="var(--color-ink)">escrow</text>
      <text x="538" y="328" text-anchor="middle" fill="var(--color-text-soft)">x/escrow</text>
      <text x="538" y="344" text-anchor="middle" fill="var(--color-text-soft)">funds locked per lease</text>

      <rect x="640" y="286" width="160" height="74" rx="6" fill="var(--color-surface)" stroke="var(--color-blue-mid)" stroke-width="1.3"></rect>
      <text x="720" y="310" text-anchor="middle" fill="var(--color-ink)">settlement</text>
      <text x="720" y="328" text-anchor="middle" fill="var(--color-text-soft)">x/settlement</text>
      <text x="720" y="344" text-anchor="middle" fill="var(--color-text-soft)">x/take · x/fraud</text>
    </g>
  </g>

  <g>
    <rect x="580" y="470" width="220" height="62" rx="8" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.5"></rect>
    <text x="690" y="496" text-anchor="middle" font-family="var(--font-display)" font-size="13" font-weight="600" fill="var(--color-ink)">Provider daemon</text>
    <text x="690" y="516" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-soft)">watches chain · runs workloads</text>
  </g>
  <text x="690" y="592" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--color-ink)">Kubernetes · SLURM clusters</text>

  <!-- 01 · order -->
  <g class="io-stage" data-stage="1">
    <path d="M190 126 V236" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="101" y="151" width="240" height="60" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="106" y="156" width="230" height="50" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="128" cy="181" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="128" y="185.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">1</text>
    <text x="146" y="177" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Order placed</text>
    <text x="146" y="195" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">encrypted specs · deposit lodged</text>
  </g>

  <!-- 02 · bid -->
  <g class="io-stage" data-stage="2">
    <path d="M690 126 V236" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="539" y="151" width="240" height="60" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="544" y="156" width="230" height="50" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="566" cy="181" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="566" y="185.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">2</text>
    <text x="584" y="177" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Providers bid</text>
    <text x="584" y="195" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">priced offers · identity-gated</text>
  </g>

  <!-- 03 · lease -->
  <g class="io-stage" data-stage="3">
    <path d="M440 380 V400" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="325" y="398" width="240" height="60" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="330" y="403" width="230" height="50" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="352" cy="428" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="352" y="432.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">3</text>
    <text x="370" y="424" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Lease matched</text>
    <text x="370" y="442" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">price locked · escrow account opens</text>
  </g>

  <!-- 04 · deploy -->
  <g class="io-stage" data-stage="4">
    <path d="M760 380 V466" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <path d="M690 532 V560" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="593" y="392" width="200" height="60" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="598" y="397" width="190" height="50" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="620" cy="422" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="620" y="426.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">4</text>
    <text x="638" y="418" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Deploy</text>
    <text x="638" y="436" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">manifest → K8s / SLURM</text>
  </g>

  <!-- 05 · usage -->
  <g class="io-stage" data-stage="5">
    <path d="M576 501 Q400 501 400 384" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="145" y="463" width="240" height="60" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="150" y="468" width="230" height="50" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="172" cy="493" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="172" y="497.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">5</text>
    <text x="190" y="489" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Usage reported</text>
    <text x="190" y="507" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">signed records · hourly collection</text>
  </g>

  <!-- 06 · settlement -->
  <g class="io-stage" data-stage="6">
    <path d="M120 380 V536" stroke="var(--color-blue-mid)" stroke-width="1.7" class="flow-dash" marker-end="url(#lc-arrow)"></path>
    <rect x="55" y="540" width="330" height="66" rx="8" fill="var(--color-sky-wash)" stroke="var(--color-sky)" stroke-width="2.4" class="io-halo"></rect>
    <rect x="60" y="545" width="320" height="56" rx="7" fill="var(--color-surface)" stroke="var(--color-hairline-strong)" stroke-width="1.4"></rect>
    <circle cx="82" cy="573" r="11" fill="var(--color-blue-deep)"></circle>
    <text x="82" y="577.5" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="#ffffff">6</text>
    <text x="100" y="567" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--color-ink)">Settlement</text>
    <text x="100" y="585" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-soft)">dispute window → escrow pays provider · take fee</text>
  </g>
</svg>
