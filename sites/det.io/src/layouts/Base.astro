---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import "../styles/editorial.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@data/site";
import { fitTitle, metaDescription } from "@lib/meta";
import {
  DEFAULT_IMAGE,
  breadcrumbNode,
  logoNode,
  organizationNode,
  schemaGraph,
  webPageNode,
  webSiteNode,
  type SchemaNode,
} from "@lib/schema";

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Path for canonical URL, e.g. "/mission". Defaults to current pathname. */
  path?: string;
  breadcrumbs?: Breadcrumb[];
  ogType?: "website" | "article";
  /** Extra JSON-LD nodes merged into this page's @graph. */
  schema?: (SchemaNode | null | undefined | false)[];
  /** schema.org WebPage subtype: WebPage, CollectionPage, AboutPage, ContactPage. */
  pageType?: string;
  /** ISO date of the last material change, when the data provides one. */
  modifiedTime?: string;
  /** Keep a page out of the index. */
  noindex?: boolean;
  /** Override the social/structured-data image with an absolute or site path. */
  image?: string;
}

const {
  title,
  description,
  path,
  breadcrumbs,
  ogType = "website",
  schema = [],
  pageType = "WebPage",
  modifiedTime,
  noindex = false,
  image,
} = Astro.props;

const pathname = (path ?? Astro.url.pathname).replace(/\.html$/, "");
const canonical = new URL(pathname === "/" ? "/" : pathname.replace(/\/$/, ""), SITE.url).href;
const ogImage = image ? new URL(image, SITE.url).href : DEFAULT_IMAGE;
/** Search-display shaping only: visible page copy keeps its authored text. */
const documentTitle = fitTitle(title, { brand: "det.io" });
const searchDescription = metaDescription(description);

const graph = schemaGraph([
  logoNode(),
  organizationNode(),
  webSiteNode(),
  webPageNode({
    canonical,
    title,
    description,
    image: ogImage,
    breadcrumbs,
    type: pageType,
    dateModified: modifiedTime,
  }),
  breadcrumbs && breadcrumbs.length > 0 ? breadcrumbNode(canonical, breadcrumbs) : null,
  ...schema,
]);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={searchDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DET.io Foundation — research and governance notes"
      href={new URL("/rss.xml", SITE.url).href}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f9fb" />
    <meta name="author" content={SITE.legalName} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_AU" />
    {modifiedTime && ogType === "article" && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      for (const element of document.querySelectorAll("main *")) {
        if (element.closest("svg, script, style")) continue;
        for (const node of element.childNodes) {
          if (node.nodeType === Node.TEXT_NODE) {
            node.textContent = (node.textContent ?? "").replace(
              /\bVEID\b(?!\s*\(|-)/g,
              "VEID (Verifiable Electronic Identity)",
            );
          }
        }
      }
    </script>
  </body>
</html>
